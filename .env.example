# ================================================================
# SGD Unitrópico — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a Git.
# ================================================================

# Supabase — Crea tu proyecto en https://supabase.com
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Secreto para firmar las cookies de sesión (genera uno con: openssl rand -hex 32)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vercel — Se inyecta automáticamente en producción
# VERCEL_URL=

