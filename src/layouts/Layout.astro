---
// src/layouts/Layout.astro
import '@styles/global.css';

interface Props {
  title?: string;
}

const { title = 'SGD Unitrópico - Sistema de Gestión Documental' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <script is:inline>
    (function() {
      try {
        var isCollapsed = window.innerWidth >= 1025 && (
          localStorage.getItem('sgd_sidebar_collapsed') === 'true' ||
          localStorage.getItem('unitropico_sidebar_collapsed') === 'true' ||
          localStorage.getItem('sidebar_collapsed') === 'true' ||
          localStorage.getItem('sidebarCollapsed') === 'true'
        );
        if (isCollapsed) {
          document.documentElement.classList.add('sidebar-is-collapsed');
          document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        }
      } catch (e) {}
    })();
  </script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body style="min-height: 100vh; width: 100%; display: flex; flex-direction: column; margin: 0; padding: 0;">
  <script is:inline>
    if (document.documentElement.classList.contains('sidebar-is-collapsed')) {
      document.body.classList.add('sidebar-collapsed');
    }
  </script>
  <slot />
</body>
</html>

