---
// src/layouts/AppLayout.astro
import Layout from './Layout.astro';
import Sidebar from '@components/layout/Sidebar.astro';
import Topbar from '@components/layout/Topbar.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Dashboard — Panel de Control', activeNav = 'dashboard' } = Astro.props;
---

<Layout title={`${title} | SGD Unitrópico`}>
  <div class="app-container">
    <!-- Barra lateral -->
    <Sidebar activeNav={activeNav} />

    <!-- Telón de fondo para menú lateral en móviles y tablets -->
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Contenido principal -->
    <main class="main-wrapper">
      <Topbar title={title} />

      <div class="content-body">
        <slot />
      </div>
    </main>
  </div>

  <!-- Contenedor Toast -->
  <div class="toast-container" id="toast-container"></div>

  <!-- Modal: Centro de Notificaciones y Alertas SLA Institucionales -->
  <div class="modal-backdrop" id="rector-alerts-modal" style="display: none;">
    <div class="modal-card" style="max-width: 880px;">
      <div class="modal-header" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(0, 89, 78, 0.08) 100%);">
        <h3>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span style="color: var(--text-main);">Centro de Notificaciones y Alertas SLA Institucionales</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-rector-alerts">&times;</button>
      </div>
      <div class="modal-body">
        <div class="notif-center-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
          <div class="filter-tabs" id="notif-filter-tabs">
            <button type="button" class="filter-tab active" data-notif-filter="all">Todas</button>
            <button type="button" class="filter-tab" data-notif-filter="critical">🔴 SLA Crítico (&le;3 días)</button>
            <button type="button" class="filter-tab" data-notif-filter="petitions">Peticiones / PQRS</button>
            <button type="button" class="filter-tab" data-notif-filter="reports">Reportes Obligatorios</button>
          </div>
          <div style="display: flex; gap: 8px;">
            <button type="button" class="btn btn-secondary btn-sm" id="btn-mark-all-notifs-read" style="font-size: 0.76rem;">
              <span>✓ Marcar todas leídas</span>
            </button>
            <a href="/calendario" class="btn btn-primary btn-sm" style="font-size: 0.76rem; text-decoration: none;">
              <span>📅 Ver Calendario</span>
            </a>
          </div>
        </div>

        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.82rem; color: #991b1b; display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div>
            <strong>Control Automático de Términos (Ley 1755 / Ley 1952):</strong> Los expedientes con vencimiento en menos de 3 días hábiles disparan alertas automáticas de semáforo rojo para evitar silencios administrativos o sanciones disciplinarias.
          </div>
        </div>

        <div class="rector-alerts-grid" id="rector-alerts-list">
          <!-- Generado dinámicamente desde JS -->
        </div>
      </div>
      <div class="modal-footer" style="justify-content: space-between;">
        <span style="font-size: 0.78rem; color: var(--text-muted);">Universidad Internacional del Trópico Americano &bull; Sistema de Notificaciones</span>
        <button type="button" class="btn btn-ghost" id="btn-close-rector-alerts-footer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Conmutador de Perfiles y Simulación RBAC -->
  <div class="modal-backdrop" id="switch-user-modal" style="display: none;">
    <div class="modal-card" style="max-width: 680px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          <span>Conmutador de Perfiles Institucionales (Simulador RBAC)</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-switch-user-modal">&times;</button>
      </div>

      <div class="modal-body">
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 14px;">
          Selecciona con qué usuario deseas interactuar para comprobar inmediatamente cómo se adapta la plataforma según sus permisos asignados por el Administrador:
        </p>

        <div class="user-switcher-list" id="user-switcher-container">
          <!-- Opciones dinámicas de usuarios -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="btn-close-switch-modal-footer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Radicar Nuevo Archivo -->
  <div class="modal-backdrop" id="upload-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Radicar Nuevo Archivo</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-upload-modal">&times;</button>
      </div>

      <form id="upload-doc-form">
        <div class="modal-body">
          <div class="dropzone" id="file-dropzone">
            <input type="file" id="file-input-selector" accept=".pdf,.doc,.docx,.xlsx,.xls,.png,.jpg" style="display: none;">
            <div class="dropzone-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <div class="dropzone-text">Arrastra tu archivo aquí o haz clic para explorar</div>
            <div class="dropzone-hint">Formatos compatibles: PDF, DOCX, XLSX (Máx. 50MB)</div>
          </div>

          <div class="file-preview-card" id="file-detected-card" style="display: none;">
            <div class="doc-icon-badge pdf" id="detected-icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
              <span id="detected-format-label">PDF</span>
            </div>
            <div style="flex: 1; overflow: hidden;">
              <div style="font-weight: 700; font-size: 0.88rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" id="detected-file-name">documento_institucional.pdf</div>
              <div style="font-size: 0.74rem; color: var(--text-muted);" id="detected-file-size">1.8 MB &bull; Archivo listo para radicar</div>
            </div>
            <span style="color: var(--secondary); font-size: 0.75rem; font-weight: 700;">Detectado &check;</span>
          </div>

          <div class="form-group">
            <label class="form-label">Título o Asunto del Documento / Petición *</label>
            <input type="text" class="form-input" id="input-doc-title" placeholder="Ej: Solicitud de Información Curricular o Recurso de Grado" required>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Origen / De dónde proviene el derecho *</label>
              <select class="form-select" id="select-doc-right-origin" required>
                <option value="Art. 23 Constitución Política (Derecho de Petición)">Art. 23 Constitución Política (Derecho Fundamental de Petición)</option>
                <option value="Ley Estatutaria 1755 de 2015 (Interés Particular)">Ley Estatutaria 1755 de 2015 (Petición de Interés Particular)</option>
                <option value="Ley Estatutaria 1755 de 2015 (Interés General)">Ley Estatutaria 1755 de 2015 (Petición de Interés General)</option>
                <option value="Ley 1712 de 2014 (Acceso a la Información y Transparencia)">Ley 1712 de 2014 (Acceso a Información y Transparencia)</option>
                <option value="Ley 1437 de 2011 CPACA (Consulta Jurídica o Técnica)">Ley 1437 de 2011 CPACA (Consulta Jurídica o Técnica)</option>
                <option value="Reglamento Estudiantil y Docente Unitrópico">Reglamento Estudiantil y Docente Unitrópico</option>
                <option value="Estatuto Contractual / Petición de Contratistas">Estatuto Contractual / Petición de Proveedores</option>
                <option value="Trámite Administrativo Interno">Trámite Administrativo Interno</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Calidad / Tipo de Peticionario *</label>
              <select class="form-select" id="select-doc-applicant-type" required>
                <option value="Estudiante de Pregrado/Posgrado">Estudiante de Pregrado / Posgrado</option>
                <option value="Docente Institucional">Docente Institucional</option>
                <option value="Egresado / Graduado">Egresado / Graduado</option>
                <option value="Ciudadano / Veeduría Ciudadana">Ciudadano / Veeduría Ciudadana</option>
                <option value="Ente de Control (Procuraduría, Contraloría, MEN)">Ente de Control (Procuraduría, Contraloría, MEN)</option>
                <option value="Entidad Gubernamental (Gobernación / Alcaldía)">Entidad Gubernamental (Gobernación / Alcaldía)</option>
                <option value="Proveedor / Contratista">Proveedor / Contratista</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Nombre del Peticionario / Solicitante *</label>
              <input type="text" class="form-input" id="input-doc-applicant" placeholder="Ej: Juan Sebastián Gómez" required>
            </div>
            <div class="form-group">
              <label class="form-label">Categoría / Tipo Documental</label>
              <select class="form-select" id="select-doc-category">
                <option value="Derecho de Petición">Derecho de Petición</option>
                <option value="Auditoría">Auditoría</option>
                <option value="Financiero">Financiero</option>
                <option value="Académico">Académico</option>
                <option value="Jurídico">Jurídico</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Fecha de Subida / Radicación *</label>
              <input type="date" class="form-input" id="input-upload-date" required>
            </div>
            <div class="form-group">
              <label class="form-label">Fecha de Vencimiento / Plazo *</label>
              <input type="date" class="form-input" id="input-due-date" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Funcionario Responsable del Archivo *</label>
            <select class="form-select" id="select-doc-responsible" required>
              <!-- Dinámico desde JS -->
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Observaciones / Instrucciones</label>
            <textarea class="form-textarea" id="input-doc-notes" rows="2" placeholder="Detalles de requisitos o firmas pendientes..."></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-upload">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-doc">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Radicar Archivo</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Visor Universal Detalle -->
  <div class="modal-backdrop" id="universal-detail-modal" style="display: none;">
    <div class="modal-card" style="max-width: 760px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
          <span id="universal-modal-title">Detalle del Registro Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-universal-modal">&times;</button>
      </div>
      <div class="modal-body" id="universal-modal-content">
        <!-- Dinámico desde JS -->
      </div>
      <div class="modal-footer" style="justify-content: space-between;">
        <button type="button" class="btn btn-ghost" id="btn-close-universal-footer">Cerrar</button>
        <button type="button" class="btn btn-primary" id="btn-download-universal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Descargar Constancia / Acto Oficial</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initAppLayout } from '@scripts/appLayout';
  initAppLayout();
</script>

