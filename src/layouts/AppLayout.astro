---
// src/layouts/AppLayout.astro
import Layout from './Layout.astro';
import Sidebar from '@components/layout/Sidebar.astro';
import Topbar from '@components/layout/Topbar.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Dashboard — Panel de Control', activeNav = 'dashboard' } = Astro.props;

// Forzar no almacenamiento en caché para proteger rutas autenticadas y prevenir reingreso por historial (bfcache)
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
---

<Layout title={`${title} | SGD Unitrópico`}>
  <div class="app-container">
    <!-- Barra lateral -->
    <Sidebar activeNav={activeNav} />

    <!-- Telón de fondo para menú lateral en móviles y tablets -->
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Contenido principal -->
    <main class="main-wrapper">
      <Topbar title={title} />

      <div class="content-body">
        <slot />
      </div>
    </main>
  </div>

  <!-- Contenedor Toast -->
  <div class="toast-container" id="toast-container"></div>

  <!-- Modal: Alerta / Diálogo Institucional del Sistema (Sustituye window.alert del navegador) -->
  <div class="modal-backdrop" id="sgd-system-dialog" style="display: none; z-index: 100000;">
    <div class="modal-card" style="max-width: 440px; border-radius: 16px; border-top: 5px solid var(--verde-principal); box-shadow: 0 20px 40px rgba(0,0,0,0.2); text-align: center; padding: 28px 24px;">
      <div id="sgd-dialog-icon-wrap" style="width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; background: var(--verde-suave-bg); color: var(--verde-principal);">
        <svg id="sgd-dialog-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h3 id="sgd-dialog-title" style="font-size: 1.2rem; font-weight: 800; color: var(--text-main); margin: 0 0 8px 0;">
        Notificación Institucional
      </h3>
      <p id="sgd-dialog-message" style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 22px 0; word-break: break-word;">
      </p>
      <div id="sgd-dialog-actions" style="display: flex; gap: 10px; justify-content: center;">
        <button type="button" class="btn btn-primary" id="sgd-dialog-btn-ok" style="min-width: 120px; font-weight: 700;">
          Aceptar
        </button>
        <button type="button" class="btn btn-ghost" id="sgd-dialog-btn-cancel" style="display: none; min-width: 100px;">
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Conmutador de Perfiles y Simulación RBAC -->
  <div class="modal-backdrop" id="switch-user-modal" style="display: none;">
    <div class="modal-card" style="max-width: 680px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          <span>Conmutador de Perfiles Institucionales (Simulador RBAC)</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-switch-user-modal">&times;</button>
      </div>

      <div class="modal-body">
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 14px;">
          Selecciona con qué usuario deseas interactuar para comprobar inmediatamente cómo se adapta la plataforma según sus permisos asignados por el Administrador:
        </p>

        <div class="user-switcher-list" id="user-switcher-container">
          <!-- Opciones dinámicas de usuarios -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="btn-close-switch-modal-footer">Cerrar</button>
      </div>
    </div>
  </div>



  <!-- Modal: Conectar Correo Institucional (Google SMTP) -->
  <div class="modal-backdrop" id="modal-smtp-config" style="display: none; z-index: 99999;">
    <div class="modal-card" style="max-width: 540px; border-top: 5px solid var(--verde-principal); border-radius: 14px; box-shadow: 0 20px 40px rgba(0,0,0,0.25);">
      <div class="modal-header">
        <h3 style="display: flex; align-items: center; gap: 10px; font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--verde-principal);"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>Conectar Correo Institucional (Google)</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-smtp-modal">&times;</button>
      </div>

      <form id="form-smtp-config" class="modal-body" style="display: flex; flex-direction: column; gap: 14px;">
        <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
          Configura la cuenta oficial de Google Workspace / Gmail que remitirá automáticamente los radicados y notificaciones por correo a los responsables.
        </p>

        <div style="background: var(--verde-suave-bg); border: 1px solid var(--verde-borde); padding: 12px 14px; border-radius: 8px; font-size: 0.8rem; color: var(--verde-principal);">
          <strong>Importante (Seguridad Google):</strong> Utiliza una <strong>Contraseña de Aplicación de 16 caracteres</strong> generada en tu cuenta de Google.
          <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer" style="color: #b45309; font-weight: 700; text-decoration: underline; margin-left: 4px;">
            Generar contraseña aquí ↗
          </a>
        </div>

        <div class="form-group">
          <label style="font-size: 0.82rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 4px;">
            Correo Electrónico Institucional *
          </label>
          <input 
            type="email" 
            id="input-smtp-user" 
            required 
            placeholder="ej: correspondencia@unitropico.edu.co o tu-correo@gmail.com" 
            class="form-control" 
            style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; font-size: 0.88rem;" 
          />
        </div>

        <div class="form-group">
          <label style="font-size: 0.82rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 4px;">
            Contraseña de Aplicación Google (16 letras) *
          </label>
          <div style="position: relative;">
            <input 
              type="password" 
              id="input-smtp-pass" 
              required 
              placeholder="abcd efgh ijkl mnop" 
              autocomplete="new-password"
              class="form-control" 
              style="width: 100%; padding: 10px 40px 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; font-size: 0.88rem; font-family: monospace;" 
            />
            <button type="button" id="btn-toggle-smtp-pass" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; color: var(--text-muted);" title="Mostrar / Ocultar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <span style="font-size: 0.72rem; color: var(--text-muted); margin-top: 3px; display: block;">
            Los espacios se eliminan automáticamente. No se requiere tu contraseña habitual.
          </span>
        </div>

        <div id="smtp-status-feedback" style="display: none; padding: 10px 12px; border-radius: 6px; font-size: 0.82rem;"></div>

        <div class="modal-footer" style="padding: 12px 0 0 0; margin-top: 8px; display: flex; justify-content: flex-end; gap: 10px;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-smtp-modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-smtp-config" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span id="btn-submit-smtp-text">Verificar y Guardar Conexión</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Visor Universal Detalle -->
  <div class="modal-backdrop" id="universal-detail-modal" style="display: none;">
    <div class="modal-card" style="max-width: 760px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
          <span id="universal-modal-title">Detalle del Registro Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-universal-modal">&times;</button>
      </div>
      <div class="modal-body" id="universal-modal-content">
        <!-- Dinámico desde JS -->
      </div>
      <div class="modal-footer" style="justify-content: space-between;">
        <button type="button" class="btn btn-ghost" id="btn-close-universal-footer">Cerrar</button>
        <button type="button" class="btn btn-primary" id="btn-download-universal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Descargar Constancia / Acto Oficial</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initAppLayout } from '@scripts/appLayout';
  initAppLayout();
</script>

