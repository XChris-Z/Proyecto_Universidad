---
// src/components/layout/Topbar.astro
interface Props {
  title?: string;
}

const { title = 'Dashboard — Panel de Control' } = Astro.props;
---

<header class="topbar">
  <div class="topbar-left-wrap" style="display: flex; align-items: center; gap: 14px;">
    <!-- Botón Toggle Plegar/Desplegar Sidebar (Desktop) -->
    <button class="btn-toggle-sidebar" id="btn-toggle-sidebar-collapse" aria-label="Plegar o desplegar menú lateral" title="Plegar / Desplegar barra lateral">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <line x1="9" y1="3" x2="9" y2="21"/>
      </svg>
    </button>

    <!-- Botón Hamburguesa en Móviles -->
    <button class="btn-hamburger" id="btn-mobile-menu-toggle" aria-label="Abrir menú de navegación" title="Abrir menú de navegación">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <div class="page-header-title">
      <h1 class="page-title" id="view-title">
        {title}
        <span class="accent-dot"></span>
      </h1>
    </div>
  </div>

  <div class="topbar-actions">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="global-search-input" placeholder="Buscar documento, radicado...">
    </div>

    <div class="date-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span id="current-date-text">Octubre 2026</span>
    </div>

    <!-- Botón Conectar Correo Institucional (Modal SMTP) -->
    <button type="button" class="btn btn-secondary btn-sm" id="btn-topbar-smtp" title="Conectar o Verificar Correo Institucional (Google SMTP)" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--verde-principal);"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      <span>Correo Google</span>
    </button>

    <a href="/peticiones/subir" class="btn btn-primary" id="btn-topbar-upload" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Subir Petición</span>
    </a>
  </div>
</header>
