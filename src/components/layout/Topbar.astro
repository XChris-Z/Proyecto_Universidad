---
// src/components/layout/Topbar.astro
interface Props {
  title?: string;
}

const { title: _title = 'Dashboard — Panel de Control' } = Astro.props;
---

<header class="topbar topbar-promax">
  <div class="topbar-left-wrap">
    <!-- Botón Hamburguesa en Móviles -->
    <button class="btn-hamburger" id="btn-mobile-menu-toggle" aria-label="Abrir menú de navegación" title="Abrir menú de navegación">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <!-- Contexto Institucional Transversal (Sin título duplicado por módulo) -->
    <div class="topbar-context-bar">
      <span class="topbar-brand-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <span>SGD UNITRÓPICO</span>
      </span>

      <span class="topbar-context-sep" aria-hidden="true">/</span>

      <span class="topbar-context-subtitle">
        Plataforma de Gestión Documental y Control Institucional
      </span>

      <span class="topbar-live-pill" title="Conexión activa en tiempo real con la base documental institucional">
        <span class="topbar-live-dot" aria-hidden="true"></span>
        <span>Sincronizado en línea</span>
      </span>
    </div>
  </div>

  <div class="topbar-actions">
    <nav class="topbar-quick-links" aria-label="Accesos rápidos transversales">
      <a href="/archivos" class="topbar-quick-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Módulo Archivos</span>
      </a>
    </nav>

    <div class="date-badge">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span id="current-date-text">Noviembre 2026</span>
    </div>
  </div>
</header>

<style>
  .topbar-promax {
    min-height: 60px;
    padding: 10px 28px;
    gap: 16px;
  }

  .topbar-left-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .topbar-context-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    overflow: hidden;
  }

  .topbar-brand-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F2F7F6;
    color: #00594E;
    border: 1px solid #B2CFCB;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .topbar-context-sep {
    color: #CBD5E1;
    font-size: 0.85rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .topbar-context-subtitle {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .topbar-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #00594E;
    background: #F2F7F6;
    border: 1px solid #DCE4E3;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .topbar-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00594E;
    box-shadow: 0 0 0 0 rgba(0, 89, 78, 0.45);
    animation: topbarStatusPulse 2.2s infinite;
    flex-shrink: 0;
  }

  .topbar-quick-links {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .topbar-quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 8px;
    border: 1px solid #DCE4E3;
    background: #F8FAFC;
    color: #334155;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .topbar-quick-btn:hover {
    background: #E6F0EE;
    border-color: #B2CFCB;
    color: #00594E;
  }

  .topbar-quick-btn.is-primary {
    background: #00594E;
    border-color: #00594E;
    color: #FFFFFF;
  }

  .topbar-quick-btn.is-primary:hover {
    background: #00453C;
    border-color: #00453C;
    color: #FFFFFF;
  }

  @keyframes topbarStatusPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 89, 78, 0.45);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(0, 89, 78, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 89, 78, 0);
    }
  }

  @media (max-width: 1180px) {
    .topbar-context-subtitle,
    .topbar-context-sep {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .topbar-promax {
      padding: 10px 14px;
    }

    .topbar-live-pill {
      display: none;
    }

    .topbar-quick-btn:not(.is-primary) span {
      display: none;
    }
  }
</style>
