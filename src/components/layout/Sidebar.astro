---
// src/components/layout/Sidebar.astro
import { SESSION_COOKIE_KEY } from '@lib/constants';
import { supabase } from '@lib/supabase';

interface Props {
  activeNav?: string;
}

const { activeNav = 'dashboard' } = Astro.props;

// Obtener rol del usuario para restringir opciones exclusivas de administración
const sessionUserId = Astro.cookies.get(SESSION_COOKIE_KEY)?.value || 'usr-root';

let isAdmin = false;
if (sessionUserId === 'usr-root') {
  isAdmin = true;
} else {
  const { data: userProfile } = await supabase
    .from('profiles')
    .select('role')
    .or(`id.eq.${sessionUserId},email.eq.${sessionUserId}`)
    .maybeSingle();
  isAdmin = userProfile?.role === 'admin';
}

const navItems = [
  { group: 'Navegación Principal' },
  { id: 'dashboard', href: '/dashboard', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { id: 'archivos', href: '/archivos', label: 'Módulo Archivos', icon: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4' },
  { id: 'peticiones', href: '/peticiones', label: 'Peticiones Radicadas', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { id: 'subir-peticion', href: '/peticiones/subir', label: 'Subir Petición', icon: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12' },
  
  { group: 'Gobierno y Normativa' },
  { id: 'normas', href: '/normas', label: 'Cuerpos Colegiados', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { id: 'juridicos', href: '/juridicos', label: 'Asuntos Jurídicos', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  
  { group: 'Control y Disciplinario' },
  { id: 'juzgamiento', href: '/juzgamiento', label: 'Fase de Juzgamiento', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' },
  { id: 'calendario', href: '/calendario', label: 'Calendario Institucional', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  
  { group: 'Academia y Estrategia' },
  { id: 'programas', href: '/programas', label: 'Programas Académicos', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222' },
  { id: 'planeacion', href: '/planeacion', label: 'Planeación y Gestión CSU', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { id: 'relacionamiento', href: '/relacionamiento', label: 'Relacionamiento Institucional', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  
  { group: 'Seguridad y Administración' },
  ...(isAdmin ? [{ id: 'usuarios', href: '/admin/usuarios', label: 'Usuarios y Permisos', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' }] : []),
  { id: 'perfil', href: '/perfil', label: 'Mi Perfil', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { id: 'auditoria', href: '/auditoria', label: 'Auditoría y Trazabilidad', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<aside class="sidebar" id="app-sidebar">
  <div class="brand-section" style="padding: 14px 16px; min-height: 80px; display: flex; align-items: center; justify-content: space-between; position: relative; border-bottom: 1px solid var(--border-color); background: #ffffff;">
    <a href="/dashboard" style="text-decoration: none; display: flex; align-items: center; justify-content: flex-start; overflow: hidden; flex: 1;" title="Ir al Dashboard — SGD Unitrópico">
      <img 
        src="/logo.png" 
        alt="Universidad Internacional del Trópico Americano" 
        style="max-height: 52px; max-width: 175px; width: auto; height: auto; object-fit: contain; display: block;" 
      />
    </a>

    <!-- Botón elegante de plegar en la esquina superior del propio Sidebar -->
    <button type="button" class="btn-sidebar-collapse" id="btn-collapse-sidebar" aria-label="Plegar barra lateral" title="Plegar barra lateral (Ctrl+B)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <path d="M9 3v18"/>
        <path d="M14 9l-3 3 3 3"/>
      </svg>
    </button>

    <button class="mobile-sidebar-close" id="btn-mobile-sidebar-close" aria-label="Cerrar menú" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav class="nav-menu" id="sidebar-nav-menu">
    {navItems.map((item) => {
      if (item.group) {
        return <div class="nav-label">{item.group}</div>;
      }
      const isActive = activeNav === item.id;
      return (
        <a href={item.href} class={`nav-item ${isActive ? 'active' : ''}`} id={`nav-${item.id}`} style="text-decoration: none;">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/></svg>
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Perfil de usuario institucional rediseñado con alta jerarquía y estética ejecutiva -->
  <div class="user-profile-section" style="padding: 14px 16px; margin: 12px 14px 16px 14px; background: #ffffff; border: 1px solid rgba(0, 89, 78, 0.15); border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);">
    <a href="/perfil" class="user-profile-header" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px; cursor: pointer; margin-bottom: 10px;" title="Ver Mi Perfil institucional">
      <div class="user-avatar" id="avatar-initials" style="width: 40px; height: 40px; min-width: 40px; border-radius: 50%; background: var(--verde-suave-bg); border: 2px solid var(--verde-borde); overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
        <span id="sidebar-avatar-text" style="font-weight: 800; font-size: 0.82rem; color: var(--verde-principal);">CL</span>
        <img id="sidebar-avatar-img" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
      </div>
      <div class="user-info" style="overflow: hidden; flex: 1;">
        <div class="user-name" id="user-display-name" style="font-weight: 600; font-size: 0.86rem; color: var(--text-main); line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          ING. Christian Lemus
        </div>
        <div class="role-badge admin" id="user-role-badge" style="margin-top: 4px; display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.68rem; font-weight: 700; background: var(--verde-suave-bg); color: var(--verde-principal); border: 1px solid var(--verde-borde);">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          <span>ADMINISTRADOR</span>
        </div>
      </div>
    </a>
    
    <div style="display: flex; gap: 8px;">
      <a href="/perfil" class="profile-action-btn" title="Editar foto de perfil y contraseña" style="flex: 1; text-decoration: none; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-size: 0.76rem; font-weight: 600; padding: 7px 10px; border-radius: 8px; background: #f8fafc; border: 1px solid var(--border-color); color: var(--text-main); transition: all 0.2s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Mi Perfil</span>
      </a>
      <button type="button" class="btn-logout" id="btn-logout" title="Cerrar Sesión del SGD Unitrópico" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-size: 0.76rem; font-weight: 600; padding: 7px 10px; border-radius: 8px; background: #fff5f5; border: 1px solid #fecaca; color: #dc2626; cursor: pointer; transition: all 0.2s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Salir</span>
      </button>
    </div>
  </div>
</aside>
