---
// src/pages/programas.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Consultar programas académicos reales desde Supabase
const { data: dbProgramas } = await (supabase
  .from('programas_academicos' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const programasList = dbProgramas || [];
const countHistorial = programasList.filter((p: any) => p.categoria === 'historial').length;
const countSaces = programasList.filter((p: any) => p.categoria === 'saces').length;
const countAcred = programasList.filter((p: any) => p.categoria === 'acreditacion').length;
---

<AppLayout title="Gestión Académica y Acreditación" activeNav="programas">
  <div class="panel-box">
    <div class="panel-header" style="flex-wrap: wrap; gap: 14px;">
      <div>
        <div class="panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
          <span>Gestión Académica y Acreditación Institucional</span>
        </div>
        <div style="font-size: 0.8rem; color: var(--secondary-light); font-weight: 600; margin-top: 4px;">
          Historial de programas, actos administrativos MEN de aprobación y negación, radicados en SACES y acreditación de alta calidad CNA
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button class="btn btn-primary" id="btn-open-programa-modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>+ Registrar Programa / Trámite MEN</span>
        </button>
      </div>
    </div>

    <div class="module-tabs" id="programas-module-tabs">
      <button class="module-tab-btn active" data-ptab="historial">
        <span>Historial de Programas (Actos Aprobación y Negación)</span>
        <span class="tab-count" id="prog-count-total">{countHistorial}</span>
      </button>
      <button class="module-tab-btn" data-ptab="saces">
        <span>Procesos Radicados SACES / MEN</span>
        <span class="tab-count" id="prog-count-saces">{countSaces}</span>
      </button>
      <button class="module-tab-btn" data-ptab="acreditacion">
        <span>Acreditación de Alta Calidad (CNA)</span>
        <span class="tab-count" id="prog-count-cna">{countAcred}</span>
      </button>
    </div>

    <div id="programas-tab-content">
      <!-- Dinámico desde JS con datos de Supabase -->
    </div>
  </div>

  <!-- Modal: Registrar Programa / Trámite MEN -->
  <div class="modal-backdrop" id="new-programa-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 600px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div class="modal-header" style="background: var(--verde-suave-bg); border-bottom: 1px solid var(--verde-borde); padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--verde-principal); margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
          <span>Registrar Programa Académico / Trámite MEN</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-new-prog-modal" style="background: transparent; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer;">&times;</button>
      </div>

      <form id="form-new-programa" style="padding: 24px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Módulo / Pestaña *</label>
            <select id="new-prog-categoria" class="form-input" style="cursor: pointer;" required>
              <option value="historial" selected>Historial de Programas (Aprobados/Negados)</option>
              <option value="saces">Procesos Radicados SACES / MEN</option>
              <option value="acreditacion">Acreditación de Alta Calidad (CNA)</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nivel de Formación *</label>
            <select id="new-prog-nivel" class="form-input" style="cursor: pointer;" required>
              <option value="Pregrado Universitario">Pregrado Universitario</option>
              <option value="Especialización">Especialización</option>
              <option value="Maestría">Maestría</option>
              <option value="Doctorado">Doctorado</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nombre del Programa Académico *</label>
          <input type="text" id="new-prog-nombre" class="form-input" placeholder="Ej: Derecho, Ingeniería de Sistemas, Medicina Veterinaria..." required />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Código SNIES</label>
            <input type="text" id="new-prog-snies" class="form-input" placeholder="Ej: 105432" />
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Facultad</label>
            <input type="text" id="new-prog-facultad" class="form-input" placeholder="Ej: Facultad de Ciencias Jurídicas" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Resolución MEN o Radicado SACES</label>
            <input type="text" id="new-prog-resolucion" class="form-input" placeholder="Ej: Res. 004812 / Radicado 98210" />
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha del Acto</label>
            <input type="date" id="new-prog-fecha" class="form-input" />
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-new-prog">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-prog" style="font-weight: 700;">
            Guardar en Supabase
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import { initProgramas } from '@scripts/programas';
  initProgramas();
</script>
