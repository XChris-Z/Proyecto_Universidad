      box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.1) !important;
    }
    .role-desc-textarea {
      resize: none !important;
      line-height: 1.4 !important;
      min-height: 54px !important;
    }

    /* Color picker */
    .role-color-custom-select {
      position: relative !important;
      width: 100% !important;
    }
    .role-color-trigger {
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 9px 12px !important;
      background: #FFFFFF !important;
      border: 1px solid #CBD5E1 !important;
      border-radius: 10px !important;
      cursor: pointer !important;
      font-family: inherit !important;
      transition: all 0.15s ease !important;
    }
    .color-dropdown-menu,
    .role-color-dropdown {
      display: none !important;
      position: absolute !important;
      top: calc(100% + 6px) !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 60 !important;
      background-color: #FFFFFF !important;
      border: 1px solid #CBD5E1 !important;
      border-radius: 12px !important;
      padding: 6px !important;
      box-shadow: 0 14px 28px -6px rgba(15, 23, 42, 0.16) !important;
      flex-direction: column !important;
      gap: 2px !important;
      max-height: 220px !important;
      overflow-y: auto !important;
    }
    .color-dropdown-menu.is-open,
    .role-color-dropdown.is-open {
      display: flex !important;
    }
    .color-dropdown-trigger[aria-expanded="true"] .dropdown-chevron,
    .role-color-trigger[aria-expanded="true"] .dropdown-chevron,
    .role-color-trigger[aria-expanded="true"] svg {
      transform: rotate(180deg) !important;
    }
    .color-dropdown-trigger .dropdown-chevron,
    .role-color-trigger .dropdown-chevron,
    .role-color-trigger svg {
      transition: transform 0.2s ease !important;
    }
    .role-color-option {
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      padding: 6px 10px !important;
      border-radius: 7px !important;
      background: transparent !important;
      border: none !important;
      cursor: pointer !important;
      text-align: left !important;
      transition: background 0.12s ease !important;
    }
    .role-color-option:hover {
      background: #F1F5F9 !important;
    }
    .role-color-swatch {
      width: 20px !important;
      height: 20px !important;
      border-radius: 50% !important;
      border: 1px solid rgba(0,0,0,0.15) !important;
      cursor: pointer !important;
      padding: 0 !important;
      transition: transform 0.12s ease !important;
    }
    .role-color-swatch:hover {
      transform: scale(1.15) !important;
    }
    .role-color-swatch.selected {
      outline: 2px solid #00594E !important;
      outline-offset: 1px !important;
    }
    .role-live-preview-pill {
      font-size: 0.70rem !important;
      font-weight: 800 !important;
      letter-spacing: 0.04em !important;
      padding: 3px 9px !important;
      border-radius: 999px !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
    }

    /* Roles List Item in Sidebar */
    .role-sidebar-item {
      padding: 10px 12px;
      border-radius: 10px;
      border: 1.5px solid #E2E8F0;
      background: #FFFFFF;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: all 0.15s ease;
      text-align: left;
      position: relative;
    }
    .role-sidebar-item:hover {
      border-color: #B2CFCB;
      background: #F2F7F6;
    }
    .role-sidebar-item.active {
      border-color: #00594E !important;
      background: #F2F7F6 !important;
      box-shadow: 0 2px 6px rgba(0, 89, 78, 0.12);
    }
  </style>

  <script>
    import { ALL_PERMISSION_IDS, DEFAULT_FUNCIONARIO_PERMISSIONS, isAdminRoleCode, normalizePermissionsList } from '@lib/permisos';
    import type { SystemRole } from '@lib/types';

    // 1. Cargar bootstrap RBAC inicial
    const bootstrapEl = document.getElementById('rbac-bootstrap-json');
    const bootstrapData = bootstrapEl ? JSON.parse(bootstrapEl.textContent || '{}') : {};
    const currentUser = bootstrapData.currentUser || {};
    const isCurrentUserAdmin = Boolean(currentUser.isAdmin);
    const currentUserPerms = normalizePermissionsList(currentUser.permissions || []);

    let rolesCatalog: SystemRole[] = Array.isArray(bootstrapData.roles) ? bootstrapData.roles : [];
    const userPermissionsMap: Record<string, string[]> = bootstrapData.userPermissions || {};
    const userCustomRolesMap: Record<string, string> = bootstrapData.userCustomRoles || {};
    const systemModules = Array.isArray(bootstrapData.modules) ? bootstrapData.modules : [];

    let activePermsUserId: string | null = null;
    let activePermsUserEmail = '';
    let activePermsUserName = '';
    let activeRoleEditorId: string | null = null;

    // Toast helper
    function notifyToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(msg, type);
      } else {
        alert(msg);
      }
    }

    // 2. Buscador y Filtro por Rol en Tabla
    const searchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.user-filter-btn');
    const userRows = document.querySelectorAll<HTMLTableRowElement>('.user-row');

    function applyUserFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const activeRoleBtn = document.querySelector<HTMLButtonElement>('.user-filter-btn.active');
      const roleFilter = activeRoleBtn?.dataset.role || 'all';

      userRows.forEach((row) => {
        const name = (row.dataset.userName || '').toLowerCase();
        const email = (row.dataset.userEmail || '').toLowerCase();
        const cargo = (row.dataset.userCargo || '').toLowerCase();
        const roleCat = row.dataset.userRoleCat || 'funcionario';
        const roleName = (row.dataset.userRoleName || '').toLowerCase();

        const matchesQuery = !q || name.includes(q) || email.includes(q) || cargo.includes(q) || roleName.includes(q);
        const matchesRole = roleFilter === 'all' || roleCat === roleFilter;

        row.style.display = matchesQuery && matchesRole ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', applyUserFilters);
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        applyUserFilters();
      });
    });

    // ─────────────────────────────────────────────────────────────
    // 3. Modal 1: Permisos RBAC por Usuario (4 Grupos, Switches y Chips)
    // ─────────────────────────────────────────────────────────────
    const permsModal = document.getElementById('modal-permissions');
    const permsUserName = document.getElementById('perm-modal-user-name');
    const permsUserDesc = document.getElementById('perm-modal-user-desc');
    const permsAdminBanner = document.getElementById('perms-admin-banner');
    const permsQuickActions = document.getElementById('perms-quick-actions');
    const btnSavePerms = document.getElementById('btn-save-dynamic-perms') as HTMLButtonElement | null;
    const btnClosePerms = document.getElementById('btn-close-perms-modal');
    const btnCancelPerms = document.getElementById('btn-cancel-perms-modal');
    const permsSummaryCount = document.getElementById('perms-summary-count');

    function updateUserMatrixSummary() {
      const allModules = document.querySelectorAll<HTMLElement>('.rbac-module-card');
      let activeCount = 0;
      allModules.forEach((card) => {
        const modId = card.dataset.moduleId || '';
        const masterSwitch = card.querySelector<HTMLInputElement>('.perm-module-master');
        const anyChecked = card.querySelector<HTMLInputElement>('.perm-checkbox:checked');
        if (masterSwitch?.checked || anyChecked) {
          activeCount += 1;
        }
      });
      if (permsSummaryCount) {
        permsSummaryCount.textContent = `${activeCount} / 14 módulos habilitados`;
      }
    }

    function setupUserMatrixInteractions() {
      // Toggle Switch Maestro
      document.querySelectorAll<HTMLInputElement>('.perm-module-master').forEach((master) => {
        master.addEventListener('change', () => {
          const modId = master.dataset.moduleId || '';
          const card = master.closest('.rbac-module-card');
          if (!card) return;

          const chips = card.querySelectorAll<HTMLInputElement>('.perm-checkbox');
          if (master.checked) {
            // Al encender, activar al menos la acción "ver"
            const verCb = card.querySelector<HTMLInputElement>(`.perm-checkbox[data-action-id="ver"]`);
            if (verCb && !verCb.disabled) verCb.checked = true;
          } else {
            // Al apagar, desactivar todas las acciones del módulo
            chips.forEach((cb) => {
              if (!cb.disabled) cb.checked = false;
            });
          }
          updateUserMatrixSummary();
        });
      });

      // Checkbox de acción granular individual
      document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          const card = cb.closest('.rbac-module-card');
          if (!card) return;

          const master = card.querySelector<HTMLInputElement>('.perm-module-master');
          const verCb = card.querySelector<HTMLInputElement>(`.perm-checkbox[data-action-id="ver"]`);
          const anyChecked = card.querySelector<HTMLInputElement>('.perm-checkbox:checked');

          if (cb.checked) {
            if (master) master.checked = true;
            if (verCb && !verCb.disabled) verCb.checked = true;
          } else {
            if (cb.dataset.actionId === 'ver') {
              // Si desmarca 'ver', desmarcar todas las demás acciones del módulo
              card.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach((other) => {
                if (!other.disabled) other.checked = false;
              });
              if (master) master.checked = false;
            } else if (!anyChecked) {
              if (master) master.checked = false;
            }
          }
          updateUserMatrixSummary();
        });
      });
    }

    setupUserMatrixInteractions();

    function applyUserPermPreset(preset: string) {
      document.querySelectorAll<HTMLElement>('.rbac-module-card').forEach((card) => {
        const grpKey = card.dataset.groupKey || '';
        const master = card.querySelector<HTMLInputElement>('.perm-module-master');
        const chips = card.querySelectorAll<HTMLInputElement>('.perm-checkbox');

        if (preset === 'clear_all') {
          if (master && !master.disabled) master.checked = false;
          chips.forEach((cb) => {
            if (!cb.disabled) cb.checked = false;
          });
        } else if (preset === 'operativos') {
          const isOperativo = grpKey === 'operativo';
          if (isOperativo) {
            if (master && !master.disabled) master.checked = true;
            chips.forEach((cb) => {
              if (!cb.disabled) cb.checked = true;
            });
          }
        } else if (preset === 'view_all') {
          if (master && !master.disabled) master.checked = true;
          chips.forEach((cb) => {
            if (!cb.disabled) {
              cb.checked = cb.dataset.actionId === 'ver';
            }
          });
        } else if (preset === 'full_modules') {
          if (master && !master.disabled) master.checked = true;
          chips.forEach((cb) => {
            if (!cb.disabled) cb.checked = true;
          });
        }
      });
      updateUserMatrixSummary();
    }

    document.querySelectorAll<HTMLButtonElement>('.btn-perm-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        applyUserPermPreset(btn.dataset.preset || '');
      });
    });

    function closePermsModal() {
      if (permsModal) permsModal.style.display = 'none';
      activePermsUserId = null;
      activePermsUserEmail = '';
      activePermsUserName = '';
    }

    btnClosePerms?.addEventListener('click', closePermsModal);
    btnCancelPerms?.addEventListener('click', closePermsModal);

    function openPermsModal(userId: string, userEmail: string, userName: string, userCargo: string, userRoleId: string) {
      activePermsUserId = userId;
      activePermsUserEmail = userEmail.toLowerCase();
      activePermsUserName = userName;

      const roleObj = rolesCatalog.find((r) => r.id === userRoleId || r.code === userRoleId);
      const isTargetAdmin = userId === 'usr-root' || isAdminRoleCode(userRoleId);
      const roleLabel = isTargetAdmin ? 'Administrador' : roleObj?.name || userRoleId;

      if (permsUserName) permsUserName.textContent = `Permisos: ${userName}`;
      if (permsUserDesc) permsUserDesc.textContent = `${userCargo} • Rol: ${roleLabel}`;
      if (permsAdminBanner) permsAdminBanner.style.display = isTargetAdmin ? 'block' : 'none';
      if (permsQuickActions) permsQuickActions.style.display = isTargetAdmin ? 'none' : 'flex';
      if (btnSavePerms) btnSavePerms.disabled = isTargetAdmin;

      const hasOverrideId = Object.prototype.hasOwnProperty.call(userPermissionsMap, userId);
      const hasOverrideEmail = Boolean(
        activePermsUserEmail && Object.prototype.hasOwnProperty.call(userPermissionsMap, activePermsUserEmail)
      );

      const effectivePerms = isTargetAdmin
        ? ALL_PERMISSION_IDS
        : hasOverrideId
          ? normalizePermissionsList(userPermissionsMap[userId])
          : hasOverrideEmail
            ? normalizePermissionsList(userPermissionsMap[activePermsUserEmail])
            : normalizePermissionsList(roleObj?.permissions || DEFAULT_FUNCIONARIO_PERMISSIONS);

      // Sincronizar switches y checkboxes granulares aplicando blindaje anti-escalamiento
      document.querySelectorAll<HTMLElement>('.rbac-module-card').forEach((card) => {
        const modId = card.dataset.moduleId || '';
        const masterSwitch = card.querySelector<HTMLInputElement>('.perm-module-master');
        const chips = card.querySelectorAll<HTMLInputElement>('.perm-checkbox');

        let hasAnyActionActive = false;

        chips.forEach((cb) => {
          const permId = cb.dataset.permId || '';
          const isGranted = isTargetAdmin || effectivePerms.includes(permId);
          cb.checked = isGranted;

          // Candado anti-escalamiento: Si el usuario que configura no es admin y no posee este permiso
          const canGrant = isCurrentUserAdmin || currentUserPerms.includes(permId);
          cb.disabled = isTargetAdmin || !canGrant;
          cb.title = !canGrant ? 'No posees este permiso en tu propia cuenta para otorgarlo' : '';

          const chipLabel = cb.closest('.action-chip');
          if (chipLabel) {
            chipLabel.classList.toggle('disabled', cb.disabled);
          }

          if (isGranted) hasAnyActionActive = true;
        });

        if (masterSwitch) {
          masterSwitch.checked = isTargetAdmin || hasAnyActionActive || effectivePerms.includes(`${modId}.ver`);
          masterSwitch.disabled = isTargetAdmin;
        }
      });

      updateUserMatrixSummary();
      if (permsModal) permsModal.style.display = 'flex';
    }

    document.querySelectorAll<HTMLButtonElement>('.btn-manage-perms').forEach((btn) => {
      btn.addEventListener('click', () => {
        openPermsModal(
          btn.dataset.userId || '',
          btn.dataset.userEmail || '',
          btn.dataset.userName || '',
          btn.dataset.userCargo || '',
          btn.dataset.userRole || 'funcionario'
        );
      });
    });

    btnSavePerms?.addEventListener('click', async () => {
      if (!activePermsUserId) return;
      const selectedPerms: string[] = [];
      document.querySelectorAll<HTMLInputElement>('.perm-checkbox:checked').forEach((cb) => {
        if (cb.dataset.permId) selectedPerms.push(cb.dataset.permId);
      });

      if (btnSavePerms) {
        btnSavePerms.textContent = 'Guardando...';
        btnSavePerms.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'save_user_permissions',
            userId: activePermsUserId,
            userEmail: activePermsUserEmail,
            userName: activePermsUserName,
            permissions: selectedPerms,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Error guardando permisos en servidor.');
        }

        const savedList = Array.isArray(data.permissions) ? data.permissions : selectedPerms;
        userPermissionsMap[activePermsUserId] = savedList;
        if (activePermsUserEmail) userPermissionsMap[activePermsUserEmail] = savedList;

        notifyToast('Matriz de permisos RBAC guardada con éxito.', 'success');
        closePermsModal();
      } catch (err: any) {
        notifyToast(err?.message || 'Error al guardar permisos.', 'error');
      } finally {
        if (btnSavePerms) {
          btnSavePerms.textContent = 'Guardar Permisos RBAC';
          btnSavePerms.disabled = false;
        }
      }
    });

    // ─────────────────────────────────────────────────────────────
    // 4. Modal 2: Crear Usuario (Blindado)
    // ─────────────────────────────────────────────────────────────
    const createModal = document.getElementById('modal-create-user');
    const btnOpenCreate = document.getElementById('btn-open-create-user');
    const btnCloseCreate = document.getElementById('btn-close-create-modal');
    const btnCancelCreate = document.getElementById('btn-cancel-create-user');
    const formCreateUser = document.getElementById('form-create-user') as HTMLFormElement | null;
    const btnSubmitCreate = document.getElementById('btn-submit-create-user') as HTMLButtonElement | null;

    btnOpenCreate?.addEventListener('click', () => {
      if (formCreateUser) formCreateUser.reset();
      if (createModal) createModal.style.display = 'flex';
    });

    function closeCreateModal() {
      if (createModal) createModal.style.display = 'none';
    }
    btnCloseCreate?.addEventListener('click', closeCreateModal);
    btnCancelCreate?.addEventListener('click', closeCreateModal);

    formCreateUser?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('create-user-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('create-user-email') as HTMLInputElement)?.value.trim();
      const password = (document.getElementById('create-user-password') as HTMLInputElement)?.value;
      const roleId = (document.getElementById('create-user-role') as HTMLSelectElement)?.value;
      const cargo = (document.getElementById('create-user-cargo') as HTMLInputElement)?.value.trim();

      if (!name || !email || !password || !cargo) {
        notifyToast('Por favor diligencie todos los campos requeridos.', 'error');
        return;
      }

      if (btnSubmitCreate) {
        btnSubmitCreate.textContent = 'Registrando...';
        btnSubmitCreate.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'create_user',
            name,
            email,
            password,
            roleId,
            cargo,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo crear el usuario.');
        }

        notifyToast(`Usuario ${name} registrado satisfactoriamente.`, 'success');
        closeCreateModal();
        setTimeout(() => window.location.reload(), 600);
      } catch (err: any) {
        notifyToast(err?.message || 'Error al registrar usuario.', 'error');
      } finally {
        if (btnSubmitCreate) {
          btnSubmitCreate.textContent = 'Registrar Usuario';
          btnSubmitCreate.disabled = false;
        }
      }
    });

    // ─────────────────────────────────────────────────────────────
    // 5. Modal 3: Editar Usuario (Blindado)
    // ─────────────────────────────────────────────────────────────
    const editModal = document.getElementById('modal-edit-user');
    const editErrorBanner = document.getElementById('edit-user-error-banner') as HTMLDivElement | null;
    const editUserId = document.getElementById('edit-user-id') as HTMLInputElement | null;
    const editUserOriginalRole = document.getElementById('edit-user-original-role') as HTMLInputElement | null;
    const editUserName = document.getElementById('edit-user-name') as HTMLInputElement | null;
    const editUserEmail = document.getElementById('edit-user-email') as HTMLInputElement | null;
    const editUserRole = document.getElementById('edit-user-role') as HTMLSelectElement | null;
    const editUserCargo = document.getElementById('edit-user-cargo') as HTMLInputElement | null;
    const editUserSubtitulo = document.getElementById('edit-user-subtitulo') as HTMLInputElement | null;
    const editUserEstado = document.getElementById('edit-user-estado') as HTMLSelectElement | null;
    const editUserPassword = document.getElementById('edit-user-password') as HTMLInputElement | null;
    const editUserRoleChangeBox = document.getElementById('edit-user-role-change-box') as HTMLDivElement | null;
    const editUserApplyPerms = document.getElementById('edit-user-apply-role-perms') as HTMLInputElement | null;
    const formEditUser = document.getElementById('form-edit-user') as HTMLFormElement | null;
    const btnCloseEdit = document.getElementById('btn-close-edit-modal');
    const btnCancelEdit = document.getElementById('btn-cancel-edit-user');
    const btnSubmitEdit = document.getElementById('btn-submit-edit-user') as HTMLButtonElement | null;

    function closeEditModal() {
      if (editModal) editModal.style.display = 'none';
      if (editErrorBanner) editErrorBanner.style.display = 'none';
    }
    btnCloseEdit?.addEventListener('click', closeEditModal);
    btnCancelEdit?.addEventListener('click', closeEditModal);

    editUserRole?.addEventListener('change', () => {
      const orig = editUserOriginalRole?.value || '';
      const curr = editUserRole?.value || '';
      if (editUserRoleChangeBox) {
        editUserRoleChangeBox.style.display = curr !== orig ? 'block' : 'none';
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-edit-user').forEach((btn) => {
      btn.addEventListener('click', () => {
        const uid = btn.dataset.userId || '';
        const name = btn.dataset.userName || '';
        const email = btn.dataset.userEmail || '';
        const role = btn.dataset.userRole || 'funcionario';
        const cargo = btn.dataset.userCargo || '';
        const subtitulo = btn.dataset.userSubtitulo || '';
        const estado = btn.dataset.userEstado || 'activo';

        if (editErrorBanner) editErrorBanner.style.display = 'none';
        if (editUserId) editUserId.value = uid;
        if (editUserName) editUserName.value = name;
        if (editUserEmail) editUserEmail.value = email;
        if (editUserCargo) editUserCargo.value = cargo;
        if (editUserSubtitulo) editUserSubtitulo.value = subtitulo;
        if (editUserOriginalRole) editUserOriginalRole.value = role;
        if (editUserRole) editUserRole.value = role;
        if (editUserEstado) editUserEstado.value = estado;
        if (editUserPassword) editUserPassword.value = '';
        if (editUserRoleChangeBox) editUserRoleChangeBox.style.display = 'none';
        if (editUserApplyPerms) editUserApplyPerms.checked = true;

        if (typeof (window as any).refrescarSelectPersonalizado === 'function') {
          if (editUserRole) (window as any).refrescarSelectPersonalizado(editUserRole);
          if (editUserEstado) (window as any).refrescarSelectPersonalizado(editUserEstado);
        }

        if (editModal) editModal.style.display = 'flex';
      });
    });

    formEditUser?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const uid = editUserId?.value;
      const name = editUserName?.value.trim();
      const email = editUserEmail?.value.trim();
      const roleId = editUserRole?.value;
      const cargo = editUserCargo?.value.trim();
      const subtitulo = editUserSubtitulo?.value.trim();
      const estado = editUserEstado?.value || 'activo';
      const password = editUserPassword?.value.trim();

      if (!uid || !name || !cargo) {
        if (editErrorBanner) {
          editErrorBanner.textContent = 'Nombre completo y dependencia oficial son obligatorios.';
          editErrorBanner.style.display = 'block';
        }
        notifyToast('Nombre y dependencia son obligatorios.', 'error');
        return;
      }

      if (password && password.length < 8) {
        if (editErrorBanner) {
          editErrorBanner.textContent = 'La nueva contraseña debe tener mínimo 8 caracteres.';
          editErrorBanner.style.display = 'block';
        }
        notifyToast('La nueva contraseña debe tener mínimo 8 caracteres.', 'error');
        return;
      }

      if (btnSubmitEdit) {
        btnSubmitEdit.textContent = 'Guardando cambios...';
        btnSubmitEdit.disabled = true;
      }
      if (editErrorBanner) editErrorBanner.style.display = 'none';

      try {
        const payload = {
          userId: uid,
          userEmail: email,
          name,
          roleId,
          cargo,
          subtitulo,
          estado,
          password: password || undefined,
          applyRolePermissions: editUserApplyPerms ? editUserApplyPerms.checked : true,
        };

        const res = await fetch('/api/usuarios/editar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          const errMsg = data.error || 'Error al actualizar funcionario.';
          if (editErrorBanner) {
            editErrorBanner.textContent = errMsg;
            editErrorBanner.style.display = 'block';
          }
          notifyToast(errMsg, 'error');
          return;
        }

        notifyToast('Funcionario modificado con éxito.', 'success');
        closeEditModal();
        setTimeout(() => window.location.reload(), 500);
      } catch (err: any) {
        const errMsg = err?.message || 'Error de conexión al actualizar funcionario.';
        if (editErrorBanner) {
          editErrorBanner.textContent = errMsg;
          editErrorBanner.style.display = 'block';
        }
        notifyToast(errMsg, 'error');
      } finally {
        if (btnSubmitEdit) {
          btnSubmitEdit.textContent = 'Guardar Cambios';
          btnSubmitEdit.disabled = false;
        }
      }
    });

    // ─────────────────────────────────────────────────────────────
    // 6. Modal 4: Eliminar Usuario
    // ─────────────────────────────────────────────────────────────
    const deleteModal = document.getElementById('modal-delete-user');
    const deleteUserId = document.getElementById('delete-user-modal-id') as HTMLInputElement | null;
    const deleteUserEmail = document.getElementById('delete-user-modal-email') as HTMLInputElement | null;
    const deleteUserName = document.getElementById('delete-user-modal-name');
    const deleteUserEmailText = document.getElementById('delete-user-modal-email-text');
    const btnCloseDelete = document.getElementById('btn-close-delete-modal');
    const btnCancelDelete = document.getElementById('btn-cancel-delete-user');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete-user') as HTMLButtonElement | null;

    function closeDeleteModal() {
      if (deleteModal) deleteModal.style.display = 'none';
    }
    btnCloseDelete?.addEventListener('click', closeDeleteModal);
    btnCancelDelete?.addEventListener('click', closeDeleteModal);

    document.querySelectorAll<HTMLButtonElement>('.btn-delete-user').forEach((btn) => {
      btn.addEventListener('click', () => {
        const uid = btn.dataset.userId || '';
        const name = btn.dataset.userName || '';
        const email = btn.dataset.userEmail || '';

        if (deleteUserId) deleteUserId.value = uid;
        if (deleteUserEmail) deleteUserEmail.value = email;
        if (deleteUserName) deleteUserName.textContent = name;
        if (deleteUserEmailText) deleteUserEmailText.textContent = email;

        if (deleteModal) deleteModal.style.display = 'flex';
      });
    });

    btnConfirmDelete?.addEventListener('click', async () => {
      const uid = deleteUserId?.value;
      const email = deleteUserEmail?.value;
      const name = deleteUserName?.textContent || '';

      if (!uid) return;

      if (btnConfirmDelete) {
        btnConfirmDelete.textContent = 'Eliminando...';
        btnConfirmDelete.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'delete_user',
            userId: uid,
            userEmail: email,
            userName: name,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo eliminar el funcionario.');
        }

        notifyToast(`Funcionario ${name} dado de baja correctamente.`, 'success');
        closeDeleteModal();
        setTimeout(() => window.location.reload(), 600);
      } catch (err: any) {
        notifyToast(err?.message || 'Error al eliminar usuario.', 'error');
      } finally {
        if (btnConfirmDelete) {
          btnConfirmDelete.textContent = 'Eliminar Funcionario';
          btnConfirmDelete.disabled = false;
        }
      }
    });

    // ─────────────────────────────────────────────────────────────
    // 7. Modal 5: Gestionar Roles (Matriz 4 Grupos, Switches y Chips)
    // ─────────────────────────────────────────────────────────────
    const rolesModal = document.getElementById('modal-roles');
    const btnOpenRoles = document.getElementById('btn-open-roles-modal');
    const btnCloseRoles = document.getElementById('btn-close-roles-modal');
    const btnCancelRoles = document.getElementById('btn-cancel-roles-modal');
    const btnNewCustomRole = document.getElementById('btn-new-custom-role');
    const rolesListContainer = document.getElementById('roles-catalog-list');
    const roleEditId = document.getElementById('role-edit-id') as HTMLInputElement | null;
    const roleEditName = document.getElementById('role-edit-name') as HTMLInputElement | null;
    const roleEditColor = document.getElementById('role-edit-color') as HTMLInputElement | null;
    const roleColorPicker = document.getElementById('role-color-picker');
    const roleColorTrigger = document.getElementById('role-color-trigger') as HTMLButtonElement | null;
    const roleColorDropdown = document.getElementById('role-color-dropdown');
    const roleColorDot = document.getElementById('role-color-dot');
    const roleColorLabel = document.getElementById('role-color-label');
    const roleEditDesc = document.getElementById('role-edit-desc') as HTMLTextAreaElement | null;
    const roleEditPropagate = document.getElementById('role-edit-propagate') as HTMLInputElement | null;
    const roleAdminLockBanner = document.getElementById('role-admin-lock-banner');
    const btnSaveRole = document.getElementById('btn-save-role') as HTMLButtonElement | null;
    const btnDeleteRole = document.getElementById('btn-delete-custom-role') as HTMLButtonElement | null;
    const roleLivePreviewBadge = document.getElementById('role-live-preview-badge');
    const roleLivePreviewDot = document.getElementById('role-live-preview-dot');
    const roleLivePreviewText = document.getElementById('role-live-preview-text');
    const roleFooterPermSummary = document.getElementById('role-footer-perm-summary');

    const ROLE_COLOR_NAMES: Record<string, string> = {
      '#00594E': 'Verde Unitrópico',
      '#B5A160': 'Dorado Institucional',
      '#003830': 'Verde Bosque',
      '#786832': 'Bronce Oscuro',
      '#1E293B': 'Pizarra Ejecutivo',
      '#334155': 'Carbón Institucional',
      '#7F1D1D': 'Vinotinto Sobrio',
    };

    function updateRoleMatrixSummary() {
      const allModules = document.querySelectorAll<HTMLElement>('.role-module-card');
      let activeCount = 0;
      let totalCheckedActions = 0;
      allModules.forEach((card) => {
        const masterSwitch = card.querySelector<HTMLInputElement>('.role-module-master');
        const checkedChips = card.querySelectorAll<HTMLInputElement>('.role-perm-checkbox:checked');
        if (masterSwitch?.checked || checkedChips.length > 0) {
          activeCount += 1;
        }
        totalCheckedActions += checkedChips.length;
      });
      if (roleFooterPermSummary) {
        roleFooterPermSummary.textContent = `${activeCount} / 14 módulos (${totalCheckedActions} acciones activas)`;
      }
    }

    function setupRoleMatrixInteractions() {
      // Switch Maestro en Roles
      document.querySelectorAll<HTMLInputElement>('.role-module-master').forEach((master) => {
        master.addEventListener('change', () => {
          const card = master.closest('.role-module-card');
          if (!card) return;

          const chips = card.querySelectorAll<HTMLInputElement>('.role-perm-checkbox');
          if (master.checked) {
            const verCb = card.querySelector<HTMLInputElement>(`.role-perm-checkbox[data-action-id="ver"]`);
            if (verCb && !verCb.disabled) verCb.checked = true;
          } else {
            chips.forEach((cb) => {
              if (!cb.disabled) cb.checked = false;
            });
          }
          updateRoleMatrixSummary();
        });
      });

      // Checkbox granular en Roles
      document.querySelectorAll<HTMLInputElement>('.role-perm-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          const card = cb.closest('.role-module-card');
          if (!card) return;

          const master = card.querySelector<HTMLInputElement>('.role-module-master');
          const verCb = card.querySelector<HTMLInputElement>(`.role-perm-checkbox[data-action-id="ver"]`);
          const anyChecked = card.querySelector<HTMLInputElement>('.role-perm-checkbox:checked');

          if (cb.checked) {
            if (master) master.checked = true;
            if (verCb && !verCb.disabled) verCb.checked = true;
          } else {
            if (cb.dataset.actionId === 'ver') {
              card.querySelectorAll<HTMLInputElement>('.role-perm-checkbox').forEach((other) => {
                if (!other.disabled) other.checked = false;
              });
              if (master) master.checked = false;
            } else if (!anyChecked) {
              if (master) master.checked = false;
            }
          }
          updateRoleMatrixSummary();
        });
      });
    }

    setupRoleMatrixInteractions();

    function applyRolePermPreset(preset: string) {
      document.querySelectorAll<HTMLElement>('.role-module-card').forEach((card) => {
        const grpKey = card.dataset.groupKey || '';
        const master = card.querySelector<HTMLInputElement>('.role-module-master');
        const chips = card.querySelectorAll<HTMLInputElement>('.role-perm-checkbox');

        if (preset === 'clear_all') {
          if (master && !master.disabled) master.checked = false;
          chips.forEach((cb) => {
            if (!cb.disabled) cb.checked = false;
          });
        } else if (preset === 'operativos') {
          const isOperativo = grpKey === 'operativo';
          if (isOperativo) {
            if (master && !master.disabled) master.checked = true;
            chips.forEach((cb) => {
              if (!cb.disabled) cb.checked = true;
            });
          }
        } else if (preset === 'view_all') {
          if (master && !master.disabled) master.checked = true;
          chips.forEach((cb) => {
            if (!cb.disabled) {
              cb.checked = cb.dataset.actionId === 'ver';
            }
          });
        } else if (preset === 'full_modules') {
          if (master && !master.disabled) master.checked = true;
          chips.forEach((cb) => {
            if (!cb.disabled) cb.checked = true;
          });
        }
      });
      updateRoleMatrixSummary();
    }

    document.querySelectorAll<HTMLButtonElement>('.btn-role-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        applyRolePermPreset(btn.dataset.preset || '');
      });
    });

    // Helpers de Control Estricto para Selector de Color en Modal de Roles
    function cerrarDropdownColor() {
      if (roleColorDropdown) {
        roleColorDropdown.classList.remove('is-open');
        roleColorDropdown.style.display = 'none';
      }
      if (roleColorTrigger) {
        roleColorTrigger.setAttribute('aria-expanded', 'false');
      }
    }

    function toggleDropdownColor(e?: Event) {
      if (e) e.stopPropagation();
      if (!roleColorDropdown || roleColorTrigger?.disabled) return;
      const isOpen = roleColorDropdown.classList.contains('is-open');
      if (isOpen) {
        cerrarDropdownColor();
      } else {
        roleColorDropdown.classList.add('is-open');
        roleColorDropdown.style.display = 'flex';
        roleColorTrigger?.setAttribute('aria-expanded', 'true');
      }
    }

    function setSelectedRoleColor(rawHex: string, disabled = false) {
      const normalized = (rawHex || '#00594E').toUpperCase();
      const matchingKey = Object.keys(ROLE_COLOR_NAMES).find((k) => k.toUpperCase() === normalized) || '#00594E';
      if (roleEditColor) roleEditColor.value = matchingKey;
      if (roleColorDot) roleColorDot.style.background = matchingKey;
      if (roleColorLabel) roleColorLabel.textContent = ROLE_COLOR_NAMES[matchingKey] || 'Verde Unitrópico';
      if (roleColorTrigger) roleColorTrigger.disabled = disabled;
      cerrarDropdownColor();

      document.querySelectorAll<HTMLButtonElement>('.role-color-option').forEach((opt) => {
        const optHex = (opt.dataset.color || '').toUpperCase();
        opt.classList.toggle('selected', optHex === matchingKey.toUpperCase());
      });
      document.querySelectorAll<HTMLButtonElement>('.role-color-swatch').forEach((sw) => {
        const swHex = (sw.dataset.color || '').toUpperCase();
        sw.classList.toggle('selected', swHex === matchingKey.toUpperCase());
        sw.disabled = disabled;
      });
      updateRoleBadgePreview();
    }

    function updateRoleBadgePreview() {
      const hex = roleEditColor?.value || '#00594E';
      const labelTxt = (roleEditName?.value || '').trim() || 'ROL PERSONALIZADO';
      if (roleLivePreviewText) roleLivePreviewText.textContent = labelTxt.toUpperCase();
      if (roleLivePreviewDot) roleLivePreviewDot.style.background = hex;
      if (roleLivePreviewBadge) {
        roleLivePreviewBadge.style.color = hex;
        roleLivePreviewBadge.style.borderColor = hex;
      }
    }

    roleEditName?.addEventListener('input', updateRoleBadgePreview);

    roleColorTrigger?.addEventListener('click', (e) => {
      toggleDropdownColor(e);
    });

    document.querySelectorAll<HTMLButtonElement>('.role-color-option').forEach((opt) => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const chosen = opt.dataset.color || '#00594E';
        setSelectedRoleColor(chosen, roleColorTrigger?.disabled || false);
        cerrarDropdownColor();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.role-color-swatch').forEach((sw) => {
      sw.addEventListener('click', () => {
        if (sw.disabled) return;
        const chosen = sw.dataset.color || '#00594E';
        setSelectedRoleColor(chosen, roleColorTrigger?.disabled || false);
        cerrarDropdownColor();
      });
    });

    document.addEventListener('click', (e) => {
      if (roleColorDropdown && roleColorPicker && !roleColorPicker.contains(e.target as Node)) {
        cerrarDropdownColor();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && roleColorDropdown?.classList.contains('is-open')) {
        e.stopPropagation();
        cerrarDropdownColor();
      }
    });

    function loadRoleIntoEditor(role?: SystemRole | null) {
      cerrarDropdownColor();
      const isNew = !role;
      const isAdminRole = Boolean(role && role.id === 'admin');
      const isBaseProtected = Boolean(role && role.isProtected);

      activeRoleEditorId = role ? role.id : '';
      if (roleEditId) roleEditId.value = activeRoleEditorId;
      if (roleEditName) {
        roleEditName.value = role ? role.name : '';
        roleEditName.readOnly = isBaseProtected;
        roleEditName.style.background = isBaseProtected ? '#F8FAFC' : '#FFFFFF';
      }
      setSelectedRoleColor(role?.color || '#00594E', isAdminRole);
      if (roleEditDesc) {
        roleEditDesc.value = role?.desc || '';
        roleEditDesc.readOnly = isAdminRole;
        roleEditDesc.style.background = isAdminRole ? '#F8FAFC' : '#FFFFFF';
      }
      if (roleAdminLockBanner) {
        roleAdminLockBanner.style.display = isAdminRole ? 'block' : 'none';
      }
      if (btnSaveRole) {
        btnSaveRole.disabled = isAdminRole;
        btnSaveRole.textContent = isNew ? 'Crear Rol' : 'Guardar Cambios del Rol';
      }
      if (btnDeleteRole) {
        const canDelete = Boolean(role && !role.isProtected && role.id !== 'admin' && role.id !== 'funcionario');
        btnDeleteRole.style.display = canDelete ? 'inline-flex' : 'none';
      }

      const rolePerms = isAdminRole
        ? ALL_PERMISSION_IDS
        : isNew
          ? DEFAULT_FUNCIONARIO_PERMISSIONS
          : normalizePermissionsList(role?.permissions || DEFAULT_FUNCIONARIO_PERMISSIONS);

      // Sincronizar matriz del rol
      document.querySelectorAll<HTMLElement>('.role-module-card').forEach((card) => {
        const modId = card.dataset.moduleId || '';
        const masterSwitch = card.querySelector<HTMLInputElement>('.role-module-master');
        const chips = card.querySelectorAll<HTMLInputElement>('.role-perm-checkbox');

        let hasAnyActionActive = false;

        chips.forEach((cb) => {
          const permId = cb.dataset.permId || '';
          const isGranted = isAdminRole || rolePerms.includes(permId);
          cb.checked = isGranted;

          // Candado anti-escalamiento en roles: Un no-admin no puede crear roles con permisos que no posee
          const canGrant = isCurrentUserAdmin || currentUserPerms.includes(permId);
          cb.disabled = isAdminRole || !canGrant;
          cb.title = !canGrant ? 'No posees este permiso en tu cuenta' : '';

          const chipLabel = cb.closest('.role-action-chip');
          if (chipLabel) {
            chipLabel.classList.toggle('disabled', cb.disabled);
          }

          if (isGranted) hasAnyActionActive = true;
        });

        if (masterSwitch) {
          masterSwitch.checked = isAdminRole || hasAnyActionActive || rolePerms.includes(`${modId}.ver`);
          masterSwitch.disabled = isAdminRole;
        }
      });

      updateRoleMatrixSummary();
      updateRoleBadgePreview();
    }

    function renderRolesCatalog() {
      if (!rolesListContainer) return;
      rolesListContainer.innerHTML = '';

      rolesCatalog.forEach((role) => {
        const item = document.createElement('div');
        item.className = `role-sidebar-item ${role.id === activeRoleEditorId ? 'active' : ''}`;
        item.dataset.roleId = role.id;

        const isAdm = role.id === 'admin';
        const isFunc = role.id === 'funcionario';
        const tagText = isAdm ? 'Control Total' : isFunc ? 'Operativo Base' : 'Personalizado';

        item.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 7px; min-width: 0;">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: ${role.color || '#00594E'}; flex-shrink: 0;"></span>
              <strong style="font-size: 0.83rem; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${role.name}</strong>
            </div>
            <span style="font-size: 0.64rem; font-weight: 800; padding: 2px 7px; border-radius: 999px; background: #F8FAFC; border: 1px solid #CBD5E1; color: #475569; white-space: nowrap;">
              ${tagText}
            </span>
          </div>
          <div style="font-size: 0.70rem; color: #64748B; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
            ${role.desc || 'Sin descripción'}
          </div>
        `;

        item.addEventListener('click', () => {
          document.querySelectorAll('.role-sidebar-item').forEach((it) => it.classList.remove('active'));
          item.classList.add('active');
          loadRoleIntoEditor(role);
        });

        rolesListContainer.appendChild(item);
      });
    }

    btnOpenRoles?.addEventListener('click', () => {
      cerrarDropdownColor();
      renderRolesCatalog();
      const defaultRole = rolesCatalog.find((r) => r.id === 'funcionario') || rolesCatalog[0];
      loadRoleIntoEditor(defaultRole);
      if (rolesModal) rolesModal.style.display = 'flex';
    });

    btnNewCustomRole?.addEventListener('click', () => {
      cerrarDropdownColor();
      document.querySelectorAll('.role-sidebar-item').forEach((it) => it.classList.remove('active'));
      loadRoleIntoEditor(null);
    });

    function closeRolesModal() {
      cerrarDropdownColor();
      if (rolesModal) rolesModal.style.display = 'none';
      activeRoleEditorId = null;
    }

    btnCloseRoles?.addEventListener('click', closeRolesModal);
    btnCancelRoles?.addEventListener('click', closeRolesModal);

    // Guardar Rol (upsert_role)
    const formRoleEditor = document.getElementById('form-role-editor') as HTMLFormElement | null;
    formRoleEditor?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = roleEditId?.value || '';
      const name = roleEditName?.value.trim() || '';
      const color = roleEditColor?.value || '#00594E';
      const desc = roleEditDesc?.value.trim() || '';
      const propagate = Boolean(roleEditPropagate?.checked);

      if (!name) {
        notifyToast('El nombre del rol es obligatorio.', 'error');
        return;
      }

      const selectedPerms: string[] = [];
      document.querySelectorAll<HTMLInputElement>('.role-perm-checkbox:checked').forEach((cb) => {
        if (cb.dataset.permId) selectedPerms.push(cb.dataset.permId);
      });

      if (btnSaveRole) {
        btnSaveRole.textContent = 'Guardando...';
        btnSaveRole.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'upsert_role',
            id,
            name,
            color,
            desc,
            permissions: selectedPerms,
            propagateToUsers: propagate,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo guardar el rol.');
        }

        if (Array.isArray(data.roles)) {
          rolesCatalog = data.roles;
        } else if (data.role) {
          const idx = rolesCatalog.findIndex((r) => r.id === data.role.id);
          if (idx >= 0) rolesCatalog[idx] = data.role;
          else rolesCatalog.push(data.role);
        }

        renderRolesCatalog();
        loadRoleIntoEditor(data.role || rolesCatalog.find((r) => r.id === id));
        syncAllRoleSelects();
        notifyToast(`Rol "${name}" guardado correctamente.`, 'success');
      } catch (err: any) {
        notifyToast(err?.message || 'Error guardando rol.', 'error');
      } finally {
        if (btnSaveRole) {
          btnSaveRole.textContent = 'Guardar Cambios del Rol';
          btnSaveRole.disabled = false;
        }
      }
    });

    // Eliminar Rol Personalizado
    btnDeleteRole?.addEventListener('click', async () => {
      if (!activeRoleEditorId || activeRoleEditorId === 'admin' || activeRoleEditorId === 'funcionario') return;
      const targetRole = rolesCatalog.find((r) => r.id === activeRoleEditorId);
      const roleName = targetRole?.name || activeRoleEditorId;

      if (!confirm(`¿Está seguro de eliminar el rol "${roleName}"? Los usuarios asociados pasarán a rol base Funcionario.`)) {
        return;
      }

      btnDeleteRole.disabled = true;
      btnDeleteRole.textContent = 'Eliminando...';

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'delete_role',
            roleId: activeRoleEditorId,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo eliminar el rol.');
        }

        rolesCatalog = rolesCatalog.filter((r) => r.id !== activeRoleEditorId);
        renderRolesCatalog();
        const defaultRole = rolesCatalog.find((r) => r.id === 'funcionario') || rolesCatalog[0];
        loadRoleIntoEditor(defaultRole);
        syncAllRoleSelects();
        notifyToast(`Rol "${roleName}" eliminado satisfactoriamente.`, 'success');
      } catch (err: any) {
        notifyToast(err?.message || 'Error al eliminar el rol.', 'error');
      } finally {
        if (btnDeleteRole) {
          btnDeleteRole.disabled = false;
          btnDeleteRole.textContent = 'Eliminar Rol';
        }
      }
    });

    // Sincronizar dinámicamente selects y KPIs de roles en toda la interfaz
    function syncAllRoleSelects() {
      const createUserRole = document.getElementById('create-user-role') as HTMLSelectElement | null;
      const editUserRole = document.getElementById('edit-user-role') as HTMLSelectElement | null;

      [createUserRole, editUserRole].forEach((sel) => {
        if (!sel) return;
        const currentVal = sel.value;
        let html = '';
        if (isCurrentUserAdmin) {
          html += '<option value="admin" data-color="#00594E">Administrador</option>';
        }
        html += '<option value="funcionario" data-color="#B5A160">Funcionario</option>';

        rolesCatalog
          .filter((r) => r.id !== 'admin' && r.id !== 'funcionario')
          .forEach((r) => {
            const isSel = r.id === currentVal ? 'selected' : '';
            html += `<option value="${r.id}" data-color="${r.color || '#64748B'}" ${isSel}>${r.name}</option>`;
          });

        sel.innerHTML = html;
        if (currentVal && sel.querySelector(`option[value="${currentVal}"]`)) {
          sel.value = currentVal;
        }
        if (typeof (window as any).refrescarSelectPersonalizado === 'function') {
          (window as any).refrescarSelectPersonalizado(sel);
        }
      });

      // Actualizar contadores de roles en cabecera
      const totalRolesEl = document.getElementById('kpi-total-roles');
      const customRolesSubEl = document.getElementById('kpi-custom-roles-sub');
      const customRolesCount = rolesCatalog.filter((r) => !r.isProtected).length;
      if (totalRolesEl) totalRolesEl.textContent = String(rolesCatalog.length);
      if (customRolesSubEl) customRolesSubEl.textContent = `${customRolesCount} rol(es) personalizado(s)`;
    }

    // Inicializar sincronización de selects al cargar
    syncAllRoleSelects();
  </script>
</AppLayout>
