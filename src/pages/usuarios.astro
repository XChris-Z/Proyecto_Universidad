              const groupModules = MODULOS_SISTEMA.filter((m) => m.groupKey === grp.key);
              return (
                <div class={`rbac-group-section ${grp.isSensitive ? 'rbac-group-sensitive' : ''}`} style={grp.isSensitive ? 'background: #FDFCF7; border: 1.5px solid #E6D8A7; border-left: 4px solid #B5A160; border-radius: 12px; padding: 14px 16px;' : 'background: #F8FAFC; border: 1.5px solid #DCE4E3; border-radius: 12px; padding: 14px 16px;'}>
