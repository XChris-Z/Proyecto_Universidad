              <button type="button" class="btn-perm-preset" data-preset="view_all" style="font-size: 0.73rem; font-weight: 750; padding: 5px 10px; border-radius: 7px; border: 1px solid #DBD2B0; background: #F7F5EE; color: #786832; cursor: pointer;">Solo Ver Todo</button>
              <button type="button" class="btn-perm-preset" data-preset="full_modules" style="font-size: 0.73rem; font-weight: 750; padding: 5px 10px; border-radius: 7px; border: 1px solid #B2CFCB; background: #F2F7F6; color: #00594E; cursor: pointer;">Ver y Gestionar Todo</button>
              <button type="button" class="btn-perm-preset" data-preset="clear_all" style="font-size: 0.73rem; font-weight: 750; padding: 5px 10px; border-radius: 7px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">Limpiar todo</button>
