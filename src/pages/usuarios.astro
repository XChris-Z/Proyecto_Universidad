                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={mod.icon}/></svg>
                            </div>
                            <div style="min-width: 0;">
                              <div style="font-size: 0.84rem; font-weight: 800; color: #111827;">{mod.label}</div>
                              <div style="font-size: 0.72rem; color: #64748B;">{mod.description}</div>
