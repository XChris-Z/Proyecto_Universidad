                          </div>

                          <!-- Switch Maestro del Módulo -->
                          <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                            <span style="font-size: 0.70rem; font-weight: 750; color: #52606D;">Acceso</span>
                            <label class="switch switch-sm" title={`Habilitar o deshabilitar módulo ${mod.label}`}>
                              <input type="checkbox" class="perm-module-master" data-module-id={mod.id} />
                              <span class="slider"></span>
                            </label>
                          </div>
                        </div>

                        <!-- Chips de Acciones Granulares -->
                        <div class="module-actions-chips-wrap" style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 8px; border-top: 1px dashed #E2E8F0;">
                          {mod.acciones.map((act) => (
                            <label class="action-chip" title={act.desc || act.label} data-module-id={mod.id} data-action-id={act.id} data-perm-id={`${mod.id}.${act.id}`}>
                              <input
                                type="checkbox"
                                class="perm-checkbox"
                                data-module-id={mod.id}
                                data-action-id={act.id}
                                data-perm-id={`${mod.id}.${act.id}`}
                              />
                              <span class="action-chip-badge">{act.label}</span>
                            </label>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

        </div>

        <div style="padding: 15px 24px; background: #f8fafc; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-perms-modal">Cancelar</button>
