---
// src/pages/login.astro
// Pantalla de Autenticación Institucional Oficial UI/UX Pro Max — SGD Unitrópico
import AuthLayout from "@layouts/AuthLayout.astro";
---

<AuthLayout title="Acceso al Sistema — SGD Unitrópico">
  <div class="login-promax-wrapper">
    <!-- =====================================================================
         PANEL IZQUIERDO: IDENTIDAD INSTITUCIONAL LIMPIA Y CENTRADA
         ===================================================================== -->
    <aside
      class="login-brand-panel"
      aria-label="Identidad Institucional Unitrópico"
    >
      <div class="brand-panel-inner">
        <div class="brand-header">
          <!-- 1. Logo Institucional con Presencia Pro Max -->
          <div class="login-brand-logo-wrap">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="brand-logo-img"
              loading="eager"
            />
          </div>

          <!-- 2. Título Principal -->
          <h1 class="brand-main-title">
            Sistema de Gestión Documental
          </h1>

          <!-- 3. Subtítulo Institucional + Línea de Acento Dorado -->
          <p class="brand-subtitle">
            PLATAFORMA INSTITUCIONAL PARA LA RADICACIÓN, SEGUIMIENTO Y GESTIÓN DE EXPEDIENTES OFICIALES.
          </p>
          <div class="brand-gold-accent"></div>
        </div>
      </div>

      <!-- Pie de Copyright Fijo en la Parte Inferior -->
      <div class="brand-panel-footer">
        <p class="brand-copy">
          &copy; {new Date().getFullYear()} Unitrópico &bull; Yopal, Casanare, Colombia
        </p>
      </div>
    </aside>

    <!-- =====================================================================
         PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
         ===================================================================== -->
    <main class="login-form-panel">
      <div class="login-form-wrapper">
        <!-- Logo en Móvil (Visible solo en pantallas pequeñas) -->
        <div class="login-mobile-header">
          <div class="login-brand-logo-wrap mobile">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="login-mobile-logo"
              loading="eager"
            />
          </div>
          <div class="brand-gold-accent mobile"></div>
        </div>

        <div class="login-card-promax">
          <!-- Encabezado del Formulario -->
          <div class="form-card-header">
            <div class="form-badge">
              <span class="badge-dot"></span>
              <span>Portal de Funcionarios Institucionales</span>
            </div>
            <h2 class="form-main-title">Iniciar Sesión</h2>
            <p class="form-main-subtitle">
              Ingrese su correo institucional para acceder al panel de control y gestión de expedientes.
            </p>
          </div>

          <!-- Caja de Alerta / Errores -->
          <div
            id="login-alert-box"
            class="login-alert-promax"
            style="display: none;"
            role="alert"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="alert-icon"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-alert-text"
              >Credenciales incorrectas o usuario no registrado.</span
            >
          </div>

          <!-- Formulario Oficial de Autenticación Institucional -->
          <form id="form-login" class="login-form-body" autocomplete="on">
            <!-- Campo: Correo Electrónico Institucional -->
            <div class="form-group-promax">
              <label for="login-email" class="form-label-promax">
                Correo Electrónico Institucional
              </label>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="login-email"
                  name="email"
                  class="form-input-promax"
                  placeholder="usuario@unitropico.edu.co"
                  required
                  autocomplete="username"
                  autofocus
                />
              </div>
            </div>

            <!-- Campo: Contraseña Institucional con Toggle de Visibilidad -->
            <div class="form-group-promax">
              <div class="label-row-promax">
                <label for="login-password" class="form-label-promax"
                  >Contraseña</label
                >
              </div>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  class="form-input-promax"
                  placeholder="••••••••••••"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="btn-toggle-password"
                  class="btn-toggle-eye-promax"
                  aria-label="Mostrar u ocultar contraseña"
                  title="Mostrar contraseña"
                >
                  <svg
                    id="eye-icon-open"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                    ></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg
                    id="eye-icon-closed"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="display: none;"
                  >
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                    ></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Opciones Adicionales: Recordar Sesión -->
            <div class="form-options-promax">
              <label class="remember-checkbox-promax">
                <input type="checkbox" id="remember-me" checked />
                <span class="checkbox-custom-promax"></span>
                <span>Mantener sesión iniciada</span>
              </label>
            </div>

            <!-- Botón de Inicio de Sesión Oficial -->
            <button
              type="submit"
              id="btn-submit-login"
              class="btn-submit-promax"
            >
              <span class="btn-text-promax" id="btn-login-text"
                >Iniciar Sesión Institucional</span
              >
              <div
                class="spinner-loader-promax"
                id="btn-login-spinner"
                style="display: none;"
              >
              </div>
            </button>
          </form>

          <!-- Separador Discreto -->
          <div class="login-divider-promax">
            <span>Accesos Complementarios</span>
          </div>

          <!-- Accesos Complementarios: Ciudadanos y Dependencias -->
          <div class="login-secondary-portals">
            <!-- 1. Consulta Ciudadana / Solicitantes -->
            <a href="/consulta-respuesta" class="sec-portal-item citizen" title="Consultar Estado o Respuesta de Radicado">
              <div class="sec-portal-icon citizen">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <div class="sec-portal-info">
                <span class="sec-portal-badge citizen">Atención al Ciudadano</span>
                <strong class="sec-portal-title">Consultar Respuesta con PIN</strong>
              </div>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="sec-arrow"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- 2. Portal Externo de Dependencias -->
            <a href="/portal-responsable" class="sec-portal-item office" title="Portal de Entrega de Anexos">
              <div class="sec-portal-icon office">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                  <polyline points="12 11 12 17"></polyline>
                  <polyline points="9 14 12 11 15 14"></polyline>
                </svg>
              </div>
              <div class="sec-portal-info">
                <span class="sec-portal-badge office">Dependencias</span>
                <strong class="sec-portal-title">Aportar Soportes con Código</strong>
              </div>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="sec-arrow"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</AuthLayout>

<style>
  /* ==========================================================================
     ANIMACIÓN GLOBAL PRO MAX CROSSFADE
     ========================================================================== */
  @keyframes proMaxCrossfade {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.992);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ==========================================================================
     CONTENEDOR SPLIT SCREEN PRO MAX
     ========================================================================== */
  .login-promax-wrapper {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background: #F8FAFC;
    font-family:
      "Montserrat",
      system-ui,
      -apple-system,
      sans-serif;
  }

  /* ==========================================================================
     PANEL IZQUIERDO: IDENTIDAD INSTITUCIONAL LIMPIA Y CENTRADA
     ========================================================================== */
  .login-brand-panel {
    width: 50%;
    min-width: 480px;
    background: radial-gradient(circle at 20% 20%, #006B5E 0%, #00594E 55%, #003E36 100%);
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    box-sizing: border-box;
    border-right: 1px solid rgba(181, 161, 96, 0.25);
    min-height: 100%;
  }

  .brand-panel-inner {
    max-width: 460px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
    animation: proMaxCrossfade 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 1. Logo Institucional con Presencia Pro Max */
  .login-brand-logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    padding: 18px 32px;
    border-radius: 18px;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.25), 0 0 0 1.5px rgba(181, 161, 96, 0.45);
    margin-bottom: 30px;
    width: fit-content;
    animation: proMaxCrossfade 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .login-brand-logo-wrap.mobile {
    margin-bottom: 14px;
    padding: 10px 22px;
    border-radius: 14px;
  }

  .login-brand-logo-wrap img {
    max-width: 260px;
    max-height: 92px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .login-brand-logo-wrap.mobile img {
    max-width: 180px;
    max-height: 54px;
  }

  /* 2. Título Principal */
  .brand-main-title {
    font-size: 2.45rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0 0 16px 0;
  }

  /* 3. Subtítulo Institucional y Acento Dorado */
  .brand-subtitle {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.65;
    max-width: 450px;
    margin: 0;
  }

  .brand-gold-accent {
    height: 2px;
    width: 90px;
    background: linear-gradient(90deg, #B5A160 0%, rgba(181, 161, 96, 0) 100%);
    margin-top: 20px;
    border-radius: 2px;
  }

  .brand-gold-accent.mobile {
    margin: 0 auto 12px auto;
  }

  /* Pie Sutil Fijo en la Parte Inferior */
  .brand-panel-footer {
    position: absolute;
    bottom: 24px;
    left: clamp(2.5rem, 5vw, 4.5rem);
    right: clamp(2.5rem, 5vw, 4.5rem);
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 460px;
    margin: 0 auto;
  }

  .brand-copy {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.62);
    margin: 0;
  }

  /* ==========================================================================
     PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
     ========================================================================== */
  .login-form-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #F8FAFC;
    box-sizing: border-box;
  }

  .login-form-wrapper {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .login-mobile-header {
    display: none;
    text-align: center;
    margin-bottom: 16px;
  }

  /* Tarjeta Ejecutiva con Elevación Multicapa y Crossfade */
  .login-card-promax {
    width: 100%;
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #DCE4E3;
    box-shadow: 0 10px 30px -10px rgba(0, 89, 78, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
    padding: clamp(28px, 4vw, 40px);
    box-sizing: border-box;
    animation: proMaxCrossfade 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Encabezado */
  .form-card-header {
    margin-bottom: 24px;
  }

  .form-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #F2F7F6;
    border: 1px solid #B2CFCB;
    color: #00594E;
    font-size: 0.72rem;
    font-weight: 750;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00594E;
  }

  .form-main-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.02em;
    margin: 0 0 6px 0;
  }

  .form-main-subtitle {
    font-size: 0.84rem;
    color: #475569;
    line-height: 1.5;
    margin: 0;
  }

  /* Alerta */
  .login-alert-promax {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 10px;
    color: #991b1b;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .alert-icon {
    flex-shrink: 0;
    color: #dc2626;
  }

  /* Inputs */
  .login-form-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group-promax {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .label-row-promax {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .form-label-promax {
    font-size: 0.78rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.01em;
  }

  .input-container-promax {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon-promax {
    position: absolute;
    left: 14px;
    color: #64748B;
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .form-input-promax {
    width: 100%;
    padding: 12px 14px 12px 42px;
    background: #F8FAFC;
    border: 1.5px solid #DCE4E3;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 550;
    color: #111827;
    font-family: inherit;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .form-input-promax::placeholder {
    color: #64748B;
    font-weight: 450;
  }

  .form-input-promax:focus {
    background: #FFFFFF;
    border-color: #00594E;
    box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
    outline: none;
  }

  .input-container-promax:focus-within .input-icon-promax {
    color: #00594E;
  }

  .btn-toggle-eye-promax {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748B;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-toggle-eye-promax:hover {
    color: #00594E;
    background: #F2F7F6;
  }

  /* Opciones */
  .form-options-promax {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    margin-top: -2px;
  }

  .remember-checkbox-promax {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #475569;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }

  .remember-checkbox-promax input[type="checkbox"] {
    accent-color: #00594E;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  /* Botón Submit */
  .btn-submit-promax {
    width: 100%;
    padding: 13px 20px;
    background: #00594E;
    color: #FFFFFF;
    border: 1px solid #00443B;
    border-bottom: 3px solid #B5A160;
    border-radius: 10px;
    font-size: 0.94rem;
    font-weight: 750;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(0, 89, 78, 0.22);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 4px;
  }

  .btn-submit-promax:hover:not(:disabled) {
    background: #00443B;
    box-shadow: 0 6px 20px rgba(0, 89, 78, 0.32);
    transform: translateY(-1px);
  }

  .btn-submit-promax:active:not(:disabled) {
    background: #00332C;
    transform: translateY(0);
  }

  .btn-submit-promax:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .spinner-loader-promax {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #FFFFFF;
    border-radius: 50%;
    animation: promaxSpin 0.75s linear infinite;
  }

  @keyframes promaxSpin {
    to { transform: rotate(360deg); }
  }

  /* Separador */
  .login-divider-promax {
    display: flex;
    align-items: center;
    margin: 24px 0 16px 0;
    color: #64748B;
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .login-divider-promax::before,
  .login-divider-promax::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #DCE4E3;
  }

  .login-divider-promax span {
    padding: 0 12px;
  }

  /* ==========================================================================
     ACCESOS COMPLEMENTARIOS (SOLICITANTES Y DEPENDENCIAS)
     ========================================================================== */
  .login-secondary-portals {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .sec-portal-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: #F8FAFC;
    border: 1px solid #DCE4E3;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    color: #111827;
  }

  .sec-portal-item:hover {
    background: #F2F7F6;
    border-color: #00594E;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -4px rgba(0, 89, 78, 0.1);
  }

  .sec-portal-item.citizen:hover {
    background: #F7F5EE;
    border-color: #B5A160;
    box-shadow: 0 6px 16px -4px rgba(181, 161, 96, 0.15);
  }

  .sec-portal-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sec-portal-icon.citizen {
    background: #F7F5EE;
    color: #786832;
    border: 1px solid #DBD2B0;
  }

  .sec-portal-icon.office {
    background: #F2F7F6;
    color: #00594E;
    border: 1px solid #B2CFCB;
  }

  .sec-portal-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sec-portal-badge {
    font-size: 0.65rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sec-portal-badge.citizen { color: #786832; }
  .sec-portal-badge.office { color: #00594E; }

  .sec-portal-title {
    font-size: 0.84rem;
    font-weight: 700;
    color: #111827;
  }

  .sec-arrow {
    color: #64748B;
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .sec-portal-item:hover .sec-arrow {
    transform: translateX(3px);
    color: #00594E;
  }

  .sec-portal-item.citizen:hover .sec-arrow {
    color: #786832;
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 1024px) {
    .login-brand-panel {
      display: none;
    }

    .login-mobile-header {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .login-form-panel {
      padding: 2rem 1.25rem;
    }

    .login-card-promax {
      padding: 28px 20px;
    }
  }
</style>

<script>
  // Detección y redirección inmediata ante parámetros de consulta de radicado o pin
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('radicado') || urlParams.has('pin') || urlParams.has('modo') || urlParams.has('consulta')) {
    window.location.replace('/consulta-respuesta' + window.location.search);
  }

  import { supabase } from "@lib/supabase";
  import { SESSION_STORAGE_KEY, SESSION_COOKIE_KEY } from "@lib/constants";
  import { logSystemActivity } from "@lib/audit";

  const form = document.getElementById("form-login") as HTMLFormElement;
  const emailInput = document.getElementById("login-email") as HTMLInputElement;
  const passwordInput = document.getElementById(
    "login-password",
  ) as HTMLInputElement;
  const rememberCheckbox = document.getElementById(
    "remember-me",
  ) as HTMLInputElement;
  const submitBtn = document.getElementById(
    "btn-submit-login",
  ) as HTMLButtonElement;
  const btnText = document.getElementById("btn-login-text") as HTMLElement;
  const btnSpinner = document.getElementById(
    "btn-login-spinner",
  ) as HTMLElement;
  const alertBox = document.getElementById("login-alert-box") as HTMLElement;
  const alertText = document.getElementById("login-alert-text") as HTMLElement;

  // Toggle visibilidad de contraseña
  const togglePassBtn = document.getElementById("btn-toggle-password");
  const eyeOpen = document.getElementById("eye-icon-open");
  const eyeClosed = document.getElementById("eye-icon-closed");

  if (togglePassBtn && passwordInput && eyeOpen && eyeClosed) {
    togglePassBtn.addEventListener("click", () => {
      const isPassword = passwordInput.type === "password";
      passwordInput.type = isPassword ? "text" : "password";
      eyeOpen.style.display = isPassword ? "none" : "block";
      eyeClosed.style.display = isPassword ? "block" : "none";
      togglePassBtn.setAttribute(
        "title",
        isPassword ? "Ocultar contraseña" : "Mostrar contraseña",
      );
    });
  }

  function showAlert(msg: string) {
    if (alertBox && alertText) {
      alertText.textContent = msg;
      alertBox.style.display = "flex";
    }
  }

  function hideAlert() {
    if (alertBox) {
      alertBox.style.display = "none";
    }
  }

  function setLoading(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    if (loading) {
      if (btnText) btnText.textContent = "Verificando credenciales...";
      if (btnSpinner) btnSpinner.style.display = "block";
    } else {
      if (btnText) btnText.textContent = "Iniciar Sesión Institucional";
      if (btnSpinner) btnSpinner.style.display = "none";
    }
  }

  // Manejo del Submit del Login Institucional
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideAlert();

    const email = emailInput?.value.trim().toLowerCase() || "";
    const password = passwordInput?.value || "";
    const remember = rememberCheckbox?.checked ?? true;

    if (!email || !password) {
      showAlert(
        "Por favor ingrese tanto el correo institucional como la contraseña.",
      );
      return;
    }

    setLoading(true);

    try {
      // 1. Autenticación con credenciales institucionales
      const { data: authData, error: authError } =
        await supabase.auth.signInWithPassword({
          email,
          password,
        });

      if (authError || !authData.user) {
        console.warn("Error de autenticación:", authError);
        const msg =
          authError?.message === "Invalid login credentials"
            ? "Credenciales incorrectas. Verifique su correo institucional y contraseña."
            : authError?.message ||
              "No se pudo iniciar sesión. Verifique sus credenciales.";
        showAlert(msg);
        setLoading(false);
        return;
      }

      // 2. Consultar perfil institucional del usuario en PostgreSQL
      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .or(`email.eq.${email},id.eq.${authData.user.id}`)
        .maybeSingle();

      const fullName =
        profile?.full_name ||
        authData.user.user_metadata?.full_name ||
        "Funcionario Institucional";
      const roleCode =
        profile?.role || authData.user.user_metadata?.role || "funcionario";
      const isAdmin = roleCode === "admin";
      const userId = profile?.id || "usr-root";

      const sessionUser = {
        id: userId,
        authId: authData.user.id,
        name: fullName,
        email: email,
        role: isAdmin ? "Administrador" : "Funcionario",
        roleId: roleCode,
        initials:
          fullName
            .split(" ")
            .map((n: string) => n[0])
            .join("")
            .substring(0, 2)
            .toUpperCase() || "FN",
        avatarColor: isAdmin ? "#00594E" : "#B5A160",
        avatar_url: profile?.avatar_url || null,
        avatarUrl: profile?.avatar_url || null,
      };

      // 3. Persistir sesión en localStorage y cookies del middleware
      localStorage.setItem("sgd_current_user", JSON.stringify(sessionUser));
      const sessionPayload = {
        userId: sessionUser.id,
        email: sessionUser.email,
        loggedAt: new Date().toISOString(),
      };

      if (remember) {
        localStorage.setItem(
          SESSION_STORAGE_KEY,
          JSON.stringify(sessionPayload),
        );
      } else {
        sessionStorage.setItem(
          SESSION_STORAGE_KEY,
          JSON.stringify(sessionPayload),
        );
      }

      // Cookie de sesión que verifica el middleware (max-age 7 días si remember, o 1 día)
      const maxAge = remember ? 7 * 24 * 3600 : 24 * 3600;
      document.cookie = `${SESSION_COOKIE_KEY}=${sessionUser.id}; path=/; max-age=${maxAge}; SameSite=Lax`;

      // 4. Registro oficial de trazabilidad en auditoría
      try {
        await logSystemActivity({
          actor: sessionUser,
          action: "Inicio de Sesión Exitoso",
          actionType: "ACCESO",
          entity: "Control de Acceso Institucional",
          entityId: sessionUser.id,
          details: `El usuario ${sessionUser.name} (${sessionUser.email}) inició sesión con credenciales institucionales verificadas.`,
          severity: "INFO",
        });
      } catch (auditErr) {
        console.warn(
          "Registro de auditoría completado en segundo plano:",
          auditErr,
        );
      }

      // 5. Redirección inmediata al Dashboard Institucional
      window.location.href = "/dashboard";
    } catch (err: any) {
      console.error("Error general durante el login:", err);
      showAlert(
        err.message ||
          "Ocurrió un error inesperado al conectar con el servidor de autenticación.",
      );
      setLoading(false);
    }
  });
</script>
