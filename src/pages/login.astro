---
// src/pages/login.astro
// Pantalla de Autenticación Institucional Oficial UI/UX Pro Max — SGD Unitrópico
import AuthLayout from "@layouts/AuthLayout.astro";
---

<AuthLayout title="Acceso al Sistema — SGD Unitrópico">
  <div class="login-promax-wrapper">
    <!-- =====================================================================
         PANEL IZQUIERDO: IDENTIDAD INSTITUCIONAL INMERSIVA (DESKTOP)
         ===================================================================== -->
    <aside
      class="login-brand-panel"
      aria-label="Identidad Institucional Unitrópico"
    >
      <div class="brand-panel-inner">
        <!-- Bloque Superior de Identidad (Compacto y Centrado/Alineado) -->
        <div class="brand-header">
          <div class="login-brand-logo-wrap">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="brand-logo-img"
              loading="eager"
            />
          </div>
          
          <div class="brand-institution-pill">
            <span class="brand-institution-dot"></span>
            <span>GESTIÓN DOCUMENTAL &bull; UNITRÓPICO</span>
          </div>

          <h1 class="brand-main-title">
            Sistema de Gestión Documental
          </h1>
          <p class="brand-subtitle">
            Plataforma institucional para la radicación, seguimiento y gestión de expedientes oficiales.
          </p>
        </div>

        <!-- Micro-Bento Visual: Chart Element Ejecutivo de Flujo Documental -->
        <div class="brand-chart-bento-card">
          <div class="bento-chart-header">
            <div class="bento-chart-titles">
              <span class="chart-badge-title">Trazabilidad en Tiempo Real</span>
              <span class="chart-badge-subtitle">Ciclo de vida del expediente documental</span>
            </div>
            <span class="bento-status-pill">
              <span class="live-pulse"></span>
              <span>Operativo</span>
            </span>
          </div>

          <!-- Gráfico y Barras de Flujo Documental -->
          <div class="flow-chart-stages">
            <!-- Etapa 1: Radicación Digital -->
            <div class="flow-stage-row">
              <div class="stage-label-group">
                <div class="stage-indicator-icon gold">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
                <span class="stage-name">Radicación Digital</span>
              </div>
              <div class="stage-bar-wrap">
                <div class="stage-bar-track">
                  <div class="stage-bar-fill gold" style="width: 100%;"></div>
                </div>
                <span class="stage-pct gold">100%</span>
              </div>
            </div>

            <!-- Etapa 2: Gestión por Dependencias -->
            <div class="flow-stage-row">
              <div class="stage-label-group">
                <div class="stage-indicator-icon emerald">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <span class="stage-name">Gestión por Dependencias</span>
              </div>
              <div class="stage-bar-wrap">
                <div class="stage-bar-track">
                  <div class="stage-bar-fill emerald" style="width: 82%;"></div>
                </div>
                <span class="stage-pct emerald">En Curso</span>
              </div>
            </div>

            <!-- Etapa 3: Despacho Oficial -->
            <div class="flow-stage-row">
              <div class="stage-label-group">
                <div class="stage-indicator-icon verified">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="stage-name">Despacho Oficial</span>
              </div>
              <div class="stage-bar-wrap">
                <div class="stage-bar-track">
                  <div class="stage-bar-fill verified" style="width: 100%;"></div>
                </div>
                <span class="stage-pct verified">Verificado</span>
              </div>
            </div>
          </div>

          <!-- Pie del Micro-Bento -->
          <div class="bento-chart-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#B5A160" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Control automatizado de términos y custodia digital</span>
          </div>
        </div>

        <!-- Footer del Panel de Marca -->
        <div class="brand-panel-footer">
          <p class="brand-copy">
            &copy; {new Date().getFullYear()} Unitrópico &bull; Yopal, Casanare, Colombia
          </p>
        </div>
      </div>
    </aside>

    <!-- =====================================================================
         PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
         ===================================================================== -->
    <main class="login-form-panel">
      <div class="login-form-wrapper">
        <!-- Logo en Móvil (Visible solo en pantallas pequeñas) -->
        <div class="login-mobile-header">
          <div class="login-brand-logo-wrap mobile">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="login-mobile-logo"
              loading="eager"
            />
          </div>
          <div class="brand-gold-line mobile"></div>
        </div>

        <div class="login-card-promax">
          <!-- Encabezado del Formulario -->
          <div class="form-card-header">
            <div class="form-badge">
              <span class="badge-dot"></span>
              <span>Portal de Funcionarios Institucionales</span>
            </div>
            <h2 class="form-main-title">Iniciar Sesión</h2>
            <p class="form-main-subtitle">
              Ingrese su correo institucional para acceder al panel de control rectoral y gestión de expedientes.
            </p>
          </div>

          <!-- Caja de Alerta / Errores -->
          <div
            id="login-alert-box"
            class="login-alert-promax"
            style="display: none;"
            role="alert"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="alert-icon"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-alert-text"
              >Credenciales incorrectas o usuario no registrado.</span
            >
          </div>

          <!-- Formulario Oficial de Autenticación Institucional -->
          <form id="form-login" class="login-form-body" autocomplete="on">
            <!-- Campo: Correo Electrónico Institucional -->
            <div class="form-group-promax">
              <label for="login-email" class="form-label-promax">
                Correo Electrónico Institucional
              </label>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="login-email"
                  name="email"
                  class="form-input-promax"
                  placeholder="usuario@unitropico.edu.co"
                  required
                  autocomplete="username"
                  autofocus
                />
              </div>
            </div>

            <!-- Campo: Contraseña Institucional con Toggle de Visibilidad -->
            <div class="form-group-promax">
              <div class="label-row-promax">
                <label for="login-password" class="form-label-promax"
                  >Contraseña</label
                >
              </div>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  class="form-input-promax"
                  placeholder="••••••••••••"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="btn-toggle-password"
                  class="btn-toggle-eye-promax"
                  aria-label="Mostrar u ocultar contraseña"
                  title="Mostrar contraseña"
                >
                  <svg
                    id="eye-icon-open"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                    ></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg
                    id="eye-icon-closed"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="display: none;"
                  >
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                    ></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Opciones Adicionales: Recordar Sesión -->
            <div class="form-options-promax">
              <label class="remember-checkbox-promax">
                <input type="checkbox" id="remember-me" checked />
                <span class="checkbox-custom-promax"></span>
                <span>Mantener sesión iniciada</span>
              </label>
            </div>

            <!-- Botón de Inicio de Sesión Oficial -->
            <button
              type="submit"
              id="btn-submit-login"
              class="btn-submit-promax"
            >
              <span class="btn-text-promax" id="btn-login-text"
                >Iniciar Sesión Institucional</span
              >
              <div
                class="spinner-loader-promax"
                id="btn-login-spinner"
                style="display: none;"
              >
              </div>
            </button>
          </form>

          <!-- Separador Discreto -->
          <div class="login-divider-promax">
            <span>Accesos Complementarios</span>
          </div>

          <!-- Accesos Complementarios: Ciudadanos y Dependencias -->
          <div class="login-secondary-portals">
            <!-- 1. Consulta Ciudadana / Solicitantes -->
            <a href="/consulta-respuesta" class="sec-portal-item citizen" title="Consultar Estado o Respuesta de Radicado">
              <div class="sec-portal-icon citizen">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <div class="sec-portal-info">
                <span class="sec-portal-badge citizen">Atención al Ciudadano</span>
                <strong class="sec-portal-title">Consultar Respuesta con PIN</strong>
              </div>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="sec-arrow"><polyline points="9 18 15 12 9 6"/></svg>
            </a>

            <!-- 2. Portal Externo de Dependencias -->
            <a href="/portal-responsable" class="sec-portal-item office" title="Portal de Entrega de Anexos">
              <div class="sec-portal-icon office">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                  <polyline points="12 11 12 17"></polyline>
                  <polyline points="9 14 12 11 15 14"></polyline>
                </svg>
              </div>
              <div class="sec-portal-info">
                <span class="sec-portal-badge office">Dependencias</span>
                <strong class="sec-portal-title">Aportar Soportes con Código</strong>
              </div>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="sec-arrow"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</AuthLayout>

<style>
  /* ==========================================================================
     CONTENEDOR SPLIT SCREEN PRO MAX
     ========================================================================== */
  .login-promax-wrapper {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background: #f8fafc;
    font-family:
      "Montserrat",
      system-ui,
      -apple-system,
      sans-serif;
  }

  /* ==========================================================================
     PANEL IZQUIERDO: MARCA E IDENTIDAD INSTITUCIONAL
     ========================================================================== */
  .login-brand-panel {
    width: 50%;
    min-width: 480px;
    background: radial-gradient(circle at 20% 20%, #00685B 0%, #00594E 60%, #003E36 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    box-sizing: border-box;
    border-right: 1px solid rgba(181, 161, 96, 0.25);
  }

  .brand-panel-inner {
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
  }

  /* Contenedor Elegante y Proporcionado del Logo Oficial */
  .login-brand-logo-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    padding: 12px 22px;
    border-radius: 14px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(181, 161, 96, 0.35);
    margin-bottom: 20px;
    width: fit-content;
  }

  .login-brand-logo-wrap.mobile {
    margin-bottom: 12px;
    padding: 8px 18px;
  }

  .login-brand-logo-wrap img {
    max-width: 190px;
    max-height: 64px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .brand-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Píldora Dorada Superior */
  .brand-institution-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #B5A160;
    background: rgba(181, 161, 96, 0.14);
    border: 1px solid rgba(181, 161, 96, 0.35);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }

  .brand-institution-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #B5A160;
  }

  .brand-gold-line {
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, #B5A160, #786832);
    border-radius: 2px;
    margin: 12px 0;
  }

  .brand-gold-line.mobile {
    margin: 10px auto;
  }

  .brand-main-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 4px 0 8px 0;
  }

  .brand-subtitle {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }

  /* ==========================================================================
     MICRO-BENTO VISUAL: CHART ELEMENT EJECUTIVO DE FLUJO DOCUMENTAL
     ========================================================================== */
  .brand-chart-bento-card {
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(181, 161, 96, 0.28);
    border-radius: 16px;
    padding: 18px 20px;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.2);
    animation: fadeSlideIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bento-chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .bento-chart-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chart-badge-title {
    font-size: 0.84rem;
    font-weight: 750;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .chart-badge-subtitle {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.68);
  }

  .bento-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(110, 231, 183, 0.15);
    border: 1px solid rgba(110, 231, 183, 0.4);
    color: #6EE7B7;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6EE7B7;
    box-shadow: 0 0 8px #6EE7B7;
    animation: pulseLiveDot 1.8s infinite;
  }

  @keyframes pulseLiveDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.6; }
  }

  .flow-chart-stages {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .flow-stage-row {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stage-label-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stage-indicator-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stage-indicator-icon.gold {
    background: rgba(181, 161, 96, 0.2);
    color: #F7F5EE;
    border: 1px solid rgba(181, 161, 96, 0.4);
  }

  .stage-indicator-icon.emerald {
    background: rgba(110, 231, 183, 0.2);
    color: #6EE7B7;
    border: 1px solid rgba(110, 231, 183, 0.4);
  }

  .stage-indicator-icon.verified {
    background: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .stage-name {
    font-size: 0.78rem;
    font-weight: 650;
    color: rgba(255, 255, 255, 0.95);
    flex: 1;
  }

  .stage-bar-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 30px;
  }

  .stage-bar-track {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
  }

  .stage-bar-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s ease;
  }

  .stage-bar-fill.gold {
    background: linear-gradient(90deg, #B5A160, #e0d19f);
  }

  .stage-bar-fill.emerald {
    background: linear-gradient(90deg, #10B981, #6EE7B7);
  }

  .stage-bar-fill.verified {
    background: linear-gradient(90deg, #00594E, #34D399);
    box-shadow: 0 0 8px rgba(110, 231, 183, 0.4);
  }

  .stage-pct {
    font-size: 0.72rem;
    font-weight: 750;
    min-width: 58px;
    text-align: right;
  }

  .stage-pct.gold { color: #fde68a; }
  .stage-pct.emerald { color: #6EE7B7; }
  .stage-pct.verified { color: #FFFFFF; }

  .bento-chart-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Footer del Panel */
  .brand-panel-footer {
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .brand-copy {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* ==========================================================================
     PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
     ========================================================================== */
  .login-form-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #f8fafc;
    box-sizing: border-box;
  }

  .login-form-wrapper {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .login-mobile-header {
    display: none;
    text-align: center;
    margin-bottom: 16px;
  }

  .login-mobile-logo {
    max-height: 48px;
    max-width: 170px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Tarjeta con animación Crossfade */
  .login-card-promax {
    width: 100%;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #DCE4E3;
    box-shadow: 0 20px 40px -15px rgba(0, 89, 78, 0.10);
    padding: clamp(28px, 4vw, 40px);
    box-sizing: border-box;
    animation: promaxCardCrossfade 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes promaxCardCrossfade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Encabezado */
  .form-card-header {
    margin-bottom: 24px;
  }

  .form-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #F2F7F6;
    border: 1px solid #B2CFCB;
    color: #00594E;
    font-size: 0.72rem;
    font-weight: 750;
    padding: 3px 10px;
