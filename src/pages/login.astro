---
// src/pages/login.astro
// Pantalla de Autenticación Institucional Oficial UI/UX Pro Max — SGD Unitrópico
import AuthLayout from "@layouts/AuthLayout.astro";
import '@styles/login.css';
---

<AuthLayout title="Acceso al Sistema — SGD Unitrópico">
  <div class="login-promax-wrapper">
    <!-- =====================================================================
        ANEL IZQUIERDO: IDENTIDAD INSTITUCIONAL INMERSIVA (DESKTOP)
        ===================================================================== -->
    <aside
      class="login-brand-panel"
      aria-label="Identidad Institucional Unitrópico"
    >
      <div class="brand-panel-inner">
        <!-- Cabecera de Marca -->
        <div class="brand-header">
          <div class="brand-logo-card">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="brand-logo-img"
              loading="eager"
            />
          </div>
          <div class="brand-gold-line"></div>
          <span class="brand-institution-chip"
            >Universidad Internacional del Trópico Americano</span
          >
          <h1 class="brand-main-title">
            Sistema de Gestión Documental de Rectoría
          </h1>
          <p class="brand-subtitle">
            Plataforma institucional de radicación oficial, seguimiento y
            gestión de documentos.
          </p>
        </div>

        <!-- 3 Píldoras de Valor Institucional -->
        <div class="brand-features-list">
          <div class="brand-feature-item">
            <div class="feature-icon-box gold">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <div class="feature-text">
              <strong>Control de Términos Ley 1755</strong>
              <span
                >Semáforo preventivo SLA de 15 días con alertas tempranas
                automatizadas.</span
              >
            </div>
          </div>

          <div class="brand-feature-item">
            <div class="feature-icon-box emerald">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline></svg
              >
            </div>
            <div class="feature-text">
              <strong>Expedientes Digitales Centralizados</strong>
              <span
                >Custodia y archivo digital con subcarpetas para cada oficina
                requerida.</span
              >
            </div>
          </div>

          <div class="brand-feature-item">
            <div class="feature-icon-box teal">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
            </div>
            <div class="feature-text">
              <strong>Autenticación Cifrada y Trazabilidad</strong>
              <span
                >Seguridad con Supabase Auth y registro inmutable en bitácora de
                auditoría.</span
              >
            </div>
          </div>
        </div>

        <!-- Footer del Panel de Marca -->
        <div class="brand-panel-footer">
          <div class="security-seal">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"
              ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
            >
            <span>Conexión Segura TLS 1.3 &bull; Despacho Rectoral</span>
          </div>
          <p class="brand-copy">
            &copy; {new Date().getFullYear()} Unitrópico &bull; Yopal, Casanare, Colombia
          </p>
        </div>
      </div>
    </aside>

    <!-- =====================================================================
         PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
         ===================================================================== -->
    <main class="login-form-panel">
      <div class="login-form-wrapper">
        <!-- Logo en Móvil (Visible solo en pantallas pequeñas) -->
        <div class="login-mobile-header">
          <img
            src="/logo.png"
            alt="Logo Oficial Unitrópico"
            class="login-mobile-logo"
            loading="eager"
          />
          <div class="brand-gold-line mobile"></div>
        </div>

        <div class="login-card-promax">
          <!-- Encabezado del Formulario -->
          <div class="form-card-header">
            <div class="form-badge">
              <span class="badge-dot"></span>
              <span>Portal de Funcionarios Institucionales</span>
            </div>
            <h2 class="form-main-title">Iniciar Sesión</h2>
            <p class="form-main-subtitle">
              Ingrese su correo institucional para acceder al panel de control
              rectoral y gestión de expedientes.
            </p>
          </div>

          <!-- Caja de Alerta / Errores -->
          <div
            id="login-alert-box"
            class="login-alert-promax"
            style="display: none;"
            role="alert"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="alert-icon"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-alert-text"
              >Credenciales incorrectas o usuario no registrado.</span
            >
          </div>

          <!-- Formulario Oficial de Autenticación con Supabase Auth -->
          <form id="form-login" class="login-form-body" autocomplete="on">
            <!-- Campo: Correo Electrónico Institucional -->
            <div class="form-group-promax">
              <label for="login-email" class="form-label-promax">
                Correo Electrónico Institucional
              </label>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="login-email"
                  name="email"
                  class="form-input-promax"
                  placeholder="usuario@unitropico.edu.co"
                  required
                  autocomplete="username"
                  autofocus
                />
              </div>
            </div>

            <!-- Campo: Contraseña Institucional con Toggle de Visibilidad -->
            <div class="form-group-promax">
              <div class="label-row-promax">
                <label for="login-password" class="form-label-promax"
                  >Contraseña</label
                >
              </div>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  class="form-input-promax"
                  placeholder="••••••••••••"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="btn-toggle-password"
                  class="btn-toggle-eye-promax"
                  aria-label="Mostrar u ocultar contraseña"
                  title="Mostrar contraseña"
                >
                  <svg
                    id="eye-icon-open"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                    ></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg
                    id="eye-icon-closed"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="display: none;"
                  >
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                    ></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Opciones Adicionales: Recordar Sesión -->
            <div class="form-options-promax">
              <label class="remember-checkbox-promax">
                <input type="checkbox" id="remember-me" checked />
                <span class="checkbox-custom-promax"></span>
                <span>Mantener sesión iniciada</span>
              </label>
            </div>

            <!-- Botón de Inicio de Sesión Oficial -->
            <button
              type="submit"
              id="btn-submit-login"
              class="btn-submit-promax"
            >
              <span class="btn-text-promax" id="btn-login-text"
                >Iniciar Sesión Institucional</span
              >
              <div
                class="spinner-loader-promax"
                id="btn-login-spinner"
                style="display: none;"
              >
              </div>
            </button>
          </form>

          <!-- Separador Discreto -->
          <div class="login-divider-promax">
            <span>Acceso Externo para Dependencias</span>
          </div>

          <!-- Banner del Portal Externo de Responsables -->
          <div class="portal-banner-promax">
            <div class="portal-banner-content">
              <div class="portal-banner-title">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Portal de Entrega de Anexos</span>
              </div>
              <p class="portal-banner-desc">
                ¿Tiene un código único temporal para aportar soportes a un
                radicado?
              </p>
            </div>
            <a href="/portal-responsable" class="btn-portal-promax">
              <span>Ingresar con Código</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                  points="12 5 19 12 12 19"></polyline></svg
              >
            </a>
          </div>

          <!-- Pie de Seguridad y Cifrado -->
          <div class="login-security-notice">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span
              >Supabase Auth &bull; TLS 1.3 &bull; Trazabilidad Inmutable
              SHA-256</span
            >
          </div>
        </div>
      </div>
    </main>
  </div>
</AuthLayout>

<script>
  import { initLogin } from "@scripts/login";
  initLogin();
</script>
</Layout>
