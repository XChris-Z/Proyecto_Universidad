---
// src/pages/login.astro
// Pantalla de Autenticación Institucional Oficial UI/UX Pro Max — SGD Unitrópico
import AuthLayout from "@layouts/AuthLayout.astro";
---

<AuthLayout title="Acceso al Sistema — SGD Unitrópico">
  <div class="login-promax-wrapper">
    <!-- =====================================================================
        ANEL IZQUIERDO: IDENTIDAD INSTITUCIONAL INMERSIVA (DESKTOP)
        ===================================================================== -->
    <aside
      class="login-brand-panel"
      aria-label="Identidad Institucional Unitrópico"
    >
      <div class="brand-panel-inner">
        <!-- Cabecera de Marca -->
        <div class="brand-header">
          <div class="brand-logo-card">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="brand-logo-img"
              loading="eager"
            />
          </div>
          <div class="brand-gold-line"></div>
          <span class="brand-institution-chip"
            >Universidad Internacional del Trópico Americano &bull; Unitrópico</span
          >
          <h1 class="brand-main-title">
            Sistema de Gestión Documental
          </h1>
          <p class="brand-subtitle">
            Plataforma institucional para el control rectoral, radicación oficial, seguimiento y custodia de expedientes.
          </p>
        </div>

        <!-- 3 Píldoras de Valor Institucional -->
        <div class="brand-features-list">
          <div class="brand-feature-item">
            <div class="feature-icon-box gold">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <div class="feature-text">
              <strong>Control de Términos Ley 1755</strong>
              <span
                >Semáforo preventivo SLA de 15 días con alertas tempranas
                automatizadas.</span
              >
            </div>
          </div>

          <div class="brand-feature-item">
            <div class="feature-icon-box emerald">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline></svg
              >
            </div>
            <div class="feature-text">
              <strong>Expedientes Digitales Centralizados</strong>
              <span
                >Custodia y archivo digital con subcarpetas para cada oficina
                requerida.</span
              >
            </div>
          </div>

          <div class="brand-feature-item">
            <div class="feature-icon-box teal">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
            </div>
            <div class="feature-text">
              <strong>Autenticación Cifrada y Trazabilidad</strong>
              <span
                >Seguridad con Supabase Auth y registro inmutable en bitácora de
                auditoría.</span
              >
            </div>
          </div>
        </div>

        <!-- Footer del Panel de Marca -->
        <div class="brand-panel-footer">
          
          <p class="brand-copy">
            &copy; {new Date().getFullYear()} Unitrópico &bull; Yopal, Casanare, Colombia
          </p>
        </div>
      </div>
    </aside>

    <!-- =====================================================================
         PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
         ===================================================================== -->
    <main class="login-form-panel">
      <div class="login-form-wrapper">
        <!-- Logo en Móvil (Visible solo en pantallas pequeñas) -->
        <div class="login-mobile-header">
          <img
            src="/logo.png"
            alt="Logo Oficial Unitrópico"
            class="login-mobile-logo"
            loading="eager"
          />
          <div class="brand-gold-line mobile"></div>
        </div>

        <div class="login-card-promax">
          <!-- Encabezado del Formulario -->
          <div class="form-card-header">
            <div class="form-badge">
              <span class="badge-dot"></span>
              <span>Portal de Funcionarios Institucionales</span>
            </div>
            <h2 class="form-main-title">Iniciar Sesión</h2>
            <p class="form-main-subtitle">
              Ingrese su correo institucional para acceder al panel de control
              rectoral y gestión de expedientes.
            </p>
          </div>

          <!-- Caja de Alerta / Errores -->
          <div
            id="login-alert-box"
            class="login-alert-promax"
            style="display: none;"
            role="alert"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="alert-icon"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="login-alert-text"
              >Credenciales incorrectas o usuario no registrado.</span
            >
          </div>

          <!-- Formulario Oficial de Autenticación con Supabase Auth -->
          <form id="form-login" class="login-form-body" autocomplete="on">
            <!-- Campo: Correo Electrónico Institucional -->
            <div class="form-group-promax">
              <label for="login-email" class="form-label-promax">
                Correo Electrónico Institucional
              </label>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="login-email"
                  name="email"
                  class="form-input-promax"
                  placeholder="usuario@unitropico.edu.co"
                  required
                  autocomplete="username"
                  autofocus
                />
              </div>
            </div>

            <!-- Campo: Contraseña Institucional con Toggle de Visibilidad -->
            <div class="form-group-promax">
              <div class="label-row-promax">
                <label for="login-password" class="form-label-promax"
                  >Contraseña</label
                >
              </div>
              <div class="input-container-promax">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="input-icon-promax"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input
                  type="password"
                  id="login-password"
                  name="password"
                  class="form-input-promax"
                  placeholder="••••••••••••"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="btn-toggle-password"
                  class="btn-toggle-eye-promax"
                  aria-label="Mostrar u ocultar contraseña"
                  title="Mostrar contraseña"
                >
                  <svg
                    id="eye-icon-open"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                    ></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg
                    id="eye-icon-closed"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="display: none;"
                  >
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                    ></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Opciones Adicionales: Recordar Sesión -->
            <div class="form-options-promax">
              <label class="remember-checkbox-promax">
                <input type="checkbox" id="remember-me" checked />
                <span class="checkbox-custom-promax"></span>
                <span>Mantener sesión iniciada</span>
              </label>
            </div>

            <!-- Botón de Inicio de Sesión Oficial -->
            <button
              type="submit"
              id="btn-submit-login"
              class="btn-submit-promax"
            >
              <span class="btn-text-promax" id="btn-login-text"
                >Iniciar Sesión Institucional</span
              >
              <div
                class="spinner-loader-promax"
                id="btn-login-spinner"
                style="display: none;"
              >
              </div>
            </button>
          </form>

          <!-- Separador Discreto -->
          <div class="login-divider-promax">
            <span>Acceso Externo para Dependencias</span>
          </div>

          <!-- Banner del Portal Externo de Responsables -->
          <div class="portal-banner-promax">
            <div class="portal-banner-content">
              <div class="portal-banner-title">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Portal de Entrega de Anexos</span>
              </div>
              <p class="portal-banner-desc">
                ¿Tiene un código único temporal para aportar soportes a un
                radicado?
              </p>
            </div>
            <a href="/portal-responsable" class="btn-portal-promax">
              <span>Ingresar con Código</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                  points="12 5 19 12 12 19"></polyline></svg
              >
            </a>
          </div>

          <!-- Acceso alternativo móvil a los portales externos -->
          <div class="login-mobile-portals">
            <div class="login-divider-promax">
              <span>Otros Portales de Acceso</span>
            </div>
            <div class="mobile-portals-buttons">
              <a href="/consulta-respuesta" class="btn-mobile-portal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <span>Consultar Respuesta Solicitante</span>
              </a>
              <a href="/portal-responsable" class="btn-mobile-portal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B5A160" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                <span>Portal Dependencias (Código)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</AuthLayout>

<style>
  /* ==========================================================================
     CONTENEDOR SPLIT SCREEN PRO MAX (SIN MANCHAS NI RAYONES)
     ========================================================================== */
  .login-promax-wrapper {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background: #f8fafc;
    font-family:
      "Montserrat",
      system-ui,
      -apple-system,
      sans-serif;
  }

  /* ==========================================================================
     PANEL IZQUIERDO: MARCA E IDENTIDAD INSTITUCIONAL
     ========================================================================== */
  .login-brand-panel {
    width: 50%;
    min-width: 480px;
    background: radial-gradient(circle at 20% 20%, #00685B 0%, #00594E 60%, #003E36 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    box-sizing: border-box;
    border-right: 1px solid rgba(181, 161, 96, 0.25);
  }

  .brand-panel-inner {
    max-width: 490px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .brand-logo-card {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    padding: 10px 18px;
    border-radius: 12px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
    margin-bottom: 8px;
    border: 1px solid rgba(181, 161, 96, 0.3);
  }

  .brand-gold-line {
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, #B5A160, #786832);
    border-radius: 2px;
    margin: 12px 0;
  }

  .brand-gold-line.mobile {
    margin: 12px auto;
  }

  .brand-institution-chip {
    display: block;
    font-size: 0.74rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #F7F5EE;
    margin-bottom: 6px;
  }

  .brand-main-title {
    font-size: 1.85rem;
    font-weight: 850;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0 0 10px 0;
  }

  .brand-subtitle {
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  /* Portales Directos Institucionales */
  .brand-portals-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .brand-portal-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    padding: 16px 18px;
    text-decoration: none;
    color: #ffffff;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .brand-portal-card:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #B5A160;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .portal-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .portal-card-icon.citizen {
    background: #F7F5EE;
    color: #786832;
    border: 1px solid #DBD2B0;
  }

  .portal-card-icon.office {
    background: #F2F7F6;
    color: #00594E;
    border: 1px solid #B2CFCB;
  }

  .portal-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .portal-card-tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .portal-card-tag.citizen { color: #fde68a; }
  .portal-card-tag.office { color: #a7f3d0; }

  .portal-card-heading {
    font-size: 0.92rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
  }

  .portal-card-text {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    line-height: 1.45;
  }

  .portal-card-action {
    color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .brand-portal-card:hover .portal-card-action {
    transform: translateX(3px);
    color: #B5A160;
  }

  .brand-panel-footer {
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .brand-copy {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* ==========================================================================
     PANEL DERECHO: FORMULARIO EJECUTIVO PRO MAX
     ========================================================================== */
  .login-form-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #f8fafc;
    box-sizing: border-box;
  }

  .login-form-wrapper {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .login-mobile-header {
    display: none;
    text-align: center;
    margin-bottom: 16px;
  }

  .login-mobile-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  /* Tarjeta con animación Crossfade */
  .login-card-promax {
    width: 100%;
    background: #ffffff;
    border-radius: 20px; border: 1px solid #DCE4E3; box-shadow: 0 20px 40px -15px rgba(0, 89, 78, 0.10);
    padding: clamp(28px, 4vw, 40px);
    box-sizing: border-box;
    animation: promaxCardCrossfade 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes promaxCardCrossfade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Encabezado */
  .form-card-header {
    margin-bottom: 24px;
  }

  .form-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #F2F7F6; border: 1px solid #B2CFCB; color: #00594E;
    font-size: 0.72rem;
    font-weight: 750;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 10px;
    letter-spacing: 0.02em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00594E;
  }

  .form-main-title {
    font-size: 1.55rem;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0 0 6px 0;
  }

  .form-main-subtitle {
    font-size: 0.84rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  /* Alerta */
  .login-alert-promax {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    color: #991b1b;
    font-weight: 600;
    line-height: 1.4;
    animation: promaxShake 0.3s ease;
  }

  @keyframes promaxShake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .alert-icon {
    flex-shrink: 0;
    color: #dc2626;
  }

  /* Formulario */
  .login-form-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group-promax {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label-promax {
    font-size: 0.78rem;
    font-weight: 750;
    color: #1e293b;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .input-container-promax {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon-promax {
    position: absolute;
    left: 14px;
    color: #94a3b8;
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .form-input-promax {
    width: 100%;
    padding: 12px 14px 12px 42px;
    font-size: 0.9rem;
    color: #0f172a;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    outline: none;
    font-family: inherit;
    font-weight: 500;
    box-sizing: border-box;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input-promax:focus {
    background: #ffffff;
    border-color: #00594E; box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
  }

  .input-container-promax:focus-within .input-icon-promax {
    color: #00594E;
  }

  .btn-toggle-eye-promax {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    padding: 6px;
    color: #94a3b8;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .btn-toggle-eye-promax:hover {
    color: #00594E; background: #F2F7F6;
  }

  /* Opciones */
  .form-options-promax {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
  }

  .remember-checkbox-promax {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.82rem;
    color: #475569;
    user-select: none;
    font-weight: 500;
  }

  .remember-checkbox-promax input[type="checkbox"] {
    accent-color: #00594E;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  /* Botón Submit */
  .btn-submit-promax {
    width: 100%;
    padding: 13px 20px;
    background: #00594E;
    color: #ffffff;
    border: 1px solid #00443B;
    border-bottom: 3px solid #B5A160;
    border-radius: 10px;
    font-size: 0.94rem;
    font-weight: 750;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(0, 89, 78, 0.22);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 4px;
