---
// src/pages/portal-responsable/index.astro
// Portal Oficial de Entrega de Anexos UI/UX Pro Max — SGD Unitrópico
import Layout from '@layouts/Layout.astro';
import ModalSubidaArchivo from '@components/ModalSubidaArchivo.astro';
---

<Layout title="Portal de Entrega de Anexos — SGD Unitrópico">
  <div class="portal-promax-wrapper portal-background app-content-area">
    
    <!-- =====================================================================
        1. CABECERA INSTITUCIONAL COMPACTA
        ===================================================================== -->
    <header class="portal-top-header">
      <div class="portal-header-container">
        <div class="portal-header-brand">
          <div class="portal-logo-card">
            <img
              src="/logo.png"
              alt="Logo Oficial Unitrópico"
              class="portal-logo-img"
              loading="eager"
            />
          </div>
          <span class="portal-header-divider" aria-hidden="true"></span>
          <span class="portal-brand-kicker">Portal Oficial de Recepción Documental</span>
        </div>

        <div class="portal-header-actions">
          <a href="/login" class="btn-portal-back-login" title="Ir al acceso de funcionarios">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <span>Acceso Funcionarios</span>
          </a>
        </div>
      </div>
    </header>

    <!-- =====================================================================
         2. STEPPER COMPACTO EN 3 ETAPAS
         ===================================================================== -->
    <div class="portal-stepper-container">
      <div class="portal-stepper-inner">

        <!-- Paso 1 -->
        <div class="stepper-step active" id="step-node-1">
          <div class="step-icon-circle">
            <span class="step-num">1</span>
            <svg class="step-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Validación de Radicado</span>
            <span class="step-desc">Código único de acceso</span>
          </div>
        </div>

        <!-- Línea conectora -->
        <div class="stepper-line" id="stepper-line-1">
          <div class="stepper-line-progress" id="stepper-progress-bar"></div>
        </div>

        <!-- Paso 2 -->
        <div class="stepper-step" id="step-node-2">
          <div class="step-icon-circle">
            <span class="step-num">2</span>
            <svg class="step-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Verificación de Términos</span>
            <span class="step-desc">Expediente y plazo SLA</span>
          </div>
        </div>

        <!-- Línea conectora -->
        <div class="stepper-line" id="stepper-line-2"></div>

        <!-- Paso 3 -->
        <div class="stepper-step" id="step-node-3">
          <div class="step-icon-circle">
            <span class="step-num">3</span>
            <svg class="step-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Carga de Soportes</span>
            <span class="step-desc">Subcarpeta Oficial</span>
          </div>
        </div>

      </div>
    </div>

    <!-- =====================================================================
         3. ÁREA PRINCIPAL DINÁMICA (CROSSFADE TRANSITION)
         ===================================================================== -->
    <main class="portal-main-area">

      <!-- ===================================================================
           PANTALLA 1: SPLIT CARD DE AUTENTICACIÓN DE DEPENDENCIA (PASO 1)
           =================================================================== -->
      <section id="portal-login-section" class="portal-card-login" aria-label="Autenticación de Dependencia">
        <div class="split-card-grid">

          <!-- Columna Izquierda: Panel Institucional -->
          <div class="split-brand-panel">
            <div class="split-brand-top">
              <span class="split-brand-badge">
                <span class="split-badge-dot" aria-hidden="true"></span>
                CANAL OFICIAL UNITRÓPICO
              </span>
              <h1 class="split-brand-title">Entrega de Anexos y Respuestas Oficiales</h1>
              <p class="split-brand-desc">
                Acceso verificado para que las dependencias radicadas carguen sus soportes dentro del término establecido.
              </p>
            </div>

            <div class="split-steps-list" aria-label="Guía rápida del portal">
              <div class="split-step-item">
                <div class="split-step-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
                </div>
                <div class="split-step-copy">
                  <strong>Credenciales del Oficio</strong>
                  <span>Correo institucional de la oficina, código temporal y PIN de 6 dígitos.</span>
                </div>
              </div>

              <div class="split-step-item">
                <div class="split-step-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
                </div>
                <div class="split-step-copy">
                  <strong>Control de Términos</strong>
                  <span>Verifique las fechas límite y las instrucciones asignadas a su dependencia.</span>
                </div>
              </div>

              <div class="split-step-item">
                <div class="split-step-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>
                </div>
                <div class="split-step-copy">
                  <strong>Constancia Automática</strong>
                  <span>Cada entrega queda registrada con fecha, hora y trazabilidad oficial.</span>
                </div>
              </div>
            </div>

            <div class="split-security-footer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B5A160" stroke-width="2.1" class="split-security-shield" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <span>Acceso cifrado &middot; Trazabilidad oficial &mdash; Universidad Internacional del Trópico Americano</span>
            </div>
          </div>

          <!-- Columna Derecha: Formulario de Autenticación -->
          <div class="split-form-panel">
            <div class="portal-login-card-header">
              <h2 class="portal-login-title">Autenticación de Dependencia</h2>
              <p class="portal-login-desc">
                Ingrese los datos recibidos en la notificación oficial de asignación.
              </p>
            </div>

            <form id="form-portal-login" class="portal-form-body" novalidate>

              <!-- Campo 1: Correo de la Dependencia -->
              <div class="portal-form-group">
                <label for="portal-input-email" class="portal-label">Correo Institucional de la Oficina *</label>
                <div class="portal-input-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="portal-field-icon" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  <input
                    type="email"
                    id="portal-input-email"
                    name="email"
                    required
                    placeholder="ej. juridica@unitropico.edu.co"
                    class="portal-input"
                    autocomplete="email"
                  />
                </div>
              </div>

              <!-- Campo 2: Código Único Temporal -->
              <div class="portal-form-group">
                <div class="label-with-hint">
                  <label for="portal-input-codigo" class="portal-label">Código Único Temporal de Acceso *</label>
                  <span class="hint-badge">Expira 5 días antes</span>
                </div>
                <div class="portal-input-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="portal-field-icon" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <input
                    type="text"
                    id="portal-input-codigo"
                    name="codigo"
                    required
                    placeholder="RAD-XXXXX-COD"
                    class="portal-input code-style"
                    autocomplete="off"
                  />
                </div>
                <small class="portal-help-text">
                  Consulte el correo de asignación oficial. Uso exclusivo de su dependencia.
                </small>
              </div>

              <!-- Campo 3: PIN de Seguridad (6 Dígitos) con 6 Casillas OTP -->
              <div class="portal-form-group">
                <div class="label-with-hint">
                  <label for="portal-otp-0" class="portal-label">PIN de Seguridad (6 Dígitos) *</label>
                  <span class="hint-badge neutral">6 dígitos</span>
                </div>

                <input type="hidden" id="portal-input-pin" name="pin" value="" />

                <div class="portal-otp-grid" id="portal-otp-grid" role="group" aria-label="PIN de seguridad de 6 dígitos">
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-0" class="portal-otp-box" data-otp-index="0" autocomplete="one-time-code" aria-label="Dígito 1 del PIN" />
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-1" class="portal-otp-box" data-otp-index="1" autocomplete="off" aria-label="Dígito 2 del PIN" />
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-2" class="portal-otp-box" data-otp-index="2" autocomplete="off" aria-label="Dígito 3 del PIN" />
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-3" class="portal-otp-box" data-otp-index="3" autocomplete="off" aria-label="Dígito 4 del PIN" />
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-4" class="portal-otp-box" data-otp-index="4" autocomplete="off" aria-label="Dígito 5 del PIN" />
                  <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="portal-otp-5" class="portal-otp-box" data-otp-index="5" autocomplete="off" aria-label="Dígito 6 del PIN" />
                </div>
                <small class="portal-help-text">
                  PIN criptográfico remitido en la notificación institucional o facilitado por el Administrador.
                </small>
              </div>

              <!-- Alerta de Error -->
              <div id="portal-login-error" class="portal-error-box" style="display: none;" role="alert"></div>

              <!-- Botón de Envío -->
              <button type="submit" id="btn-portal-enter" class="btn-portal-submit">
                <span>Validar Acceso y Continuar</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>

            </form>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           PANTALLA 2: EXPEDIENTE Y CARGA DE ANEXOS (PASOS 2 Y 3)
           =================================================================== -->
      <section id="portal-upload-section" class="portal-upload-container" style="display: none;">
        
        <!-- Tarjeta de Información del Radicado y Oficina -->
        <div class="portal-info-card">
          <div class="portal-info-header">
            <div>
              <div class="portal-meta-chips">
                <span class="chip-radicado" id="portal-disp-radicado">RAD-2026-XXXXX</span>
                <span class="chip-oficina" id="portal-disp-oficina">Oficina Asignada</span>
                <span class="chip-status-safe">Acceso Autorizado</span>
              </div>
              <h2 id="portal-disp-asunto" class="portal-asunto-title">Asunto de la petición</h2>
              <p id="portal-disp-desc" class="portal-asunto-desc" style="display: none;">Descripción del trámite solicitado.</p>
            </div>

            <button type="button" id="btn-portal-logout" class="btn-portal-logout" title="Finalizar sesión">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Salir del Portal</span>
            </button>
          </div>

          <!-- Banner Alerta de Margen Preventivo SLA -->
          <div class="portal-sla-banner">
            <div class="sla-banner-item">
              <div class="sla-dot gold"></div>
              <div>
                <span class="sla-label">Límite para su Oficina:</span>
                <strong id="portal-disp-fecha-resp" class="sla-val gold">--</strong>
              </div>
            </div>
            <div class="sla-banner-divider"></div>
            <div class="sla-banner-item">
              <div class="sla-dot emerald"></div>
              <div>
                <span class="sla-label">Término General Peticionario:</span>
                <strong id="portal-disp-fecha-entrega" class="sla-val emerald">--</strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta del Documento Original Radicado (si existe) -->
        <div id="portal-doc-original-card" class="portal-doc-card" style="display: none;">
          <div class="portal-doc-details">
            <div class="portal-doc-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div>
              <span class="doc-badge">Documento Base Radicado</span>
              <strong id="portal-doc-original-name" class="doc-title">documento_radicado.pdf</strong>
              <p class="doc-hint">Descargue y examine la solicitud oficial para adjuntar su informe o respuesta.</p>
            </div>
          </div>
          <a id="portal-doc-original-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn-download-doc">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Descargar Documento</span>
          </a>
        </div>

        <!-- Zona Drag & Drop para Carga de Anexos -->
        <div class="portal-upload-card">
          <div class="upload-card-header">
            <div>
              <h3 class="upload-title">Carga Segura de Soportes y Anexos Oficiales</h3>
              <p class="upload-subtitle">
                Los archivos aportados se radicarán automáticamente en la subcarpeta virtual de su dependencia en el repositorio institucional.
              </p>
            </div>
            <span class="storage-secure-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Repositorio Aislado</span>
            </span>
          </div>

          <!-- Layout Horizontal Pro Max: Selector a la izquierda, Zona de Carga a la derecha -->
          <div class="portal-upload-grid">
            <!-- Columna Lateral: Selector de Subcarpetas y Requerimiento Específico -->
            <div class="portal-upload-sidebar">
              <div id="portal-subcarpetas-selector-box" style="padding: 14px; background: #FAF9F5; border: 1px solid var(--dorado-borde, #dcd4b8); border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.02);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 6px;">
                  <div style="font-size: 0.76rem; font-weight: 800; color: #00594E; text-transform: uppercase; display: flex; align-items: center; gap: 6px; letter-spacing: 0.3px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span>Subcarpetas:</span>
                  </div>
                  <span id="portal-subcarpeta-badge" style="font-size: 0.68rem; font-weight: 800; color: #786832; background: #F7F5EE; border: 1px solid #DBD2B0; padding: 2px 7px; border-radius: 6px;">
                    1 Asignada
                  </span>
                </div>
                
                <!-- Lista Vertical de Pestañas de Subcarpetas -->
                <div id="portal-subcarpetas-tabs" style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 10px;">
                  <!-- Se inyecta dinámicamente con las subcarpetas del responsable -->
                </div>

                <!-- Recuadro de Instrucción / Requerimiento con Transición Crossfade -->
                <div id="portal-subcarpeta-desc-box" style="font-size: 0.78rem; color: #334155; background: #ffffff; border: 1px solid #DCE4E3; border-left: 3px solid #00594E; padding: 10px 12px; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02); transition: opacity 0.25s ease, transform 0.25s ease;">
                  <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 3px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    <strong id="portal-subcarpeta-desc-title" style="color: #00594E; font-weight: 800; text-transform: uppercase; font-size: 0.70rem; letter-spacing: 0.3px;">Requerimiento:</strong>
                  </div>
                  <span id="portal-subcarpeta-desc-text" style="line-height: 1.45; color: #475569; display: block; font-size: 0.76rem;">Cargue los documentos de soporte solicitados.</span>
                </div>
              </div>
            </div>

            <!-- Columna Principal: Dropzone y Acción de Envío -->
            <div class="portal-upload-main">
              <!-- Encabezado Destacado Dinámico de Subcarpeta Activa -->
              <div id="portal-subcarpeta-active-banner" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #00594E; color: #ffffff; padding: 12px 16px; border-radius: 8px; margin-bottom: 12px; border: 1px solid #1A6A60; box-shadow: 0 3px 10px rgba(0, 89, 78, 0.12);">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 32px; height: 32px; border-radius: 6px; background: rgba(255, 255, 255, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                  </div>
                  <div>
                    <div style="font-size: 0.64rem; font-weight: 750; color: #fef08a; text-transform: uppercase; letter-spacing: 0.5px;">Destino de Radicación Activo</div>
                    <div style="font-size: 0.88rem; font-weight: 800;">
                      Subiendo aporte en: <span id="portal-active-subname" style="color: #ffffff; text-decoration: underline; text-underline-offset: 3px;">1A</span>
                    </div>
                  </div>
                </div>
                <span id="portal-active-sub-status-badge" style="font-size: 0.68rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; white-space: nowrap;">
                  Pendiente de carga
                </span>
              </div>

              <!-- Drag and Drop Box -->
              <div id="drop-zone" class="portal-drop-zone" style="padding: 24px 16px;">
                <div class="drop-icon-box" style="margin-bottom: 8px;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </div>
                <div class="drop-title" style="font-size: 0.90rem;">Arrastre sus archivos aquí o haga clic para examinar</div>
                <div class="drop-formats" style="font-size: 0.72rem;">Formatos permitidos: PDF, DOCX, XLSX, JPG, PNG, ZIP &middot; Capacidad Ilimitada · Soporte de Archivos Pesados</div>
                <input type="file" id="portal-file-input" multiple style="display: none;" />
              </div>

              <!-- Bandeja de Pre-Carga / Cola de Archivos Listos para Enviar -->
              <div id="portal-preupload-container" style="display: none; margin-top: 14px; background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 12px; padding: 14px 16px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 6px; background: #E6EFEF; color: #00594E;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span style="font-weight: 800; font-size: 0.82rem; color: #00594E; text-transform: uppercase; letter-spacing: 0.03em;">
                      Archivos Listos para Enviar (<span id="portal-staged-count">0</span>)
                    </span>
                  </div>
                  <button type="button" id="btn-clear-staged-files" style="background: none; border: none; font-size: 0.72rem; font-weight: 700; color: #DC2626; cursor: pointer; text-decoration: underline;">
                    Vaciar cola
                  </button>
                </div>
                <div id="portal-staged-list" style="display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow-y: auto;">
                  <!-- Elementos inyectados dinámicamente -->
                </div>
              </div>

              <!-- Observaciones -->
              <div class="portal-form-group" style="margin-top: 12px;">
                <label for="portal-observaciones" class="portal-label" style="font-size: 0.74rem;">Observaciones o Aclaraciones de la Entrega (Opcional)</label>
                <textarea 
                  id="portal-observaciones" 
                  rows="2" 
                  placeholder="Describa brevemente el contenido de los anexos suministrados..." 
