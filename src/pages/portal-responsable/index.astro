---
// src/pages/portal-responsable/index.astro
// Portal Oficial de Entrega de Anexos UI/UX Pro Max — SGD Unitrópico
import Layout from '@layouts/Layout.astro';
---

<Layout title="Portal de Entrega de Anexos — SGD Unitrópico">
  <div class="portal-promax-wrapper">
    
    <!-- =====================================================================
         1. CABECERA INSTITUCIONAL SUPERIOR (LIMPIA, SIN RAYONES NI ARTEFACTOS)
         ===================================================================== -->
    <header class="portal-top-header">
      <div class="portal-header-container">
        
        <div class="portal-header-brand">
          <div class="portal-logo-card">
            <img 
              src="/logo.png" 
              alt="Logo Oficial Unitrópico" 
              class="portal-logo-img" 
              loading="eager"
            />
          </div>
          <div class="portal-brand-text">
            <div class="portal-official-badge">
              <span class="badge-dot-gold"></span>
              <span>Portal Oficial de Recepción Documental &bull; Unitrópico</span>
            </div>
            <h1 class="portal-system-title">Entrega de Anexos y Respuestas Oficiales</h1>
          </div>
        </div>

        <div class="portal-header-actions">
          <a href="/login" class="btn-portal-back-login" title="Ir al acceso de funcionarios">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <span>Acceso Funcionarios</span>
          </a>
        </div>

      </div>
    </header>

    <!-- =====================================================================
         2. STEPPER GUÍA EN 3 ETAPAS CON INDICADOR VISUAL SHARED ELEMENT
         ===================================================================== -->
    <div class="portal-stepper-container">
      <div class="portal-stepper-inner">
        
        <!-- Paso 1 -->
        <div class="stepper-step active" id="step-node-1">
          <div class="step-icon-circle">
            <span class="step-num">1</span>
            <svg class="step-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Validación de Radicado</span>
            <span class="step-desc">Código único de acceso</span>
          </div>
        </div>

        <!-- Línea conectora -->
        <div class="stepper-line" id="stepper-line-1">
          <div class="stepper-line-progress" id="stepper-progress-bar"></div>
        </div>

        <!-- Paso 2 -->
        <div class="stepper-step" id="step-node-2">
          <div class="step-icon-circle">
            <span class="step-num">2</span>
            <svg class="step-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Verificación de Términos</span>
            <span class="step-desc">Expediente y plazo SLA</span>
          </div>
        </div>

        <!-- Línea conectora -->
        <div class="stepper-line" id="stepper-line-2"></div>

        <!-- Paso 3 -->
        <div class="stepper-step" id="step-node-3">
          <div class="step-icon-circle">
            <span class="step-num">3</span>
            <svg class="step-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="step-labels">
            <span class="step-title">Carga de Soportes</span>
            <span class="step-desc">Subcarpeta en Storage</span>
          </div>
        </div>

      </div>
    </div>

    <!-- =====================================================================
         3. ÁREA PRINCIPAL DINÁMICA (CROSSFADE TRANSITION)
         ===================================================================== -->
    <main class="portal-main-area">

      <!-- ===================================================================
           PANTALLA 1: FORMULARIO DE ACCESO POR CÓDIGO TEMPORAL (PASO 1)
           =================================================================== -->
      <section id="portal-login-section" class="portal-card-login">
        
        <div class="portal-login-card-header">
          <div class="portal-shield-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h2 class="portal-login-title">Autenticación de Dependencia</h2>
          <p class="portal-login-desc">
            Ingrese el correo institucional de la oficina requerida y el código único temporal recibido en la notificación oficial para radicar anexos.
          </p>
        </div>

        <form id="form-portal-login" class="portal-form-body">
          
          <!-- Correo de la Dependencia -->
          <div class="portal-form-group">
            <label for="portal-input-email" class="portal-label">Correo Institucional de la Oficina *</label>
            <div class="portal-input-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="portal-field-icon">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <input 
                type="email" 
                id="portal-input-email" 
                required 
                placeholder="ej. juridica@unitropico.edu.co" 
                class="portal-input" 
                autocomplete="email"
              />
            </div>
          </div>

          <!-- Código Único Temporal -->
          <div class="portal-form-group">
            <div class="label-with-hint">
              <label for="portal-input-codigo" class="portal-label">Código Único Temporal de Acceso *</label>
              <span class="hint-badge">Expira 5 días antes</span>
            </div>
            <div class="portal-input-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="portal-field-icon">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                type="text" 
                id="portal-input-codigo" 
                required 
                placeholder="RAD-XXXXX-COD" 
                class="portal-input code-style" 
                autocomplete="off"
              />
            </div>
            <small class="portal-help-text">
              Consulte el correo de asignación oficial. El código es de uso exclusivo de su dependencia.
            </small>
          </div>

          <!-- PIN Criptográfico de Seguridad de 6 Dígitos -->
          <div class="portal-form-group">
            <div class="label-with-hint">
              <label for="portal-input-pin" class="portal-label">PIN de Seguridad (6 Dígitos) *</label>
              <span class="hint-badge" style="background: rgba(184, 134, 11, 0.12); color: #92400e; border: 1px solid rgba(184, 134, 11, 0.3);">Anti-Enumeración</span>
            </div>
            <div class="portal-input-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="portal-field-icon">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <input 
                type="text" 
                id="portal-input-pin" 
                maxlength="6"
                pattern="[0-9]{6}"
                placeholder="Ej. 849201" 
                class="portal-input code-style" 
                style="letter-spacing: 4px; font-weight: 800;"
                autocomplete="one-time-code"
              />
            </div>
            <small class="portal-help-text">
              PIN criptográfico remitido en la notificación institucional o facilitado por el Administrador documental.
            </small>
          </div>

          <!-- Alerta de Error -->
          <div id="portal-login-error" class="portal-error-box" style="display: none;" role="alert"></div>

          <!-- Botón de Envío -->
          <button type="submit" id="btn-portal-enter" class="btn-portal-submit">
            <span>Validar Acceso y Continuar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>

        </form>

        <div class="portal-login-footer-info">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span>Ley 1755 de 2015 &bull; Trazabilidad oficial de respuesta institucional</span>
        </div>

      </section>

      <!-- ===================================================================
           PANTALLA 2: EXPEDIENTE Y CARGA DE ANEXOS (PASOS 2 Y 3)
           =================================================================== -->
      <section id="portal-upload-section" class="portal-upload-container" style="display: none;">
        
        <!-- Tarjeta de Información del Radicado y Oficina -->
        <div class="portal-info-card">
          <div class="portal-info-header">
            <div>
              <div class="portal-meta-chips">
                <span class="chip-radicado" id="portal-disp-radicado">RAD-2026-XXXXX</span>
                <span class="chip-oficina" id="portal-disp-oficina">Oficina Asignada</span>
                <span class="chip-status-safe">Acceso Autorizado</span>
              </div>
              <h2 id="portal-disp-asunto" class="portal-asunto-title">Asunto de la petición</h2>
              <p id="portal-disp-desc" class="portal-asunto-desc">Descripción del trámite solicitado.</p>
            </div>

            <button type="button" id="btn-portal-logout" class="btn-portal-logout" title="Finalizar sesión">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Salir del Portal</span>
            </button>
          </div>

          <!-- Banner Alerta de Margen Preventivo SLA -->
          <div class="portal-sla-banner">
            <div class="sla-banner-item">
              <div class="sla-dot gold"></div>
              <div>
                <span class="sla-label">Límite para su Oficina:</span>
                <strong id="portal-disp-fecha-resp" class="sla-val gold">--</strong>
              </div>
            </div>
            <div class="sla-banner-divider"></div>
            <div class="sla-banner-item">
              <div class="sla-dot emerald"></div>
              <div>
                <span class="sla-label">Término General Peticionario:</span>
                <strong id="portal-disp-fecha-entrega" class="sla-val emerald">--</strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta del Documento Original Radicado (si existe) -->
        <div id="portal-doc-original-card" class="portal-doc-card" style="display: none;">
          <div class="portal-doc-details">
            <div class="portal-doc-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div>
              <span class="doc-badge">Documento Base Radicado</span>
              <strong id="portal-doc-original-name" class="doc-title">documento_radicado.pdf</strong>
              <p class="doc-hint">Descargue y examine la solicitud oficial para adjuntar su informe o respuesta.</p>
            </div>
          </div>
          <a id="portal-doc-original-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn-download-doc">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Descargar Documento</span>
          </a>
        </div>

        <!-- Zona Drag & Drop para Carga de Anexos -->
        <div class="portal-upload-card">
          <div class="upload-card-header">
            <div>
              <h3 class="upload-title">Carga Segura de Soportes y Anexos Oficiales</h3>
              <p class="upload-subtitle">
                Los archivos aportados se radicarán automáticamente en la subcarpeta virtual de su dependencia en Supabase Storage.
              </p>
            </div>
            <span class="storage-secure-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Storage Aislado</span>
            </span>
          </div>

          <!-- Drag and Drop Box -->
          <div id="drop-zone" class="portal-drop-zone">
            <div class="drop-icon-box">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <div class="drop-title">Arrastre sus archivos aquí o haga clic para examinar</div>
            <div class="drop-formats">Formatos permitidos: PDF, DOCX, XLSX, JPG, PNG, ZIP (hasta 50 MB)</div>
            <input type="file" id="portal-file-input" multiple style="display: none;" />
          </div>

          <!-- Observaciones -->
          <div class="portal-form-group" style="margin-top: 18px;">
            <label for="portal-observaciones" class="portal-label">Observaciones o Aclaraciones de la Entrega (Opcional)</label>
            <textarea 
              id="portal-observaciones" 
              rows="2" 
              placeholder="Describa brevemente el contenido de los anexos suministrados..." 
              class="portal-textarea"
            ></textarea>
          </div>

          <!-- Botón de Carga -->
          <div class="upload-actions-row">
            <button type="button" id="btn-upload-files" class="btn-confirm-upload">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span>Confirmar y Subir Archivos a Subcarpeta</span>
            </button>
          </div>
        </div>

        <!-- Lista de Soportes Entregados -->
        <div class="portal-history-card">
          <div class="history-card-header">
            <h3 class="history-title">Soportes Entregados en esta Petición</h3>
            <span class="history-badge">Registro Inmutable</span>
          </div>
          
          <div id="portal-anexos-list" class="anexos-list-container">
            <div id="no-anexos-msg" class="no-anexos-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>Aún no se han aportado documentos de soporte para esta petición.</span>
            </div>
          </div>
        </div>

      </section>

    </main>

    <!-- =====================================================================
         4. PIE DE PÁGINA INSTITUCIONAL LIMPIO
         ===================================================================== -->
    <footer class="portal-bottom-footer">
      <div class="portal-footer-inner">
        <span>&copy; {new Date().getFullYear()} Universidad Internacional del Trópico Americano &bull; Yopal, Casanare, Colombia</span>
        <span class="footer-divider">&bull;</span>
        <span>Sistema de Gestión y Gobierno Universitario (SGD)</span>
      </div>
    </footer>

  </div>
</Layout>

<style>
  /* ==========================================================================
     LAYOUT PRINCIPAL DEL PORTAL (100% LIMPIO, SIN MANCHAS NI RAYONES)
     ========================================================================== */
  .portal-promax-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    background: #f8fafc;
    color: #0f172a;
    font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* ==========================================================================
     CABECERA SUPERIOR
     ========================================================================== */
  .portal-top-header {
    width: 100%;
    background: #052e16;
    color: #ffffff;
    border-bottom: 2.5px solid #b8860b;
    padding: 14px 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .portal-header-container {
    max-width: 1040px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .portal-header-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .portal-logo-card {
    background: #ffffff;
    padding: 6px 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
  }

  .portal-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .portal-official-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.70rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fde047;
    margin-bottom: 2px;
  }

  .badge-dot-gold {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4af37;
  }

  .portal-system-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .btn-portal-back-login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 750;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-portal-back-login:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: #d4af37;
    transform: translateY(-1px);
  }

  /* ==========================================================================
     STEPPER GUÍA EN 3 ETAPAS
     ========================================================================== */
  .portal-stepper-container {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 16px 20px;
  }

  .portal-stepper-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .stepper-step {
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0.5;
    transition: opacity 0.25s ease;
  }

  .stepper-step.active,
  .stepper-step.completed {
    opacity: 1;
  }

  .step-icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 2px solid #cbd5e1;
    color: #64748b;
    font-weight: 800;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.25s ease;
  }

  .stepper-step.active .step-icon-circle {
    background: #006837;
    border-color: #006837;
    color: #ffffff;
    box-shadow: 0 0 0 4px rgba(0, 104, 55, 0.15);
  }

  .stepper-step.completed .step-icon-circle {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  .step-check {
    display: none;
  }

  .stepper-step.completed .step-check {
    display: block;
  }

  .stepper-step.completed .step-num {
    display: none;
  }

  .step-labels {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-size: 0.78rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
  }

  .step-desc {
    font-size: 0.70rem;
    color: #64748b;
    line-height: 1.2;
  }

  .stepper-line {
    flex: 1;
    height: 3px;
    background: #e2e8f0;
    border-radius: 2px;
    position: relative;
    margin: 0 10px;
    overflow: hidden;
  }

  .stepper-line-progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 33%;
    background: #006837;
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ==========================================================================
     ÁREA PRINCIPAL
     ========================================================================== */
  .portal-main-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1rem, 2vw, 2rem);
    width: 100%;
    box-sizing: border-box;
  }

  /* ==========================================================================
     PANTALLA 1: FORMULARIO DE ACCESO (CARD)
     ========================================================================== */
  .portal-card-login {
    width: 100%;
    max-width: 500px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: clamp(24px, 4vw, 36px);
    box-shadow: 0 8px 30px -6px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.02);
    box-sizing: border-box;
    animation: portalCrossfade 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes portalCrossfade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .portal-login-card-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .portal-shield-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fefce8;
    color: #b8860b;
    border: 1.5px solid #fef08a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px auto;
  }

  .portal-login-title {
    font-size: 1.35rem;
    font-weight: 850;
    color: #0f172a;
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
  }

  .portal-login-desc {
    font-size: 0.82rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .portal-form-body {
    display: flex;
