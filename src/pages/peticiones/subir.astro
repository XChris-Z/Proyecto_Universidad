---
// src/pages/peticiones/subir.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Obtener catálogo de oficinas institucionales activas directamente desde Supabase PostgreSQL
const { data: oficinasData } = await (supabase
  .from('oficinas' as any)
  .select('id, codigo, nombre, email_institucional, titular_cargo')
  .eq('activo', true)
  .order('nombre') as any);

const fallbackOficinas = [
  { id: 'a05d4e8e-3545-44b0-a184-1daf1b07556f', codigo: 'PRUEBA-1', nombre: 'Prueba 1', email_institucional: 'taxxgameryt@gmail.com' },
  { id: 'b8a96d4e-69bc-4eb5-a4de-8d43589af91b', codigo: 'PRUEBA-2', nombre: 'Prueba 2', email_institucional: 'oscargalindo.es@unitropico.edu.co' },
  { id: '6c717727-996b-46dc-9ea4-cc55ff000e13', codigo: 'REC', nombre: 'Despacho de Rectoría', email_institucional: null },
  { id: 'e288247f-ac9d-434c-8006-8218780da725', codigo: 'SEC-GEN', nombre: 'Secretaría General', email_institucional: null },
  { id: '92cbd906-e694-4d3a-be26-598c2681aebf', codigo: 'OFI-JUR', nombre: 'Oficina Asesora Jurídica', email_institucional: null },
  { id: 'd5e2b1ed-4f18-4208-8d9a-64ebb5ede6ae', codigo: 'VIC-ACAD', nombre: 'Vicerrectoría Académica', email_institucional: null },
  { id: '18ce2c98-dde5-44f9-a517-2761b539c874', codigo: 'VIC-ADMIN', nombre: 'Vicerrectoría Administrativa y Financiera', email_institucional: null },
  { id: '1bcd5449-e637-4c9c-bdb2-e63cb7416a7c', codigo: 'PLA-INST', nombre: 'Dirección de Planeación', email_institucional: null },
  { id: '63ab865f-ad5f-42c0-88e6-6269c267d0db', codigo: 'ADM-REG', nombre: 'Admisiones, Registro y Control', email_institucional: null },
  { id: '2e2995a4-c553-470b-850e-f688f3bf9eea', codigo: 'CORRESP', nombre: 'Gestión Documental y Correspondencia', email_institucional: null },
];

const rawList = (oficinasData && oficinasData.length > 0) ? oficinasData : fallbackOficinas;

// Ordenar para posicionar "Prueba 1" y "Prueba 2" en los primeros lugares del selector
const oficinas = [...rawList].sort((a: any, b: any) => {
  const isA = a.codigo?.toUpperCase().includes('PRUEBA') || a.nombre?.toLowerCase().includes('prueba');
  const isB = b.codigo?.toUpperCase().includes('PRUEBA') || b.nombre?.toLowerCase().includes('prueba');
  if (isA && !isB) return -1;
  if (!isA && isB) return 1;
  return (a.nombre || '').localeCompare(b.nombre || '');
});
---

<AppLayout title="Subir Petición Institucional" activeNav="subir-peticion">
  <div class="subir-peticion-container subir-bento-shell">
    
    <!-- Banner Ejecutivo Bento + Chart Element SLA en Vivo -->
    <section class="subir-hero-bento">
      <div class="subir-hero-top">
        <div class="subir-hero-text">
          <div class="subir-eyebrow-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            <span>RADICACIÓN OFICIAL · LEY 1755</span>
          </div>
          <h2 class="subir-hero-title">Subir Petición y Asignar Expediente</h2>
          <p class="subir-hero-subtitle">
            Carga de memorial oficial hasta 500 MB, generación automática de radicado, cálculo de margen operativo (-5 días) y notificación directa a oficinas.
          </p>
        </div>

        <a href="/peticiones" class="btn-subir-back">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          <span>Volver a Radicados</span>
        </a>
      </div>

      <!-- Chart Element en Vivo: Línea de Tiempo SLA (Dependencias vs Consolidación) -->
      <div class="subir-sla-chart-card">
        <div class="subir-sla-metrics-row">
          <div class="subir-sla-metric">
            <span class="subir-sla-metric-label">Prioridad Seleccionada</span>
            <span class="subir-sla-priority-chip" id="sla-chart-priority-pill">Media &middot; 15 días</span>
          </div>
          <div class="subir-sla-metric">
            <span class="subir-sla-metric-label">Límite Oficinas (-5 días)</span>
            <strong class="subir-sla-metric-value verde" id="sla-chart-oficinas-date">--</strong>
          </div>
          <div class="subir-sla-metric">
            <span class="subir-sla-metric-label">Expiración General</span>
            <strong class="subir-sla-metric-value dorado" id="sla-chart-general-date">--</strong>
          </div>
          <div class="subir-sla-metric">
            <span class="subir-sla-metric-label">Ventana Total</span>
            <strong class="subir-sla-metric-value" id="sla-chart-total-days">15 días</strong>
          </div>
        </div>

        <div class="subir-sla-bar-wrap">
          <div class="subir-sla-bar-track" aria-hidden="true">
            <div class="subir-sla-bar-oficinas" id="sla-chart-bar-oficinas" style="width: 67%;"></div>
            <div class="subir-sla-bar-margen" id="sla-chart-bar-margen" style="width: 33%;"></div>
          </div>
          <div class="subir-sla-legend">
            <span class="subir-legend-item">
              <span class="subir-legend-dot verde"></span>
              <span>Gestión y carga de soportes (<strong id="sla-legend-oficinas-days">10 días</strong>)</span>
            </span>
            <span class="subir-legend-item">
              <span class="subir-legend-dot dorado"></span>
              <span>Margen de revisión y cierre final (<strong id="sla-legend-margen-days">5 días</strong>)</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Formulario Bento de Radicación de Petición -->
    <form id="form-subir-peticion" class="subir-bento-form">

      <!-- BENTO GRID SUPERIOR: ZONA DE CARGA + DATOS PRINCIPALES -->
      <div class="subir-bento-main-grid">

        <!-- SECCIÓN 0: ZONA DE CARGA DRAG & DROP PRO MAX HASTA 500 MB -->
        <div class="subir-bento-card subir-upload-card">
          <div class="subir-card-header">
            <div class="subir-card-icon dorado">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <div>
              <h3 class="subir-card-title">1. Documento Base de la Petición</h3>
              <p class="subir-card-subtitle">Adjunte el oficio o memorial original (hasta 500 MB).</p>
            </div>
          </div>

          <div id="drop-zone-peticion" class="subir-dropzone">
            <div class="subir-dropzone-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            </div>
            <div class="subir-dropzone-title" id="drop-zone-title">
              Arrastre el documento aquí o haga clic para explorar
            </div>
            <div class="subir-dropzone-subtitle" id="drop-zone-subtitle">
              PDF, DOC, DOCX, JPG o PNG &middot; Capacidad máxima <strong>500 MB</strong>
            </div>
            <input type="file" id="input-archivo-peticion" accept="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png" style="display: none;" />
          </div>

          <div id="file-selected-indicator" class="subir-file-preview" style="display: none;">
            <div class="subir-file-info">
              <div class="subir-file-badge-icon">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div style="min-width: 0;">
                <strong class="subir-file-name" id="selected-file-name">archivo.pdf</strong>
                <div class="subir-file-meta">
                  <span id="selected-file-size">0 KB</span>
                  <span class="subir-file-ok-pill">Listo para radicar</span>
                </div>
              </div>
            </div>
            <button type="button" id="btn-remove-selected-file" class="subir-btn-remove-file">
              Quitar archivo
            </button>
          </div>
        </div>

        <!-- SECCIÓN 2: CONTROL DE FECHAS Y REGLA DE LOS 5 DÍAS -->
        <div class="subir-bento-card">
          <div class="subir-card-header">
            <div class="subir-card-icon verde">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <h3 class="subir-card-title">2. Vencimiento y Regla -5 Días</h3>
              <p class="subir-card-subtitle">Cierre automático para oficinas responsables.</p>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 14px; flex: 1; justify-content: space-between;">
            <div class="form-group" style="margin: 0;">
              <label for="fecha-limite-entrega" class="subir-field-label">Fecha Límite de Cierre General *</label>
              <input type="date" id="fecha-limite-entrega" required class="form-input" style="font-weight: 700; font-size: 0.94rem;" />
              <small style="font-size: 0.72rem; color: #64748B; margin-top: 5px; display: block;">
                Fecha final improrrogable para emitir respuesta oficial al solicitante.
              </small>
            </div>

            <div class="subir-deadline-callout">
              <div class="subir-deadline-eyebrow">Plazo Máximo Oficinas Responsables (-5 Días)</div>
              <div id="preview-fecha-responsable" class="subir-deadline-value">
                -- Seleccione fecha de cierre --
              </div>
              <div class="subir-deadline-note">
                El enlace externo se cierra a las 23:59:59 de esta fecha para reservar 5 días de consolidación en Rectoría.
              </div>
            </div>
          </div>
        </div>

      </div>
      
      <!-- SECCIÓN 1: DATOS DE LA PETICIÓN Y SOLICITANTE -->
      <div class="subir-bento-card">
        <div class="subir-card-header">
          <div class="subir-card-icon verde">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div>
            <h3 class="subir-card-title">3. Datos del Solicitante y Clasificación Jurídica</h3>
            <p class="subir-card-subtitle">Asunto principal, datos de notificación del ciudadano y prioridad SLA</p>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div class="form-group" style="margin: 0;">
            <label for="peticion-asunto" class="subir-field-label">Asunto o Título de la Petición *</label>
            <input type="text" id="peticion-asunto" required placeholder="Ej. Solicitud de expedición y entrega de soporte de grado 2024" class="form-input" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="grid-two-cols">
            <div class="form-group" style="margin: 0;">
              <label for="solicitante-nombre" class="subir-field-label">Nombre del Solicitante / Peticionario *</label>
              <input type="text" id="solicitante-nombre" required placeholder="Ej. Dr. Mario Andrés Rincón" class="form-input" />
            </div>
            <div class="form-group" style="margin: 0;">
              <label for="solicitante-email" class="subir-field-label">Correo del Solicitante</label>
              <input type="email" id="solicitante-email" placeholder="peticionario@ejemplo.com" class="form-input" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;" class="grid-three-cols">
            <div class="form-group" style="margin: 0;">
              <label for="solicitante-tipo" class="subir-field-label">Tipo de Solicitante</label>
              <select id="solicitante-tipo" class="form-input">
                <option value="Ciudadano" selected>Ciudadano / Particular</option>
                <option value="Estudiante">Estudiante / Graduado</option>
                <option value="Profesor">Profesor / Investigador</option>
                <option value="Entidad Pública">Entidad Pública / Órgano de Control</option>
                <option value="Empresa Privada">Empresa / Convenio</option>
              </select>
            </div>
            <div class="form-group" style="margin: 0;">
              <label for="peticion-categoria" class="subir-field-label">Categoría Legal</label>
              <select id="peticion-categoria" class="form-input">
                <option value="Petición General" selected>Petición General (CP art. 23)</option>
                <option value="Información y Documentos">Solicitud de Información y Documentos (Ley 1755)</option>
                <option value="Consulta Jurídica">Consulta Jurídica / Técnica</option>
                <option value="Reclamo Administrativo">Reclamo / Queja Administrativa</option>
              </select>
            </div>
            <div class="form-group" style="margin: 0;">
              <label for="peticion-prioridad" class="subir-field-label">Prioridad SLA</label>
              <select id="peticion-prioridad" class="form-input">
                <option value="Alta">Alta (10 días calendario)</option>
                <option value="Media" selected>Media (15 días calendario)</option>
                <option value="Baja">Baja (20 días calendario)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 3: ARQUITECTURA DEL EXPEDIENTE Y CONSTRUCTOR DE SUBCARPETAS -->
      <div class="subir-bento-card">
        <div class="subir-card-header-between">
          <div style="display: flex; align-items: center; gap: 12px;">
            <div class="subir-card-icon verde">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div>
              <h3 class="subir-card-title">4. Subcarpetas y Dependencias Responsables</h3>
              <p class="subir-card-subtitle">Estructure las subcarpetas del radicado y asigne las oficinas encargadas de aportar soportes</p>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span class="subir-root-chip">Carpeta Raíz: RAD-2026-XXXXX</span>
            <span class="subir-count-chip" id="subcarpetas-count-badge">1 Subcarpeta</span>
          </div>
        </div>

        <!-- Contenedor dinámico de subcarpetas -->
        <div id="subcarpetas-container" style="display: flex; flex-direction: column; gap: 16px;">
          <!-- Se inyecta dinámicamente con JavaScript -->
        </div>

        <!-- Barra inferior del constructor -->
        <div class="subir-subcarpetas-footer">
          <button type="button" id="btn-add-subcarpeta" class="btn-add-subcarpeta-pro">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Agregar Otra Subcarpeta al Expediente</span>
          </button>

          <button type="submit" id="btn-submit-peticion" class="btn-submit-subir-pro">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span>Radicar Petición y Notificar Oficinas</span>
          </button>
        </div>
      </div>

      <!-- JSON del catálogo de oficinas disponibles para el constructor de subcarpetas -->
      <script id="data-oficinas-catalog" type="application/json" set:html={JSON.stringify(oficinas)} />

    </form>

    <!-- Modal de Éxito / Radicado Generado -->
    <div class="modal-backdrop" id="modal-radicado-success" style="display: none; position: fixed; inset: 0; background: rgba(17, 24, 39, 0.55); z-index: 1000; align-items: center; justify-content: center; padding: 16px;">
      <div class="modal-card" style="background: #FFFFFF; width: 100%; max-width: 620px; border-radius: 16px; border: 1px solid #DCE4E3; box-shadow: 0 20px 50px rgba(0, 89, 78, 0.22); overflow: hidden;">
        <div style="background: #00594E; color: #FFFFFF; padding: 24px; text-align: center;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(181, 161, 96, 0.65); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.8"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">Petición Radicada Exitosamente</h3>
          <div id="modal-radicado-number" style="font-size: 1.35rem; font-weight: 800; letter-spacing: 1.5px; font-family: 'JetBrains Mono', ui-monospace, monospace; color: #F7F5EE; margin-top: 6px;">
            RAD-2026-XXXXX
          </div>
        </div>

        <div style="padding: 22px 24px; display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #F8FAFC; border: 1px solid #DCE4E3; border-radius: 12px; padding: 14px 16px; font-size: 0.82rem; display: flex; flex-direction: column; gap: 7px;">
            <div style="display: flex; justify-content: space-between; gap: 10px;">
              <span style="color: #64748B;">Fecha Límite de Entrega:</span>
              <strong style="color: #111827;" id="modal-fecha-entrega">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; gap: 10px;">
              <span style="color: #64748B;">Límite para Oficinas (-5 Días):</span>
              <strong style="color: #00594E;" id="modal-fecha-responsable">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; gap: 10px;">
              <span style="color: #64748B;">Documento Original Guardado:</span>
              <strong style="color: #111827;" id="modal-doc-name">Ninguno</strong>
            </div>
            <div style="display: flex; justify-content: space-between; gap: 10px;">
              <span style="color: #64748B;">PIN de Seguridad (6 Dígitos):</span>
              <strong style="color: #786832; font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 2px; background: #F7F5EE; border: 1px solid #DBD2B0; padding: 1px 8px; border-radius: 6px;" id="modal-pin-acceso">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; gap: 10px;">
              <span style="color: #64748B;">Estructura de Carpeta:</span>
              <code id="modal-storage-path" style="font-size: 0.78rem; color: #00594E;">peticiones/RAD-.../</code>
            </div>
          </div>

          <div>
            <div style="font-size: 0.82rem; font-weight: 800; color: #111827; margin-bottom: 8px;">
              Oficinas Notificadas vía Correo Formal con Código Único Temporal:
            </div>
            <div id="modal-responsables-list" class="pro-scroll-container" style="display: flex; flex-direction: column; gap: 8px; max-height: 180px; overflow-y: auto;">
              <!-- Se inyecta dinámicamente -->
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px;">
            <a href="/peticiones" class="btn-subir-back" style="height: 38px;">Ver Todas las Peticiones</a>
            <button type="button" class="btn-submit-subir-pro" style="padding: 8px 18px; height: 38px;" id="btn-modal-close-reset">Radicar Otra Petición</button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <style>
    .subir-bento-shell {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
      animation: subirCrossfade 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes subirCrossfade {
      from { opacity: 0.4; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .subir-hero-bento {
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-left: 4px solid #00594E;
      border-radius: 16px;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 2px 10px rgba(17, 24, 39, 0.03);
    }

    .subir-hero-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 14px;
    }

    .subir-eyebrow-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: #786832;
      background: #F7F5EE;
      border: 1px solid #DBD2B0;
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 8px;
    }

    .subir-hero-title {
      margin: 0;
      font-size: 1.32rem;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.02em;
    }

    .subir-hero-subtitle {
      margin: 4px 0 0 0;
      font-size: 0.84rem;
      color: #475569;
      max-width: 680px;
      line-height: 1.45;
    }

    .btn-subir-back {
      display: inline-flex;
      align-items: center;
