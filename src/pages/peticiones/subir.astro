---
// src/pages/peticiones/subir.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Obtener catálogo de oficinas institucionales activas directamente desde Supabase PostgreSQL
const { data: oficinasData } = await (supabase
  .from('oficinas' as any)
  .select('id, codigo, nombre, email_institucional, titular_cargo')
  .eq('activo', true)
  .order('nombre') as any);

const fallbackOficinas = [
  { id: 'a05d4e8e-3545-44b0-a184-1daf1b07556f', codigo: 'PRUEBA-1', nombre: 'Prueba 1', email_institucional: 'taxxgameryt@gmail.com' },
  { id: 'b8a96d4e-69bc-4eb5-a4de-8d43589af91b', codigo: 'PRUEBA-2', nombre: 'Prueba 2', email_institucional: 'oscargalindo.es@unitropico.edu.co' },
  { id: '6c717727-996b-46dc-9ea4-cc55ff000e13', codigo: 'REC', nombre: 'Despacho de Rectoría', email_institucional: null },
  { id: 'e288247f-ac9d-434c-8006-8218780da725', codigo: 'SEC-GEN', nombre: 'Secretaría General', email_institucional: null },
  { id: '92cbd906-e694-4d3a-be26-598c2681aebf', codigo: 'OFI-JUR', nombre: 'Oficina Asesora Jurídica', email_institucional: null },
  { id: 'd5e2b1ed-4f18-4208-8d9a-64ebb5ede6ae', codigo: 'VIC-ACAD', nombre: 'Vicerrectoría Académica', email_institucional: null },
  { id: '18ce2c98-dde5-44f9-a517-2761b539c874', codigo: 'VIC-ADMIN', nombre: 'Vicerrectoría Administrativa y Financiera', email_institucional: null },
  { id: '1bcd5449-e637-4c9c-bdb2-e63cb7416a7c', codigo: 'PLA-INST', nombre: 'Dirección de Planeación', email_institucional: null },
  { id: '63ab865f-ad5f-42c0-88e6-6269c267d0db', codigo: 'ADM-REG', nombre: 'Admisiones, Registro y Control', email_institucional: null },
  { id: '2e2995a4-c553-470b-850e-f688f3bf9eea', codigo: 'CORRESP', nombre: 'Gestión Documental y Correspondencia', email_institucional: null },
];

const rawList = (oficinasData && oficinasData.length > 0) ? oficinasData : fallbackOficinas;

// Ordenar para posicionar "Prueba 1" y "Prueba 2" en los primeros lugares del selector
const oficinas = [...rawList].sort((a: any, b: any) => {
  const isA = a.codigo?.toUpperCase().includes('PRUEBA') || a.nombre?.toLowerCase().includes('prueba');
  const isB = b.codigo?.toUpperCase().includes('PRUEBA') || b.nombre?.toLowerCase().includes('prueba');
  if (isA && !isB) return -1;
  if (!isA && isB) return 1;
  return (a.nombre || '').localeCompare(b.nombre || '');
});
---

<AppLayout title="Subir Petición Institucional" activeNav="subir-peticion">
  <div class="subir-peticion-container" style="max-width: 980px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">
    
    <!-- Banner de Encabezado Institucional -->
    <div class="card" style="padding: 24px 28px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md); border-left: 5px solid var(--verde-principal); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin: 0;">Módulo Subir Petición</h2>
          <span class="role-badge admin">Radicación Oficial</span>
        </div>
        <p style="font-size: 0.84rem; color: var(--text-muted); margin: 4px 0 0 0;">
          Carga de memorial oficial, generación de radicado consecutivo, asignación a oficinas responsables con cálculo estricto de margen (-5 días) y envío automático del requerimiento vía correo electrónico.
        </p>
      </div>

      <a href="/peticiones" style="background: var(--verde-suave-bg); color: var(--verde-principal); border: 1px solid var(--verde-borde); padding: 8px 16px; border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <span>Volver a Radicados</span>
      </a>
    </div>

    <!-- Formulario de Radicación de Petición -->
    <form id="form-subir-peticion" style="display: flex; flex-direction: column; gap: 24px;">

      <!-- SECCIÓN 0: CARGA DEL ARCHIVO PRINCIPAL DE LA PETICIÓN -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">Documento Original de la Petición</h3>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Suba el oficio o memorial recibido (PDF, Word o imagen escaneada).</span>
          </div>
        </div>

        <div id="drop-zone-peticion" style="border: 2px dashed var(--verde-borde); background: var(--verde-suave-bg); border-radius: var(--radius-md); padding: 32px 20px; text-align: center; cursor: pointer; transition: all 0.15s ease;">
          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="var(--verde-principal)" stroke-width="2" style="margin-bottom: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          <div style="font-weight: 800; font-size: 0.95rem; color: var(--verde-principal);" id="drop-zone-title">
            Arrastre el archivo de la petición aquí o haga clic para seleccionar
          </div>
          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 4px;" id="drop-zone-subtitle">
            Formatos soportados: PDF, DOCX, JPG, PNG (hasta 50 MB)
          </div>
          <input type="file" id="input-archivo-peticion" accept="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png" style="display: none;" />
        </div>

        <div id="file-selected-indicator" style="display: none; margin-top: 12px; background: #ffffff; border: 1px solid var(--verde-borde); border-radius: var(--radius-sm); padding: 10px 14px; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--verde-principal)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <div>
              <strong style="color: var(--text-main); font-size: 0.85rem;" id="selected-file-name">archivo.pdf</strong>
              <div style="color: var(--text-muted); font-size: 0.72rem;" id="selected-file-size">0 KB</div>
            </div>
          </div>
          <button type="button" id="btn-remove-selected-file" style="background: none; border: none; color: #DC2626; font-size: 0.75rem; font-weight: 700; cursor: pointer;">
            Quitar archivo
          </button>
        </div>
      </div>
      
      <!-- SECCIÓN 1: DATOS DE LA PETICIÓN Y SOLICITANTE -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">1. Información General del Radicado</h3>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Asunto, datos de contacto del peticionario y clasificación jurídica</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Asunto o Título de la Petición *</label>
            <input type="text" id="peticion-asunto" required placeholder="Ej. Solicitud de expedición y entrega de soporte de grado 2024" class="form-input" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="grid-two-cols">
            <div class="form-group">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nombre del Solicitante / Peticionario *</label>
              <input type="text" id="solicitante-nombre" required placeholder="Ej. Dr. Mario Andrés Rincón" class="form-input" />
            </div>
            <div class="form-group">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Correo del Solicitante</label>
              <input type="email" id="solicitante-email" placeholder="peticionario@ejemplo.com" class="form-input" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;" class="grid-three-cols">
            <div class="form-group">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo de Solicitante</label>
              <select id="solicitante-tipo" class="form-input">
                <option value="Ciudadano" selected>Ciudadano / Particular</option>
                <option value="Estudiante">Estudiante / Graduado</option>
                <option value="Profesor">Profesor / Investigador</option>
                <option value="Entidad Pública">Entidad Pública / Órgano de Control</option>
                <option value="Empresa Privada">Empresa / Convenio</option>
              </select>
            </div>
            <div class="form-group">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Categoría Legal</label>
              <select id="peticion-categoria" class="form-input">
                <option value="Petición General" selected>Petición General (CP art. 23)</option>
                <option value="Información y Documentos">Solicitud de Información y Documentos (Ley 1755)</option>
                <option value="Consulta Jurídica">Consulta Jurídica / Técnica</option>
                <option value="Reclamo Administrativo">Reclamo / Queja Administrativa</option>
              </select>
            </div>
            <div class="form-group">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Prioridad</label>
              <select id="peticion-prioridad" class="form-input">
                <option value="Alta">Alta</option>
                <option value="Media" selected>Media</option>
                <option value="Baja">Baja</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2: CONTROL DE FECHAS Y REGLA DE LOS 5 DÍAS -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">2. Vencimiento General y Regla de los 5 Días</h3>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Cálculo automático de la fecha límite para las oficinas responsables</span>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="grid-two-cols">
          <div class="form-group">
            <label for="fecha-limite-entrega" style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha Límite de Cierre de la Petición *</label>
            <input type="date" id="fecha-limite-entrega" required class="form-input" style="font-weight: 700; font-size: 0.95rem;" />
            <small style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px; display: block;">
              Fecha final improrrogable para responder al peticionario.
            </small>
          </div>

          <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 14px 18px; display: flex; flex-direction: column; justify-content: center;">
            <div style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: var(--dorado-oscuro); letter-spacing: 0.05em; margin-bottom: 2px;">
              Plazo Máximo para Oficinas Responsables (-5 Días)
            </div>
            <div id="preview-fecha-responsable" style="font-size: 1.25rem; font-weight: 800; color: var(--verde-principal); font-family: monospace;">
              -- Seleccione fecha de cierre --
            </div>
            <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px;">
              * Las oficinas tienen plazo hasta este día (23:59:59) para subir sus anexos. Luego su acceso queda bloqueado para dar 5 días de consolidación.
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 3: ARQUITECTURA DEL EXPEDIENTE Y CONSTRUCTOR DE SUBCARPETAS -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div>
              <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">3. Arquitectura del Expediente y Asignación de Subcarpetas</h3>
              <span style="font-size: 0.74rem; color: var(--text-muted);">Estructure las subcarpetas del radicado y asigne las dependencias requeridas para cada una</span>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 0.74rem; font-family: monospace; font-weight: 800; color: var(--verde-principal); background: var(--verde-suave-bg); border: 1px solid var(--verde-borde); padding: 4px 10px; border-radius: 4px;">
              Carpeta Raíz: RAD-2026-XXXXX
            </span>
            <span style="font-size: 0.74rem; font-weight: 800; color: var(--dorado-oscuro); background: var(--dorado-suave-bg); border: 1px solid var(--dorado-borde); padding: 4px 10px; border-radius: 4px;" id="subcarpetas-count-badge">
              1 Subcarpeta
            </span>
          </div>
        </div>

        <!-- Contenedor dinámico de subcarpetas -->
        <div id="subcarpetas-container" style="display: flex; flex-direction: column; gap: 18px;">
          <!-- Se inyecta dinámicamente con JavaScript -->
        </div>

        <!-- Botón para agregar más subcarpetas -->
        <div style="margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--border-color); display: flex; justify-content: flex-start;">
          <button type="button" id="btn-add-subcarpeta" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 750; border-color: var(--verde-borde); color: var(--verde-principal); background: var(--verde-suave-bg); padding: 8px 16px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Agregar Otra Subcarpeta al Expediente</span>
          </button>
        </div>
      </div>

      <!-- JSON del catálogo de oficinas disponibles para el constructor de subcarpetas -->
      <script id="data-oficinas-catalog" type="application/json" set:html={JSON.stringify(oficinas)} />

      <!-- BOTÓN DE ENVÍO Y GUARDADO -->
      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="submit" id="btn-submit-peticion" class="btn btn-primary" style="padding: 13px 28px; font-size: 0.95rem; font-weight: 800; box-shadow: var(--shadow-sm); display: inline-flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Radicar Petición y Notificar Oficinas</span>
        </button>
      </div>

    </form>

    <!-- Modal de Éxito / Radicado Generado -->
    <div class="modal-backdrop" id="modal-radicado-success" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 16px;">
      <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
        <div style="background: var(--verde-principal); color: #ffffff; padding: 24px; text-align: center;">
          <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 style="font-size: 1.3rem; font-weight: 800; margin: 0;">Petición Radicada Exitosamente</h3>
          <div id="modal-radicado-number" style="font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; font-family: monospace; color: var(--dorado-principal); margin-top: 6px;">
            RAD-2026-XXXXX
          </div>
        </div>

        <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
          <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 14px; font-size: 0.82rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span style="color: var(--text-muted);">Fecha Límite de Entrega:</span>
              <strong id="modal-fecha-entrega">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span style="color: var(--text-muted);">Límite para Oficinas (-5 Días):</span>
              <strong style="color: var(--verde-principal);" id="modal-fecha-responsable">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span style="color: var(--text-muted);">Documento Original Guardado:</span>
              <strong style="color: var(--text-main);" id="modal-doc-name">Ninguno</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
              <span style="color: var(--text-muted);">PIN de Seguridad (6 Dígitos):</span>
              <strong style="color: #b45309; font-family: monospace; letter-spacing: 2px;" id="modal-pin-acceso">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Estructura de Carpeta:</span>
              <code id="modal-storage-path" style="font-size: 0.78rem; color: var(--verde-oscuro);">peticiones/RAD-.../</code>
            </div>
          </div>

          <div>
            <div style="font-size: 0.82rem; font-weight: 800; color: var(--text-main); margin-bottom: 8px;">
              Oficinas Notificadas vía Correo Formal con Código Único Temporal:
            </div>
            <div id="modal-responsables-list" style="display: flex; flex-direction: column; gap: 8px; max-height: 180px; overflow-y: auto;">
              <!-- Se inyecta dinámicamente -->
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">
            <a href="/peticiones" class="btn btn-secondary" style="text-decoration: none;">Ver Todas las Peticiones</a>
            <button type="button" class="btn btn-primary" id="btn-modal-close-reset">Radicar Otra Petición</button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <style>
    @media (max-width: 768px) {
      .grid-two-cols, .grid-three-cols {
        grid-template-columns: 1fr !important;
      }
    }
    .form-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.85rem;
      color: var(--text-main);
      transition: var(--transition-normal);
    }
    .form-input:focus {
      outline: none;
      border-color: var(--verde-principal);
      box-shadow: 0 0 0 3px var(--verde-suave-bg);
    }
    .oficina-card-label:hover {
      border-color: var(--verde-principal) !important;
      background: var(--verde-suave-bg) !important;
    }
    .oficina-card-label.selected {
      border-color: var(--verde-principal) !important;
      background: var(--verde-suave-bg) !important;
    }
    .oficina-card-label.is-test-office.selected {
      border-color: var(--dorado-oscuro) !important;
      background: rgba(181, 161, 96, 0.12) !important;
    }
  </style>

  <script>
    import { supabase } from '@lib/supabase';

    // 0. Archivo Principal de la Petición & Auto-rellenado inteligente
    let primaryFile: File | null = null;
    const dropZone = document.getElementById('drop-zone-peticion');
    const fileInput = document.getElementById('input-archivo-peticion') as HTMLInputElement;
    const fileIndicator = document.getElementById('file-selected-indicator');
    const selectedFileName = document.getElementById('selected-file-name');
    const selectedFileSize = document.getElementById('selected-file-size');
    const btnRemoveFile = document.getElementById('btn-remove-selected-file');
    const asuntoInput = document.getElementById('peticion-asunto') as HTMLInputElement;

    function setPrimaryFile(file: File) {
      primaryFile = file;
      if (selectedFileName) selectedFileName.textContent = file.name;
      if (selectedFileSize) selectedFileSize.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      if (fileIndicator) fileIndicator.style.display = 'flex';
      if (dropZone) dropZone.style.display = 'none';

      // Auto-rellenar Asunto si está vacío a partir del nombre del archivo
      if (asuntoInput && !asuntoInput.value.trim()) {
        const cleanName = file.name
          .replace(/\.[^/.]+$/, '') // quitar extensión
          .replace(/[-_]+/g, ' ')   // reemplazar guiones por espacios
          .trim();
        // Capitalizar primera letra
        asuntoInput.value = cleanName.charAt(0).toUpperCase() + cleanName.slice(1);
      }
    }

    function removePrimaryFile() {
      primaryFile = null;
      if (fileInput) fileInput.value = '';
      if (fileIndicator) fileIndicator.style.display = 'none';
      if (dropZone) dropZone.style.display = 'block';
    }

    if (dropZone && fileInput) {
      dropZone.addEventListener('click', () => fileInput.click());

      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.background = 'rgba(0, 89, 78, 0.15)';
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.style.background = 'var(--verde-suave-bg)';
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.background = 'var(--verde-suave-bg)';
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          setPrimaryFile(files[0]!);
        }
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          setPrimaryFile(fileInput.files[0]!);
        }
      });
    }

    btnRemoveFile?.addEventListener('click', removePrimaryFile);

    // 1. Cálculo en Vivo de la Regla de los 5 Días
    const inputFechaEntrega = document.getElementById('fecha-limite-entrega') as HTMLInputElement;
    const previewFechaResp = document.getElementById('preview-fecha-responsable');

    // Por defecto sugerir fecha a 15 días calendario a partir de hoy (en zona horaria local)
    const today = new Date();
    const defaultEntrega = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 15);
    const yyyy = defaultEntrega.getFullYear();
    const mm = String(defaultEntrega.getMonth() + 1).padStart(2, '0');
    const dd = String(defaultEntrega.getDate()).padStart(2, '0');
    if (inputFechaEntrega) {
      inputFechaEntrega.value = `${yyyy}-${mm}-${dd}`;
      calculateFiveDaysRule();
      inputFechaEntrega.addEventListener('change', calculateFiveDaysRule);
      inputFechaEntrega.addEventListener('input', calculateFiveDaysRule);
    }

    function calculateFiveDaysRule() {
      if (!inputFechaEntrega || !previewFechaResp) return;
      const val = inputFechaEntrega.value;
      if (!val) {
        previewFechaResp.textContent = '-- Seleccione fecha de cierre --';
        return;
      }

      const dateObj = new Date(val + 'T12:00:00');
      if (isNaN(dateObj.getTime())) return;

      // Restar exactamente 5 días calendario
      const fechaResp = new Date(dateObj);
      fechaResp.setDate(fechaResp.getDate() - 5);

      const formatted = fechaResp.toLocaleDateString('es-CO', {
        weekday: 'short',
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });

      previewFechaResp.textContent = `${formatted} (5 días antes)`;
    }

    // 2. Constructor Dinámico de Subcarpetas y Asignación de Dependencias
    let oficinasCatalog: any[] = [];
    try {
      const catalogEl = document.getElementById('data-oficinas-catalog');
      if (catalogEl && catalogEl.textContent) {
        oficinasCatalog = JSON.parse(catalogEl.textContent);
      }
    } catch (e) {
      console.error('Error cargando catálogo de oficinas:', e);
    }

    let subcarpetasState = [
      {
        uid: Date.now(),
        nombre: 'Soportes Técnicos y Concepto',
        descripcion: 'Aportar memorandos oficiales, certificaciones o conceptos requeridos para responder de fondo la petición.',
        selectedOffices: [] as string[],
      },
    ];

    const subcarpetasContainer = document.getElementById('subcarpetas-container');
    const subcarpetasCountBadge = document.getElementById('subcarpetas-count-badge');
    const btnAddSubcarpeta = document.getElementById('btn-add-subcarpeta');

    function syncCurrentInputsToState() {
      subcarpetasContainer?.querySelectorAll('.subcarpeta-card').forEach((card) => {
        const uid = Number(card.getAttribute('data-sub-uid'));
        const sub = subcarpetasState.find((s) => s.uid === uid);
        if (!sub) return;
        const nameInput = card.querySelector('.sub-input-nombre') as HTMLInputElement | null;
        const descInput = card.querySelector('.sub-input-desc') as HTMLTextAreaElement | null;
        if (nameInput) sub.nombre = nameInput.value;
        if (descInput) sub.descripcion = descInput.value;
      });
    }

    function renderSubcarpetas() {
      syncCurrentInputsToState();
      if (!subcarpetasContainer) return;
      if (subcarpetasCountBadge) {
        subcarpetasCountBadge.textContent = `${subcarpetasState.length} Subcarpeta${subcarpetasState.length === 1 ? '' : 's'}`;
      }

      subcarpetasContainer.innerHTML = subcarpetasState.map((sub, idx) => {
        const canDelete = subcarpetasState.length > 1;
        const selectedCount = sub.selectedOffices.length;

        const officesChipsHtml = oficinasCatalog.map((ofi: any) => {
          const isChecked = sub.selectedOffices.includes(ofi.id);
          const isTestOffice = (ofi.codigo || '').toUpperCase().includes('PRUEBA') || (ofi.nombre || '').toLowerCase().includes('prueba');
          const emailDisplay = isTestOffice ? (ofi.email_institucional || '') : '';

          return `
            <div 
              class="sub-office-chip ${isChecked ? 'is-selected' : ''}" 
              data-sub-uid="${sub.uid}" 
              data-ofi-id="${ofi.id}"
              style="display: flex; align-items: flex-start; gap: 8px; padding: 8px 10px; border: 1px solid ${isChecked ? 'var(--verde-principal)' : (isTestOffice ? 'var(--dorado-borde, #dcd4b8)' : 'var(--border-color)')}; border-radius: 6px; cursor: pointer; background: ${isChecked ? 'var(--verde-suave-bg)' : (isTestOffice ? '#FCFBF7' : '#ffffff')}; transition: all 0.12s ease; user-select: none;"
            >
              <input 
                type="checkbox" 
                class="sub-office-checkbox" 
                data-sub-uid="${sub.uid}" 
                data-ofi-id="${ofi.id}" 
                ${isChecked ? 'checked' : ''} 
                style="margin-top: 2px; accent-color: var(--verde-principal); pointer-events: none; width: 15px; height: 15px;" 
              />
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                  <span style="font-size: 0.78rem; font-weight: 700; color: ${isChecked ? 'var(--verde-oscuro)' : 'var(--text-main)'}; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    ${ofi.nombre}
                  </span>
                  ${isTestOffice ? `
                    <span style="background: rgba(181, 161, 96, 0.15); color: #7a6a35; border: 1px solid rgba(181, 161, 96, 0.4); font-size: 0.58rem; font-weight: 800; padding: 1px 4px; border-radius: 3px; text-transform: uppercase;">Prueba</span>
                  ` : ''}
                </div>
                ${emailDisplay ? `<div style="font-size: 0.68rem; color: var(--text-muted); font-family: monospace;">${emailDisplay}</div>` : ''}
              </div>
            </div>
          `;
        }).join('');

        return `
          <div class="subcarpeta-card" data-sub-uid="${sub.uid}" style="background: #FAF9F5; border: 1px solid var(--border-color); border-left: 4px solid var(--verde-principal); border-radius: var(--radius-sm); padding: 18px; display: flex; flex-direction: column; gap: 14px; position: relative;">
            
            <!-- Cabecera de la subcarpeta -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1.1rem;">📁</span>
                <strong style="font-size: 0.92rem; color: var(--verde-oscuro);">Subcarpeta #${idx + 1}</strong>
                <span style="font-size: 0.70rem; font-weight: 700; color: ${selectedCount > 0 ? 'var(--verde-principal)' : 'var(--text-muted)'}; background: ${selectedCount > 0 ? 'var(--verde-suave-bg)' : '#f1f5f9'}; border: 1px solid ${selectedCount > 0 ? 'var(--verde-borde)' : '#e2e8f0'}; padding: 2px 8px; border-radius: 4px;">
                  ${selectedCount} dependencia${selectedCount === 1 ? '' : 's'} asignada${selectedCount === 1 ? '' : 's'}
                </span>
              </div>

              ${canDelete ? `
                <button type="button" class="btn-remove-subcarpeta" data-sub-uid="${sub.uid}" title="Eliminar esta subcarpeta" style="border: 1px solid #fee2e2; background: #fef2f2; color: #dc2626; border-radius: 4px; padding: 4px 10px; font-size: 0.72rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <span>Eliminar Subcarpeta</span>
                </button>
              ` : ''}
            </div>

            <!-- Campos de la subcarpeta -->
            <div style="display: grid; grid-template-columns: minmax(240px, 1fr) 2fr; gap: 14px;" class="grid-sub-fields">
              <div>
                <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-main); text-transform: uppercase; margin-bottom: 4px; display: block;">
                  Nombre de la Subcarpeta *
                </label>
                <input 
                  type="text" 
                  class="form-input sub-input-nombre" 
                  data-sub-uid="${sub.uid}" 
                  value="${escapeHtmlAttr(sub.nombre)}" 
                  placeholder="Ej. Soportes Financieros, Concepto Jurídico..." 
                  required 
                  style="font-size: 0.84rem; font-weight: 700; background: #ffffff;"
                />
              </div>

              <div>
                <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; display: block;">
                  Instrucciones o requerimiento de anexos para esta subcarpeta
                </label>
                <textarea 
                  class="form-input sub-input-desc" 
                  data-sub-uid="${sub.uid}" 
                  rows="2" 
                  placeholder="Especifique los certificados, actas o documentos que las dependencias deben aportar aquí..." 
                  style="font-size: 0.82rem; resize: vertical; background: #ffffff;"
                >${escapeHtmlText(sub.descripcion)}</textarea>
              </div>
            </div>

            <!-- Selector de Oficinas Responsables Asignadas a esta Subcarpeta -->
            <div style="margin-top: 4px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <label style="font-size: 0.75rem; font-weight: 700; color: var(--dorado-oscuro); text-transform: uppercase;">
                  Dependencias Asignadas a esta Subcarpeta *
                </label>
                <span style="font-size: 0.70rem; color: var(--text-muted);">
                  Haga clic sobre una o más dependencias para asignarlas
                </span>
              </div>
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 8px;">
                ${officesChipsHtml}
              </div>
            </div>

          </div>
        `;
      }).join('');

      attachSubcarpetasEvents();
    }

    function escapeHtmlAttr(str: string) {
      return String(str || '').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escapeHtmlText(str: string) {
      return String(str || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function attachSubcarpetasEvents() {
      // Inputs de nombre
      subcarpetasContainer?.querySelectorAll('.sub-input-nombre').forEach((input) => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const uid = Number(target.getAttribute('data-sub-uid'));
          const sub = subcarpetasState.find((s) => s.uid === uid);
          if (sub) sub.nombre = target.value;
        });
      });

      // Textareas de descripción
      subcarpetasContainer?.querySelectorAll('.sub-input-desc').forEach((textarea) => {
        textarea.addEventListener('input', (e) => {
          const target = e.target as HTMLTextAreaElement;
          const uid = Number(target.getAttribute('data-sub-uid'));
          const sub = subcarpetasState.find((s) => s.uid === uid);
          if (sub) sub.descripcion = target.value;
        });
      });

      // Chips de selección de oficinas
      subcarpetasContainer?.querySelectorAll('.sub-office-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const uid = Number(chip.getAttribute('data-sub-uid'));
          const ofiId = chip.getAttribute('data-ofi-id');
          if (!ofiId) return;

          const sub = subcarpetasState.find((s) => s.uid === uid);
          if (!sub) return;

          const index = sub.selectedOffices.indexOf(ofiId);
          if (index > -1) {
            sub.selectedOffices.splice(index, 1);
          } else {
            sub.selectedOffices.push(ofiId);
          }

          renderSubcarpetas();
        });
      });

      // Botones de eliminación de subcarpeta
      subcarpetasContainer?.querySelectorAll('.btn-remove-subcarpeta').forEach((btn) => {
        btn.addEventListener('click', () => {
          const uid = Number(btn.getAttribute('data-sub-uid'));
          if (subcarpetasState.length <= 1) return;
          subcarpetasState = subcarpetasState.filter((s) => s.uid !== uid);
          renderSubcarpetas();
        });
      });
    }

    btnAddSubcarpeta?.addEventListener('click', () => {
      syncCurrentInputsToState();
      subcarpetasState.push({
        uid: Date.now(),
        nombre: `Subcarpeta ${subcarpetasState.length + 1}`,
        descripcion: '',
        selectedOffices: [],
      });
      renderSubcarpetas();
      // Scroll suave hacia la nueva subcarpeta
      const cards = subcarpetasContainer?.querySelectorAll('.subcarpeta-card');
      if (cards && cards.length > 0) {
        cards[cards.length - 1]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    // Render inicial de subcarpetas
    renderSubcarpetas();

    // 3. Envío del Formulario vía FormData a /api/peticiones/crear
    const form = document.getElementById('form-subir-peticion');
    const submitBtn = document.getElementById('btn-submit-peticion') as HTMLButtonElement;
    const modalSuccess = document.getElementById('modal-radicado-success');

    let isSubmitting = false;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isSubmitting) return;
        syncCurrentInputsToState();
        isSubmitting = true;

        // Validaciones de arquitectura de subcarpetas
        if (subcarpetasState.length === 0) {
          const msg = 'Debe configurar al menos una subcarpeta en el expediente.';
          if ((window as any).showToast) (window as any).showToast(msg, 'warning');
          else alert(msg);
          return;
        }

        for (let i = 0; i < subcarpetasState.length; i++) {
          const sub = subcarpetasState[i]!;
          if (!sub.nombre.trim()) {
            const msg = `La Subcarpeta #${i + 1} debe tener un nombre asignado.`;
            if ((window as any).showToast) (window as any).showToast(msg, 'warning');
            else alert(msg);
            return;
          }
          if (sub.selectedOffices.length === 0) {
            const msg = `Por favor asigne al menos una dependencia responsable a la subcarpeta "${sub.nombre}".`;
            if ((window as any).showToast) (window as any).showToast(msg, 'warning');
            else alert(msg);
            return;
          }
        }

        const allUniqueOfficeIds = Array.from(
          new Set(subcarpetasState.flatMap((s) => s.selectedOffices))
        );

        const subcarpetasPayload = subcarpetasState.map((s) => ({
          nombre: s.nombre.trim(),
          descripcion: s.descripcion.trim(),
          oficina_ids: s.selectedOffices,
        }));

        const instruccionesConsolidadas = subcarpetasState
          .map((s) => `[${s.nombre}]: ${s.descripcion || 'Sin requerimiento específico'}`)
          .join('\n');

        if (!primaryFile && fileInput?.files && fileInput.files.length > 0) {
          primaryFile = fileInput.files[0]!;
        }

        let archivoNombre: string | null = null;
        let archivoMime: string | null = null;
        let archivoStoragePath: string | null = null;
        let archivoTamano: number = 0;
        let archivoBase64: string | null = null;

        const detectSafeMime = (file: File): string => {
          if (file.type && file.type.trim() && file.type !== 'application/octet-stream') {
            return file.type;
          }
          const ext = file.name.split('.').pop()?.toLowerCase() || '';
          switch (ext) {
            case 'pdf': return 'application/pdf';
            case 'doc': return 'application/msword';
            case 'docx': return 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
            case 'xls': return 'application/vnd.ms-excel';
            case 'xlsx': return 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
            case 'jpg':
            case 'jpeg': return 'image/jpeg';
            case 'png': return 'image/png';
            case 'zip': return 'application/zip';
            default: return 'application/pdf';
          }
        };

        if (primaryFile) {
          archivoNombre = primaryFile.name;
          archivoMime = detectSafeMime(primaryFile);
          archivoTamano = primaryFile.size;

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span>Subiendo documento (${(primaryFile.size / (1024 * 1024)).toFixed(1)} MB)...</span>`;
          }

          // Blindaje contra límite de Vercel (413 Payload Too Large) y RLS del Storage:
          const cleanName = primaryFile.name.replace(/[^a-zA-Z0-9._-]/g, '_');
          const tempPath = `temp_radicaciones/${Date.now()}_${cleanName}`;
          let uploadedSuccessfully = false;

          try {
            // 1. Intentar subir mediante URL firmada de subida (Service Role / Administrativa)
            try {
              const signedRes = await fetch('/api/storage/signed-url', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ bucket: 'peticiones', path: tempPath }),
              });
              const signedJson = await signedRes.json().catch(() => ({}));
              if (signedJson.success && signedJson.signedUrl) {
                const putRes = await fetch(signedJson.signedUrl, {
                  method: 'PUT',
                  headers: { 'Content-Type': archivoMime },
                  body: primaryFile,
                });
                if (putRes.ok) {
                  archivoStoragePath = signedJson.path || tempPath;
                  uploadedSuccessfully = true;
                }
              }
            } catch (signedErr) {
              console.warn('Aviso en subida por URL firmada:', signedErr);
            }

            // 2. Si no se pudo por URL firmada, intentar con SDK de Supabase directo
            if (!uploadedSuccessfully) {
              try {
                const { data: uploadData, error: uploadErr } = await supabase.storage
                  .from('peticiones')
                  .upload(tempPath, primaryFile, {
                    contentType: archivoMime,
                    upsert: true,
                  });

                if (!uploadErr && uploadData?.path) {
                  archivoStoragePath = uploadData.path;
                  uploadedSuccessfully = true;
                }
              } catch (sdkErr) {
                console.warn('Aviso en subida SDK directa:', sdkErr);
              }
            }

            // 3. Fallback a Base64 ESTRICTAMENTE para archivos menores a 1.5 MB para evitar 413 Payload Too Large
            if (!uploadedSuccessfully) {
              if (primaryFile.size < 1.5 * 1024 * 1024) {
                archivoBase64 = await new Promise<string>((resolve, reject) => {
                  const reader = new FileReader();
                  reader.onload = () => {
                    const resStr = String(reader.result || '');
                    resolve(resStr.includes(',') ? resStr.split(',')[1] : resStr);
                  };
                  reader.onerror = reject;
                  reader.readAsDataURL(primaryFile!);
                });
              } else {
                throw new Error('No se pudo subir el archivo adjunto (' + (primaryFile.size / (1024 * 1024)).toFixed(1) + ' MB) al almacenamiento institucional. Verifique su conexión a internet e intente nuevamente.');
              }
            }
          } catch (uploadException: any) {
            console.error('Error al subir archivo:', uploadException);
            if ((window as any).showToast) {
              (window as any).showToast(uploadException.message || 'Error al cargar el documento adjunto.', 'error');
            }
            if (submitBtn) {
              isSubmitting = false;
              submitBtn.disabled = false;
              submitBtn.innerHTML = `
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                <span>Radicar Petición y Notificar Oficinas</span>
              `;
            }
            return;
          }
        }

        const payload = {
          asunto: (document.getElementById('peticion-asunto') as HTMLInputElement).value,
          descripcion: instruccionesConsolidadas,
          instrucciones_anexos: instruccionesConsolidadas,
          solicitante_nombre: (document.getElementById('solicitante-nombre') as HTMLInputElement).value,
          solicitante_email: (document.getElementById('solicitante-email') as HTMLInputElement).value,
          solicitante_tipo: (document.getElementById('solicitante-tipo') as HTMLSelectElement).value,
          categoria: (document.getElementById('peticion-categoria') as HTMLSelectElement).value,
          prioridad: (document.getElementById('peticion-prioridad') as HTMLSelectElement).value,
          fecha_limite_entrega: inputFechaEntrega.value,
          oficina_ids: allUniqueOfficeIds,
          subcarpetas: subcarpetasPayload,
          archivo_nombre: archivoNombre,
          archivo_mime: archivoMime,
          archivo_tamano: archivoTamano,
          archivo_storage_path: archivoStoragePath,
          archivo_base64: archivoBase64,
        };

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `<span>Radicando y enviando notificaciones por correo...</span>`;
        }

        try {
          const res = await fetch('/api/peticiones/crear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const rawText = await res.text();
          let data: any = null;
          try {
            data = JSON.parse(rawText);
          } catch (jsonErr) {
            console.error('El servidor no retornó JSON válido:', rawText);
            const errMsg = `Error del servidor (${res.status}): ${rawText.slice(0, 150) || res.statusText || 'Error inesperado'}`;
            if ((window as any).showToast) {
              (window as any).showToast(errMsg, 'error');
            } else if ((window as any).showAlert) {
              (window as any).showAlert(errMsg, 'Error del Servidor');
            }
            return;
          }

          if (!res.ok || !data.success) {
            const errMsg = 'Error al radicar petición: ' + (data.error || 'Ocurrió un error en el servidor.');
            if ((window as any).showToast) {
              (window as any).showToast(errMsg, 'error');
            } else if ((window as any).showAlert) {
              (window as any).showAlert(errMsg, 'Error en Radicación');
            }
            return;
          }

          // Mostrar modal con los datos generados
          const modalNum = document.getElementById('modal-radicado-number');
          const modalEntrega = document.getElementById('modal-fecha-entrega');
          const modalResp = document.getElementById('modal-fecha-responsable');
          const modalPin = document.getElementById('modal-pin-acceso');
          const modalDoc = document.getElementById('modal-doc-name');
          const modalPath = document.getElementById('modal-storage-path');
          const listContainer = document.getElementById('modal-responsables-list');

          if (modalNum) modalNum.textContent = data.peticion.numero_radicado;
          if (modalEntrega) modalEntrega.textContent = data.peticion.fecha_limite_entrega;
          if (modalResp) modalResp.textContent = `${data.peticion.fecha_limite_responsable} (Cierre para dependencias)`;
          if (modalPin) modalPin.textContent = data.peticion.pin_acceso || '--';
          if (modalDoc) {
            modalDoc.textContent = data.peticion.archivo_principal?.nombre_archivo || (primaryFile ? primaryFile.name : 'Ninguno adjunto');
          }
          if (modalPath) modalPath.textContent = data.peticion.storage_folder_path;

          if (listContainer && Array.isArray(data.responsables)) {
            listContainer.innerHTML = data.responsables.map((r: any) => {
              const isTest = (r.oficina_nombre || '').toLowerCase().includes('prueba');
              const emailHtml = (isTest && r.email_institucional) 
                ? `<div style="color: var(--text-muted); font-size: 0.70rem;">${r.email_institucional}</div>`
                : '';
              const notifyStatus = (isTest && r.email_institucional)
                ? `<div style="font-size: 0.65rem; color: #059669; margin-top: 2px; font-weight: 700;">Notificado vía Correo</div>`
                : `<div style="font-size: 0.65rem; color: var(--text-muted); margin-top: 2px;">Código Asignado</div>`;

              return `
                <div style="background: var(--bg-body); border: 1px solid var(--border-subtle); padding: 8px 12px; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem;">
                  <div>
                    <strong style="color: var(--text-main);">${r.oficina_nombre}</strong>
                    ${emailHtml}
                  </div>
                  <div style="text-align: right;">
                    <span style="font-family: monospace; font-weight: 900; color: var(--verde-principal); background: var(--verde-suave-bg); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--verde-borde);">${r.codigo_acceso}</span>
                    ${notifyStatus}
                  </div>
                </div>
              `;
            }).join('');
          }

          if (modalSuccess) modalSuccess.style.display = 'flex';
          (form as HTMLFormElement).reset();
          removePrimaryFile();
          subcarpetasState = [
            {
              uid: Date.now(),
              nombre: 'Soportes Técnicos y Concepto',
              descripcion: 'Aportar memorandos oficiales, certificaciones o conceptos requeridos para responder de fondo la petición.',
              selectedOffices: [],
            },
          ];
          renderSubcarpetas();
        } catch (err: any) {
          console.error('Error de red al conectar con el servidor:', err);
          const errMsg = 'Error de conexión al servidor: ' + (err.message || 'Verifique su conexión de red.');
          if ((window as any).showToast) {
            (window as any).showToast(errMsg, 'error');
          } else if ((window as any).showAlert) {
            (window as any).showAlert(errMsg, 'Error de Conexión');
          }
        } finally {
          isSubmitting = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span>Radicar Petición y Notificar Oficinas</span>
            `;
          }
        }
      });
    }

    // Cerrar modal y reiniciar
    document.getElementById('btn-modal-close-reset')?.addEventListener('click', () => {
      if (modalSuccess) modalSuccess.style.display = 'none';
      calculateFiveDaysRule();
    });
  </script>
</AppLayout>
