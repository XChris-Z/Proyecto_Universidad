---
// src/pages/juzgamiento.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Consultar procesos disciplinarios registrados en Supabase
const { data: dbProcesos } = await (supabase
  .from('juzgamiento_procesos' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const procesosList = dbProcesos || [];
const total = procesosList.length;
const autosCount = procesosList.filter((p: any) => p.tipo_acto && p.tipo_acto.toLowerCase().includes('auto')).length;
const apelCount = procesosList.filter((p: any) => p.tipo_acto && (p.tipo_acto.toLowerCase().includes('apelación') || p.etapa_procesal.toLowerCase().includes('segunda'))).length;
---

<AppLayout title="Fase de Juzgamiento Disciplinario" activeNav="juzgamiento">
  <div class="panel-box">
    <div class="panel-header" style="flex-wrap: wrap; gap: 14px;">
      <div>
        <div class="panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Fase de Juzgamiento y Régimen Disciplinario Institucional</span>
        </div>
        <div style="font-size: 0.8rem; color: var(--secondary-light); font-weight: 600; margin-top: 4px;">
          Control Interno Disciplinario conforme a la Ley 1952 de 2019 / Ley 2094 de 2021: Autos y Apelaciones en Segunda Instancia
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button class="btn btn-primary" id="btn-open-juzgamiento-modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>+ Radicar Auto / Apelación</span>
        </button>
      </div>
    </div>

    <div class="juzgamiento-header-card" style="background: var(--bg-surface-elevated); padding: 16px; border-radius: 8px; margin-bottom: 18px;">
      <div>
        <div style="font-size: 0.88rem; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">Línea de Términos Procesales de Juzgamiento</div>
        <div class="stage-tracker-row" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.78rem;">
          <div class="stage-step active" style="font-weight: 700; color: var(--primary);">
            <span class="stage-step-dot" style="display: inline-block; width: 20px; height: 20px; border-radius: 50%; background: var(--primary); color: #fff; text-align: center; line-height: 20px; margin-right: 4px;">1</span>
            <span>Indagación Previa</span>
          </div>
          <span>&rarr;</span>
          <div class="stage-step active" style="font-weight: 700; color: var(--primary);">
            <span class="stage-step-dot" style="display: inline-block; width: 20px; height: 20px; border-radius: 50%; background: var(--primary); color: #fff; text-align: center; line-height: 20px; margin-right: 4px;">2</span>
            <span>Pliego de Cargos</span>
          </div>
          <span>&rarr;</span>
          <div class="stage-step active" style="font-weight: 700; color: var(--primary);">
            <span class="stage-step-dot" style="display: inline-block; width: 20px; height: 20px; border-radius: 50%; background: var(--primary); color: #fff; text-align: center; line-height: 20px; margin-right: 4px;">3</span>
            <span>Etapa Probatoria</span>
          </div>
          <span>&rarr;</span>
          <div class="stage-step" style="color: var(--text-muted);">
            <span class="stage-step-dot" style="display: inline-block; width: 20px; height: 20px; border-radius: 50%; background: var(--border-color); color: var(--text-main); text-align: center; line-height: 20px; margin-right: 4px;">4</span>
            <span>Fallo 1ra Instancia</span>
          </div>
          <span>&rarr;</span>
          <div class="stage-step" style="color: var(--text-muted);">
            <span class="stage-step-dot" style="display: inline-block; width: 20px; height: 20px; border-radius: 50%; background: var(--border-color); color: var(--text-main); text-align: center; line-height: 20px; margin-right: 4px;">5</span>
            <span>Apelación 2da Instancia (CSU / Rectoría)</span>
          </div>
        </div>
      </div>
    </div>

    <div class="module-tabs" id="juzgamiento-module-tabs">
      <button class="module-tab-btn active" data-jstage="all">
        <span>Todos los Procesos</span>
        <span class="tab-count" id="juzg-count-all">{total}</span>
      </button>
      <button class="module-tab-btn" data-jstage="autos">
        <span>Autos Procesales</span>
        <span class="tab-count" id="juzg-count-autos">{autosCount}</span>
      </button>
      <button class="module-tab-btn" data-jstage="apelaciones">
        <span>Apelaciones en Segunda Instancia</span>
        <span class="tab-count" id="juzg-count-apelaciones">{apelCount}</span>
      </button>
    </div>

    <div class="table-responsive">
      <table class="doc-table">
        <thead>
          <tr>
            <th>Expediente / Implicado</th>
            <th>Tipo de Acto / Auto</th>
            <th>Conducta / Causal Investigada</th>
            <th>Etapa Procesal</th>
            <th>Fecha Notificación</th>
            <th>Segunda Instancia</th>
            <th>Estado de Términos</th>
            <th style="text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody id="juzgamiento-table-body">
          <!-- Renderizado dinámico desde JS con datos reales de Supabase -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Radicar Auto / Apelación en Supabase -->
  <div class="modal-backdrop" id="new-juzgamiento-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 640px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div class="modal-header" style="background: var(--verde-suave-bg); border-bottom: 1px solid var(--verde-borde); padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--verde-principal); margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Radicar Auto / Pieza Procesal Disciplinaria</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-new-juzg-modal" style="background: transparent; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer;">&times;</button>
      </div>

      <form id="form-new-juzgamiento" style="padding: 24px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Radicado del Expediente *</label>
            <input type="text" id="new-juzg-radicado" class="form-input" placeholder="Ej: EXP-DISC-2026-005" required />
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Funcionario / Implicado *</label>
            <input type="text" id="new-juzg-implicado" class="form-input" placeholder="Nombre completo del investigado" required />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Cargo o Dependencia</label>
            <input type="text" id="new-juzg-cargo" class="form-input" placeholder="Ej: Docente Ocasional / Auxiliar" />
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo de Acto / Auto *</label>
            <select id="new-juzg-tipo" class="form-input" style="cursor: pointer;" required>
              <option value="Auto de Apertura de Indagación Previa">Auto de Apertura de Indagación Previa</option>
              <option value="Auto de Formulación de Cargos">Auto de Formulación de Cargos</option>
              <option value="Auto de Decreto de Pruebas Periciales">Auto de Decreto de Pruebas Periciales</option>
              <option value="Fallo de Primera Instancia">Fallo de Primera Instancia</option>
              <option value="Recurso de Apelación 2da Instancia">Recurso de Apelación 2da Instancia</option>
              <option value="Auto de Archivo Definitivo">Auto de Archivo Definitivo</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Etapa Procesal *</label>
            <select id="new-juzg-etapa" class="form-input" style="cursor: pointer;" required>
              <option value="Indagación Previa">1. Indagación Previa</option>
              <option value="Pliego de Cargos">2. Pliego de Cargos</option>
              <option value="Etapa Probatoria">3. Etapa Probatoria</option>
              <option value="Fallo 1ra Instancia">4. Fallo 1ra Instancia</option>
              <option value="Segunda Instancia (CSU / Rectoría)">5. Segunda Instancia (CSU / Rectoría)</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha de Notificación</label>
            <input type="date" id="new-juzg-fecha" class="form-input" required />
          </div>
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Conducta o Causal Investigada</label>
          <textarea id="new-juzg-conducta" class="form-input" rows="2" placeholder="Descripción sucinta de los hechos materia de indagación..."></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-new-juzg">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-juzg" style="font-weight: 700;">
            Incorporar a Supabase
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import { initJuzgamiento } from '@scripts/juzgamiento';
  initJuzgamiento();
</script>
