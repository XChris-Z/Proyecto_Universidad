---
// src/pages/planeacion.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Consultar informes de planeación reales desde Supabase
const { data: dbInformes } = await (supabase
  .from('planeacion_informes' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const informesList = dbInformes || [];
const countFin = informesList.filter((i: any) => i.tipo === 'financiero').length;
const countRec = informesList.filter((i: any) => i.tipo === 'rectoral').length;
---

<AppLayout title="Planeación y Gestión CSU" activeNav="planeacion">
  <section class="module-board-card" style="max-width: 1280px; margin: 0 auto;">
    
    <!-- Cabecera Sobria y Ejecutiva (Bento Pro Max) -->
    <div class="module-board-header">
      <div style="min-width: 0; flex: 1;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h1 style="font-size: 1.55rem; font-weight: 800; color: #111827; margin: 0; letter-spacing: -0.01em;">Planeación Estratégica y Financiera CSU</h1>
          <span style="font-size: 0.72rem; font-weight: 800; background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; padding: 3px 10px; border-radius: 999px;">Rendición y PDI</span>
        </div>
        <p style="font-size: 0.86rem; color: #52606D; margin: 6px 0 0 0;">
          Informes Financieros Mensuales e Informes de Gestión Rectoral del Plan de Desarrollo Institucional (PDI Unitrópico) ante el Consejo Superior Universitario.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button class="btn btn-primary" id="btn-open-planeacion-modal" style="background: #00594E; border: 1.5px solid #00594E; color: #ffffff; font-weight: 800; font-size: 0.84rem; border-radius: 10px; padding: 10px 20px; box-shadow: 0 2px 8px rgba(0, 89, 78, 0.25); cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          <span>Radicar Informe ante CSU</span>
        </button>
      </div>
    </div>

    <!-- KPIs de Informes y Rendición de Cuentas CSU (Bento Grid Pro Max) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
      
      <!-- KPI 1: Informes Financieros Mensuales -->
      <div class="kpi-card stat-card" style="padding: 18px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.72rem; text-transform: uppercase; font-weight: 800; color: #52606D; letter-spacing: 0.5px; display: block;">Informes Financieros Mensuales</span>
          <div style="font-size: 1.9rem; font-weight: 800; color: #00594E; margin-top: 4px; line-height: 1;" id="plan-kpi-count-fin">{countFin}</div>
          <span style="font-size: 0.74rem; font-weight: 600; color: #00594E; margin-top: 6px; display: inline-block;">Radicados y verificados ante el CSU</span>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #FFFFFF; border: 1.5px solid #B2CFCB; display: flex; align-items: center; justify-content: center; color: #00594E; flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
      </div>

      <!-- KPI 2: Informes de Gestión Rectoral -->
      <div class="kpi-card stat-card" style="padding: 18px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.72rem; text-transform: uppercase; font-weight: 800; color: #786832; letter-spacing: 0.5px; display: block;">Informes de Gestión Rectoral</span>
          <div style="font-size: 1.9rem; font-weight: 800; color: #786832; margin-top: 4px; line-height: 1;" id="plan-kpi-count-rec">{countRec}</div>
          <span style="font-size: 0.74rem; font-weight: 600; color: #786832; margin-top: 6px; display: inline-block;">Rendición periódica oficial del PDI</span>
        </div>
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #FFFFFF; border: 1.5px solid #DBD2B0; display: flex; align-items: center; justify-content: center; color: #786832; flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
      </div>

    </div>

    <!-- Pestañas de Navegación Estilizadas con Contadores -->
    <div class="module-tabs-container module-tabs" id="planeacion-module-tabs" role="tablist">
      <button class="module-tab-btn active" data-ptab="financieros" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Informes Financieros Mensuales CSU</span>
        <span class="tab-count" id="plan-count-fin" style="background: #00594E; color: #ffffff; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{countFin}</span>
      </button>
      <button class="module-tab-btn" data-ptab="rectorales" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Informes de Gestión Rectoral CSU</span>
        <span class="tab-count" id="plan-count-rec" style="background: #DBD2B0; color: #786832; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{countRec}</span>
      </button>
    </div>

    <!-- Buscador en tiempo real de Informes CSU -->
    <div class="search-bar-wrapper filter-bar" style="padding: 12px 18px;">
      <div style="position: relative; width: 100%;">
        <input type="text" id="planeacion-search-input" placeholder="Buscar informe por período (Ej: 2026), radicado CSU, responsable o tema..." class="form-input" style="padding-left: 38px; border-radius: 10px; border: 1.5px solid #DCE4E3; font-size: 0.85rem; height: 42px; width: 100%; box-sizing: border-box; background: #FFFFFF;" />
        <div style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748B; display: flex; align-items: center; pointer-events: none;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </div>
      </div>
    </div>

    <!-- Tarjeta Contenedora Principal con Scrollbar Interna Propia -->
    <div class="table-wrapper" style="padding: 16px;">
      <div id="planeacion-tab-content" class="pro-scroll-container table-scroll-wrapper records-card-body" style="max-height: 540px; overflow-y: auto; overflow-x: auto; width: 100%;">
        <!-- Dinámico desde JS con datos de Supabase -->
      </div>
    </div>
  </section>

  <!-- Modal: Radicar Informe de Planeación ante CSU -->
  <div class="modal-backdrop" id="new-planeacion-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(2px);">
    <div class="modal-card plan-modal-card" style="background: #ffffff; width: 100%; max-width: 640px; max-height: 92vh; overflow-y: auto; border-radius: 16px; box-shadow: 0 20px 45px rgba(0,0,0,0.2); border-top: 4px solid #00594E;">
      <div class="modal-header" style="background: #F2F7F6; border-bottom: 1.5px solid #DCE4E3; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 5;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #00594E; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <span>Radicar Informe ante el Consejo Superior (CSU)</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-plan-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #64748B; cursor: pointer; line-height: 1;">&times;</button>
      </div>

      <form id="form-new-planeacion" class="plan-modal-form">
        <!-- Sección 1: Datos del Informe y Período con Calendario -->
        <div class="plan-modal-section">
          <div class="plan-section-heading">
            <span class="plan-section-dot"></span>
            <span>Datos del Informe</span>
          </div>

          <div class="plan-grid-2">
            <div class="form-group">
              <label for="new-plan-tipo" class="plan-field-label">Tipo de Informe *</label>
              <select id="new-plan-tipo" class="form-input plan-field-input" style="cursor: pointer;" required>
                <option value="financiero" selected>Informe Financiero Mensual CSU</option>
                <option value="rectoral">Informe de Gestión Rectoral PDI</option>
              </select>
            </div>
            <div class="form-group">
              <label for="new-plan-radicado" class="plan-field-label">Radicado ante CSU</label>
              <input type="text" id="new-plan-radicado" class="form-input plan-field-input" placeholder="Ej: CSU-INF-2026-012" />
            </div>
          </div>

          <div class="plan-period-calendar-box">
            <div class="plan-period-calendar-header">
              <span class="plan-field-label" style="margin: 0; color: #00594E;">Período / Vigencia con Calendario *</span>
              <span id="new-plan-periodo-preview" class="plan-period-preview-chip">Seleccione rango de fechas</span>
            </div>
            <div class="plan-grid-2">
              <div class="form-group">
                <label for="new-plan-fecha-inicio" class="plan-field-label">Fecha de Inicio del Período *</label>
                <input type="date" id="new-plan-fecha-inicio" class="form-input plan-field-input" required />
              </div>
              <div class="form-group">
                <label for="new-plan-fecha-fin" class="plan-field-label">Fecha de Corte / Fin *</label>
                <input type="date" id="new-plan-fecha-fin" class="form-input plan-field-input" required />
              </div>
            </div>
          </div>
        </div>

        <!-- Sección 2: Resumen Financiero -->
        <div class="plan-financial-card">
          <div class="plan-section-heading">
            <span class="plan-section-dot"></span>
            <span>Resumen Financiero</span>
          </div>

          <div class="plan-grid-2">
            <div class="form-group">
              <label for="new-plan-ingresos" class="plan-field-label">Ingresos Totales (COP)</label>
              <div class="plan-affix-wrap">
                <span class="plan-prefix-symbol" aria-hidden="true">$</span>
                <input type="text" inputmode="numeric" id="new-plan-ingresos" class="form-input plan-field-input has-prefix" placeholder="4.250.000.000" autocomplete="off" />
              </div>
            </div>
            <div class="form-group">
              <label for="new-plan-gastos" class="plan-field-label">Gastos Ejecutados (COP)</label>
              <div class="plan-affix-wrap">
                <span class="plan-prefix-symbol" aria-hidden="true">$</span>
                <input type="text" inputmode="numeric" id="new-plan-gastos" class="form-input plan-field-input has-prefix" placeholder="3.890.000.000" autocomplete="off" />
              </div>
            </div>
          </div>

          <div class="form-group" style="margin-top: 2px;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 5px;">
              <label for="new-plan-ejecucion" class="plan-field-label" style="margin: 0;">% Ejecución Presupuestal</label>
              <span id="new-plan-ejecucion-badge" class="plan-pct-live-label">0% ejecutado</span>
            </div>
            <div class="plan-affix-wrap">
              <input type="number" id="new-plan-ejecucion" class="form-input plan-field-input has-suffix" min="0" max="100" step="0.1" value="0" />
              <span class="plan-suffix-symbol" aria-hidden="true">%</span>
            </div>
            <div class="plan-mini-progress-track" aria-hidden="true">
              <div id="new-plan-ejecucion-bar" class="plan-mini-progress-fill" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <!-- Sección 3: Resumen Ejecutivo -->
        <div class="form-group">
          <label for="new-plan-observaciones" class="plan-field-label">Resumen Ejecutivo / Observaciones</label>
          <textarea id="new-plan-observaciones" class="form-input plan-field-input" rows="3" placeholder="Síntesis de los logros alcanzados y ejecución reportada al Consejo Superior..." style="resize: vertical; min-height: 82px; line-height: 1.5;"></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; padding-top: 14px; border-top: 1px solid #DCE4E3;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-plan" style="border: 1.5px solid #DCE4E3; color: #52606D; background: #ffffff; font-weight: 700; border-radius: 8px; padding: 9px 18px; cursor: pointer;">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-plan" style="background: #00594E; border: none; color: #ffffff; font-weight: 800; border-radius: 8px; padding: 9px 22px; cursor: pointer; box-shadow: 0 2px 6px rgba(0,89,78,0.25);">
            Radicar Informe
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<style>
  .plan-modal-form {
    padding: 20px 24px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .plan-modal-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .plan-financial-card {
    background: #F8FAFB;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .plan-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #00594E;
  }

  .plan-section-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #00594E;
    display: inline-block;
    flex-shrink: 0;
  }

  .plan-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .plan-field-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 750;
    color: #52606D;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 5px;
  }

  .plan-field-input {
    width: 100%;
    box-sizing: border-box;
    border-radius: 8px;
    border: 1.5px solid #DCE4E3;
    padding: 9px 12px;
    font-size: 0.84rem;
    background: #FFFFFF;
    color: #0F172A;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .plan-field-input:focus {
    outline: none;
    border-color: #00594E;
    box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
  }

  .plan-period-calendar-box {
    background: #F4F8F7;
    border: 1px solid #D5E4E0;
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plan-period-calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .plan-period-preview-chip {
    font-size: 0.72rem;
    font-weight: 700;
    color: #00594E;
    background: #FFFFFF;
    border: 1px solid #B2CFCB;
    padding: 2px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .plan-affix-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .plan-prefix-symbol {
    position: absolute;
    left: 12px;
    font-weight: 800;
    font-size: 0.86rem;
    color: #00594E;
    pointer-events: none;
    user-select: none;
  }

  .plan-suffix-symbol {
    position: absolute;
    right: 12px;
    font-weight: 800;
    font-size: 0.84rem;
    color: #52606D;
    pointer-events: none;
    user-select: none;
  }

  .plan-field-input.has-prefix {
    padding-left: 28px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .plan-field-input.has-suffix {
    padding-right: 32px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .plan-pct-live-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #00594E;
    font-variant-numeric: tabular-nums;
  }

  .plan-mini-progress-track {
    width: 100%;
    height: 7px;
    background: #E2E8F0;
    border-radius: 999px;
    overflow: hidden;
    margin-top: 7px;
  }

  .plan-mini-progress-fill {
    height: 100%;
    background: #00594E;
    border-radius: 999px;
    transition: width 0.2s ease;
  }

  @media (max-width: 580px) {
    .plan-grid-2 {
      grid-template-columns: 1fr;
    }
    .plan-modal-form {
      padding: 16px;
    }
  }
</style>

<script>
  import { initPlaneacion } from '@scripts/planeacion';
  initPlaneacion();
</script>
