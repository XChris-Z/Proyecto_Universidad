---
// src/pages/auth/denegado.astro
import AuthLayout from '@layouts/AuthLayout.astro';

const email = Astro.url.searchParams.get('email') || 'tu_correo@unitropico.edu.co';
---

<AuthLayout title="Acceso Denegado — SGD Unitrópico">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div class="card" style="max-width: 540px; width: 100%; padding: 36px 32px; text-align: center; background: #ffffff; border-radius: var(--radius-md); box-shadow: var(--shadow-md); border-top: 5px solid #dc2626;">
      
      <div style="width: 64px; height: 64px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
      </div>

      <span style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #dc2626; background: #fee2e2; padding: 4px 12px; border-radius: var(--radius-sm); display: inline-block; margin-bottom: 12px;">
        Acceso No Autorizado por Whitelist
      </span>

      <h2 style="font-size: 1.45rem; font-weight: 800; color: #1e293b; margin: 0 0 12px 0;">
        Tu correo institucional no está autorizado en este sistema
      </h2>

      <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 18px 0;">
        La cuenta de Google <strong style="color: #0f172a; word-break: break-all;">{email}</strong> fue autenticada por Google, pero <strong>NO se encuentra registrada en la Lista Blanca (Whitelist)</strong> del SGD Unitrópico.
      </p>

      <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 14px 16px; text-align: left; font-size: 0.80rem; color: #475569; margin-bottom: 24px; line-height: 1.45;">
        <div style="font-weight: 700; color: #0f172a; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Política de Seguridad de la Información:
        </div>
        Tener una cuenta institucional <code>@unitropico.edu.co</code> no otorga acceso automático. Cada funcionario debe ser dado de alta explícitamente por la Rectoría o el Administrador General del sistema. Este intento ha quedado registrado en la bitácora inmutable de auditoría.
      </div>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/login" class="btn btn-primary" style="padding: 10px 22px; font-weight: 700; text-decoration: none;">
          &larr; Volver a Iniciar Sesión
        </a>
        <a href="mailto:soporte.dti@unitropico.edu.co?subject=Solicitud%20de%20Acceso%20SGD%20Unitropico" class="btn btn-secondary" style="padding: 10px 20px; font-weight: 700; text-decoration: none;">
          Solicitar Autorización
        </a>
      </div>

    </div>
  </div>
</AuthLayout>
