---
// src/pages/auth/callback.astro
import AuthLayout from '@layouts/AuthLayout.astro';
import '@styles/callback.css';
---

<AuthLayout title="Verificando Autorización Institucional — SGD Unitrópico">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div class="card" style="max-width: 480px; width: 100%; padding: 36px 28px; text-align: center; background: #ffffff; border-radius: var(--radius-md); box-shadow: var(--shadow-md);">
      <div class="spinner" style="width: 52px; height: 52px; border: 4px solid var(--verde-suave-bg); border-top-color: var(--verde-principal); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px auto;"></div>
      <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0 0 8px 0;">Validando Identidad y Whitelist</h3>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;" id="auth-status-text">
        Consultando repositorio institucional de funcionarios autorizados...
      </p>
    </div>
  </div>
</AuthLayout>

<script>
  import { initAuthCallback } from "@scripts/callback";
  initAuthCallback();
</script>
