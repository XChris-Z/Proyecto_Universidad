---
// src/pages/peticiones.astro
export const prerender = false;

import AppLayout from '@layouts/AppLayout.astro';
import '@styles/peticiones.css';
import { supabase } from '@lib/supabase';
import { calculateDeadlineProgress } from '@lib/utils';
import { getDeterministicPin } from '@lib/security';
import { separarRespuestaMeta, esSubcarpetaValida, filtrarSubcarpetasValidas } from '@lib/subcarpetas';

// Consultar peticiones reales en base de datos PostgreSQL
const { data: dbPeticiones } = await (supabase
  .from('peticiones' as any)
  .select(`
    id,
    numero_radicado,
    asunto,
    descripcion,
    solicitante_nombre,
    solicitante_tipo,
    solicitante_email,
    fecha_radicacion,
    fecha_limite_entrega,
    fecha_limite_responsable,
    storage_folder_path,
    estado,
    prioridad,
    created_at,
    peticion_responsables (
      id,
      codigo_acceso,
      estado_entrega,
      fecha_entrega,
      observaciones_entrega,
      storage_subfolder_path,
      oficinas (
        id,
        nombre,
        email_institucional
      )
    )
  `)
  .order('created_at', { ascending: false }) as any);

// Consultar subcarpetas y anexos para cálculo consolidado de entregas por subcarpeta
let dbSubcarpetas: any[] = [];
try {
  const { data: subsData } = await (supabase
    .from('peticion_subcarpetas' as any)
    .select('id, peticion_id, nombre, descripcion') as any);
  if (subsData) dbSubcarpetas = subsData;
} catch (e) {}

let dbAnexos: any[] = [];
try {
  const { data: anexosData } = await (supabase
    .from('peticion_anexos' as any)
    .select('id, peticion_id, peticion_responsable_id, subcarpeta_id, nombre_archivo, storage_path') as any);
  if (anexosData) dbAnexos = anexosData;
} catch (e) {}

const respSubcarpetasMap: Record<string, string> = {};
try {
  const { data: respSubs } = await (supabase
    .from('peticion_responsables' as any)
    .select('id, subcarpeta_id') as any);
  if (respSubs && respSubs.length > 0) {
    respSubs.forEach((r: any) => {
      if (r.id && r.subcarpeta_id) respSubcarpetasMap[r.id] = r.subcarpeta_id;
    });
  }
} catch {}

const peticionesList = ((dbPeticiones as any[]) || []).map((p: any) => {
  const respObs = p.peticion_responsables?.find((r: any) => r?.observaciones_entrega?.includes('PIN:'))?.observaciones_entrega;
  const pinMatch = respObs?.match(/PIN:\s*([0-9A-Z]{6})/i);
  const storedPin = pinMatch ? pinMatch[1] : null;

  const enrichedResponsables = (p.peticion_responsables || []).map((r: any) => ({
    ...r,
    subcarpeta_id: r.subcarpeta_id || respSubcarpetasMap[r.id] || null,
  }));

  return {
    ...p,
    peticion_responsables: enrichedResponsables,
    pin_acceso: storedPin || p.pin_acceso || getDeterministicPin(p.numero_radicado || p.id),
  };
});
const pendientesCount = peticionesList.filter((p: any) => p.estado !== 'respondida' && p.estado !== 'completada').length;
---

<AppLayout title="Peticiones Radicadas y Expedientes" activeNav="peticiones">
  <div class="legal-basis-banner">
    <div class="legal-basis-text">
      <h4>Control de Radicación Oficial y Regla de Margen de 5 Días</h4>
      <p>Gestión de peticiones con cálculo automatizado de términos, generación de carpetas virtuales por radicado y portal externo para entrega de soportes por parte de las oficinas responsables.</p>
    </div>
    <div class="legal-basis-badges">
      <span class="badge-right-origin cp23">Constitución Art. 23</span>
      <span class="badge-right-origin ley1755">Ley 1755 / 2015</span>
      <span class="badge-right-origin ley1712">Regla -5 Días Activa</span>
      <span class="badge-right-origin interno">Expediente Virtualizado</span>
    </div>
  </div>

  <div class="section-toolbar" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <div class="filter-tabs" id="peticiones-filter-tabs">
        <button class="filter-tab active" data-pfilter="all">
          <span>Todas las Peticiones</span>
          <span class="filter-count" id="pcount-all">{peticionesList.length}</span>
        </button>
        <button class="filter-tab" data-pfilter="pendientes">
          <span class="dist-dot" style="background: var(--dorado-oscuro);"></span>
          <span>En Trámite</span>
          <span class="filter-count">{pendientesCount}</span>
        </button>
      </div>

      <!-- Buscador en tiempo real de Peticiones -->
      <div style="position: relative; width: 280px; max-width: 100%;">
        <input type="text" id="peticiones-search-input" placeholder="Buscar radicado, solicitante, asunto..." class="form-input" style="padding-left: 34px; height: 38px; font-size: 0.82rem;" />
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 11px; top: 12px; color: var(--text-muted);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
    </div>

    <div>
      <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        <span>Subir Petición</span>
      </a>
    </div>
  </div>

  <!-- Vista Principal: Tabla de Radicados con Semáforo SLA y Acciones Globales -->
  <div class="card" style="padding: 20px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
    <div class="table-responsive pro-scroll-container table-scroll-wrapper" style="max-height: 540px; overflow-y: auto; overflow-x: auto; border-radius: 12px;">
      <table class="doc-table" id="tabla-peticiones" style="width: 100%; border-collapse: collapse;">
        <thead style="position: sticky; top: 0; z-index: 10;">
          <tr style="border-bottom: 2px solid #DCE4E3; text-align: left; color: #52606D; font-size: 0.74rem; text-transform: uppercase;">
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Radicado / Asunto</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Peticionario</th>
            <th style="padding: 12px 10px; min-width: 180px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Término General / SLA</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Límite Oficinas (-5 Días)</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Oficinas Responsables</th>
            <th style="padding: 12px 10px; text-align: right; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {peticionesList.length > 0 ? (
            peticionesList.map((pet: any) => {
              const responsables = pet.peticion_responsables || [];
              const prog = calculateDeadlineProgress(pet.fecha_radicacion || pet.created_at, pet.fecha_limite_entrega);

              return (
                <tr id={`row-pet-${pet.id}`} data-estado={pet.estado} style="border-bottom: 1px solid var(--border-subtle); font-size: 0.84rem;">
                  <td style="padding: 12px 8px;">
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                      <a 
                        href={`/archivos?radicado=${encodeURIComponent(pet.numero_radicado)}`}
                        class="btn-abrir-carpeta"
                        data-radicado={pet.numero_radicado}
                        title="Abrir Carpeta de este Radicado en Gestor de Archivos"
                        style="text-decoration: none; font-family: monospace; font-size: 0.86rem; font-weight: 800; color: var(--verde-principal); background: var(--verde-suave-bg); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--verde-borde); display: inline-flex; align-items: center; gap: 4px; transition: all 0.15s ease;"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        <span>{pet.numero_radicado}</span>
                      </a>
                      <span style={`font-size: 0.65rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; ${pet.prioridad === 'Alta' ? 'background: #FEE2E2; color: #B91C1C;' : 'background: #E0F2FE; color: #0369A1;'}`}>
                        {pet.prioridad || 'Media'}
                      </span>
                      <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(217, 119, 6, 0.12); border: 1px solid rgba(217, 119, 6, 0.25); padding: 2px 6px; border-radius: 4px;" title="PIN Criptográfico de Acceso (6 dígitos)">
                        <span style="font-size: 0.65rem; font-weight: 700; color: #b45309;">PIN:</span>
                        <span style="font-family: monospace; font-size: 0.72rem; font-weight: 800; color: #b45309;">{pet.pin_acceso || '849201'}</span>
                        <button 
                          type="button" 
                          title="Copiar PIN" 
                          onclick={`event.stopPropagation(); navigator.clipboard.writeText('${pet.pin_acceso || '849201'}'); alert('PIN copiado al portapapeles: ${pet.pin_acceso || '849201'}');`} 
                          style="border: none; background: transparent; cursor: pointer; color: #b45309; padding: 0; display: inline-flex; align-items: center;"
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                      </div>
                    </div>
                    <div class="pet-asunto-text" style="font-weight: 700; color: var(--text-main); margin-top: 5px;">
                      {pet.asunto}
                    </div>
                  </td>

                  <td style="padding: 12px 8px;">
                    <div class="pet-solicitante-text" style="font-weight: 600; color: var(--text-main);">{pet.solicitante_nombre}</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted);">{pet.solicitante_tipo === 'Docente' ? 'Profesor' : (pet.solicitante_tipo || 'Ciudadano')}</div>
                  </td>

                  <!-- REEMPLAZO: Columna de Semáforo SLA -->
                  <td style="padding: 12px 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 0.76rem;">
                      <span style="font-weight: 700; color: var(--text-main);">{pet.fecha_limite_entrega}</span>
                      <span style={`font-weight: 800; font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; background: ${prog.bgLight}; color: ${prog.color};`}>
                        {prog.statusBadge}
                      </span>
                    </div>
                    <div style="width: 100%; height: 7px; background: #F1F5F9; border-radius: 9999px; overflow: hidden; border: 1px solid var(--border-subtle);">
                      <div style={`width: ${prog.percentage}%; height: 100%; background: ${prog.color}; transition: width 0.3s ease; border-radius: 9999px;`}></div>
                    </div>
                    <div style="font-size: 0.68rem; color: var(--text-muted); margin-top: 3px; display: flex; justify-content: space-between;">
                      <span>Consumido: {prog.percentage}%</span>
                      <span>{prog.daysRemaining > 0 ? `${prog.daysRemaining} días restantes` : 'Término expirado'}</span>
                    </div>
                  </td>

                  <td style="padding: 12px 8px;">
                    <span style="color: var(--dorado-oscuro); font-weight: 800; background: var(--dorado-suave-bg); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--dorado-borde); font-family: monospace; font-size: 0.8rem;">
                      {pet.fecha_limite_responsable}
                    </span>
                  </td>

                  <td style="padding: 12px 8px;">
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                      {responsables.map((r: any) => {
                        const ofiNombre = r.oficinas?.nombre || 'Oficina';
                        let petSubs = filtrarSubcarpetasValidas(dbSubcarpetas.filter((s: any) => s.peticion_id === pet.id));
                        const rawObs = r.observaciones_entrega || '';
                        const { textoLimpio } = separarRespuestaMeta(rawObs);
                        const cleanObs = textoLimpio.replace(/^PIN:\s*[0-9A-Z]{6}(\s*\|\s*)?/i, '').trim();

                        // Si no hay subcarpetas físicas registradas en la tabla, inferir desde observaciones y anexos
                        if (petSubs.length === 0) {
                          const foundMap: any = {};
                          const matches = cleanObs.matchAll(/\[([a-zA-Z0-9_\-\s]+)\]/g);
                          for (const m of matches) {
                            const name = String(m?.[1] || '').trim();
                            if (name && esSubcarpetaValida(name) && !foundMap[name.toUpperCase()]) {
                              foundMap[name.toUpperCase()] = { id: `inf-${pet.id}-${name}`, nombre: name, peticion_id: pet.id };
                            }
                          }
                          (dbAnexos || []).filter((a: any) => a.peticion_id === pet.id).forEach((a: any) => {
                            const fm = (a.nombre_archivo || '').match(/\[([a-zA-Z0-9_\-\s]+)\]/i);
                            if (fm && fm[1]) {
                              const name = String(fm[1] || '').trim();
                              if (name && esSubcarpetaValida(name) && !foundMap[name.toUpperCase()]) {
                                foundMap[name.toUpperCase()] = { id: `inf-${pet.id}-${name}`, nombre: name, peticion_id: pet.id };
                              }
                            }
                          });
                          petSubs = filtrarSubcarpetasValidas(Object.values(foundMap));
                        }

                        // Calcular subcarpetas asignadas a esta oficina
                        const assignedSubs = petSubs.filter((s: any) => 
                          (r.subcarpeta_id && r.subcarpeta_id === s.id) || 
                          rawObs.includes(`[${s.nombre}]`) || 
                          petSubs.length === 1
                        );
                        const totalSubs = assignedSubs.length > 0 ? assignedSubs.length : (petSubs.length > 0 ? petSubs.length : 1);

                        // Contar entregas verificadas por archivo o estado
                        let deliveredCount = 0;
                        if (assignedSubs.length > 0) {
                          for (const asub of assignedSubs) {
                            const subSlug = (asub.nombre || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
                            const hasFile = dbAnexos.some((a: any) => 
                              a.peticion_responsable_id === r.id && 
                              ((a.subcarpeta_id && a.subcarpeta_id === asub.id) || 
                               (a.nombre_archivo && a.nombre_archivo.includes(`[${asub.nombre}]`)) || 
                               (subSlug && a.storage_path && a.storage_path.toLowerCase().includes(`/${subSlug}/`)) || 
                               petSubs.length === 1)
                            );
                            if (hasFile) deliveredCount++;
                          }
                        }

                        const isEntregado = String(r.estado_entrega || '').toLowerCase() === 'entregado';
                        if (isEntregado && deliveredCount === 0) {
                          deliveredCount = totalSubs;
                        }

                        // Determinar badge consolidado (Paleta sobria institucional: verde, dorado, ámbar)
                        let statusText = 'Pendiente';
                        let dotColor = 'var(--dorado-principal)';
                        let badgeStyle = 'background: #fffbeb; color: #b45309; border: 1px solid #fde68a;';

                        if (totalSubs > 1) {
                          if (deliveredCount >= totalSubs) {
                            statusText = 'Entregado';
                            dotColor = '#059669';
                            badgeStyle = 'background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;';
                          } else if (deliveredCount > 0) {
                            statusText = `Parcial (${deliveredCount}/${totalSubs})`;
                            dotColor = '#d97706';
                            badgeStyle = 'background: #fefce8; color: #854d0e; border: 1px solid #fef08a;';
                          } else {
                            statusText = 'Pendiente';
                            dotColor = 'var(--dorado-principal)';
                            badgeStyle = 'background: #fffbeb; color: #b45309; border: 1px solid #fde68a;';
                          }
                        } else {
                          if (isEntregado || deliveredCount > 0) {
                            statusText = 'Entregado';
                            dotColor = '#059669';
                            badgeStyle = 'background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;';
                          } else {
                            statusText = 'Pendiente';
                            dotColor = 'var(--dorado-principal)';
                            badgeStyle = 'background: #fffbeb; color: #b45309; border: 1px solid #fde68a;';
                          }
                        }

                        return (
                          <div style="display: flex; align-items: center; gap: 6px; font-size: 0.74rem;">
                            <span style={`width: 7px; height: 7px; border-radius: 50%; background: ${dotColor}; flex-shrink: 0;`}></span>
                            <span style="color: var(--text-main); font-weight: 600;">{ofiNombre}</span>
                            <span style={`font-size: 0.65rem; padding: 1px 7px; border-radius: 4px; font-weight: 750; ${badgeStyle}`}>
                              {statusText}
                            </span>
                            {cleanObs ? (
                              <span title={`Observación de la oficina: "${cleanObs}"`} style="display: inline-flex; align-items: center; color: #d97706; cursor: help;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                              </span>
                            ) : null}
                          </div>
                        );
                      })}
                    </div>
                  </td>

                  <!-- ACCIONES CON ICONOS SVG VECTORIALES LIMPIOS -->
                  <td style="padding: 12px 8px; text-align: right; white-space: nowrap;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      
                      <!-- Botón Reenviar Correo / Diagnóstico Activo -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-resend-mail" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        title="Reenviar Notificación por Correo a Responsables"
                        style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: #ffffff; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                      </button>

                      <!-- Botón Abrir Carpeta en Gestor de Archivos -->
                      <a 
                        href={`/archivos?radicado=${encodeURIComponent(pet.numero_radicado)}`}
                        class="btn-icon-action btn-abrir-carpeta" 
                        data-radicado={pet.numero_radicado}
                        title="Abrir Carpeta en Gestor de Archivos"
                        style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--verde-borde); background: var(--verde-suave-bg); color: var(--verde-principal); text-decoration: none; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                      </a>

                      <!-- Botón Editar Petición -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-edit-pet" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        data-asunto={pet.asunto}
                        data-solicitante={pet.solicitante_nombre}
                        data-tipo={pet.solicitante_tipo || 'Ciudadano'}
                        data-email={pet.solicitante_email || ''}
                        data-prioridad={pet.prioridad || 'Media'}
                        data-entrega={pet.fecha_limite_entrega}
                        data-estado={pet.estado || 'en_tramite'}
                        data-descripcion={pet.descripcion || ''}
                        title="Editar Petición"
                        style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--dorado-borde); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>

                      <!-- Botón Eliminar Petición -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-delete-pet" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        title="Eliminar Radicado Definitivamente"
                        style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>

                    </div>
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="6" style="text-align: center; padding: 36px; color: var(--text-muted);">
                No hay peticiones registradas aún. Haga clic en "+ Subir Petición" para radicar la primera.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Editar Petición -->
  <div class="modal-backdrop" id="modal-edit-peticion" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="edit-modal-title">Editar Petición Radicada</span>
        </h3>
        <button type="button" id="btn-close-edit-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>

      <form id="form-edit-peticion" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" id="edit-pet-id" />

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Asunto o Título del Trámite *</label>
          <input type="text" id="edit-pet-asunto" required class="form-input" style="font-size: 0.88rem; font-weight: 600;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nombre del Solicitante *</label>
            <input type="text" id="edit-pet-solicitante" required class="form-input" />
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo de Solicitante</label>
            <select id="edit-pet-tipo" class="form-select">
              <option value="Estudiante">Estudiante</option>
              <option value="Docente">Profesor</option>
              <option value="Egresado">Egresado</option>
              <option value="Ciudadano">Ciudadano</option>
              <option value="Ente de Control">Ente de Control</option>
              <option value="Entidad Gubernamental">Entidad Gubernamental</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Prioridad</label>
            <select id="edit-pet-prioridad" class="form-select">
              <option value="Baja">Baja</option>
              <option value="Media">Media</option>
              <option value="Alta">Alta (Vencimiento Urgente)</option>
            </select>
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Estado de Gestión</label>
            <select id="edit-pet-estado" class="form-select">
              <option value="en_tramite">En Trámite</option>
              <option value="respondida">Respondida</option>
              <option value="archivada">Archivada</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha Límite General de Entrega *</label>
          <input type="date" id="edit-pet-entrega" required class="form-input" />
          <small style="font-size: 0.70rem; color: var(--dorado-oscuro); margin-top: 4px; display: block;">
            Al modificar esta fecha, el plazo para las oficinas se recalculará automáticamente (-5 días calendario).
          </small>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 16px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-edit-pet">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-save-edit-pet">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <script>
  import { initPeticiones } from '@scripts/peticiones';
  initPeticiones();
</script>
</AppLayout>
