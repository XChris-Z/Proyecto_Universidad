---
// src/pages/peticiones.astro
export const prerender = false;

// No almacenar en caché para reflejar eliminaciones y cambios al instante
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
import { calculateDeadlineProgress } from '@lib/utils';
import { getDeterministicPin } from '@lib/security';
import { separarRespuestaMeta, esSubcarpetaValida, filtrarSubcarpetasValidas, isPeticionRespondida, isAuditLogOfficialResponse, getSlaBucket } from '@lib/subcarpetas';
import { extractRejectionInfo, sanitizeRevisionTokens } from '@lib/revision-meta';

// 1. Obtener todas las peticiones con select('*') de forma tolerante al esquema (idéntico enfoque seguro a archivos.astro)
const { data: peticionesRaw, error: errPeticiones } = await (supabase
  .from('peticiones' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

let dbPeticionesList: any[] = Array.isArray(peticionesRaw) ? peticionesRaw : [];
if (errPeticiones || !peticionesRaw) {
  const { data: fallbackData } = await (supabase
    .from('peticiones' as any)
    .select('*') as any);
  dbPeticionesList = Array.isArray(fallbackData) ? fallbackData : [];
}

// 2. Consultar oficinas/dependencias, asignaciones, subcarpetas, anexos y logs por separado (cero riesgo de romper el select principal)
const oficinasById: Record<string, any> = {};
try {
  const { data: ofisData } = await (supabase
    .from('oficinas' as any)
    .select('id, codigo, nombre, email_institucional') as any);
  if (Array.isArray(ofisData)) {
    ofisData.forEach((o: any) => {
      if (o?.id) oficinasById[String(o.id)] = o;
    });
  }
} catch {}

const responsablesPorPeticion: Record<string, any[]> = {};
try {
  const { data: respData } = await (supabase
    .from('peticion_responsables' as any)
    .select('*') as any);
  if (Array.isArray(respData)) {
    respData.forEach((r: any) => {
      const petId = String(r?.peticion_id || '').trim();
      if (!petId) return;
      if (!responsablesPorPeticion[petId]) responsablesPorPeticion[petId] = [];
      const ofiResolved = r?.oficinas || (r?.oficina_id ? oficinasById[String(r.oficina_id)] : null) || null;
      responsablesPorPeticion[petId]!.push({
        ...r,
        oficinas: ofiResolved,
      });
    });
  }
} catch {}

let dbSubcarpetas: any[] = [];
try {
  const { data: subsData, error: subsErr } = await (supabase
    .from('peticion_subcarpetas' as any)
    .select('id, peticion_id, nombre, descripcion, created_at')
    .order('created_at', { ascending: true }) as any);
  if (!subsErr && Array.isArray(subsData)) {
    dbSubcarpetas = subsData;
  } else {
    const { data: subsFallback } = await (supabase
      .from('peticion_subcarpetas' as any)
      .select('*') as any);
    if (Array.isArray(subsFallback)) dbSubcarpetas = subsFallback;
  }
} catch {}

let dbAnexos: any[] = [];
const anexosPorPeticion: Record<string, any[]> = {};
try {
  const { data: anexosData } = await (supabase
    .from('peticion_anexos' as any)
    .select('*') as any);
  if (Array.isArray(anexosData)) {
    dbAnexos = anexosData;
    anexosData.forEach((a: any) => {
      const petId = String(a?.peticion_id || '').trim();
      if (!petId) return;
      if (!anexosPorPeticion[petId]) anexosPorPeticion[petId] = [];
      anexosPorPeticion[petId]!.push(a);
    });
  }
} catch {}

let auditRespLogs: any[] = [];
try {
  const { data: auditData } = await (supabase
    .from('audit_logs' as any)
    .select('action, entity_id, details')
    .eq('action_type', 'RESPUESTA')
    .limit(400) as any);
  if (Array.isArray(auditData)) auditRespLogs = auditData;
} catch {}

function computeFallbackOfficeDeadline(fechaEntrega: string | null | undefined): string | null {
  if (!fechaEntrega) return null;
  const parsed = new Date(`${String(fechaEntrega).slice(0, 10)}T12:00:00Z`);
  if (isNaN(parsed.getTime())) return null;
  parsed.setUTCDate(parsed.getUTCDate() - 5);
  return parsed.toISOString().slice(0, 10);
}

const peticionesList = dbPeticionesList.map((p: any) => {
  const petResponsables = responsablesPorPeticion[String(p.id)] || (Array.isArray(p.peticion_responsables) ? p.peticion_responsables : []);
  const petAnexos = anexosPorPeticion[String(p.id)] || (Array.isArray(p.peticion_anexos) ? p.peticion_anexos : []);

  const respObs = petResponsables.find((r: any) => r?.observaciones_entrega?.includes('PIN:'))?.observaciones_entrega;
  const pinMatch = respObs?.match(/PIN:\s*([0-9A-Z]{6})/i);
  const storedPin = pinMatch ? pinMatch[1] : null;

  const { respuestaMeta: metaInstr } = separarRespuestaMeta(p.instrucciones_anexos || '');
  const { respuestaMeta: metaDesc } = separarRespuestaMeta(p.descripcion || '');
  const respuestaMeta = metaInstr || metaDesc || null;
  const cleanAsunto = separarRespuestaMeta(p.asunto || '').textoLimpio || p.asunto || 'Sin asunto';

  const auditMatch = auditRespLogs.some((log: any) => isAuditLogOfficialResponse(log, p));

  const enriched: any = {
    ...p,
    asunto: cleanAsunto,
    fecha_limite_responsable: p.fecha_limite_responsable || computeFallbackOfficeDeadline(p.fecha_limite_entrega),
    respuesta_mensaje: p.respuesta_mensaje ?? respuestaMeta?.msg ?? null,
    respuesta_fecha_envio: p.respuesta_fecha_envio ?? respuestaMeta?.fecha_envio ?? null,
    respuesta_pin_solicitante: p.respuesta_pin_solicitante ?? respuestaMeta?.pin ?? null,
    tiene_respuesta_audit: auditMatch,
    peticion_responsables: petResponsables,
    peticion_anexos: petAnexos,
    pin_acceso: storedPin || p.pin_acceso || respuestaMeta?.pin || getDeterministicPin(p.numero_radicado || p.id),
  };

  return {
    ...enriched,
    respondida: isPeticionRespondida(enriched),
  };
});

let pendientesCount = 0;
let respondidasCount = 0;
let safeCount = 0;
let warnCount = 0;
let criticalCount = 0;

peticionesList.forEach((p: any) => {
  if (isPeticionRespondida(p)) {
    respondidasCount++;
    return;
  }
  pendientesCount++;
  const prog = calculateDeadlineProgress(p.fecha_radicacion || p.created_at, p.fecha_limite_entrega);
  const bucket = getSlaBucket(prog.daysRemaining);
  if (bucket === 'warn') warnCount++;
  else if (bucket === 'critical') criticalCount++;
  else safeCount++;
});

const totalCount = peticionesList.length;
const eficaciaPct = totalCount > 0 ? Math.round((respondidasCount / totalCount) * 100) : 0;
const pctResp = totalCount > 0 ? (respondidasCount / totalCount) * 100 : 0;
const pctSafe = totalCount > 0 ? (safeCount / totalCount) * 100 : 0;
const pctWarn = totalCount > 0 ? (warnCount / totalCount) * 100 : 0;
const pctCrit = totalCount > 0 ? (criticalCount / totalCount) * 100 : 0;

function getPetSlaTone(bucket: string, responded: boolean) {
  if (responded) {
    return {
      bar: '#00594E',
      text: '#00594E',
      badgeBg: '#E6EFEF',
      badgeBorder: '#B2CFCB',
      label: 'Respondida',
    };
  }
  if (bucket === 'critical') {
    return {
      bar: '#DC2626',
      text: '#B91C1C',
      badgeBg: '#FEF2F2',
      badgeBorder: '#FECACA',
      label: 'Crítico / Vencido',
    };
  }
  if (bucket === 'warn') {
    return {
      bar: '#B5A160',
      text: '#786832',
      badgeBg: '#F7F5EE',
      badgeBorder: '#DBD2B0',
      label: 'Próximo a Vencer',
    };
  }
  return {
    bar: '#00594E',
    text: '#00594E',
    badgeBg: '#F2F7F6',
    badgeBorder: '#B2CFCB',
    label: 'Al Día',
  };
}
---

<AppLayout title="Peticiones Radicadas y Expedientes" activeNav="peticiones">
  <!-- Cabecera Bento Ejecutiva UI/UX Pro Max con Chart Element -->
  <section class="peticiones-bento-header" aria-label="Resumen Ejecutivo de Peticiones">
    <div style="display: flex; align-items: flex-start; gap: 14px; flex: 1 1 480px; min-width: 0;">
      <div style="width: 42px; height: 42px; border-radius: 11px; background: #F2F7F6; border: 1px solid #B2CFCB; color: #00594E; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h2 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #111827; letter-spacing: -0.02em;">Control de Peticiones Radicadas</h2>
          <span id="pcount-bento-total" style="background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; font-size: 0.72rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; white-space: nowrap;">{totalCount} radicado(s)</span>
        </div>
        <p style="margin: 3px 0 9px; font-size: 0.8rem; color: #475569; line-height: 1.35;">Seguimiento centralizado de plazos, entregas por dependencia y despacho oficial</p>
        <div style="height: 8px; width: 100%; max-width: 460px; background: #F1F5F9; border-radius: 999px; overflow: hidden; display: flex; gap: 2px;" role="img" aria-label="Distribución de estado de peticiones">
          <div id="chart-seg-resp" style={`width: ${pctResp}%; background: #00594E; transition: width 0.35s ease;`} title={`Respondidas: ${respondidasCount}`}></div>
          <div id="chart-seg-safe" style={`width: ${pctSafe}%; background: #B5A160; transition: width 0.35s ease;`} title={`En Trámite al día: ${safeCount}`}></div>
          <div id="chart-seg-warn" style={`width: ${pctWarn}%; background: #D97706; transition: width 0.35s ease;`} title={`Próximas a Vencer: ${warnCount}`}></div>
          <div id="chart-seg-crit" style={`width: ${pctCrit}%; background: #DC2626; transition: width 0.35s ease;`} title={`Vencidas: ${criticalCount}`}></div>
        </div>
        <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 7px; font-size: 0.73rem; color: #475569; font-weight: 600;">
          <span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #00594E;"></span><strong id="bento-num-resp" style="color: #00594E;">{respondidasCount}</strong> respondidas</span>
          <span style="color: #CBD5E1;">·</span>
          <span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #B5A160;"></span><strong id="bento-num-pend" style="color: #786832;">{pendientesCount}</strong> en trámite</span>
          <span style="color: #CBD5E1;">·</span>
          <span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #D97706;"></span><strong id="bento-num-warn" style="color: #B45309;">{warnCount}</strong> por vencer</span>
          <span style="color: #CBD5E1;">·</span>
          <span style="display: inline-flex; align-items: center; gap: 5px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #DC2626;"></span><strong id="bento-num-crit" style="color: #DC2626;">{criticalCount}</strong> vencidas</span>
        </div>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <div style="background: #F2F7F6; border: 1px solid #B2CFCB; border-radius: 12px; padding: 9px 14px; display: flex; flex-direction: column; align-items: flex-end; min-width: 152px;">
        <span style="font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #00594E;">Tasa de Atención / Eficacia</span>
        <strong id="bento-eficacia-pct" style="font-size: 1.2rem; font-weight: 800; color: #00594E; line-height: 1.15;">{eficaciaPct}%</strong>
        <span id="bento-eficacia-sub" style="font-size: 0.69rem; color: #475569; font-weight: 600;">{respondidasCount} de {totalCount} despachadas</span>
      </div>
      <a href="/peticiones/subir" class="btn-bento-cta" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: #00594E; border: 1px solid #00594E; color: #FFFFFF; font-weight: 700; font-size: 0.82rem; padding: 10px 16px; border-radius: 10px; box-shadow: 0 4px 12px -2px rgba(0, 89, 78, 0.25); transition: all 0.18s ease; white-space: nowrap;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
        <span>Subir Petición</span>
      </a>
    </div>
  </section>

  <div class="section-toolbar peticiones-toolbar-bento" style="margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; width: 100%;">
      <div class="filter-tabs" id="peticiones-filter-tabs">
        <button class="filter-tab active" data-pfilter="all">
          <span>Todas</span>
          <span class="filter-count" id="pcount-all">{peticionesList.length}</span>
        </button>
        <button class="filter-tab" data-pfilter="pendientes">
          <span class="dist-dot" style="background: #786832;"></span>
          <span>En Trámite</span>
          <span class="filter-count" id="pcount-pendientes">{pendientesCount}</span>
        </button>
        <button class="filter-tab" data-pfilter="respondidas">
          <span class="dist-dot" style="background: #00594E;"></span>
          <span>Respondidas</span>
          <span class="filter-count" id="pcount-respondidas">{respondidasCount}</span>
        </button>
        <button class="filter-tab" data-pfilter="warn">
          <span class="dist-dot" style="background: #D97706;"></span>
          <span>Próximas a Vencer</span>
          <span class="filter-count" id="pcount-warn">{warnCount}</span>
        </button>
        <button class="filter-tab" data-pfilter="critical">
          <span class="dist-dot" style="background: #DC2626;"></span>
          <span>Vencidas</span>
          <span class="filter-count" id="pcount-critical">{criticalCount}</span>
        </button>
      </div>

      <!-- Buscador en tiempo real de Peticiones -->
      <div style="position: relative; min-width: 295px; flex: 1; max-width: 380px;">
        <input type="text" id="peticiones-search-input" placeholder="Buscar radicado, solicitante, asunto..." class="form-input" style="padding-left: 34px; height: 38px; font-size: 0.82rem; width: 100%;" />
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 11px; top: 12px; color: var(--text-muted);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
    </div>
  </div>

  <!-- Vista Principal: Tabla de Radicados con Semáforo SLA y Acciones Globales -->
  <div class="card" style="padding: 20px; background: #ffffff; border: 1px solid #DCE4E3; border-radius: var(--radius-md); box-shadow: 0 4px 16px -6px rgba(15, 23, 42, 0.05);">
    <div class="table-responsive pro-scroll-container table-scroll-wrapper" style="max-height: 540px; overflow-y: auto; overflow-x: auto; border-radius: 12px;">
      <table class="doc-table" id="tabla-peticiones" style="width: 100%; border-collapse: collapse;">
        <thead style="position: sticky; top: 0; z-index: 10;">
          <tr style="border-bottom: 1px solid #DCE4E3; text-align: left; color: #475569; font-size: 0.74rem; text-transform: uppercase;">
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Radicado / Asunto</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Peticionario</th>
            <th style="padding: 12px 10px; min-width: 190px; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Fecha de Expiración</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Límite Oficinas (-5 Días)</th>
            <th style="padding: 12px 10px; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Oficinas Responsables</th>
            <th style="padding: 12px 10px; text-align: right; position: sticky; top: 0; z-index: 10; background: #F8FAFC; border-bottom: 1px solid #DCE4E3;">Acciones</th>
          </tr>
        </thead>
        <tbody id="peticiones-table-body">
          {peticionesList.length > 0 ? (
            peticionesList.map((pet: any) => {
              const responsables = pet.peticion_responsables || [];
              const prog = calculateDeadlineProgress(pet.fecha_radicacion || pet.created_at, pet.fecha_limite_entrega);
              const isResponded = isPeticionRespondida(pet);
              const { respuestaMeta: rowMeta } = separarRespuestaMeta(pet.instrucciones_anexos || '');
              const rowProrrogas = Array.isArray(rowMeta?.prorrogas) ? rowMeta.prorrogas : [];
              const slaBucket = isResponded ? 'safe' : getSlaBucket(prog.daysRemaining);
              const slaTone = getPetSlaTone(slaBucket, isResponded);
              const barPct = isResponded ? 100 : prog.percentage;
              const slaMetaText = isResponded
                ? 'Expediente Completo'
                : (prog.daysRemaining > 0 ? `${prog.daysRemaining} días restantes` : 'Término expirado');

              return (
                <tr id={`row-pet-${pet.id}`} class="peticion-row" data-estado={pet.estado} data-responded={isResponded ? 'true' : 'false'} data-sla={slaBucket} style="border-bottom: 1px solid #DCE4E3; font-size: 0.84rem;">
                  <td style="padding: 12px 8px;">
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                      <a 
                        href={`/archivos?radicado=${encodeURIComponent(pet.numero_radicado)}`}
                        class="btn-abrir-carpeta"
                        data-radicado={pet.numero_radicado}
                        title="Abrir Carpeta de este Radicado en Gestor de Archivos"
                        style="text-decoration: none; font-family: monospace; font-size: 0.86rem; font-weight: 800; color: #00594E; background: #F2F7F6; padding: 3px 8px; border-radius: 6px; border: 1px solid #B2CFCB; display: inline-flex; align-items: center; gap: 4px; transition: all 0.15s ease;"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        <span>{pet.numero_radicado}</span>
                      </a>
                      <span style={`font-size: 0.65rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; text-transform: uppercase; border: 1px solid; ${pet.prioridad === 'Alta' ? 'background: #FEF2F2; color: #B91C1C; border-color: #FECACA;' : 'background: #F7F5EE; color: #786832; border-color: #DBD2B0;'}`}>
                        {pet.prioridad || 'Media'}
                      </span>
                      <div style="display: inline-flex; align-items: center; gap: 5px; background: #F7F5EE; border: 1px solid #DBD2B0; padding: 2px 7px; border-radius: 5px; white-space: nowrap;" title="PIN Criptográfico de Acceso (6 dígitos)">
                        <span style="font-size: 0.65rem; font-weight: 700; color: #786832;">PIN:</span>
                        <span style="font-family: monospace; font-size: 0.72rem; font-weight: 800; color: #00594E;">{pet.pin_acceso || '849201'}</span>
                        <button 
                          type="button" 
                          class="btn-copy-pin"
                          data-pin={pet.pin_acceso || '849201'}
                          title="Copiar PIN" 
                          style="border: none; background: transparent; cursor: pointer; color: #786832; padding: 0; display: inline-flex; align-items: center;"
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                      </div>
                    </div>
                    <div class="pet-asunto-text" style="font-weight: 700; color: #111827; margin-top: 5px;">
                      {pet.asunto}
                    </div>
                  </td>

                  <td style="padding: 12px 8px;">
                    <div class="pet-solicitante-text" style="font-weight: 600; color: #111827;">{pet.solicitante_nombre}</div>
                    <div style="font-size: 0.72rem; color: #64748B;">{pet.solicitante_tipo === 'Docente' ? 'Profesor' : (pet.solicitante_tipo || 'Ciudadano')}</div>
                  </td>

                  <!-- Columna Chart Element: Fecha de Expiración -->
                  <td style="padding: 12px 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 0.76rem; gap: 6px;">
                      <span style="font-weight: 700; color: #111827;">{pet.fecha_limite_entrega || 'Por definir'}</span>
                      <span style={`font-weight: 800; font-size: 0.68rem; padding: 2px 7px; border-radius: 5px; border: 1px solid ${slaTone.badgeBorder}; background: ${slaTone.badgeBg}; color: ${slaTone.text}; white-space: nowrap;`}>
                        {slaTone.label}
                      </span>
                    </div>
                    <div style="width: 100%; height: 7px; background: #F1F5F9; border-radius: 9999px; overflow: hidden; border: 1px solid #DCE4E3;">
                      <div style={`width: ${barPct}%; height: 100%; background: ${slaTone.bar}; transition: width 0.3s ease; border-radius: 9999px;`}></div>
                    </div>
                    <div style="font-size: 0.68rem; color: #64748B; margin-top: 3px; display: flex; justify-content: space-between;">
                      <span>{isResponded ? 'Completado: 100%' : `Consumido: ${barPct}%`}</span>
                      <span style={isResponded ? 'color: #00594E; font-weight: 700;' : ''}>{slaMetaText}</span>
                    </div>
                  </td>

                  <td style="padding: 12px 8px;">
                    <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-start;">
                      <span style="color: #786832; font-weight: 800; background: #F7F5EE; padding: 3px 8px; border-radius: 5px; border: 1px solid #DBD2B0; font-family: monospace; font-size: 0.8rem;">
                        {pet.fecha_limite_responsable ? String(pet.fecha_limite_responsable).slice(0, 10) : 'Por definir'}
                      </span>
                      {rowProrrogas.length > 0 && (
                        <span
                          title={rowProrrogas[rowProrrogas.length - 1]?.motivo || 'Prórroga registrada'}
                          style="font-size: 0.66rem; font-weight: 800; color: #786832; background: #F7F5EE; border: 1px solid #B5A160; padding: 1px 6px; border-radius: 4px; display: inline-flex; align-items: center; gap: 3px;"
                        >
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <span>+{rowProrrogas.length} Prórroga</span>
                        </span>
                      )}
                    </div>
                  </td>

                  <td style="padding: 12px 8px;">
                    <div style="display: flex; flex-direction: column; gap: 5px;">
                      {responsables.length > 0 ? responsables.map((r: any) => {
                        const ofiNombre = r.oficinas?.nombre || 'Oficina';
                        let petSubs = filtrarSubcarpetasValidas(dbSubcarpetas.filter((s: any) => s.peticion_id === pet.id));
                        const rawObs = r.observaciones_entrega || '';
                        const rejectionInfo = extractRejectionInfo(rawObs);
                        const obsWithoutRev = sanitizeRevisionTokens(rawObs).replace(/\[RECHAZADO[^\]]*\]:?[^|]*/gi, '').trim();
                        const { textoLimpio } = separarRespuestaMeta(obsWithoutRev);
                        const cleanObs = textoLimpio.replace(/^PIN:\s*[0-9A-Z]{6}(\s*\|\s*)?/i, '').trim();

                        // Si no hay subcarpetas físicas registradas en la tabla, inferir desde observaciones y anexos
                        if (petSubs.length === 0) {
                          const foundMap: any = {};
                          const matches = cleanObs.matchAll(/\[([a-zA-Z0-9_\-\s]+)\]/g);
                          for (const m of matches) {
                            const name = String(m?.[1] || '').trim();
                            if (name && esSubcarpetaValida(name) && !foundMap[name.toUpperCase()]) {
                              foundMap[name.toUpperCase()] = { id: `inf-${pet.id}-${name}`, nombre: name, peticion_id: pet.id };
                            }
                          }
                          (dbAnexos || []).filter((a: any) => a.peticion_id === pet.id && !String(a.nombre_archivo || '').toUpperCase().includes('[RECHAZADO]')).forEach((a: any) => {
                            const fm = (a.nombre_archivo || '').match(/\[([a-zA-Z0-9_\-\s]+)\]/i);
                            if (fm && fm[1]) {
                              const name = String(fm[1] || '').trim();
                              if (name && esSubcarpetaValida(name) && !foundMap[name.toUpperCase()]) {
                                foundMap[name.toUpperCase()] = { id: `inf-${pet.id}-${name}`, nombre: name, peticion_id: pet.id };
                              }
                            }
                          });
                          petSubs = filtrarSubcarpetasValidas(Object.values(foundMap));
                        }

                        // Calcular subcarpetas asignadas a esta oficina
                        const assignedSubs = petSubs.filter((s: any) => 
                          (r.subcarpeta_id && r.subcarpeta_id === s.id) || 
                          rawObs.includes(`[${s.nombre}]`) || 
                          petSubs.length === 1
                        );
                        const totalSubs = assignedSubs.length > 0 ? assignedSubs.length : (petSubs.length > 0 ? petSubs.length : 1);

                        // Contar entregas verificadas por archivo válido (no rechazado) o estado
                        let deliveredCount = 0;
                        if (assignedSubs.length > 0) {
                          for (const asub of assignedSubs) {
                            const subSlug = (asub.nombre || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
                            const hasFile = dbAnexos.some((a: any) => 
                              !String(a.nombre_archivo || '').toUpperCase().includes('[RECHAZADO]') &&
                              a.peticion_responsable_id === r.id && 
                              ((a.subcarpeta_id && a.subcarpeta_id === asub.id) || 
                               (a.nombre_archivo && a.nombre_archivo.includes(`[${asub.nombre}]`)) || 
                               (subSlug && a.storage_path && a.storage_path.toLowerCase().includes(`/${subSlug}/`)) || 
                               petSubs.length === 1)
                            );
                            if (hasFile) deliveredCount++;
                          }
                        }

                        const isEntregado = !rejectionInfo && String(r.estado_entrega || '').toLowerCase() === 'entregado';
                        if (isEntregado && deliveredCount === 0) {
                          deliveredCount = totalSubs;
                        }

                        // Paleta estricta Unitrópico: Verde (#00594E) Entregado, Dorado (#B5A160/#786832) Parcial, Rojo (#DC2626) Pendiente
                        let statusText = rejectionInfo ? 'Devuelto' : 'Pendiente';
                        let dotColor = '#DC2626';
                        let badgeStyle = 'background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA;';

                        if (totalSubs > 1) {
                          if (deliveredCount >= totalSubs) {
                            statusText = 'Entregado';
                            dotColor = '#00594E';
                            badgeStyle = 'background: #E6F4EA; color: #00594E; border: 1px solid #B2CFCB;';
                          } else if (deliveredCount > 0) {
                            statusText = `Parcial (${deliveredCount}/${totalSubs})`;
                            dotColor = '#B5A160';
                            badgeStyle = 'background: #F7F5EE; color: #786832; border: 1px solid #B5A160;';
                          }
                        } else if (isEntregado || deliveredCount > 0) {
                          statusText = 'Entregado';
                          dotColor = '#00594E';
                          badgeStyle = 'background: #E6F4EA; color: #00594E; border: 1px solid #B2CFCB;';
                        }

                        const isPendingInteractive = statusText !== 'Entregado';
                        const pillTooltip = isPendingInteractive
                          ? 'Clic para reenviar notificación y credenciales a esta dependencia'
                          : (cleanObs ? `Observación de ${ofiNombre}: "${cleanObs}"` : `${ofiNombre} · Entregado`);

                        if (isPendingInteractive) {
                          return (
                            <button
                              type="button"
                              class="btn-resend-single-dep"
                              data-peticion-id={pet.id}
                              data-radicado={pet.numero_radicado}
                              data-asignacion-id={r.id}
                              data-responsable-id={r.id}
                              data-dependencia-nombre={ofiNombre}
                              data-oficina={ofiNombre}
                              data-correo={r.oficinas?.email_institucional || ''}
                              title={pillTooltip}
                              style={`display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 0.73rem; line-height: 1.25; max-width: 100%; cursor: pointer; font-family: inherit; transition: all 0.18s ease; ${badgeStyle}`}
                            >
                              <span style={`width: 7px; height: 7px; border-radius: 50%; background: ${dotColor}; flex-shrink: 0;`}></span>
                              <span style="font-weight: 700; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{ofiNombre}</span>
                              <span style="font-size: 0.67rem; font-weight: 800; white-space: nowrap; opacity: 0.92;">· {statusText}</span>
                              <svg class="dep-mail-hover-ico" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="flex-shrink: 0; opacity: 0.65; transition: opacity 0.18s ease, transform 0.18s ease;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </button>
                          );
                        }

                        return (
                          <div
                            title={pillTooltip}
                            style={`display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 0.73rem; line-height: 1.25; max-width: 100%; ${cleanObs ? 'cursor: help;' : ''} ${badgeStyle}`}
                          >
                            <span style={`width: 7px; height: 7px; border-radius: 50%; background: ${dotColor}; flex-shrink: 0;`}></span>
                            <span style="font-weight: 700; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{ofiNombre}</span>
                            <span style="font-size: 0.67rem; font-weight: 800; white-space: nowrap; opacity: 0.92;">· {statusText}</span>
                          </div>
                        );
                      }) : (
                        <span style="font-size: 0.74rem; color: #64748B; font-style: italic;">Sin dependencias asignadas</span>
                      )}
                    </div>
                  </td>

                  <!-- ACCIONES CON ICONOS SVG VECTORIALES LIMPIOS -->
                  <td style="padding: 12px 8px; text-align: right; white-space: nowrap;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      
                      <!-- Botón + Prórroga -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-action-prorroga btn-open-prorroga" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        data-entrega={pet.fecha_limite_entrega ? String(pet.fecha_limite_entrega).slice(0, 10) : ''}
                        data-responsable={pet.fecha_limite_responsable ? String(pet.fecha_limite_responsable).slice(0, 10) : ''}
                        title="Registrar Prórroga Auditada"
                        style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #DBD2B0; background: #F7F5EE; color: #786832; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.18s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
                      </button>

                      <!-- Botón Abrir Carpeta en Gestor de Archivos -->
                      <a 
                        href={`/archivos?radicado=${encodeURIComponent(pet.numero_radicado)}`}
                        class="btn-icon-action btn-action-folder btn-abrir-carpeta" 
                        data-radicado={pet.numero_radicado}
                        title="Abrir Carpeta en Gestor de Archivos"
                        style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #B2CFCB; background: #F2F7F6; color: #00594E; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: all 0.18s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                      </a>

                      <!-- Botón Editar Petición -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-action-edit btn-edit-pet" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        data-asunto={pet.asunto}
                        data-solicitante={pet.solicitante_nombre}
                        data-tipo={pet.solicitante_tipo || 'Ciudadano'}
                        data-email={pet.solicitante_email || ''}
                        data-prioridad={pet.prioridad || 'Alta'}
                        data-entrega={pet.fecha_limite_entrega ? String(pet.fecha_limite_entrega).slice(0, 10) : ''}
                        data-responsable={pet.fecha_limite_responsable ? String(pet.fecha_limite_responsable).slice(0, 10) : ''}
                        data-estado={pet.estado || 'en_tramite'}
                        data-descripcion={separarRespuestaMeta(pet.descripcion || '').textoLimpio}
                        title="Editar Petición"
                        style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #DBD2B0; background: #F7F5EE; color: #786832; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.18s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>

                      <!-- Botón Eliminar Petición -->
                      <button 
                        type="button" 
                        class="btn-icon-action btn-action-delete btn-delete-pet" 
                        data-id={pet.id} 
                        data-radicado={pet.numero_radicado}
                        title="Eliminar Radicado Definitivamente"
                        style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.18s ease;"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>

                    </div>
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="6" style="text-align: center; padding: 36px; color: var(--text-muted);">
                No hay peticiones registradas aún. Haga clic en "+ Subir Petición" para radicar la primera.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal: Editar Petición -->
  <div class="modal-backdrop" id="modal-edit-peticion" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="edit-modal-title">Editar Petición Radicada</span>
        </h3>
        <button type="button" id="btn-close-edit-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>

      <form id="form-edit-peticion" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" id="edit-pet-id" />

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Asunto o Título del Trámite *</label>
          <input type="text" id="edit-pet-asunto" required class="form-input" style="font-size: 0.88rem; font-weight: 600;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nombre del Solicitante *</label>
            <input type="text" id="edit-pet-solicitante" required class="form-input" />
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo de Solicitante</label>
            <select id="edit-pet-tipo" class="form-select">
              <option value="Estudiante">Estudiante</option>
              <option value="Docente">Profesor</option>
              <option value="Egresado">Egresado</option>
              <option value="Ciudadano">Ciudadano</option>
              <option value="Ente de Control">Ente de Control</option>
              <option value="Entidad Gubernamental">Entidad Gubernamental</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Prioridad</label>
            <select id="edit-pet-prioridad" class="form-select">
              <option value="Baja">Baja</option>
              <option value="Media">Media</option>
              <option value="Alta">Alta</option>
            </select>
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Estado de Gestión</label>
            <select id="edit-pet-estado" class="form-select">
              <option value="en_tramite">En Trámite</option>
              <option value="respondida">Expediente Completo / Respondida</option>
              <option value="archivada">Archivada</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha Límite General de Entrega *</label>
            <input type="date" id="edit-pet-entrega" required class="form-input" />
          </div>
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--dorado-oscuro); text-transform: uppercase;">Plazo Oficinas Responsables</label>
            <input type="date" id="edit-pet-responsable" class="form-input" />
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 16px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-edit-pet">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-save-edit-pet">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Registrar Prórroga Auditada -->
  <div class="modal-backdrop" id="modal-prorroga" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2050; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 560px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden; border: 1.5px solid #B5A160;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 16px 22px; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #B5A160;">
        <div>
          <h3 style="font-size: 1rem; font-weight: 800; margin: 0;">Registrar Prórroga de Plazo</h3>
          <span style="font-size: 0.72rem; color: rgba(255,255,255,0.85);">Ampliación manual con registro antes/después en Auditoría</span>
        </div>
        <button type="button" id="btn-close-prorroga-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>
      <form id="form-prorroga" style="padding: 20px 22px; display: flex; flex-direction: column; gap: 14px;">
        <input type="hidden" id="prorroga-pet-id" />
        <div style="background: #F2F7F6; border: 1px solid #B2CFCB; border-radius: 8px; padding: 10px 14px; font-size: 0.80rem; color: #00594E; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <span>Radicado: <strong id="prorroga-disp-radicado" style="font-family: monospace;">RAD-2026</strong></span>
          <span id="prorroga-disp-actual" style="font-size: 0.74rem; font-weight: 700; color: #475569;">Plazo actual: --</span>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label for="prorroga-nueva-entrega" style="font-size: 0.74rem; font-weight: 800; color: #334155; text-transform: uppercase;">Nueva Fecha Límite General *</label>
            <input type="date" id="prorroga-nueva-entrega" required class="form-input" />
          </div>
          <div class="form-group">
            <label for="prorroga-nueva-resp" style="font-size: 0.74rem; font-weight: 800; color: #786832; text-transform: uppercase;">Nuevo Límite Dependencias</label>
            <input type="date" id="prorroga-nueva-resp" class="form-input" />
          </div>
        </div>
        <div class="form-group">
          <label for="prorroga-motivo" style="font-size: 0.74rem; font-weight: 800; color: #334155; text-transform: uppercase;">Motivo de la Prórroga *</label>
          <textarea id="prorroga-motivo" rows="3" required class="form-input" placeholder="Indique el motivo de la ampliación de plazo..." style="font-size: 0.84rem; resize: vertical;"></textarea>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #E2E8F0; padding-top: 12px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-prorroga">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-save-prorroga" style="border-bottom: 2px solid #B5A160;">Guardar Prórroga</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // 1. FILTRO DE PESTAÑAS CROSSFADE Y BUSCADOR EN TIEMPO REAL
    const filterButtons = document.querySelectorAll('#peticiones-filter-tabs .filter-tab');
    const tableBody = document.getElementById('peticiones-table-body') as HTMLElement | null;
    const searchInput = document.getElementById('peticiones-search-input') as HTMLInputElement | null;
    let currentFilterMode = 'all';

    function updatePeticionesCounts() {
      const rows = document.querySelectorAll<HTMLTableRowElement>('#tabla-peticiones tbody tr[id^="row-pet-"]');
      let all = 0;
      let pendientes = 0;
      let respondidas = 0;
      let safe = 0;
      let warn = 0;
      let critical = 0;
      rows.forEach((row) => {
        all++;
        const isResponded = row.getAttribute('data-responded') === 'true';
        const sla = row.getAttribute('data-sla') || 'safe';
        if (isResponded) {
          respondidas++;
        } else {
          pendientes++;
          if (sla === 'warn') warn++;
          else if (sla === 'critical') critical++;
          else safe++;
        }
      });
      const setCount = (id: string, val: number) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };
      setCount('pcount-all', all);
      setCount('pcount-pendientes', pendientes);
      setCount('pcount-respondidas', respondidas);
      setCount('pcount-warn', warn);
      setCount('pcount-critical', critical);

      // Sincronizar cabecera Bento y Chart Element
      setCount('bento-num-resp', respondidas);
      setCount('bento-num-pend', pendientes);
      setCount('bento-num-warn', warn);
      setCount('bento-num-crit', critical);

      const bentoTotal = document.getElementById('pcount-bento-total');
      if (bentoTotal) bentoTotal.textContent = `${all} radicado(s)`;

      const eficPct = all > 0 ? Math.round((respondidas / all) * 100) : 0;
      const eficEl = document.getElementById('bento-eficacia-pct');
      if (eficEl) eficEl.textContent = `${eficPct}%`;
      const eficSubEl = document.getElementById('bento-eficacia-sub');
      if (eficSubEl) eficSubEl.textContent = `${respondidas} de ${all} despachadas`;

      const setSegWidth = (id: string, count: number) => {
        const seg = document.getElementById(id);
        if (seg) seg.style.width = `${all > 0 ? (count / all) * 100 : 0}%`;
      };
      setSegWidth('chart-seg-resp', respondidas);
      setSegWidth('chart-seg-safe', safe);
      setSegWidth('chart-seg-warn', warn);
      setSegWidth('chart-seg-crit', critical);
    }

    function applyPeticionesFilters(useCrossfade = false) {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll<HTMLTableRowElement>('#tabla-peticiones tbody tr[id^="row-pet-"]');

      rows.forEach((row) => {
        const isResponded = row.getAttribute('data-responded') === 'true';
        const sla = row.getAttribute('data-sla') || 'safe';
        let matchesTab = true;
        if (currentFilterMode === 'pendientes') matchesTab = !isResponded;
        else if (currentFilterMode === 'respondidas') matchesTab = isResponded;
        else if (currentFilterMode === 'warn') matchesTab = !isResponded && sla === 'warn';
        else if (currentFilterMode === 'critical') matchesTab = !isResponded && sla === 'critical';

        const text = row.textContent?.toLowerCase() || '';
        const matchesQ = !q || text.includes(q);
        const visible = matchesTab && matchesQ;
        row.style.display = visible ? 'table-row' : 'none';

        row.classList.remove('is-crossfade');
        if (visible && useCrossfade) {
          void row.offsetWidth;
          row.classList.add('is-crossfade');
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterMode = btn.getAttribute('data-pfilter') || 'all';
        applyPeticionesFilters(true);
      });
    });

    searchInput?.addEventListener('input', () => applyPeticionesFilters(false));

    // 2. MODAL DE EDICIÓN Y MODAL DE PRÓRROGA
    const editModal = document.getElementById('modal-edit-peticion');
    const editTitle = document.getElementById('edit-modal-title');
    const inputId = document.getElementById('edit-pet-id') as HTMLInputElement;
    const inputAsunto = document.getElementById('edit-pet-asunto') as HTMLInputElement;
    const inputSolicitante = document.getElementById('edit-pet-solicitante') as HTMLInputElement;
    const selectTipo = document.getElementById('edit-pet-tipo') as HTMLSelectElement;
    const selectPrioridad = document.getElementById('edit-pet-prioridad') as HTMLSelectElement;
    const selectEstado = document.getElementById('edit-pet-estado') as HTMLSelectElement;
    const inputEntrega = document.getElementById('edit-pet-entrega') as HTMLInputElement;
    const inputResponsable = document.getElementById('edit-pet-responsable') as HTMLInputElement;
    const formEdit = document.getElementById('form-edit-peticion') as HTMLFormElement;

    const closeEdit = () => { if (editModal) editModal.style.display = 'none'; };
    document.getElementById('btn-close-edit-modal')?.addEventListener('click', closeEdit);
    document.getElementById('btn-cancel-edit-pet')?.addEventListener('click', closeEdit);

    const prorrogaModal = document.getElementById('modal-prorroga');
    const inputProrrogaId = document.getElementById('prorroga-pet-id') as HTMLInputElement | null;
    const dispProrrogaRadicado = document.getElementById('prorroga-disp-radicado');
    const dispProrrogaActual = document.getElementById('prorroga-disp-actual');
    const inputProrrogaEntrega = document.getElementById('prorroga-nueva-entrega') as HTMLInputElement | null;
    const inputProrrogaResp = document.getElementById('prorroga-nueva-resp') as HTMLInputElement | null;
    const inputProrrogaMotivo = document.getElementById('prorroga-motivo') as HTMLTextAreaElement | null;
    const formProrroga = document.getElementById('form-prorroga') as HTMLFormElement | null;
    const btnSaveProrroga = document.getElementById('btn-save-prorroga') as HTMLButtonElement | null;

    const closeProrroga = () => {
      if (prorrogaModal) prorrogaModal.style.display = 'none';
      if (formProrroga) formProrroga.reset();
    };
    document.getElementById('btn-close-prorroga-modal')?.addEventListener('click', closeProrroga);
    document.getElementById('btn-cancel-prorroga')?.addEventListener('click', closeProrroga);
    prorrogaModal?.addEventListener('click', (e) => {
      if (e.target === prorrogaModal) closeProrroga();
    });

    // 3. DELEGACIÓN GLOBAL DE ACCIONES (Abrir Carpeta, Editar, Eliminar y Reenviar)
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // A. Botón Copiar PIN con Toast institucional
      const copyPinBtn = target.closest('.btn-copy-pin') as HTMLElement | null;
      if (copyPinBtn) {
        e.preventDefault();
        e.stopPropagation();
        const pin = copyPinBtn.getAttribute('data-pin') || '849201';
        try {
          if (navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(pin);
          }
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast(`PIN de acceso ${pin} copiado al portapapeles.`, 'info');
          }
        } catch {}
        return;
      }

      // B. Botón Abrir Carpeta
      const abrirBtn = target.closest('.btn-abrir-carpeta') as HTMLAnchorElement | null;
      if (abrirBtn && abrirBtn.href) {
        // Permitir la navegación natural inmediata al módulo de archivos
        return;
      }

      // A2. Botón Reenviar Correo Individual a Dependencia Pendiente/Parcial
      const singleDepBtn = target.closest('.btn-resend-single-dep') as HTMLButtonElement | null;
      if (singleDepBtn) {
        e.preventDefault();
        e.stopPropagation();
        const peticionId = singleDepBtn.dataset.peticionId || '';
        const asignacionId = singleDepBtn.dataset.asignacionId || singleDepBtn.dataset.responsableId || '';
        const oficina = singleDepBtn.dataset.dependenciaNombre || singleDepBtn.dataset.oficina || 'Dependencia';
        const radicado = singleDepBtn.dataset.radicado || '';
        const correo = singleDepBtn.dataset.correo || '';
        if (!peticionId && !radicado && !asignacionId) return;

        singleDepBtn.disabled = true;
        const origHtml = singleDepBtn.innerHTML;
        singleDepBtn.style.opacity = '0.7';
        singleDepBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg><span>Enviando...</span>`;

        try {
          const res = await fetch('/api/enviar-correo-peticion', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              peticion_id: peticionId,
              radicado,
              responsable_id: asignacionId,
              asignacion_id: asignacionId,
              dependencia_nombre: oficina,
              correo,
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            (window as any).showToast(
              data.error || `No se pudo notificar a ${oficina}.`,
              'error',
              `Reenvío ${radicado}`
            );
          } else {
            (window as any).showToast(
              data.message || `Notificación enviada únicamente a ${oficina}.`,
              'success',
              `Recordatorio a ${oficina}`
            );
          }
        } catch {
          (window as any).showToast(`Error de red intentando notificar a ${oficina}.`, 'error');
        } finally {
          singleDepBtn.disabled = false;
          singleDepBtn.style.opacity = '';
          singleDepBtn.innerHTML = origHtml;
        }
        return;
      }

      // A3. Botón Abrir Modal de Prórroga
      const prorrogaBtn = target.closest('.btn-open-prorroga') as HTMLElement | null;
      if (prorrogaBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = prorrogaBtn.dataset.id || '';
        const radicado = prorrogaBtn.dataset.radicado || '';
        const entrega = prorrogaBtn.dataset.entrega || '';
        const responsable = prorrogaBtn.dataset.responsable || '';

        if (inputProrrogaId) inputProrrogaId.value = id;
        if (dispProrrogaRadicado) dispProrrogaRadicado.textContent = radicado;
        if (dispProrrogaActual) dispProrrogaActual.textContent = `Plazo actual: ${entrega || '--'}`;
        if (inputProrrogaEntrega) inputProrrogaEntrega.value = entrega;
        if (inputProrrogaResp) inputProrrogaResp.value = responsable;
        if (inputProrrogaMotivo) inputProrrogaMotivo.value = '';
        if (prorrogaModal) prorrogaModal.style.display = 'flex';
        return;
      }

      // B. Botón Editar
      const editBtn = target.closest('.btn-edit-pet') as HTMLElement | null;
      if (editBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = editBtn.dataset.id || '';
        const radicado = editBtn.dataset.radicado || '';
        const asunto = editBtn.dataset.asunto || '';
        const solicitante = editBtn.dataset.solicitante || '';
        const tipo = editBtn.dataset.tipo || 'Ciudadano';
        const prioridad = editBtn.dataset.prioridad || 'Alta';
        const estado = editBtn.dataset.estado || 'en_tramite';
        const entrega = editBtn.dataset.entrega || '';
        const responsable = editBtn.dataset.responsable || '';

        if (editTitle) editTitle.textContent = `Editar Radicado ${radicado}`;
        if (inputId) inputId.value = id;
        if (inputAsunto) inputAsunto.value = asunto;
        if (inputSolicitante) inputSolicitante.value = solicitante;
        if (selectTipo) selectTipo.value = tipo;
        if (selectPrioridad) selectPrioridad.value = prioridad;
        if (selectEstado) selectEstado.value = estado;
        if (inputEntrega) inputEntrega.value = entrega;
        if (inputResponsable) inputResponsable.value = responsable;

        if (editModal) editModal.style.display = 'flex';
        return;
      }

      // C. Botón Eliminar
      const deleteBtn = target.closest('.btn-delete-pet') as HTMLElement | null;
      if (deleteBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = deleteBtn.dataset.id;
        const radicado = deleteBtn.dataset.radicado;
        if (!id) return;

        const confirmed = typeof (window as any).showConfirm === 'function'
          ? await (window as any).showConfirm(
              `¿Está seguro de que desea eliminar definitivamente el radicado ${radicado}?\n\nEsta acción purgará los registros de oficinas asignadas, archivos en el repositorio y registrará el evento de eliminación en la Auditoría institucional.`,
              'Confirmar Eliminación'
            )
          : true;
        if (!confirmed) return;

        deleteBtn.setAttribute('disabled', 'true');

        try {
          const res = await fetch('/api/peticiones/eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            (window as any).showToast('Error al eliminar: ' + (data.error || 'No se pudo procesar la eliminación'), 'error');
            deleteBtn.removeAttribute('disabled');
            return;
          }

          const row = document.getElementById(`row-pet-${id}`);
          if (row) {
            row.style.transition = 'opacity 0.25s ease';
            row.style.opacity = '0';
            setTimeout(() => {
              row.remove();
              updatePeticionesCounts();
            }, 260);
          } else {
            updatePeticionesCounts();
          }

          (window as any).showToast(`El radicado ${radicado} ha sido eliminado satisfactoriamente.`, 'success');
        } catch (err: any) {
          (window as any).showToast('Error al comunicarse con el servidor para la eliminación.', 'error');
          deleteBtn.removeAttribute('disabled');
        }
        return;
      }

      // D. Botón Reenviar Correo SMTP
      const resendBtn = target.closest('.btn-resend-mail') as HTMLButtonElement | null;
      if (resendBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = resendBtn.dataset.id;
        const radicado = resendBtn.dataset.radicado;
        if (!id) return;

        resendBtn.disabled = true;
        const originalContent = resendBtn.innerHTML;
        resendBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>`;

        try {
          const res = await fetch('/api/peticiones/reenviar-correo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            (window as any).showToast(
              `Fallo en el envío SMTP para ${radicado}: ${data.error || 'No se pudo conectar con el servidor de correo'}`,
              'error',
              'Diagnóstico SMTP'
            );
          } else {
            (window as any).showToast(
              data.message || `Notificación enviada a dependencias pendientes de ${radicado}.`,
              'success',
              'Despacho a Pendientes'
            );
          }
        } catch (err: any) {
          (window as any).showToast('Error de red al intentar conectar con el servicio de correo.', 'error');
        } finally {
          resendBtn.disabled = false;
          resendBtn.innerHTML = originalContent;
        }
        return;
      }
    });

    formProrroga?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inputProrrogaId?.value || !inputProrrogaEntrega?.value) return;
      const motivo = inputProrrogaMotivo?.value.trim() || '';
      if (!motivo) {
        (window as any).showToast('Debe indicar el motivo oficial de la prórroga.', 'warning');
        return;
      }

      if (btnSaveProrroga) {
        btnSaveProrroga.disabled = true;
        btnSaveProrroga.textContent = 'Guardando prórroga...';
      }

      try {
        const res = await fetch('/api/peticiones/prorroga', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            peticion_id: inputProrrogaId.value,
            nueva_fecha_entrega: inputProrrogaEntrega.value,
            nueva_fecha_responsable: inputProrrogaResp?.value || undefined,
            motivo,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          (window as any).showToast(data.error || 'No se pudo registrar la prórroga.', 'error');
          return;
        }
        closeProrroga();
        const prorrogaId = inputProrrogaId.value;
        const row = document.querySelector(`tr[data-id="${prorrogaId}"]`);
        if (row && data.nueva_fecha_entrega) {
          const dateCell = row.querySelector('.pet-delivery-deadline');
          if (dateCell) dateCell.textContent = data.nueva_fecha_entrega;
        }
        (window as any).showToast(
          data.message || 'Prórroga registrada con trazabilidad en Auditoría.',
          'success',
          'Plazo Ampliado'
        );
      } catch {
        (window as any).showToast('Error de red registrando prórroga.', 'error');
      } finally {
        if (btnSaveProrroga) {
          btnSaveProrroga.disabled = false;
          btnSaveProrroga.textContent = 'Guardar Prórroga';
        }
      }
    });

    formEdit?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-edit-pet') as HTMLButtonElement;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Actualizando...';
      }

      try {
        const payload = {
          id: inputId.value,
          asunto: inputAsunto.value.trim(),
          solicitante_nombre: inputSolicitante.value.trim(),
          solicitante_tipo: selectTipo.value,
          prioridad: selectPrioridad.value,
          estado: selectEstado.value,
          fecha_limite_entrega: inputEntrega.value,
          fecha_limite_responsable: inputResponsable?.value || undefined,
        };

        const res = await fetch('/api/peticiones/editar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          (window as any).showToast('Error al actualizar: ' + (data.error || 'No se pudo guardar la modificación'), 'error');
          return;
        }

        const editModal = document.getElementById('modal-edit-peticion');
        if (editModal) editModal.style.display = 'none';

        const row = document.querySelector(`tr[data-id="${payload.id}"]`);
        if (row) {
          const asuntoEl = row.querySelector('.pet-asunto-link, .pet-asunto-text');
          if (asuntoEl) asuntoEl.textContent = payload.asunto;
          const solEl = row.querySelector('.pet-solicitante-text');
          if (solEl) solEl.textContent = payload.solicitante_nombre;
          row.setAttribute('data-search', `${payload.asunto} ${payload.solicitante_nombre}`.toLowerCase());
        }

        (window as any).showToast('Petición actualizada con éxito.', 'success');
      } catch (err: any) {
        (window as any).showToast('Error de conexión al actualizar la petición.', 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Guardar Cambios';
        }
      }
    });
  </script>

  <style>
    @keyframes spin {
      100% { transform: rotate(360deg); }
    }
    @keyframes proMaxCrossfade {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .peticiones-bento-header {
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-top: 3px solid #00594E;
      border-radius: 16px;
      padding: 16px 22px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 8px 24px -8px rgba(0, 89, 78, 0.07);
    }
    .btn-bento-cta:hover {
      background: #00443B !important;
      border-color: #00443B !important;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px -3px rgba(0, 89, 78, 0.34) !important;
    }
    .pro-scroll-container {
      scrollbar-width: thin;
      scrollbar-color: #00594E #F2F7F6;
    }
    .pro-scroll-container::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    .pro-scroll-container::-webkit-scrollbar-track {
      background: #F2F7F6;
      border-radius: 999px;
    }
    .pro-scroll-container::-webkit-scrollbar-thumb {
      background: #00594E;
      border-radius: 999px;
      border: 1px solid #F2F7F6;
    }
    .pro-scroll-container::-webkit-scrollbar-thumb:hover {
      background: #00443B;
    }
    tr.peticion-row {
      transition: background-color 0.18s ease, box-shadow 0.18s ease;
    }
    tr.peticion-row:hover {
      background-color: #F8FAFC;
      box-shadow: inset 3.5px 0 0 #00594E;
    }
    tr.peticion-row.is-crossfade {
      animation: proMaxCrossfade 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-icon-action:hover {
      transform: translateY(-1px);
      box-shadow: 0 3px 8px rgba(0, 89, 78, 0.14);
    }
    .btn-action-mail:hover,
    .btn-action-folder:hover {
      background: #00594E !important;
      border-color: #00594E !important;
      color: #FFFFFF !important;
    }
    .btn-action-edit:hover,
    .btn-action-prorroga:hover {
      background: #B5A160 !important;
      border-color: #B5A160 !important;
      color: #FFFFFF !important;
    }
    .btn-resend-single-dep:hover:not(:disabled) {
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.16);
      transform: translateY(-1px);
      filter: brightness(0.97);
    }
    .btn-resend-single-dep:hover .dep-mail-ico {
      opacity: 1 !important;
      transform: scale(1.1);
    }
    .btn-action-delete:hover {
      background: #DC2626 !important;
      border-color: #DC2626 !important;
      color: #FFFFFF !important;
    }
  </style>
</AppLayout>
