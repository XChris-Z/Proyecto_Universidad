    }

    .empty-combined-desc {
      margin: 5px 0 0 0;
      font-size: 0.80rem;
      color: #64748B;
      max-width: 460px;
      line-height: 1.45;
    }

    /* BLOQUE 3: Resultados de Búsqueda */
    .results-header-bar {
      background: #F8FAFB;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn-clear-search-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid #B2CFCB;
      background: #FFFFFF;
      color: #00594E;
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
