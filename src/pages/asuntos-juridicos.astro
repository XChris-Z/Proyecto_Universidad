    .results-grid {
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    :global(.search-group-label) {
      font-size: 0.73rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #475569;
