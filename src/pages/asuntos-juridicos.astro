      border-color: #F87171;
    }

    /* Agrupaciones Por Año / Por Tema */
    :global(.juridico-group-block) {
      margin-bottom: 16px;
    }

    :global(.juridico-group-title) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.80rem;
