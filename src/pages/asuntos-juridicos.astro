    :global(.btn-doc-download) {
      all: unset;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      height: 30px;
      padding: 0 11px;
      font-size: 0.74rem;
      font-weight: 700;
      border-radius: 7px;
      background: #FFFFFF;
      border: 1px solid #CBD5E1;
      color: #334155;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    :global(.btn-doc-download:hover) {
