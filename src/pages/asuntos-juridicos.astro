  </style>

  <script id="juridico-bootstrap-data" type="application/json" is:inline set:html={JSON.stringify({ carpetas, documentos })}></script>

  <script>
    const __juridicoBootstrap = (() => {
      try {
        return JSON.parse(document.getElementById('juridico-bootstrap-data')?.textContent || '{}');
      } catch {
        return {};
      }
    })();
    const carpetas: any[] = Array.isArray(__juridicoBootstrap.carpetas) ? __juridicoBootstrap.carpetas : [];
    const documentos: any[] = Array.isArray(__juridicoBootstrap.documentos) ? __juridicoBootstrap.documentos : [];

    // Estado reactivo en memoria
    let currentCategoria: string = 'conceptos_internos';
    let currentFolderId: string | null = null;
    let currentSearchScope: string = 'section';
    let currentYearFilter: string = 'todos';
    let currentTemaFilter: string = 'todos';
    let currentViewMode: string = 'carpetas';
    let isSearchActive: boolean = false;

    const catLabels: Record<string, string> = {
      conceptos_internos: 'Conceptos Internos',
      litigios_judiciales: 'Litigios y Asuntos Judiciales',
      auditoria_entes_control: 'Auditoría de Entes de Control',
    };

    // Referencias al DOM
    const catCards = document.querySelectorAll<HTMLElement>('.root-cat-card');
    const searchInput = document.getElementById('juridico-deep-search-input') as HTMLInputElement | null;
    const scopeBtns = document.querySelectorAll<HTMLElement>('.scope-btn');
    const yearChips = document.querySelectorAll<HTMLElement>('#year-filter-chips .year-chip');
    const temaSelect = document.getElementById('select-filter-tema') as HTMLSelectElement | null;
    const modeBtns = document.querySelectorAll<HTMLElement>('#view-mode-selector .mode-btn');

    const breadcrumbsNav = document.getElementById('juridico-breadcrumbs') as HTMLElement | null;
    const normalPanel = document.getElementById('normal-explorer-panel') as HTMLElement | null;
    const searchPanel = document.getElementById('search-results-panel') as HTMLElement | null;
    const resultsContainer = document.getElementById('results-cards-container') as HTMLElement | null;
    const resultsCountLabel = document.getElementById('results-count-label') as HTMLElement | null;
    const resultsQueryLabel = document.getElementById('results-query-label') as HTMLElement | null;
    const clearSearchBtn = document.getElementById('btn-clear-search') as HTMLElement | null;

    const subfoldersGrid = document.getElementById('subfolders-grid') as HTMLElement | null;
    const subfoldersCountPill = document.getElementById('subfolders-count-pill') as HTMLElement | null;
    const documentsList = document.getElementById('documents-list-container') as HTMLElement | null;
    const documentsCountPill = document.getElementById('documents-count-pill') as HTMLElement | null;

    // Cambiar Categoría Raíz
    catCards.forEach((card) => {
      card.addEventListener('click', () => {
        catCards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
        currentCategoria = card.getAttribute('data-cat') || 'conceptos_internos';
        currentFolderId = null; // Volver a raíz de la categoría
        renderExplorer();
      });
    });

    // Cambiar Ámbito de Búsqueda
    scopeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        scopeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentSearchScope = btn.getAttribute('data-scope') || 'section';
        triggerDeepSearch();
      });
    });

    // Filtro por Año
    yearChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        yearChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        currentYearFilter = chip.getAttribute('data-year') || 'todos';
        if (searchInput && searchInput.value.trim().length > 0) {
          triggerDeepSearch();
        } else {
          renderExplorer();
        }
      });
    });

    // Filtro por Tema
    temaSelect?.addEventListener('change', () => {
      if (temaSelect) currentTemaFilter = temaSelect.value;
      if (searchInput && searchInput.value.trim().length > 0) {
        triggerDeepSearch();
      } else {
        renderExplorer();
      }
    });

    // Modos de Visualización
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentViewMode = btn.getAttribute('data-mode') || 'carpetas';
        renderExplorer();
      });
    });

    // Búsqueda en tiempo real con debounce
    let searchDebounceTimer: any = null;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        triggerDeepSearch();
      }, 250);
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentYearFilter = 'todos';
      currentTemaFilter = 'todos';
      yearChips.forEach((c) => c.classList.toggle('active', c.getAttribute('data-year') === 'todos'));
      if (temaSelect) temaSelect.value = 'todos';
      isSearchActive = false;
      if (searchPanel) searchPanel.style.display = 'none';
      if (normalPanel) normalPanel.style.display = 'block';
      renderExplorer();
    });

    // Disparar Búsqueda Profunda Universal
    async function triggerDeepSearch() {
      const q = (searchInput?.value || '').trim();
      const hasFilters = currentYearFilter !== 'todos' || currentTemaFilter !== 'todos';

      if (!q && !hasFilters) {
        isSearchActive = false;
        if (searchPanel) searchPanel.style.display = 'none';
        if (normalPanel) normalPanel.style.display = 'block';
        renderExplorer();
        return;
      }

      isSearchActive = true;
      if (normalPanel) normalPanel.style.display = 'none';
      if (searchPanel) searchPanel.style.display = 'block';

      if (resultsContainer) {
        resultsContainer.innerHTML = '<div style="text-align: center; padding: 24px; color: #64748B;">Buscando profundamente en metadatos y contenido de archivos...</div>';
      }

      try {
        const catParam = currentSearchScope === 'all' ? 'todas' : currentCategoria;
        const url = `/api/juridico/buscar?q=${encodeURIComponent(q)}&categoria=${catParam}&anio=${currentYearFilter}&tema=${encodeURIComponent(currentTemaFilter)}`;
        const res = await fetch(url);
        const data = await res.json();

        if (!data.success) {
          if (resultsContainer) resultsContainer.innerHTML = `<div style="color: #DC2626; padding: 18px;">Error: ${data.error || 'No se pudo realizar la búsqueda.'}</div>`;
          return;
        }

        renderSearchResults(data);
      } catch (err) {
        console.error('Error buscando:', err);
        if (resultsContainer) resultsContainer.innerHTML = '<div style="color: #DC2626; padding: 18px;">Error de red en la búsqueda profunda.</div>';
      }
    }

    // Renderizar Resultados de Búsqueda
    function renderSearchResults(data: any) {
      const docs: any[] = data.documentos || [];
      const carps: any[] = data.carpetas || [];
      const totalCount = docs.length + carps.length;

      if (resultsCountLabel) resultsCountLabel.textContent = `${totalCount} resultado${totalCount === 1 ? '' : 's'} encontrado${totalCount === 1 ? '' : 's'}`;
      if (resultsQueryLabel) resultsQueryLabel.textContent = data.query ? `para "${data.query}"` : '';

      if (totalCount === 0) {
        if (resultsContainer) {
          resultsContainer.innerHTML = `
            <div class="juridico-empty-state" style="justify-content: center; text-align: center; padding: 32px 20px;">
              <div class="juridico-empty-icon" style="width: 40px; height: 40px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              </div>
              <div>
                <strong style="display: block; font-weight: 700; font-size: 0.95rem; color: #111827;">No se encontraron coincidencias</strong>
                <span style="font-size: 0.78rem; color: #64748B;">Intente con otras palabras clave, amplíe el ámbito de búsqueda o verifique la ortografía.</span>
              </div>
            </div>
          `;
        }
        return;
      }

      let html = '';

      // Carpetas encontradas
      carps.forEach((c: any) => {
        html += `
          <div class="result-search-card" style="border-left: 4px solid #00594E;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: #00594E;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                </span>
                <strong style="font-size: 0.95rem; color: #111827;">${c.nombre}</strong>
                <span style="font-size: 0.68rem; background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; padding: 1px 7px; border-radius: 999px;">Subcarpeta</span>
              </div>
              <button type="button" class="btn-jump-folder" data-cat="${c.categoria_raiz}" data-id="${c.id}" style="font-size: 0.74rem; font-weight: 700; color: #00594E; background: none; border: none; cursor: pointer;">
                Ir a la carpeta &rarr;
              </button>
            </div>
            <div style="font-size: 0.74rem; color: #64748B;">Ruta: ${c.breadcrumb}</div>
            ${c.descripcion ? `<div style="font-size: 0.76rem; color: #334155;">${c.descripcion}</div>` : ''}
          </div>
        `;
      });

      // Documentos encontrados con snippets
      docs.forEach((d: any) => {
        const ext = (d.archivo_nombre || '').split('.').pop()?.toUpperCase() || 'DOC';
        html += `
          <div class="result-search-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
                <span style="width: 32px; height: 32px; border-radius: 8px; background: #F0F7F5; border: 1px solid #B2CFCB; color: #00594E; display: inline-flex; align-items: center; justify-content: center; font-size: 0.70rem; font-weight: 800; flex-shrink: 0;">
                  ${ext}
                </span>
                <div style="min-width: 0;">
                  <h4 style="margin: 0; font-size: 0.94rem; font-weight: 800; color: #111827; line-height: 1.25;">
                    ${d.titulo}
                  </h4>
                  <div style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: #64748B; margin-top: 2px; flex-wrap: wrap;">
                    <span style="background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; padding: 1px 6px; border-radius: 4px; font-weight: 700;">Año ${d.anio}</span>
                    ${d.tema ? `<span style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; padding: 1px 6px; border-radius: 4px; font-weight: 600;">${d.tema}</span>` : ''}
                    ${d.isContentMatch ? `<span style="background: #FEF9C3; color: #854D0E; border: 1px solid #FDE047; padding: 1px 6px; border-radius: 4px; font-weight: 700;">Coincidencia en texto del archivo</span>` : ''}
                  </div>
                </div>
              </div>

              <!-- Botones de Acción de Documento -->
              <div style="display: flex; align-items: center; gap: 6px;">
                <a href="${d.archivo_url}" target="_blank" rel="noopener noreferrer" style="all: unset; box-sizing: border-box; display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 4px 10px; font-size: 0.72rem; font-weight: 700; border-radius: 6px; background: #F0F7F5; border: 1px solid #00594E; color: #00594E; cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Ver</span>
                </a>
                <a href="${d.archivo_url}" download="${d.archivo_nombre || 'documento'}" style="all: unset; box-sizing: border-box; display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 4px 10px; font-size: 0.72rem; font-weight: 700; border-radius: 6px; background: #FFFFFF; border: 1px solid #DCE4E3; color: #334155; cursor: pointer;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  <span>Descargar</span>
                </a>
              </div>
            </div>

            <!-- Snippet con <mark> -->
            ${d.snippet ? `
              <div style="background: #F8FAFB; border-radius: 6px; padding: 8px 12px; font-size: 0.76rem; color: #334155; line-height: 1.4; border-left: 3px solid #B5A160;">
                <span style="font-weight: 700; color: #64748B; font-size: 0.70rem;">Fragmento:</span> ${d.snippet}
              </div>
            ` : ''}

            <!-- Breadcrumb clickeable -->
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.71rem; color: #64748B; margin-top: 2px;">
              <span>Ruta: <strong>${d.breadcrumb}</strong></span>
              <button type="button" class="btn-jump-folder" data-cat="${d.categoria_raiz}" data-id="${d.carpeta_id || ''}" style="all: unset; font-weight: 700; color: #00594E; cursor: pointer;">
                Abrir en carpeta &rarr;
              </button>
            </div>
          </div>
        `;
      });

      if (resultsContainer) {
        resultsContainer.innerHTML = html;
        attachJumpEvents();
      }
    }

    function attachJumpEvents() {
      document.querySelectorAll<HTMLElement>('.btn-jump-folder').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          const folderId = btn.getAttribute('data-id') || null;
          if (cat) {
            currentCategoria = cat;
            catCards.forEach((c) => c.classList.toggle('active', c.getAttribute('data-cat') === cat));
          }
          currentFolderId = folderId;
          if (searchInput) searchInput.value = '';
          isSearchActive = false;
          if (searchPanel) searchPanel.style.display = 'none';
          if (normalPanel) normalPanel.style.display = 'block';
          renderExplorer();
        });
      });
    }

    // Renderizar Explorador Normal
    function renderExplorer() {
      renderBreadcrumbs();

      // Filtrar subcarpetas del nivel actual
      const currentSubfolders = carpetas.filter((c: any) => {
        if (c.categoria_raiz !== currentCategoria) return false;
        if (currentFolderId === null) {
          return !c.parent_id;
        }
        return c.parent_id === currentFolderId;
      });

      // Filtrar documentos del nivel actual
      const currentDocs = documentos.filter((d: any) => {
        if (d.categoria_raiz !== currentCategoria) return false;
        if (currentFolderId === null) {
          return !d.carpeta_id;
        }
        return d.carpeta_id === currentFolderId;
      });

      // Renderizar Subcarpetas
      if (subfoldersCountPill) subfoldersCountPill.textContent = `${currentSubfolders.length} subcarpeta${currentSubfolders.length === 1 ? '' : 's'}`;
      if (subfoldersGrid) {
        if (currentSubfolders.length === 0) {
          subfoldersGrid.innerHTML = `
            <div class="juridico-empty-state" style="grid-column: 1 / -1;">
              <div class="juridico-empty-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              </div>
