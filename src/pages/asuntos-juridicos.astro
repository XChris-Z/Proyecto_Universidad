      background: #F2F7F6;
      border: 1px solid #B2CFCB;
      border-radius: 8px;
      padding: 7px 12px;
      margin-bottom: 8px;
    }

    /* Estado vacío único */
    .juridico-combined-empty {
      margin-top: 16px;
      background: #F8FAFB;
      border: 1.5px dashed #CBD5E1;
      border-radius: 14px;
      padding: 36px 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .juridico-empty-icon-lg {
      width: 52px;
