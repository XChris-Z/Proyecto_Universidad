---
// src/pages/asuntos-juridicos.astro
// Explorador Inteligente de Asuntos Jurídicos — Carpetas, Temas, Años y Búsqueda Universal Profunda
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Consultar datos de carpetas y documentos en Supabase
const { data: dbCarpetas } = await (supabase
  .from('juridico_carpetas' as any)
  .select('*')
  .order('created_at', { ascending: true }) as any);

const { data: dbDocumentos } = await (supabase
  .from('juridico_documentos' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const carpetas = Array.isArray(dbCarpetas) ? dbCarpetas : [];
const documentos = Array.isArray(dbDocumentos) ? dbDocumentos : [];

// Contadores por categoría raíz
const countConceptosDocs = documentos.filter((d) => d.categoria_raiz === 'conceptos_internos').length;
const countConceptosCarpetas = carpetas.filter((c) => c.categoria_raiz === 'conceptos_internos').length;

const countLitigiosDocs = documentos.filter((d) => d.categoria_raiz === 'litigios_judiciales').length;
const countLitigiosCarpetas = carpetas.filter((c) => c.categoria_raiz === 'litigios_judiciales').length;

const countAuditoriasDocs = documentos.filter((d) => d.categoria_raiz === 'auditoria_entes_control').length;
const countAuditoriasCarpetas = carpetas.filter((c) => c.categoria_raiz === 'auditoria_entes_control').length;

// Lista de temas únicos para los chips
const allTemas = Array.from(
  new Set([
    ...carpetas.map((c) => c.tema).filter(Boolean),
    ...documentos.map((d) => d.tema).filter(Boolean),
  ])
).sort();

// Años disponibles desde 2021
const yearsList = ['2026', '2025', '2024', '2023', '2022', '2021'];
---

<AppLayout title="Asuntos Jurídicos — Explorador Inteligente" activeNav="juridicos">
  <section class="module-board-card juridicos-shell">
    
    <!-- Cabecera Institucional Bento -->
    <header class="juridicos-hero-header">
      <div style="min-width: 0; flex: 1;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h1 style="font-size: 1.55rem; font-weight: 800; color: #111827; margin: 0; letter-spacing: -0.01em;">
            Asuntos Jurídicos
          </h1>
          <span style="font-size: 0.72rem; font-weight: 800; background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; padding: 3px 10px; border-radius: 999px;">
            Oficina Asesora Jurídica
          </span>
          <span style="font-size: 0.72rem; font-weight: 700; background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; padding: 3px 10px; border-radius: 999px;">
            Búsqueda Profunda Indexada
          </span>
        </div>
        <p style="font-size: 0.86rem; color: #52606D; margin: 6px 0 0 0;">
          Explorador documental jerárquico de conceptos jurídicos internos, litigios judiciales y auditorías de entes de control con indexación de contenido plano.
        </p>
      </div>
    </header>

    <!-- FILA 1: Selector de las 3 Carpetas Raíz (Tarjetas Ejecutivas Bento) -->
    <section class="root-categories-grid" aria-label="Carpetas Raíz Principales">
      <div class="root-cat-card active" data-cat="conceptos_internos" id="cat-card-conceptos">
        <div class="root-cat-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div style="flex: 1; min-width: 0;">
          <h3 class="root-cat-title">Conceptos Internos</h3>
          <div class="root-cat-meta">
            <span>{countConceptosCarpetas} subcarpetas</span>
            <span>&middot;</span>
            <strong>{countConceptosDocs} documentos</strong>
          </div>
        </div>
        <div class="root-cat-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>

      <div class="root-cat-card" data-cat="litigios_judiciales" id="cat-card-litigios">
        <div class="root-cat-icon dorado">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div style="flex: 1; min-width: 0;">
          <h3 class="root-cat-title">Litigios y Asuntos Judiciales</h3>
          <div class="root-cat-meta">
            <span>{countLitigiosCarpetas} subcarpetas</span>
            <span>&middot;</span>
            <strong>{countLitigiosDocs} expedientes</strong>
          </div>
        </div>
        <div class="root-cat-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>

      <div class="root-cat-card" data-cat="auditoria_entes_control" id="cat-card-auditorias">
        <div class="root-cat-icon slate">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
        </div>
        <div style="flex: 1; min-width: 0;">
          <h3 class="root-cat-title">Auditoría de Entes de Control</h3>
          <div class="root-cat-meta">
            <span>{countAuditoriasCarpetas} subcarpetas</span>
            <span>&middot;</span>
            <strong>{countAuditoriasDocs} actuaciones</strong>
          </div>
        </div>
        <div class="root-cat-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>
    </section>

    <!-- FILA 2: Barra de Búsqueda Profunda, Filtros de Año/Tema y Modos de Vista -->
    <section class="juridicos-toolbar-panel">
      <!-- Input de búsqueda universal profunda -->
      <div class="deep-search-bar-wrap">
        <div style="position: relative; flex: 1;">
          <input
            type="text"
            id="juridico-deep-search-input"
            class="form-input juridico-search-input"
            placeholder="Buscar por cualquier palabra dentro del archivo, tema, año, número de proceso o carpeta..."
            style="width: 100%; height: 44px; padding-left: 42px; padding-right: 12px; border-radius: 10px; border: 1px solid #CBD5E1; font-size: 0.86rem; background: #FFFFFF;"
          />
          <div style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #00594E; display: flex; align-items: center; pointer-events: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </div>
        </div>

        <!-- Scope switch: En esta carpeta / Todo el módulo -->
        <div class="search-scope-toggle">
          <button type="button" class="scope-btn active" data-scope="section">Esta categoría</button>
          <button type="button" class="scope-btn" data-scope="all">Todo Jurídico</button>
        </div>
      </div>

      <!-- Filtros de Año, Tema y Modo de Vista -->
      <div class="filters-and-modes-bar">
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <!-- Selector de Año -->
          <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase; white-space: nowrap; flex-shrink: 0;">Año:</span>
          <div class="year-chips-wrap" id="year-filter-chips">
            <button type="button" class="year-chip active" data-year="todos">Todos</button>
            {yearsList.map((y) => (
              <button type="button" class="year-chip" data-year={y}>{y}</button>
            ))}
          </div>

          <!-- Divisor vertical sutil entre Año y Tema -->
          <div style="width: 1px; height: 20px; background: #E2E8F0; margin: 0 4px; flex-shrink: 0;"></div>

          <!-- Selector de Tema -->
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-size: 0.72rem; font-weight: 700; color: #64748B; text-transform: uppercase; white-space: nowrap; flex-shrink: 0;">Tema:</span>
            <select id="select-filter-tema" class="form-input" style="height: 32px; min-width: 170px; border-radius: 8px; font-size: 0.76rem; font-weight: 600; padding: 2px 10px; border: 1px solid #DCE4E3; background: #FFFFFF; white-space: nowrap; flex-shrink: 0;">
              <option value="todos">Todos los Temas</option>
              {allTemas.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Selector de Modo de Visualización -->
        <div class="view-mode-toggle" id="view-mode-selector">
          <button type="button" class="mode-btn active" data-mode="carpetas" title="Explorador jerárquico de carpetas">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <span>Carpetas</span>
          </button>
          <button type="button" class="mode-btn" data-mode="anio" title="Agrupar por Año">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Por Año</span>
          </button>
          <button type="button" class="mode-btn" data-mode="tema" title="Agrupar por Tema">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span>Por Tema</span>
          </button>
        </div>
      </div>
    </section>

    <!-- FILA 3: Barra de Ruta (Breadcrumbs) y Botones de Acción del Nivel Actual -->
    <section class="breadcrumbs-actions-bar">
      <!-- Breadcrumbs dinámicos -->
      <nav class="juridico-breadcrumbs" id="juridico-breadcrumbs" aria-label="Ruta de carpetas">
        <button type="button" class="breadcrumb-btn breadcrumb-item root-link" data-folder-id="">
          Asuntos Jurídicos
        </button>
        <span class="breadcrumb-sep">&rsaquo;</span>
        <button type="button" class="breadcrumb-btn breadcrumb-item is-current active" id="breadcrumb-current-cat" data-folder-id="">
          Conceptos Internos
        </button>
      </nav>

      <!-- Botones de Acción del nivel actual -->
      <div style="display: flex; align-items: center; gap: 8px;">
        <button type="button" id="btn-open-new-folder-modal" class="btn btn-secondary btn-sm" style="height: 34px; padding: 6px 14px; font-size: 0.78rem; font-weight: 700; border-radius: 8px; background: #FFFFFF; border: 1.5px solid #00594E; color: #00594E; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
          <span>+ Nueva Subcarpeta</span>
        </button>

        <button type="button" id="btn-open-upload-modal" class="btn btn-primary btn-sm" style="height: 34px; padding: 6px 16px; font-size: 0.78rem; font-weight: 800; border-radius: 8px; background: #00594E; border: 1.5px solid #00594E; color: #FFFFFF; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(0, 89, 78, 0.2);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>+ Subir Archivo Aquí</span>
        </button>
      </div>
    </section>

    <!-- ÁREA DE CONTENIDO: 2 Estados (Resultados de Búsqueda Profunda vs Explorador Normal) -->
    <div class="content-viewport" id="juridico-content-viewport">
      
      <!-- ESTADO A: Resultados de Búsqueda Profunda (cuando hay query o filtro de año/tema activo) -->
      <section id="search-results-panel" style="display: none;">
        <div class="results-header-bar">
          <div>
            <strong id="results-count-label" style="font-size: 0.95rem; color: #111827;">0 resultados encontrados</strong>
            <span id="results-query-label" style="font-size: 0.80rem; color: #64748B; margin-left: 6px;"></span>
          </div>
          <button type="button" id="btn-clear-search" class="btn btn-ghost btn-sm" style="font-size: 0.74rem; color: #00594E; font-weight: 700;">
            Limpiar búsqueda &times;
          </button>
        </div>

        <div id="results-cards-container" class="results-grid" style="margin-top: 14px; display: flex; flex-direction: column; gap: 12px;">
          <!-- Inyectado dinámicamente desde JS -->
        </div>
      </section>

      <!-- ESTADO B: Explorador Normal de Carpetas y Documentos -->
      <section id="normal-explorer-panel">
        <!-- Subsección 1: Subcarpetas del nivel actual -->
        <div class="subfolders-section">
          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid #EEF2F5; margin-bottom: 12px;">
            <div style="font-size: 0.84rem; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.03em;">
              Subcarpetas en este nivel
            </div>
            <span id="subfolders-count-pill" style="font-size: 0.72rem; font-weight: 700; color: #00594E; background: #F0F7F5; border: 1px solid #B2CFCB; padding: 2px 8px; border-radius: 999px;">
              0 carpetas
            </span>
          </div>

          <div id="subfolders-grid" class="subfolders-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px;">
            <!-- Inyectado dinámicamente desde JS -->
          </div>
        </div>

        <!-- Subsección 2: Documentos en esta carpeta -->
        <div class="documents-section" style="margin-top: 26px;">
          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid #EEF2F5; margin-bottom: 12px;">
            <div style="font-size: 0.84rem; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.03em;">
              Documentos en esta carpeta
            </div>
            <span id="documents-count-pill" style="font-size: 0.72rem; font-weight: 700; color: #786832; background: #F7F5EE; border: 1px solid #DBD2B0; padding: 2px 8px; border-radius: 999px;">
              0 documentos
            </span>
          </div>

          <div id="documents-list-container" class="documents-list" style="display: flex; flex-direction: column; gap: 10px;">
            <!-- Inyectado dinámicamente desde JS -->
          </div>
        </div>
      </section>

    </div>
  </section>

  <!-- MODAL 1: Nueva Subcarpeta -->
  <div class="modal-backdrop" id="modal-new-folder" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(2px);">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 520px; border-radius: 16px; box-shadow: 0 20px 45px rgba(0,0,0,0.2); overflow: hidden; border-top: 4px solid #00594E;">
      <div class="modal-header" style="background: #F2F7F6; border-bottom: 1.5px solid #DCE4E3; padding: 16px 22px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: #00594E; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Nueva Subcarpeta</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-new-folder" style="background: none; border: none; cursor: pointer; color: #64748B;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding: 22px;">
        <form id="form-new-folder">
          <div class="form-group" style="margin-bottom: 14px;">
            <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Nombre de la Subcarpeta *</label>
            <input type="text" id="folder-input-nombre" class="form-input" placeholder="Ej: Contratación 2025, Tutelas en Trámite, Auditoría Contraloría..." required style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
            <div>
              <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Tema Jurídico (Opcional)</label>
              <input type="text" id="folder-input-tema" class="form-input" placeholder="Ej: Contratación, Laboral..." style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;" />
            </div>
            <div>
              <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Año (Opcional)</label>
              <select id="folder-input-anio" class="form-input" style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;">
                <option value="">Sin año específico</option>
                {yearsList.map((y) => (
                  <option value={y}>{y}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Descripción o Notas</label>
            <textarea id="folder-input-desc" class="form-input" rows="2" placeholder="Detalles de los expedientes o asuntos alojados aquí..." style="width: 100%; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.82rem; padding: 6px;"></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; padding-top: 14px; border-top: 1px solid #DCE4E3;">
            <button type="button" class="btn btn-ghost" id="btn-cancel-new-folder">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-submit-new-folder" style="background: #00594E; border-color: #00594E; color: #FFFFFF; font-weight: 700;">Crear Subcarpeta</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL 2: Subir Archivo con Extracción Automática -->
  <div class="modal-backdrop" id="modal-upload-doc" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(2px);">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: 16px; box-shadow: 0 20px 45px rgba(0,0,0,0.2); overflow: hidden; border-top: 4px solid #00594E;">
      <div class="modal-header" style="background: #F2F7F6; border-bottom: 1.5px solid #DCE4E3; padding: 16px 22px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.05rem; font-weight: 800; color: #00594E; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>Subir Archivo e Indexar Contenido</span>
        </h3>
        <button type="button" class="btn-close-modal" id="btn-close-upload-doc" style="background: none; border: none; cursor: pointer; color: #64748B;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding: 22px; max-height: calc(85vh - 120px); overflow-y: auto;">
        <form id="form-upload-doc" novalidate>
          <!-- Alerta de error clara dentro del modal -->
          <div id="doc-upload-error-banner" role="alert" style="display: none; align-items: flex-start; gap: 10px; background: #FEF2F2; border: 1.5px solid #FECACA; border-left: 4px solid #DC2626; border-radius: 10px; padding: 11px 14px; color: #991B1B; font-size: 0.80rem; font-weight: 600; margin-bottom: 14px; line-height: 1.4;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" style="flex-shrink: 0; margin-top: 1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="doc-upload-error-text" style="flex: 1;"></span>
          </div>

          <!-- Dropzone para Archivo -->
          <div style="border: 2px dashed #00594E; border-radius: 10px; padding: 18px; text-align: center; background: #F0F7F5; margin-bottom: 16px;">
            <input type="file" id="doc-file-input" accept=".pdf,.docx,.txt,.csv" style="display: none;" />
            <button type="button" id="btn-browse-doc-file" class="btn btn-secondary btn-sm" style="background: #FFFFFF; border: 1.5px solid #00594E; color: #00594E; font-weight: 700; padding: 6px 14px; border-radius: 8px; cursor: pointer;">
              Seleccionar Documento (PDF, DOCX, TXT)
            </button>
            <div id="doc-file-label" style="font-size: 0.78rem; font-weight: 700; color: #00594E; margin-top: 8px;">
              Ningún archivo seleccionado *
            </div>
            <div style="font-size: 0.70rem; color: #64748B; margin-top: 4px;">
              El texto plano será extraído e indexado automáticamente para búsqueda profunda.
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Título del Documento *</label>
            <input type="text" id="doc-input-titulo" class="form-input" placeholder="Se autollenará con el nombre del archivo o edítelo aquí..." required style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div>
              <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Año del Documento *</label>
              <select id="doc-input-anio" class="form-input" required style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;">
                {yearsList.map((y) => (
                  <option value={y}>{y}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Tema Jurídico</label>
              <input type="text" id="doc-input-tema" class="form-input" placeholder="Ej: Contratación, Tutelas..." style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Palabras Clave / Radicado / Número de Proceso</label>
            <input type="text" id="doc-input-palabras" class="form-input" placeholder="Ej: EXP-2025-084, Tribunal Administrativo de Casanare, Juzgado 1..." style="width: 100%; height: 38px; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.85rem;" />
          </div>

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label" style="font-size: 0.76rem; font-weight: 700; color: #0F172A; text-transform: uppercase; margin-bottom: 4px; display: block;">Descripción o Resumen</label>
            <textarea id="doc-input-desc" class="form-input" rows="2" placeholder="Resumen del pronunciamiento, sentencia o informe..." style="width: 100%; border-radius: 8px; border: 1.5px solid #DCE4E3; font-size: 0.82rem; padding: 6px;"></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 10px; padding-top: 14px; border-top: 1px solid #DCE4E3;">
            <button type="button" class="btn btn-ghost" id="btn-cancel-upload-doc">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-submit-upload-doc" style="background: #00594E; border-color: #00594E; color: #FFFFFF; font-weight: 700;">Subir e Indexar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

