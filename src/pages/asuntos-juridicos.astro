    :global(.btn-doc-view) {
      all: unset;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      height: 30px;
      padding: 0 11px;
      font-size: 0.74rem;
      font-weight: 700;
      border-radius: 7px;
      background: #F0F7F5;
