    }

    :global(.result-search-card) {
      background: #FFFFFF !important;
      border: 1.5px solid #E2E8F0 !important;
      border-radius: 12px !important;
      padding: 14px 16px !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 9px !important;
      transition: all 0.18s ease !important;
    }

    :global(.result-search-card:hover) {
      border-color: #00594E !important;
      box-shadow: 0 4px 14px rgba(0, 89, 78, 0.08) !important;
    }

    :global(.result-path-chip) {
      all: unset;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      max-width: 100%;
      padding: 4px 10px;
      border-radius: 999px;
      background: #F0F7F5;
      border: 1px solid #B2CFCB;
      color: #00594E;
      font-size: 0.73rem;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    :global(.result-path-chip:hover) {
      background: #DCEEE9;
    }

    :global(.result-snippet-box) {
      background: #F8FAFB;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 0.77rem;
      color: #334155;
      line-height: 1.45;
      border-left: 3px solid #B5A160;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    :global(mark.juridico-mark) {
      background-color: #FEF08A !important;
      color: #00443B !important;
      font-weight: 800 !important;
      padding: 1px 4px !important;
      border-radius: 3px !important;
    }

    :global(.juridico-empty-state) {
      display: flex !important;
      align-items: center !important;
      gap: 12px !important;
      padding: 20px !important;
      background-color: #F8FAFB !important;
      border: 1.5px dashed #CBD5E1 !important;
      border-radius: 12px !important;
      color: #64748B !important;
      font-size: 0.83rem !important;
    }

    :global(.juridico-empty-icon) {
      width: 36px !important;
      height: 36px !important;
      border-radius: 9px !important;
      background-color: #E6F2EF !important;
      color: #00594E !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
    }

    @media (max-width: 959px) {
      .mobile-tree-toggle-bar {
        display: block;
      }

      .juridico-workspace-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .juridico-tree-panel {
        display: none;
        position: static;
        max-height: 360px;
      }

      .juridico-tree-panel.is-open {
        display: block;
      }
    }
  </style>

  <script id="juridico-bootstrap-data" type="application/json" is:inline set:html={JSON.stringify({ carpetas, documentos })}></script>

  <script>
    const __juridicoBootstrap = (() => {
      try {
        return JSON.parse(document.getElementById('juridico-bootstrap-data')?.textContent || '{}');
      } catch {
        return {};
      }
    })();
    let carpetas: any[] = Array.isArray(__juridicoBootstrap.carpetas) ? __juridicoBootstrap.carpetas : [];
    let documentos: any[] = Array.isArray(__juridicoBootstrap.documentos) ? __juridicoBootstrap.documentos : [];

    // Estado reactivo en memoria
    let currentCategoria: string = 'conceptos_internos';
    let currentFolderId: string | null = null;
    let currentSearchScope: string = 'all';
    let userSelectedScope: boolean = false;
    let currentYearFilter: string = 'todos';
    let currentTemaFilter: string = 'todos';
    let currentViewMode: string = 'carpetas';
    let isSearchActive: boolean = false;
    const expandedTreeNodes = new Set<string>([
      'cat:conceptos_internos',
      'cat:litigios_judiciales',
      'cat:auditoria_entes_control',
    ]);

    const rootCategories = [
      { key: 'conceptos_internos', label: 'Conceptos Internos', iconClass: '', unit: 'documentos' },
      { key: 'litigios_judiciales', label: 'Litigios y Asuntos Judiciales', iconClass: 'dorado', unit: 'expedientes' },
      { key: 'auditoria_entes_control', label: 'Auditoría de Entes de Control', iconClass: 'slate', unit: 'actuaciones' },
    ];

    const catLabels: Record<string, string> = {
      conceptos_internos: 'Conceptos Internos',
      litigios_judiciales: 'Litigios y Asuntos Judiciales',
      auditoria_entes_control: 'Auditoría de Entes de Control',
    };

    function escapeHtml(raw: unknown): string {
      return String(raw ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function sanitizeSnippetHtml(raw: unknown): string {
      const escaped = escapeHtml(raw);
      return escaped
        .replace(/&lt;mark class=&quot;juridico-mark&quot;&gt;/gi, '<mark class="juridico-mark">')
        .replace(/&lt;\/mark&gt;/gi, '</mark>');
    }

    const TRASH_SVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>`;
    const VIEW_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
    const DOWNLOAD_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;
    const CHEVRON_DOWN_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="6 9 12 15 18 9"/></svg>`;
    const CHEVRON_RIGHT_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>`;

    function getRootIconSvg(catKey: string): string {
      if (catKey === 'litigios_judiciales') {
        return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`;
      }
      if (catKey === 'auditoria_entes_control') {
        return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 14 2 2 4-4"/></svg>`;
      }
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`;
    }

    function getExtBadgeClass(ext: string): string {
      const up = ext.toUpperCase();
      if (up === 'PDF') return 'ext-pdf';
      if (up === 'DOCX' || up === 'DOC') return 'ext-docx';
      return 'ext-txt';
    }

    // Referencias al DOM
    const searchInput = document.getElementById('juridico-deep-search-input') as HTMLInputElement | null;
    const quickClearBtn = document.getElementById('btn-quick-clear-search') as HTMLButtonElement | null;
    const scopeBtns = document.querySelectorAll<HTMLElement>('.scope-btn');
    const anioSelect = document.getElementById('select-filter-anio') as HTMLSelectElement | null;
    const temaSelect = document.getElementById('select-filter-tema') as HTMLSelectElement | null;
    const modeBtns = document.querySelectorAll<HTMLElement>('#view-mode-selector .mode-btn');

    const treePanel = document.getElementById('juridico-tree-panel') as HTMLElement | null;
    const treeRootEl = document.getElementById('juridico-tree-root') as HTMLElement | null;
    const treeToggleAllBtn = document.getElementById('btn-tree-toggle-all') as HTMLButtonElement | null;
    const mobileTreeToggleBtn = document.getElementById('btn-toggle-tree-mobile') as HTMLButtonElement | null;

    const breadcrumbsNav = document.getElementById('juridico-breadcrumbs') as HTMLElement | null;
    const folderBackBtn = document.getElementById('btn-folder-back') as HTMLButtonElement | null;
    const activeFolderTitleEl = document.getElementById('active-folder-title') as HTMLElement | null;
    const activeFolderBadgeEl = document.getElementById('active-folder-badge') as HTMLElement | null;
    const activeFolderMetaEl = document.getElementById('active-folder-meta') as HTMLElement | null;

    const normalPanel = document.getElementById('normal-explorer-panel') as HTMLElement | null;
    const searchPanel = document.getElementById('search-results-panel') as HTMLElement | null;
    const resultsContainer = document.getElementById('results-cards-container') as HTMLElement | null;
    const resultsCountLabel = document.getElementById('results-count-label') as HTMLElement | null;
    const resultsQueryLabel = document.getElementById('results-query-label') as HTMLElement | null;
    const clearSearchBtn = document.getElementById('btn-clear-search') as HTMLElement | null;

    const subfoldersSection = document.getElementById('subfolders-section') as HTMLElement | null;
    const subfoldersGrid = document.getElementById('subfolders-grid') as HTMLElement | null;
    const subfoldersCountPill = document.getElementById('subfolders-count-pill') as HTMLElement | null;
    const documentsSection = document.getElementById('documents-section') as HTMLElement | null;
    const documentsHeadingEl = document.getElementById('documents-section-heading') as HTMLElement | null;
    const documentsList = document.getElementById('documents-list-container') as HTMLElement | null;
    const documentsCountPill = document.getElementById('documents-count-pill') as HTMLElement | null;
    const combinedEmptyEl = document.getElementById('juridico-combined-empty') as HTMLElement | null;

    function syncScopeButtonsUI() {
      scopeBtns.forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-scope') === currentSearchScope);
      });
    }

    function syncQuickClearVisibility() {
      if (!quickClearBtn || !searchInput) return;
      quickClearBtn.style.display = searchInput.value.length > 0 ? 'inline-flex' : 'none';
    }

    function ensureFolderAncestorsExpanded(folderId: string | null) {
      expandedTreeNodes.add(`cat:${currentCategoria}`);
      let currId = folderId;
      let depth = 0;
      while (currId && depth < 10) {
        const f = carpetas.find((c: any) => c.id === currId);
        if (!f) break;
        expandedTreeNodes.add(`folder:${f.id}`);
        currId = f.parent_id || null;
        depth++;
      }
    }

    function countFolderSubtreeDocs(folderId: string): number {
      let count = documentos.filter((d: any) => d.carpeta_id === folderId).length;
      const children = carpetas.filter((c: any) => c.parent_id === folderId);
      children.forEach((child: any) => {
        count += countFolderSubtreeDocs(child.id);
      });
      return count;
    }

    // Renderizar árbol jerárquico en el panel izquierdo
    function renderTree() {
      if (!treeRootEl) return;

      function renderFolderBranch(folder: any): string {
        const childFolders = carpetas.filter((c: any) => c.parent_id === folder.id);
        const hasChildren = childFolders.length > 0;
        const nodeKey = `folder:${folder.id}`;
        const isExpanded = expandedTreeNodes.has(nodeKey);
        const isActive = !isSearchActive && currentFolderId === folder.id;
        const docsInSubtree = countFolderSubtreeDocs(folder.id);

        const chevronHtml = hasChildren
          ? `<button type="button" class="tree-chevron-btn" data-toggle-node="${nodeKey}" title="${isExpanded ? 'Contraer' : 'Expandir'}" aria-label="${isExpanded ? 'Contraer' : 'Expandir'}">${isExpanded ? CHEVRON_DOWN_SVG : CHEVRON_RIGHT_SVG}</button>`
          : `<span class="tree-chevron-spacer"></span>`;

        const childrenHtml = hasChildren && isExpanded
          ? `<div class="tree-children-list">${childFolders.map((cf: any) => renderFolderBranch(cf)).join('')}</div>`
          : '';

        return `
          <div class="tree-node-group">
            <div class="tree-node-row ${isActive ? 'is-active' : ''}" data-tree-cat="${escapeHtml(folder.categoria_raiz)}" data-tree-folder="${escapeHtml(folder.id)}">
              ${chevronHtml}
              <span class="tree-node-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>
              </span>
              <span class="tree-node-label" title="${escapeHtml(folder.nombre)}">${escapeHtml(folder.nombre)}</span>
              <span class="tree-node-count">${docsInSubtree}</span>
            </div>
            ${childrenHtml}
          </div>
        `;
      }

      treeRootEl.innerHTML = rootCategories.map((cat) => {
        const catNodeKey = `cat:${cat.key}`;
        const rootFolders = carpetas.filter((c: any) => c.categoria_raiz === cat.key && !c.parent_id);
        const hasChildren = rootFolders.length > 0;
        const isExpanded = expandedTreeNodes.has(catNodeKey);
        const isActive = !isSearchActive && currentCategoria === cat.key && currentFolderId === null;
        const totalDocsCat = documentos.filter((d: any) => d.categoria_raiz === cat.key).length;

        const chevronHtml = hasChildren
          ? `<button type="button" class="tree-chevron-btn" data-toggle-node="${catNodeKey}" title="${isExpanded ? 'Contraer' : 'Expandir'}" aria-label="${isExpanded ? 'Contraer' : 'Expandir'}">${isExpanded ? CHEVRON_DOWN_SVG : CHEVRON_RIGHT_SVG}</button>`
          : `<span class="tree-chevron-spacer"></span>`;

        const childrenHtml = hasChildren && isExpanded
          ? `<div class="tree-children-list">${rootFolders.map((rf: any) => renderFolderBranch(rf)).join('')}</div>`
          : '';

        return `
          <div class="tree-node-group">
            <div class="tree-node-row ${isActive ? 'is-active' : ''}" data-tree-cat="${cat.key}" data-tree-folder="">
              ${chevronHtml}
              <span class="tree-node-icon ${cat.iconClass}">${getRootIconSvg(cat.key)}</span>
              <span class="tree-node-label" title="${cat.label}">${cat.label}</span>
              <span class="tree-node-count">${totalDocsCat}</span>
            </div>
            ${childrenHtml}
          </div>
        `;
      }).join('');

      treeRootEl.querySelectorAll<HTMLElement>('.tree-chevron-btn').forEach((btn) => {
        btn.addEventListener('click', (e: MouseEvent) => {
          e.stopPropagation();
          const key = btn.getAttribute('data-toggle-node');
          if (!key) return;
          if (expandedTreeNodes.has(key)) expandedTreeNodes.delete(key);
          else expandedTreeNodes.add(key);
          renderTree();
        });
      });

      treeRootEl.querySelectorAll<HTMLElement>('.tree-node-row').forEach((row) => {
        row.addEventListener('click', (e: MouseEvent) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('.tree-chevron-btn')) return;

          const cat = row.getAttribute('data-tree-cat') || 'conceptos_internos';
          const fId = row.getAttribute('data-tree-folder') || null;
          currentCategoria = cat;
          currentFolderId = fId;
          ensureFolderAncestorsExpanded(fId);

          if (isSearchActive) {
            if (searchInput) searchInput.value = '';
            currentYearFilter = 'todos';
            currentTemaFilter = 'todos';
            if (anioSelect) {
              anioSelect.value = 'todos';
              (window as any).refrescarSelectPersonalizado?.(anioSelect);
            }
            if (temaSelect) {
              temaSelect.value = 'todos';
              (window as any).refrescarSelectPersonalizado?.(temaSelect);
            }
            isSearchActive = false;
            syncQuickClearVisibility();
            if (searchPanel) searchPanel.style.display = 'none';
            if (normalPanel) normalPanel.style.display = 'block';
          }

          if (window.innerWidth < 960 && treePanel?.classList.contains('is-open')) {
            treePanel.classList.remove('is-open');
            mobileTreeToggleBtn?.setAttribute('aria-expanded', 'false');
          }

          renderTree();
          renderExplorer();
        });
      });
    }

    // Colapsar / expandir árbol desde encabezado izquierdo
    treeToggleAllBtn?.addEventListener('click', () => {
      const anyFolderExpanded = carpetas.some((c: any) => expandedTreeNodes.has(`folder:${c.id}`));
      if (anyFolderExpanded) {
        carpetas.forEach((c: any) => expandedTreeNodes.delete(`folder:${c.id}`));
      } else {
        rootCategories.forEach((c) => expandedTreeNodes.add(`cat:${c.key}`));
        carpetas.forEach((c: any) => expandedTreeNodes.add(`folder:${c.id}`));
      }
      renderTree();
    });

    // Toggle árbol móvil (< 960px)
    mobileTreeToggleBtn?.addEventListener('click', () => {
      if (!treePanel) return;
      const openNow = treePanel.classList.toggle('is-open');
      mobileTreeToggleBtn.setAttribute('aria-expanded', openNow ? 'true' : 'false');
    });

    // Botón "← Volver" al nivel superior
    folderBackBtn?.addEventListener('click', () => {
      if (!currentFolderId) return;
      const activeFolder = carpetas.find((c: any) => c.id === currentFolderId);
      currentFolderId = activeFolder?.parent_id || null;
      renderTree();
      renderExplorer();
    });

    // Cambiar Ámbito de Búsqueda
    scopeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        userSelectedScope = true;
        currentSearchScope = btn.getAttribute('data-scope') || 'all';
        syncScopeButtonsUI();
        triggerDeepSearch();
      });
    });

    // Filtro por Año (Select)
    anioSelect?.addEventListener('change', () => {
      currentYearFilter = anioSelect.value || 'todos';
      triggerDeepSearch();
    });

    // Filtro por Tema (Select)
    temaSelect?.addEventListener('change', () => {
      currentTemaFilter = temaSelect.value || 'todos';
      triggerDeepSearch();
    });

    // Modos de Visualización
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentViewMode = btn.getAttribute('data-mode') || 'carpetas';
        if (isSearchActive) {
          // Si estaba filtrando por año/tema únicamente, volver a modo normal en esa vista
          if (!searchInput?.value.trim()) {
            isSearchActive = false;
            if (searchPanel) searchPanel.style.display = 'none';
            if (normalPanel) normalPanel.style.display = 'block';
          }
        }
        renderExplorer();
      });
    });

    // Búsqueda en tiempo real con debounce + botón X rápido
    let searchDebounceTimer: any = null;
    searchInput?.addEventListener('input', () => {
      syncQuickClearVisibility();
      if (searchInput.value.trim().length > 0 && !userSelectedScope && currentSearchScope !== 'all') {
        currentSearchScope = 'all';
        syncScopeButtonsUI();
      }
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        triggerDeepSearch();
      }, 240);
    });

    quickClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      syncQuickClearVisibility();
      triggerDeepSearch();
    });

    function resetAllSearchAndFilters() {
      if (searchInput) searchInput.value = '';
      currentYearFilter = 'todos';
      currentTemaFilter = 'todos';
      userSelectedScope = false;
      currentSearchScope = 'all';
      syncScopeButtonsUI();
      syncQuickClearVisibility();

      if (anioSelect) {
        anioSelect.value = 'todos';
        (window as any).refrescarSelectPersonalizado?.(anioSelect);
      }
      if (temaSelect) {
        temaSelect.value = 'todos';
        (window as any).refrescarSelectPersonalizado?.(temaSelect);
      }
      isSearchActive = false;
      if (searchPanel) searchPanel.style.display = 'none';
      if (normalPanel) normalPanel.style.display = 'block';
      renderTree();
      renderExplorer();
    }

    clearSearchBtn?.addEventListener('click', resetAllSearchAndFilters);

    // Disparar Búsqueda Profunda Universal
    async function triggerDeepSearch() {
      const q = (searchInput?.value || '').trim();
      const hasFilters = currentYearFilter !== 'todos' || currentTemaFilter !== 'todos';

      if (!q && !hasFilters) {
        isSearchActive = false;
        if (searchPanel) searchPanel.style.display = 'none';
        if (normalPanel) normalPanel.style.display = 'block';
        renderTree();
        renderExplorer();
        return;
      }

      isSearchActive = true;
      renderTree();
      if (normalPanel) normalPanel.style.display = 'none';
      if (searchPanel) searchPanel.style.display = 'block';

      if (resultsContainer) {
        resultsContainer.innerHTML = '<div style="text-align: center; padding: 28px; color: #64748B; font-size: 0.85rem;">Buscando en metadatos y contenido indexado...</div>';
      }

      try {
        const catParam = currentSearchScope === 'all' ? 'todas' : currentCategoria;
        let url = `/api/juridico/buscar?q=${encodeURIComponent(q)}&categoria=${catParam}&anio=${encodeURIComponent(currentYearFilter)}&tema=${encodeURIComponent(currentTemaFilter)}`;
        if (currentSearchScope === 'section' && currentFolderId) {
          url += `&carpeta_id=${encodeURIComponent(currentFolderId)}`;
        }

        const res = await fetch(url, { credentials: 'same-origin' });
        const data = await res.json();

        if (!data.success) {
          if (resultsContainer) resultsContainer.innerHTML = `<div style="color: #DC2626; padding: 18px;">Error: ${escapeHtml(data.error || 'No se pudo realizar la búsqueda.')}</div>`;
          return;
        }

        renderSearchResults(data);
      } catch (err) {
        console.error('Error buscando:', err);
        if (resultsContainer) resultsContainer.innerHTML = '<div style="color: #DC2626; padding: 18px;">Error de red en la búsqueda profunda.</div>';
      }
    }

    // BLOQUE 3: Renderizar Resultados de Búsqueda claros con ruta clicable y snippet
    function renderSearchResults(data: any) {
      const docs: any[] = data.documentos || [];
      const carps: any[] = data.carpetas || [];
      const totalCount = docs.length + carps.length;

      if (resultsCountLabel) {
        resultsCountLabel.textContent = data.query
          ? `Resultados para "${data.query}" (${totalCount} coincidencia${totalCount === 1 ? '' : 's'})`
          : `Resultados filtrados (${totalCount} coincidencia${totalCount === 1 ? '' : 's'})`;
      }

      if (resultsQueryLabel) {
        const activeFilterTags: string[] = [];
        if (currentSearchScope === 'section') {
          const activeLabel = currentFolderId
            ? (carpetas.find((c: any) => c.id === currentFolderId)?.nombre || 'Carpeta actual')
            : (catLabels[currentCategoria] || currentCategoria);
          activeFilterTags.push(`En: ${activeLabel}`);
        } else {
          activeFilterTags.push('Todo Jurídico');
        }
        if (currentYearFilter !== 'todos') activeFilterTags.push(`Año ${currentYearFilter}`);
        if (currentTemaFilter !== 'todos') activeFilterTags.push(`Tema: ${currentTemaFilter}`);
        resultsQueryLabel.textContent = activeFilterTags.length ? `· ${activeFilterTags.join(' · ')}` : '';
      }

      if (totalCount === 0) {
        if (resultsContainer) {
          resultsContainer.innerHTML = `
            <div class="juridico-empty-state" style="justify-content: center; text-align: center; padding: 34px 20px; flex-direction: column;">
              <div class="juridico-empty-icon" style="width: 44px; height: 44px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              </div>
              <div>
                <strong style="display: block; font-weight: 800; font-size: 0.95rem; color: #0F172A;">No se encontraron coincidencias</strong>
                <span style="font-size: 0.79rem; color: #64748B;">Pruebe con otro término, amplíe a "Todo Jurídico" o limpie los filtros de año/tema.</span>
              </div>
            </div>
          `;
        }
        return;
      }

      let html = '';

      // Grupo superior: Carpetas coincidentes
      if (carps.length > 0) {
        html += `<div class="search-group-label">Carpetas coincidentes (${carps.length})</div>`;
        carps.forEach((c: any) => {
          html += `
            <div class="result-search-card" style="border-left: 4px solid #00594E !important;">
              <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
                  <span style="color: #00594E; display: inline-flex; flex-shrink: 0;">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>
                  </span>
                  <div style="min-width: 0;">
                    <strong style="font-size: 0.94rem; color: #0F172A;">${escapeHtml(c.nombre)}</strong>
                    <div style="font-size: 0.73rem; color: #64748B; margin-top: 2px;">Ubicación padre: ${escapeHtml(c.breadcrumb)}</div>
                  </div>
                </div>
                <button type="button" class="result-path-chip btn-jump-folder" data-cat="${escapeHtml(c.categoria_raiz)}" data-id="${escapeHtml(c.id)}">
                  <span>Abrir carpeta &rarr;</span>
                </button>
              </div>
              ${c.descripcion ? `<div style="font-size: 0.76rem; color: #475569;">${escapeHtml(c.descripcion)}</div>` : ''}
            </div>
          `;
        });
      }

      // Documentos encontrados con ruta clicable y snippet
      if (docs.length > 0) {
        if (carps.length > 0) {
          html += `<div class="search-group-label" style="margin-top: 6px;">Documentos encontrados (${docs.length})</div>`;
        }
        docs.forEach((d: any) => {
          const ext = (d.archivo_nombre || '').split('.').pop()?.toUpperCase() || 'DOC';
          const sizeKb = d.archivo_tamano ? (d.archivo_tamano / 1024).toFixed(1) : '0';
          const safeSnippet = d.snippet ? sanitizeSnippetHtml(d.snippet) : '';

          html += `
            <div class="result-search-card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px;">
                <div style="display: flex; align-items: flex-start; gap: 11px; min-width: 0; flex: 1;">
                  <span class="doc-ext-badge ${getExtBadgeClass(ext)}">${escapeHtml(ext)}</span>
                  <div style="min-width: 0; flex: 1;">
                    <h4 class="doc-title-main">${escapeHtml(d.titulo)}</h4>
                    <div class="doc-meta-line">
                      <span class="doc-chip-year">Año ${escapeHtml(d.anio)}</span>
                      ${d.tema ? `<span class="doc-chip-tema">${escapeHtml(d.tema)}</span>` : ''}
                      <span>${sizeKb} KB</span>
                      ${d.isContentMatch ? `<span class="doc-chip-indexed">&check; Coincidencia en texto indexado</span>` : ''}
                    </div>
                  </div>
                </div>

                <div class="doc-actions-inline">
                  <a href="${escapeHtml(d.archivo_url)}" target="_blank" rel="noopener noreferrer" class="btn-doc-view">
                    ${VIEW_SVG}
                    <span>Ver</span>
                  </a>
                  <a href="${escapeHtml(d.archivo_url)}" download="${escapeHtml(d.archivo_nombre || 'documento')}" class="btn-doc-download">
                    ${DOWNLOAD_SVG}
                    <span>Descargar</span>
                  </a>
                </div>
              </div>

              <div>
                <button type="button" class="result-path-chip btn-jump-folder" data-cat="${escapeHtml(d.categoria_raiz)}" data-id="${escapeHtml(d.carpeta_id || '')}" title="Abrir esta carpeta en el explorador">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>
                  <span>${escapeHtml(d.breadcrumb)}</span>
                </button>
              </div>

              ${safeSnippet ? `
                <div class="result-snippet-box">${safeSnippet}</div>
              ` : ''}
            </div>
          `;
        });
      }

      if (resultsContainer) {
        resultsContainer.innerHTML = html;
        attachJumpEvents();
      }
    }

    function attachJumpEvents() {
      document.querySelectorAll<HTMLElement>('.btn-jump-folder').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          const folderId = btn.getAttribute('data-id') || null;
          if (cat) currentCategoria = cat;
          currentFolderId = folderId;
          ensureFolderAncestorsExpanded(folderId);
          resetAllSearchAndFilters();
        });
      });
    }

    function renderDocumentRowHtml(d: any): string {
      const ext = (d.archivo_nombre || '').split('.').pop()?.toUpperCase() || 'DOC';
      const sizeKb = d.archivo_tamano ? (d.archivo_tamano / 1024).toFixed(1) : '0';
      const hasText = Boolean(d.contenido_extraido && d.contenido_extraido.length > 0);

      return `
        <div class="document-row-card">
          <div style="display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1;">
            <span class="doc-ext-badge ${getExtBadgeClass(ext)}">${escapeHtml(ext)}</span>
            <div style="min-width: 0; flex: 1;">
              <h4 class="doc-title-main">${escapeHtml(d.titulo)}</h4>
              <div class="doc-meta-line">
                <span class="doc-chip-year">Año ${escapeHtml(d.anio)}</span>
                ${d.tema ? `<span class="doc-chip-tema">${escapeHtml(d.tema)}</span>` : ''}
                <span>${sizeKb} KB</span>
                ${hasText ? `<span class="doc-chip-indexed">&check; Texto indexado</span>` : `<span style="color: #64748B; font-style: italic;">Sin texto extraíble</span>`}
              </div>
            </div>
          </div>

          <div class="doc-actions-inline">
            <a href="${escapeHtml(d.archivo_url)}" target="_blank" rel="noopener noreferrer" class="btn-doc-view">
              ${VIEW_SVG}
              <span>Ver</span>
            </a>
            <a href="${escapeHtml(d.archivo_url)}" download="${escapeHtml(d.archivo_nombre || 'documento')}" class="btn-doc-download">
              ${DOWNLOAD_SVG}
              <span>Descargar</span>
            </a>
            <button type="button" class="btn-delete-doc" data-id="${escapeHtml(d.id)}" data-name="${escapeHtml(d.titulo)}" title="Eliminar documento" aria-label="Eliminar documento">
              ${TRASH_SVG}
            </button>
          </div>
        </div>
      `;
    }

    function attachDocumentDeleteListeners() {
      documentsList?.querySelectorAll<HTMLElement>('.btn-delete-doc').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name') || 'este documento';
          if (!id) return;

          const confirmed = typeof (window as any).showConfirm === 'function'
            ? await (window as any).showConfirm(`¿Eliminar el documento "${name}"?`, 'Confirmar Eliminación')
            : confirm(`¿Eliminar el documento "${name}"?`);
          if (!confirmed) return;

          try {
            const res = await fetch('/api/juridico/eliminar', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ tipo: 'documento', id }),
            });
            const data = await res.json();
            if (data.success) {
              documentos = documentos.filter((doc: any) => doc.id !== id);
              (window as any).showToast?.(`Documento "${name}" eliminado.`, 'success');
              renderTree();
              renderExplorer();
            } else {
              (window as any).showToast?.('Error al eliminar: ' + (data.error || 'Error'), 'error');
            }
          } catch {
            (window as any).showToast?.('Error de conexión al eliminar el documento.', 'error');
          }
        });
      });
    }

    // Renderizar Explorador Normal en Panel Derecho
    function renderExplorer() {
      renderBreadcrumbs();
      updateLocationHeader();

      const currentSubfolders = carpetas.filter((c: any) => {
        if (c.categoria_raiz !== currentCategoria) return false;
        return currentFolderId === null ? !c.parent_id : c.parent_id === currentFolderId;
      });

      const currentDocs = documentos.filter((d: any) => {
        if (d.categoria_raiz !== currentCategoria) return false;
        if (currentViewMode === 'carpetas') {
          return currentFolderId === null ? !d.carpeta_id : d.carpeta_id === currentFolderId;
        }
        // En modos "Por Año" / "Por Tema": mostrar todos los de la subcarpeta actual (o toda la categoría si está en raíz)
        return currentFolderId === null ? true : d.carpeta_id === currentFolderId;
      });

      const showSubfoldersSection = currentViewMode === 'carpetas' && currentSubfolders.length > 0;
      const showDocumentsSection = currentDocs.length > 0;

      // Subsección 1: Subcarpetas (OCULTAR completamente cuando length === 0)
      if (subfoldersSection) {
        subfoldersSection.style.display = showSubfoldersSection ? 'block' : 'none';
      }
      if (subfoldersCountPill) {
        subfoldersCountPill.textContent = `${currentSubfolders.length} subcarpeta${currentSubfolders.length === 1 ? '' : 's'}`;
      }
      if (subfoldersGrid && showSubfoldersSection) {
        subfoldersGrid.innerHTML = currentSubfolders.map((c: any) => {
          const directDocsCount = documentos.filter((d: any) => d.carpeta_id === c.id).length;
          const totalSubDocs = countFolderSubtreeDocs(c.id);
          const countLabel = totalSubDocs === directDocsCount
            ? `${directDocsCount} archivo${directDocsCount === 1 ? '' : 's'}`
            : `${totalSubDocs} archivo${totalSubDocs === 1 ? '' : 's'}`;

          return `
            <div class="folder-card" data-folder-id="${escapeHtml(c.id)}">
              <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
                <span style="color: #00594E; display: flex; align-items: center; flex-shrink: 0;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>
                </span>
                <div style="min-width: 0; flex: 1;">
                  <strong style="font-size: 0.86rem; color: #0F172A; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(c.nombre)}">
                    ${escapeHtml(c.nombre)}
                  </strong>
                  <div style="font-size: 0.71rem; color: #64748B; margin-top: 2px; display: flex; align-items: center; gap: 5px; flex-wrap: wrap;">
                    ${c.anio ? `<span class="doc-chip-year">${escapeHtml(c.anio)}</span>` : ''}
                    <span>${countLabel}</span>
                  </div>
                </div>
              </div>
              <button type="button" class="btn-delete-folder" data-id="${escapeHtml(c.id)}" data-name="${escapeHtml(c.nombre)}" title="Eliminar subcarpeta" aria-label="Eliminar subcarpeta">
                ${TRASH_SVG}
              </button>
            </div>
          `;
        }).join('');

        subfoldersGrid.querySelectorAll<HTMLElement>('.folder-card').forEach((card) => {
          card.addEventListener('click', (e: MouseEvent) => {
            const target = e.target as HTMLElement | null;
            if (target?.closest('.btn-delete-folder')) return;
            const fId = card.getAttribute('data-folder-id');
            if (fId) {
              currentFolderId = fId;
              ensureFolderAncestorsExpanded(fId);
              renderTree();
              renderExplorer();
            }
          });
        });

        subfoldersGrid.querySelectorAll<HTMLElement>('.btn-delete-folder').forEach((btn) => {
          btn.addEventListener('click', async (e: MouseEvent) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name') || 'esta subcarpeta';
            if (!id) return;

            const confirmed = typeof (window as any).showConfirm === 'function'
              ? await (window as any).showConfirm(`¿Eliminar la subcarpeta "${name}" y todos sus documentos contenidos?`, 'Confirmar Eliminación')
              : confirm(`¿Eliminar la subcarpeta "${name}" y todos sus documentos contenidos?`);
            if (!confirmed) return;

            try {
              const res = await fetch('/api/juridico/eliminar', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tipo: 'carpeta', id }),
              });
              const data = await res.json();
              if (data.success) {
                carpetas = carpetas.filter((c: any) => c.id !== id);
                documentos = documentos.filter((d: any) => d.carpeta_id !== id);
                if (currentFolderId === id) currentFolderId = null;
                (window as any).showToast?.(`Subcarpeta "${name}" eliminada.`, 'success');
                renderTree();
                renderExplorer();
              } else {
                (window as any).showToast?.('Error al eliminar: ' + (data.error || 'Error'), 'error');
              }
            } catch {
              (window as any).showToast?.('Error de conexión al eliminar la subcarpeta.', 'error');
            }
          });
        });
      }

      // Subsección 2: Documentos (o agrupados Por Año / Por Tema)
      if (documentsSection) {
        documentsSection.style.display = showDocumentsSection ? 'block' : 'none';
      }
      if (documentsHeadingEl) {
        documentsHeadingEl.textContent = currentViewMode === 'anio'
          ? 'DOCUMENTOS AGRUPADOS POR AÑO'
          : currentViewMode === 'tema'
            ? 'DOCUMENTOS AGRUPADOS POR TEMA'
            : 'DOCUMENTOS';
      }
      if (documentsCountPill) {
        documentsCountPill.textContent = `${currentDocs.length} documento${currentDocs.length === 1 ? '' : 's'}`;
      }

      if (documentsList && showDocumentsSection) {
        if (currentViewMode === 'anio') {
          const groups = new Map<string, any[]>();
          currentDocs.forEach((d: any) => {
            const k = d.anio ? `Año ${d.anio}` : 'Sin año';
            if (!groups.has(k)) groups.set(k, []);
            groups.get(k)!.push(d);
          });
          const sortedKeys = Array.from(groups.keys()).sort((a, b) => b.localeCompare(a));
          documentsList.innerHTML = sortedKeys.map((gKey) => {
            const items = groups.get(gKey) || [];
            return `
              <div class="juridico-group-block">
                <div class="juridico-group-title">
                  <span>${escapeHtml(gKey)}</span>
                  <span style="font-size: 0.72rem; font-weight: 700;">${items.length} archivo${items.length === 1 ? '' : 's'}</span>
                </div>
                <div class="documents-list">${items.map(renderDocumentRowHtml).join('')}</div>
              </div>
            `;
          }).join('');
        } else if (currentViewMode === 'tema') {
          const groups = new Map<string, any[]>();
          currentDocs.forEach((d: any) => {
            const k = d.tema ? String(d.tema).trim() : 'Sin tema asignado';
            if (!groups.has(k)) groups.set(k, []);
            groups.get(k)!.push(d);
          });
          const sortedKeys = Array.from(groups.keys()).sort((a, b) => a.localeCompare(b, 'es'));
          documentsList.innerHTML = sortedKeys.map((gKey) => {
            const items = groups.get(gKey) || [];
            return `
              <div class="juridico-group-block">
                <div class="juridico-group-title">
                  <span>${escapeHtml(gKey)}</span>
                  <span style="font-size: 0.72rem; font-weight: 700;">${items.length} archivo${items.length === 1 ? '' : 's'}</span>
                </div>
                <div class="documents-list">${items.map(renderDocumentRowHtml).join('')}</div>
              </div>
            `;
          }).join('');
        } else {
          documentsList.innerHTML = currentDocs.map(renderDocumentRowHtml).join('');
        }
        attachDocumentDeleteListeners();
      }

      // Estado vacío único (solo cuando no hay ni subcarpetas visibles ni documentos)
      if (combinedEmptyEl) {
        combinedEmptyEl.style.display = !showSubfoldersSection && !showDocumentsSection ? 'flex' : 'none';
      }
    }

    function updateLocationHeader() {
      const activeFolder = currentFolderId ? carpetas.find((c: any) => c.id === currentFolderId) : null;
      const currentSubfoldersCount = carpetas.filter((c: any) =>
        c.categoria_raiz === currentCategoria && (currentFolderId === null ? !c.parent_id : c.parent_id === currentFolderId)
      ).length;
      const currentDocsCount = documentos.filter((d: any) =>
        d.categoria_raiz === currentCategoria && (currentFolderId === null ? !d.carpeta_id : d.carpeta_id === currentFolderId)
      ).length;
      const totalItems = currentSubfoldersCount + currentDocsCount;

      if (folderBackBtn) {
        folderBackBtn.style.display = currentFolderId ? 'inline-flex' : 'none';
      }

      if (activeFolderTitleEl) {
        activeFolderTitleEl.textContent = activeFolder
          ? activeFolder.nombre
          : (catLabels[currentCategoria] || currentCategoria);
      }

      if (activeFolderBadgeEl) {
        activeFolderBadgeEl.textContent = `${totalItems} ítem${totalItems === 1 ? '' : 's'}`;
      }

      if (activeFolderMetaEl) {
        if (activeFolder) {
          const metaParts: string[] = [];
          if (activeFolder.anio) metaParts.push(`Año ${activeFolder.anio}`);
          if (activeFolder.tema) metaParts.push(`Tema: ${activeFolder.tema}`);
          if (activeFolder.descripcion) metaParts.push(activeFolder.descripcion);
          if (metaParts.length > 0) {
            activeFolderMetaEl.textContent = metaParts.join(' · ');
            activeFolderMetaEl.style.display = 'block';
          } else {
            activeFolderMetaEl.style.display = 'none';
          }
        } else {
          activeFolderMetaEl.style.display = 'none';
        }
      }
    }

    // Renderizar Breadcrumbs
    function renderBreadcrumbs() {
      if (!breadcrumbsNav) return;

      const segments: string[] = [
        `<button type="button" class="breadcrumb-btn breadcrumb-item root-link" data-level="root">Asuntos Jurídicos</button>`,
        `<span class="breadcrumb-sep">&rsaquo;</span>`,
        `<button type="button" class="breadcrumb-btn breadcrumb-item ${currentFolderId === null ? 'is-current active' : ''}" data-level="cat">${escapeHtml(catLabels[currentCategoria] || currentCategoria)}</button>`,
      ];

      if (currentFolderId) {
        const folderChain: any[] = [];
        let curr = carpetas.find((c: any) => c.id === currentFolderId);
        let depth = 0;

        while (curr && depth < 8) {
          folderChain.unshift(curr);
          curr = carpetas.find((c: any) => c.id === curr.parent_id);
          depth++;
        }

        folderChain.forEach((f: any, idx: number) => {
          segments.push(`<span class="breadcrumb-sep">&rsaquo;</span>`);
          const isLast = idx === folderChain.length - 1;
          segments.push(`
            <button type="button" class="breadcrumb-btn breadcrumb-item ${isLast ? 'is-current active' : ''}" data-level="folder" data-folder-id="${escapeHtml(f.id)}">
              ${escapeHtml(f.nombre)}
            </button>
          `);
        });
      }

      breadcrumbsNav.innerHTML = segments.join('');

      breadcrumbsNav.querySelectorAll<HTMLElement>('.breadcrumb-btn, .breadcrumb-item').forEach((item) => {
        item.addEventListener('click', () => {
          const level = item.getAttribute('data-level');
          if (level === 'root' || level === 'cat') {
            currentFolderId = null;
            renderTree();
            renderExplorer();
          } else if (level === 'folder') {
            const fId = item.getAttribute('data-folder-id');
            if (fId) {
              currentFolderId = fId;
              renderTree();
              renderExplorer();
            }
          }
        });
      });
    }

    // Modal: Nueva Subcarpeta
    const folderModal = document.getElementById('modal-new-folder') as HTMLElement | null;
    const openFolderModalBtn = document.getElementById('btn-open-new-folder-modal') as HTMLElement | null;
    const closeFolderModalBtn = document.getElementById('btn-close-new-folder') as HTMLElement | null;
    const cancelFolderModalBtn = document.getElementById('btn-cancel-new-folder') as HTMLElement | null;
    const folderForm = document.getElementById('form-new-folder') as HTMLFormElement | null;
    const folderNombreInput = document.getElementById('folder-input-nombre') as HTMLInputElement | null;
    const folderTemaInput = document.getElementById('folder-input-tema') as HTMLInputElement | null;
    const folderAnioInput = document.getElementById('folder-input-anio') as HTMLInputElement | null;
    const folderDescInput = document.getElementById('folder-input-desc') as HTMLTextAreaElement | null;
    const submitFolderBtn = document.getElementById('btn-submit-new-folder') as HTMLButtonElement | null;

    const openNewFolderModal = () => {
      if (folderForm) folderForm.reset();
      if (folderAnioInput) (window as any).refrescarSelectPersonalizado?.(folderAnioInput);
      if (folderModal) folderModal.style.display = 'flex';
    };

    openFolderModalBtn?.addEventListener('click', openNewFolderModal);
    document.querySelectorAll('.empty-quick-folder').forEach((btn) => {
      btn.addEventListener('click', openNewFolderModal);
    });

    const closeFolderModal = () => {
      if (folderModal) folderModal.style.display = 'none';
    };
    closeFolderModalBtn?.addEventListener('click', closeFolderModal);
    cancelFolderModalBtn?.addEventListener('click', closeFolderModal);
    folderModal?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === folderModal) closeFolderModal();
    });

    folderForm?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (!folderNombreInput?.value.trim()) return;
      if (submitFolderBtn) {
        submitFolderBtn.disabled = true;
        submitFolderBtn.textContent = 'Creando...';
      }

      try {
        const payload = {
          categoria_raiz: currentCategoria,
          parent_id: currentFolderId,
          nombre: folderNombreInput.value.trim(),
          tema: folderTemaInput?.value.trim() || null,
          anio: folderAnioInput?.value ? parseInt(folderAnioInput.value, 10) : null,
          descripcion: folderDescInput?.value.trim() || null,
        };

        const res = await fetch('/api/juridico/carpetas/crear', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (data.success && data.carpeta) {
          carpetas.push(data.carpeta);
          ensureFolderAncestorsExpanded(currentFolderId);
          if (data.carpeta.tema && temaSelect) {
            const existsOpt = Array.from(temaSelect.options).some((opt) => opt.value === data.carpeta.tema);
            if (!existsOpt) {
              const newOpt = document.createElement('option');
              newOpt.value = data.carpeta.tema;
              newOpt.textContent = data.carpeta.tema;
              temaSelect.appendChild(newOpt);
              (window as any).refrescarSelectPersonalizado?.(temaSelect);
            }
          }
          closeFolderModal();
          (window as any).showToast?.(`Subcarpeta "${data.carpeta.nombre}" creada.`, 'success');
          renderTree();
          renderExplorer();
        } else if (data.success) {
          window.location.reload();
        } else {
          (window as any).showToast?.('Error creando subcarpeta: ' + (data.error || 'Error'), 'error');
        }
      } catch (err) {
        console.error('Error:', err);
        (window as any).showToast?.('Error de conexión al crear subcarpeta.', 'error');
      } finally {
        if (submitFolderBtn) {
          submitFolderBtn.disabled = false;
          submitFolderBtn.textContent = 'Crear Subcarpeta';
        }
      }
    });

    // Modal: Subir Documento (CONSERVADO INTACTO)
    const docModal = document.getElementById('modal-upload-doc') as HTMLElement | null;
    const openDocModalBtn = document.getElementById('btn-open-upload-modal') as HTMLElement | null;
    const closeDocModalBtn = document.getElementById('btn-close-upload-doc') as HTMLElement | null;
    const cancelDocModalBtn = document.getElementById('btn-cancel-upload-doc') as HTMLElement | null;
    const docForm = document.getElementById('form-upload-doc') as HTMLFormElement | null;
    const docErrorBanner = document.getElementById('doc-upload-error-banner') as HTMLElement | null;
    const docErrorText = document.getElementById('doc-upload-error-text') as HTMLElement | null;
    const docFileInput = document.getElementById('doc-file-input') as HTMLInputElement | null;
    const browseDocFileBtn = document.getElementById('btn-browse-doc-file') as HTMLElement | null;
    const docFileLabel = document.getElementById('doc-file-label') as HTMLElement | null;
    const docTituloInput = document.getElementById('doc-input-titulo') as HTMLInputElement | null;
    const docAnioInput = document.getElementById('doc-input-anio') as HTMLSelectElement | null;
    const docTemaInput = document.getElementById('doc-input-tema') as HTMLInputElement | null;
    const docPalabrasInput = document.getElementById('doc-input-palabras') as HTMLInputElement | null;
    const docDescInput = document.getElementById('doc-input-desc') as HTMLTextAreaElement | null;
    const submitDocBtn = document.getElementById('btn-submit-upload-doc') as HTMLButtonElement | null;
    let selectedUploadFile: File | null = null;

    function showDocUploadError(msg: string) {
      if (docErrorBanner && docErrorText) {
        docErrorText.textContent = msg;
        docErrorBanner.style.display = 'flex';
        docErrorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      (window as any).showToast?.(msg, 'error');
    }

    function clearDocUploadError() {
      if (docErrorBanner) docErrorBanner.style.display = 'none';
      if (docErrorText) docErrorText.textContent = '';
    }

    function applySelectedFile(file: File | null) {
      selectedUploadFile = file;
      clearDocUploadError();
      if (file && docFileLabel) {
        docFileLabel.textContent = '';
        const nameSpan = document.createElement('span');
        nameSpan.textContent = file.name;
        nameSpan.style.cssText = 'display: block; word-break: break-word; line-height: 1.35;';

        const sizeSpan = document.createElement('span');
        sizeSpan.textContent = `${(file.size / 1024).toFixed(1)} KB`;
        sizeSpan.style.cssText = 'display: inline-block; margin-top: 4px; font-size: 0.71rem; font-weight: 700; color: #475569; background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 999px; padding: 1px 9px; white-space: nowrap;';

        docFileLabel.appendChild(nameSpan);
        docFileLabel.appendChild(sizeSpan);

        if (docTituloInput && !docTituloInput.value.trim()) {
          const cleanName = file.name.replace(/\.[^/.]+$/, '');
          docTituloInput.value = cleanName;
        }
      } else if (docFileLabel) {
        docFileLabel.textContent = 'Ningún archivo seleccionado *';
      }
    }

    browseDocFileBtn?.addEventListener('click', async (e: MouseEvent) => {
      e.preventDefault();
      clearDocUploadError();
      const modalOpener = (window as any)['abrirModalSubida'];
      if (typeof modalOpener === 'function') {
        const files = await modalOpener({
          titulo: 'Cargar Documento Jurídico',
          subtitulo: 'Arrastre el documento o examine en su equipo para extracción de texto e indexación',
          accept: '.pdf,.docx,.txt,.csv',
          multiple: false,
          textoConfirmar: 'Seleccionar Documento',
        });
        if (files && files[0]) {
          applySelectedFile(files[0]);
          if (docFileInput) {
            try {
              const dt = new DataTransfer();
              dt.items.add(files[0]);
              docFileInput.files = dt.files;
            } catch {
              // selectedUploadFile conserva el archivo aun si el navegador restringe asignar FileList
            }
          }
        }
      } else {
        docFileInput?.click();
      }
    });

    docFileInput?.addEventListener('change', () => {
      if (docFileInput.files && docFileInput.files[0]) {
        applySelectedFile(docFileInput.files[0]);
      }
    });

    const openUploadModal = () => {
      selectedUploadFile = null;
      clearDocUploadError();
      if (docForm) docForm.reset();
      if (docAnioInput) {
        (window as any).refrescarSelectPersonalizado?.(docAnioInput);
      }
      if (docFileLabel) docFileLabel.textContent = 'Ningún archivo seleccionado *';
      if (docModal) docModal.style.display = 'flex';
    };

    openDocModalBtn?.addEventListener('click', openUploadModal);
    document.querySelectorAll('.empty-quick-upload').forEach((btn) => {
      btn.addEventListener('click', openUploadModal);
    });

    const closeDocModal = () => {
      selectedUploadFile = null;
      clearDocUploadError();
      if (docModal) docModal.style.display = 'none';
    };
    closeDocModalBtn?.addEventListener('click', closeDocModal);
    cancelDocModalBtn?.addEventListener('click', closeDocModal);
    docModal?.addEventListener('click', (e: MouseEvent) => {
      if (e.target === docModal) closeDocModal();
    });

    docForm?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      clearDocUploadError();

      const fileToUpload = selectedUploadFile || (docFileInput?.files && docFileInput.files[0]) || null;
      if (!fileToUpload) {
        showDocUploadError('Por favor seleccione un archivo (.pdf, .docx, .txt o .csv) antes de subir e indexar.');
        return;
      }

      const tituloVal = (docTituloInput?.value || '').trim();
      if (!tituloVal) {
        showDocUploadError('El título del documento es obligatorio.');
        docTituloInput?.focus();
        return;
      }

      const anioVal = (docAnioInput?.value || '').trim();
      if (!anioVal) {
        showDocUploadError('Debe seleccionar el año del documento.');
        return;
      }

      if (submitDocBtn) {
        submitDocBtn.disabled = true;
        submitDocBtn.textContent = 'Subiendo e indexando...';
      }

      try {
        const formData = new FormData();
        formData.append('file', fileToUpload);
        formData.append('categoria_raiz', currentCategoria);
        if (currentFolderId) {
          formData.append('carpeta_id', currentFolderId);
        }
        formData.append('titulo', tituloVal);
        formData.append('anio', anioVal);
        if (docTemaInput?.value.trim()) formData.append('tema', docTemaInput.value.trim());
        if (docPalabrasInput?.value.trim()) formData.append('palabras_clave', docPalabrasInput.value.trim());
        if (docDescInput?.value.trim()) formData.append('descripcion', docDescInput.value.trim());

        const res = await fetch('/api/juridico/documentos/subir', {
          method: 'POST',
          credentials: 'same-origin',
          body: formData,
        });

        const rawText = await res.text();
        let data: any = {};
        try {
          data = rawText ? JSON.parse(rawText) : {};
        } catch {
          data = {};
        }

        if (!res.ok || !data.success) {
          const fallbackHttpMsg = res.status === 413
            ? 'El archivo supera el límite máximo permitido por el servidor (413).'
            : (rawText && !rawText.trim().startsWith('<') ? rawText.slice(0, 220) : `Error HTTP ${res.status} al subir el documento.`);
          const errorMsg = data.error || data.message || fallbackHttpMsg;
          showDocUploadError(errorMsg);
          return;
        }

        if (data.documento) {
          documentos.unshift(data.documento);
          if (data.documento.tema && temaSelect) {
            const existsOpt = Array.from(temaSelect.options).some((opt) => opt.value === data.documento.tema);
            if (!existsOpt) {
              const newOpt = document.createElement('option');
              newOpt.value = data.documento.tema;
              newOpt.textContent = data.documento.tema;
              temaSelect.appendChild(newOpt);
              (window as any).refrescarSelectPersonalizado?.(temaSelect);
            }
          }
        }

        closeDocModal();
        if (docForm) docForm.reset();

        (window as any).showToast?.(
          data.hasText
            ? `Documento "${tituloVal}" subido e indexado (${data.indexedChars || 0} caracteres).`
            : `Documento "${tituloVal}" subido exitosamente.`,
          'success'
        );

        renderTree();
        if (isSearchActive) {
          await triggerDeepSearch();
        } else {
          renderExplorer();
        }
      } catch (err: any) {
        console.error('Error subiendo documento jurídico:', err);
        showDocUploadError(err?.message || 'Error de conexión al intentar subir e indexar el documento.');
      } finally {
        if (submitDocBtn) {
          submitDocBtn.disabled = false;
          submitDocBtn.textContent = 'Subir e Indexar';
        }
      }
    });

    // Inicializar vista de 2 paneles
    renderTree();
    renderExplorer();
  </script>
</AppLayout>
