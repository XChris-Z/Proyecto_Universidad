      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 7px;
      background: #FEF2F2;
      border: 1px solid #FECACA;
      color: #DC2626;
      cursor: pointer;
      flex-shrink: 0;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    :global(.btn-delete-doc:hover) {
