---
// src/pages/relacionamiento.astro
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout title="Relacionamiento Institucional y Convenios" activeNav="relacionamiento">
  <div class="panel-box">
    <div class="panel-header" style="flex-wrap: wrap; gap: 14px;">
      <div>
        <div class="panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          <span>Relacionamiento Institucional y Cooperación</span>
        </div>
        <div style="font-size: 0.8rem; color: var(--secondary-light); font-weight: 600; margin-top: 4px;">
          Convenios con entes gubernamentales, cooperación nacional e internacional de la Universidad
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button class="btn btn-primary" id="btn-open-convenio-modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>+ Registrar Nuevo Convenio</span>
        </button>
      </div>
    </div>

    <div class="module-tabs" id="convenios-module-tabs">
      <button class="module-tab-btn active" data-ctab="all">
        <span>Todos los Convenios</span>
        <span class="tab-count" id="conv-count-all">11</span>
      </button>
      <button class="module-tab-btn" data-ctab="gubernamental">
        <span>Entes Gubernamentales</span>
        <span class="tab-count" id="conv-count-gob">4</span>
      </button>
      <button class="module-tab-btn" data-ctab="internacional">
        <span>Cooperación Internacional</span>
        <span class="tab-count" id="conv-count-int">3</span>
      </button>
      <button class="module-tab-btn" data-ctab="nacional">
        <span>Cooperación Nacional</span>
        <span class="tab-count" id="conv-count-nal">4</span>
      </button>
    </div>

    <div class="convenios-grid" id="convenios-cards-grid">
      <!-- Dinámico desde JS -->
    </div>
  </div>

  <!-- Modal: Registrar Nuevo Convenio Institucional -->
  <div class="modal-backdrop" id="new-convenio-modal">
    <div class="modal-card" style="max-width: 640px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          <span>Registrar Nuevo Convenio Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-new-conv-modal">&times;</button>
      </div>
      <form id="new-convenio-form">
        <div class="modal-body">
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Tipo de Cooperación *</label>
              <select class="form-select" id="select-conv-tipo" required>
                <option value="gubernamental">Ente Gubernamental (Gobernación / Alcaldía / Min)</option>
                <option value="internacional">Cooperación Internacional</option>
                <option value="nacional">Cooperación Nacional</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Número de Convenio *</label>
              <input type="text" class="form-input" id="input-conv-numero" placeholder="Ej: CONV-GOB-2026-009" required>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Entidad o Institución Aliada *</label>
            <input type="text" class="form-input" id="input-conv-entidad" placeholder="Ej: Gobernación de Casanare o Universidad Nacional Autónoma de México" required>
          </div>
          <div class="form-group">
            <label class="form-label">Objeto del Convenio *</label>
            <textarea class="form-textarea" id="input-conv-objeto" rows="2" placeholder="Describa el objetivo de la cooperación institucional..." required></textarea>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Fecha de Inicio *</label>
              <input type="date" class="form-input" id="input-conv-inicio" required>
            </div>
            <div class="form-group">
              <label class="form-label">Fecha de Terminación *</label>
              <input type="date" class="form-input" id="input-conv-fin" required>
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Supervisor Interno Unitrópico</label>
              <input type="text" class="form-input" id="input-conv-supervisor" placeholder="Ej: Vicerrectoría de Investigación">
            </div>
            <div class="form-group">
              <label class="form-label">Aporte / Cuantía</label>
              <input type="text" class="form-input" id="input-conv-cuantia" placeholder="Ej: $2.400.000.000 COP o Sin cuantía pecuniaria">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-new-conv">Cancelar</button>
          <button type="submit" class="btn btn-primary">Registrar Convenio</button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import { initRelacionamiento } from '@scripts/relacionamiento';
  initRelacionamiento();
</script>

