---
// src/pages/relacionamiento.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
import { formatNiceDate } from '@lib/utils';

// Consultar convenios institucionales reales en Supabase
const { data: dbConvenios } = await (supabase
  .from('convenios' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const conveniosList = dbConvenios || [];
const totalCount = conveniosList.length;
const gobCount = conveniosList.filter((c: any) => c.tipo === 'gubernamental').length;
const intCount = conveniosList.filter((c: any) => c.tipo === 'internacional').length;
const nalCount = conveniosList.filter((c: any) => c.tipo === 'nacional').length;

const LOWERCASE_CONNECTORS = new Set(['de', 'del', 'la', 'las', 'el', 'los', 'y', 'e', 'o', 'u', 'en', 'con', 'para', 'por', 'a', 'al']);

function formatEntityOrPersonName(raw?: string | null, fallback = ''): string {
  const clean = String(raw || '').trim().replace(/\s+/g, ' ');
  if (!clean) return fallback;
  return clean
    .split(' ')
    .map((word, idx) => {
      if (!word) return '';
      if (/^[A-ZÁÉÍÓÚÑ0-9.-]{2,}$/.test(word) && /[A-ZÁÉÍÓÚÑ]/.test(word)) {
        return word;
      }
      const lower = word.toLowerCase();
      if (idx > 0 && LOWERCASE_CONNECTORS.has(lower)) {
        return lower;
      }
      if (word !== lower && /[A-ZÁÉÍÓÚÑ]/.test(word.charAt(0))) {
        return word;
      }
      return lower.charAt(0).toUpperCase() + lower.slice(1);
    })
    .join(' ');
}

function formatSentenceText(raw?: string | null): string {
  const clean = String(raw || '').trim();
  if (!clean) return 'Sin objeto especificado.';
  return clean.charAt(0).toUpperCase() + clean.slice(1);
}

function formatCopCuantia(raw?: string | number | null): string {
  const str = String(raw ?? '').trim();
  if (!str || /^sin\s*cuant[ií]a$/i.test(str) || str === '0') {
    return 'Sin cuantía';
  }
  const stripped = str.replace(/COP/gi, '').replace(/\$/g, '').trim();
  if (/^[\d.\s,]+$/.test(stripped)) {
    const digitsOnly = stripped.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
    if (digitsOnly && digitsOnly !== '0') {
      return `$ ${digitsOnly.replace(/\B(?=(\d{3})+(?!\d))/g, '.')}`;
    }
    return 'Sin cuantía';
  }
  return str;
}

const SHORT_MONTHS_ES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

function formatVigenciaDate(dateStr?: string | null): string {
  if (!dateStr) return 'N/D';
  const match = String(dateStr).trim().match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (match) {
    const [, year, month, day] = match;
    const mIdx = parseInt(month!, 10) - 1;
    const monthAbbr = SHORT_MONTHS_ES[mIdx] || month;
    return `${day} ${monthAbbr} ${year}`;
  }
  try {
    return formatNiceDate(String(dateStr).slice(0, 10)).replace(/\./g, '').replace(/\s+/g, ' ').trim();
  } catch {
    return String(dateStr);
  }
}

function formatConvenioCode(numero?: string | null): string {
  const clean = String(numero || '').trim();
  if (!clean) return '#SIN-NUM';
  return clean.startsWith('#') ? clean : `#${clean}`;
}
---

<AppLayout title="Relacionamiento Institucional y Convenios" activeNav="relacionamiento">
  <section class="module-board-card relacionamiento-container">
    
    <!-- Cabecera Sobria y Ejecutiva (Bento Pro Max) -->
    <div class="module-board-header">
      <div style="min-width: 0; flex: 1;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h1 style="font-size: 1.55rem; font-weight: 800; color: #111827; margin: 0; letter-spacing: -0.01em;">Relacionamiento Institucional y Convenios</h1>
          <span style="font-size: 0.72rem; font-weight: 800; background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; padding: 3px 10px; border-radius: 999px;">Alianzas Estratégicas</span>
        </div>
        <p style="font-size: 0.86rem; color: #52606D; margin: 6px 0 0 0;">
          Convenios con entes gubernamentales, cooperación nacional e internacional de la Universidad Internacional del Trópico Americano.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <button class="btn btn-primary" id="btn-open-convenio-modal" style="background: #00594E; border: 1.5px solid #00594E; color: #ffffff; font-weight: 800; font-size: 0.84rem; border-radius: 10px; padding: 10px 20px; box-shadow: 0 2px 8px rgba(0, 89, 78, 0.25); cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          <span>Registrar Nuevo Convenio</span>
        </button>
      </div>
    </div>

    <!-- Pestañas de Navegación Estilizadas con Contadores -->
    <div class="module-tabs-container module-tabs" id="convenios-module-tabs" role="tablist">
      <button class="module-tab-btn active" data-ctab="all" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Todos los Convenios</span>
        <span class="tab-count" id="conv-count-all" style="background: #00594E; color: #ffffff; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{totalCount}</span>
      </button>
      <button class="module-tab-btn" data-ctab="gubernamental" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Entes Gubernamentales</span>
        <span class="tab-count" id="conv-count-gob" style="background: #B2CFCB; color: #00594E; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{gobCount}</span>
      </button>
      <button class="module-tab-btn" data-ctab="internacional" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Cooperación Internacional</span>
        <span class="tab-count" id="conv-count-int" style="background: #DBD2B0; color: #786832; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{intCount}</span>
      </button>
      <button class="module-tab-btn" data-ctab="nacional" style="padding: 10px 18px; border-radius: 10px; font-size: 0.82rem; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;">
        <span>Cooperación Nacional</span>
        <span class="tab-count" id="conv-count-nal" style="background: #E2E8F0; color: #475569; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 800;">{nalCount}</span>
      </button>
    </div>

    <!-- Buscador en tiempo real de Convenios -->
    <div class="search-bar-wrapper filter-bar" style="padding: 12px 18px;">
      <div style="position: relative; width: 100%;">
        <input type="text" id="convenios-search-input" placeholder="Buscar convenio por número (Ej: CONV-2026), entidad, supervisor u objeto..." class="form-input" style="padding-left: 38px; border-radius: 10px; border: 1.5px solid #DCE4E3; font-size: 0.85rem; height: 42px; width: 100%; box-sizing: border-box; background: #FFFFFF;" />
        <div style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748B; display: flex; align-items: center; pointer-events: none;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </div>
      </div>
    </div>

    <!-- Tarjeta Contenedora Principal con Scrollbar Interna Propia -->
    <div class="table-wrapper relacionamiento-board-wrapper" style="padding: 18px;">
      <div class="pro-scroll-container records-card-body relacionamiento-scroll" style="max-height: 620px; overflow-y: auto; overflow-x: hidden; width: 100%; padding: 4px;">
        <div class="convenios-grid" id="convenios-cards-grid">
          {conveniosList.length > 0 ? (
            conveniosList.map((c: any) => {
              const categoryLabel = c.tipo_label || (c.tipo === 'gubernamental' ? 'Ente Gubernamental' : c.tipo === 'internacional' ? 'Cooperación Internacional' : 'Cooperación Nacional');
              const formattedCode = formatConvenioCode(c.numero);
              const formattedEntidad = formatEntityOrPersonName(c.entidad, 'Entidad Aliada');
              const formattedObjeto = formatSentenceText(c.objeto);
              const formattedVigencia = `${formatVigenciaDate(c.inicio)} → ${formatVigenciaDate(c.fin)}`;
              const formattedCuantia = formatCopCuantia(c.cuantia);
              const formattedSupervisor = formatEntityOrPersonName(c.supervisor, 'Secretaría General');
              const estadoLabel = String(c.estado || 'Activo / En Ejecución').trim();

              return (
                <article class="convenio-card" data-tipo={c.tipo}>
                  <div class="convenio-card-body-wrap">
                    <div class="convenio-card-header">
                      <span class={`convenio-type-badge ${c.tipo}`}>
                        {categoryLabel}
                      </span>
                      <span class="convenio-code-chip" title={`Convenio ${formattedCode}`}>
                        {formattedCode}
                      </span>
                    </div>

                    <h4 class="convenio-entity-title">
                      {formattedEntidad}
                    </h4>
                    <p class="convenio-objeto-desc">
                      {formattedObjeto}
                    </p>

                    <div class="convenio-meta-box">
                      <div class="convenio-meta-item">
                        <span class="convenio-meta-label">Vigencia:</span>
                        <strong class="convenio-meta-value convenio-vigencia-val">{formattedVigencia}</strong>
                      </div>
                      <div class="convenio-meta-item">
                        <span class="convenio-meta-label">Cuantía / Aporte:</span>
                        <strong class="convenio-meta-value convenio-cuantia-val">{formattedCuantia}</strong>
                      </div>
                      <div class="convenio-meta-item">
                        <span class="convenio-meta-label">Supervisor:</span>
                        <span class="convenio-meta-value convenio-supervisor-val">{formattedSupervisor}</span>
                      </div>
                    </div>
                  </div>

                  <div class="convenio-card-footer">
                    <span class="convenio-status-badge">
                      {estadoLabel}
                    </span>
                    <div class="convenio-card-actions">
                      <button
                        type="button"
                        class="btn-convenio-minuta"
                        onclick={`window.showToast('Descargando expediente ${c.numero}...')`}
                        title="Descargar minuta y constancia formal"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        <span>Minuta</span>
                      </button>
                    </div>
                  </div>
                </article>
              );
            })
          ) : (
            <div style="grid-column: 1 / -1; text-align: center; padding: 48px 16px; color: #64748B; background: #F8FAFC; border-radius: 12px; border: 1px dashed #DCE4E3;">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="1.8" style="margin-bottom: 8px; display: inline-block;"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              <div style="font-weight: 800; color: #111827; font-size: 1rem;">No hay convenios registrados actualmente</div>
              <p style="font-size: 0.85rem; margin-top: 4px; color: #52606D;">Utilice el botón superior para registrar y formalizar un nuevo convenio institucional.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Modal: Registrar Nuevo Convenio Institucional -->
  <div class="modal-backdrop" id="new-convenio-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(2px);">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 640px; border-radius: 16px; box-shadow: 0 20px 45px rgba(0,0,0,0.2); overflow: hidden; border-top: 4px solid #00594E;">
      <div class="modal-header" style="background: #F2F7F6; border-bottom: 1.5px solid #DCE4E3; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #00594E; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          <span>Registrar Nuevo Convenio Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-new-conv-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #64748B; cursor: pointer; line-height: 1;">&times;</button>
      </div>
      <form id="new-convenio-form" style="padding: 24px; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Tipo de Cooperación *</label>
            <select class="form-select" id="select-conv-tipo" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required>
              <option value="gubernamental">Ente Gubernamental (Gobernación / Alcaldía / Min)</option>
              <option value="internacional">Cooperación Internacional</option>
              <option value="nacional">Cooperación Nacional</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Número de Convenio *</label>
            <input type="text" class="form-input" id="input-conv-numero" placeholder="Ej: CONV-GOB-2026-009" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required>
          </div>
        </div>
        <div class="form-group">
          <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Entidad o Institución Aliada *</label>
          <input type="text" class="form-input" id="input-conv-entidad" placeholder="Ej: Gobernación de Casanare o Universidad Nacional Autónoma de México" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required>
        </div>
        <div class="form-group">
          <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Objeto del Convenio *</label>
          <textarea class="form-textarea" id="input-conv-objeto" rows="2" placeholder="Describa el objetivo de la cooperación institucional..." style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required></textarea>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Fecha de Inicio *</label>
            <input type="date" class="form-input" id="input-conv-inicio" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required>
          </div>
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Fecha de Terminación *</label>
            <input type="date" class="form-input" id="input-conv-fin" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;" required>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Supervisor Interno Unitrópico</label>
            <input type="text" class="form-input" id="input-conv-supervisor" placeholder="Ej: Vicerrectoría de Investigación" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;">
          </div>
          <div class="form-group">
            <label style="font-size: 0.74rem; font-weight: 750; color: #52606D; text-transform: uppercase;">Aporte / Cuantía Estimada</label>
            <input type="text" class="form-input" id="input-conv-cuantia" placeholder="Ej: $2.400.000.000 COP o Sin cuantía" style="border-radius: 8px; border: 1.5px solid #DCE4E3; padding: 8px 12px; font-size: 0.82rem; width: 100%; box-sizing: border-box;">
          </div>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; padding-top: 14px; border-top: 1px solid #DCE4E3;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-new-conv" style="border: 1.5px solid #DCE4E3; color: #52606D; background: #ffffff; font-weight: 700; border-radius: 8px; padding: 8px 16px; cursor: pointer;">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-convenio" style="background: #00594E; border: none; color: #ffffff; font-weight: 800; border-radius: 8px; padding: 9px 20px; cursor: pointer; box-shadow: 0 2px 6px rgba(0,89,78,0.25);">Guardar Convenio</button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<style>
  .relacionamiento-container :global(.relacionamiento-board-wrapper) {
    width: 100%;
    box-sizing: border-box;
  }

  .relacionamiento-container :global(.convenios-grid),
  .relacionamiento-container :global(#convenios-cards-grid) {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)) !important;
    gap: 18px !important;
    width: 100%;
    margin-top: 0;
  }

  .relacionamiento-container :global(.convenio-card) {
    background: #ffffff;
    border: 1.5px solid #DCE4E3;
    border-radius: 14px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    min-width: 0;
    overflow-wrap: break-word;
    word-break: normal;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .relacionamiento-container :global(.convenio-card:hover) {
    border-color: #9EC5BE;
    box-shadow: 0 10px 24px -8px rgba(0, 89, 78, 0.14);
    transform: translateY(-2px);
  }

  .relacionamiento-container :global(.convenio-card-body-wrap) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .relacionamiento-container :global(.convenio-card-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .relacionamiento-container :global(.convenio-type-badge) {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 999px;
    background: #F2F7F6;
    color: #00594E;
    border: 1px solid #B2CFCB;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .relacionamiento-container :global(.convenio-type-badge.internacional) {
    background: #EAF4F2;
    color: #004239;
    border-color: #9EC5BE;
  }

  .relacionamiento-container :global(.convenio-type-badge.nacional) {
    background: #F7F5EE;
    color: #786832;
    border-color: #DBD2B0;
  }

  .relacionamiento-container :global(.convenio-code-chip) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 800;
    background: #F8FAFC;
    color: #00594E;
    border: 1px solid #DCE4E3;
    padding: 3px 9px;
    border-radius: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .relacionamiento-container :global(.convenio-entity-title) {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 6px 0;
    line-height: 1.35;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .relacionamiento-container :global(.convenio-objeto-desc) {
    color: #475569;
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0 0 14px 0;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .relacionamiento-container :global(.convenio-meta-box) {
    background: #F8FAFB;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.80rem;
  }

  .relacionamiento-container :global(.convenio-meta-item) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .relacionamiento-container :global(.convenio-meta-label) {
    color: #64748B;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .relacionamiento-container :global(.convenio-meta-value) {
    color: #0F172A;
    text-align: right;
    min-width: 0;
  }

  .relacionamiento-container :global(.convenio-vigencia-val) {
    font-weight: 700;
    color: #111827;
    white-space: nowrap;
  }

  .relacionamiento-container :global(.convenio-cuantia-val) {
    color: #00594E;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

