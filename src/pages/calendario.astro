    height: 13px;
    margin: 0;
  }
  .chip-color-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .chip-color-dot.peticion {
    background: #dc2626;
  }
  .chip-color-dot.reporte {
    background: #f59e0b;
  }
  .chip-color-dot.colegiado {
    background: #10b981;
  }

  /* Selector de vista con píldora deslizante */
  .view-segmented-control {
    position: relative;
    display: inline-flex;
    background: #f1f5f9;
    padding: 3px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    gap: 2px;
  }
  .view-indicator-pill {
    position: absolute;
    top: 3px;
    left: 0;
    bottom: 3px;
    background: #ffffff;
    border-radius: 7px;
    box-shadow:
      0 1px 4px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.04);
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }
  .gcal-view-btn {
    position: relative;
    z-index: 2;
    background: transparent;
    border: none;
    padding: 6px 13px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.18s ease;
