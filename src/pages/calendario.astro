  :global(.progress-remaining) {
    color: #0f172a;
    font-weight: 800;
  }

  :global(.timeline-card-actions) {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #e2e8f0;
    display: flex;
    justify-content: flex-end;
  }
  :global(.timeline-action-link) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.74rem;
    font-weight: 700;
    color: #00594e;
    text-decoration: none;
  }
  :global(.timeline-action-link:hover) {
    text-decoration: underline;
  }

  /* Estado vacío en timeline */
  :global(.timeline-empty-card) {
    text-align: center;
    padding: 36px 16px;
    color: #64748b;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    background: #f8fafc;
  }
  :global(.timeline-empty-card svg) {
    color: #94a3b8;
    margin-bottom: 8px;
  }
  :global(.timeline-empty-card h5) {
    font-size: 0.94rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px 0;
  }
  :global(.timeline-empty-card p) {
    font-size: 0.8rem;
    margin: 0 0 12px 0;
  }

  /* ==========================================================================
     VISTA GOOGLE EMBED OFICIAL
     ========================================================================== */
  .google-iframe-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    padding: 16px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }
  .iframe-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 12px;
  }
  .iframe-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #334155;
  }
  .google-calendar-frame {
    width: 100%;
    min-height: clamp(500px, 72dvh, 850px);
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  /* ==========================================================================
     MODALES PRO MAX
     ========================================================================== */
  .promax-glass-modal {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.25);
    max-width: 580px;
  }
  .modal-title-pro {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .modal-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(0, 89, 78, 0.1);
    color: #00594e;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promax-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 24px;
  }
  .form-row-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .form-label-pro {
    font-size: 0.8rem;
    font-weight: 750;
    color: #334155;
    margin-bottom: 4px;
    display: block;
  }
  .form-control-pro {
    width: 100%;
    padding: 9px 12px;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.86rem;
    font-family: inherit;
    background: #ffffff;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }
  .form-control-pro:focus {
    outline: none;
    border-color: #00594e;
    box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.14);
  }
  .resize-y {
    resize: vertical;
  }

  .modal-footer-pro {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 24px;
    border-top: 1px solid #f1f5f9;
  }

  /* ==========================================================================
     ANIMACIONES DE MOVIMIENTO: CROSSFADE & SHARED ELEMENT TRANSITIONS
     ========================================================================== */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 280ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.crossfade-enter) {
    animation: proMaxFadeEnter 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  :global(.crossfade-leave) {
    animation: proMaxFadeLeave 100ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes proMaxFadeEnter {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes proMaxFadeLeave {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-2px);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import {
    connectGoogleCalendar,
    disconnectGoogleCalendar,
  } from "@lib/calendar";
  import { initCalendario } from "@scripts/calendario";

  // 1. Manejo del Botón Conectar con Google Calendar
  const btnConnect = document.getElementById(
    "btn-connect-google",
  ) as HTMLButtonElement | null;
  const btnLabel = document.getElementById("btn-connect-label");

  if (btnConnect) {
    btnConnect.addEventListener("click", async () => {
      if (btnLabel) btnLabel.textContent = "Conectando con Google...";
      btnConnect.disabled = true;

      try {
        const userId = btnConnect.dataset.userId || "usr-root";
        await connectGoogleCalendar(userId);
      } catch (err: any) {
        console.error("Error conectando Google Calendar:", err);
        if ((window as any).showToast) {
          (window as any).showToast(
            "No se pudo conectar: " + (err.message || "Error de red"),
            "error",
          );
        }
        if (btnLabel) btnLabel.textContent = "Vincular Google Calendar";
        btnConnect.disabled = false;
      }
    });
  }

  // 2. Manejo de Desvincular Cuenta
  const btnDisconnect = document.getElementById(
    "btn-disconnect-calendar",
  ) as HTMLButtonElement | null;
  if (btnDisconnect) {
    btnDisconnect.addEventListener("click", async () => {
      const confirmed =
        typeof (window as any).showConfirm === "function"
          ? await (window as any).showConfirm(
              "¿Estás seguro de que deseas desvincular tu cuenta de Google Calendar institucional?",
              "Desvincular Google Calendar",
            )
          : true;

      if (!confirmed) return;

      btnDisconnect.disabled = true;

      try {
        const userId = btnDisconnect.dataset.userId || "usr-root";
        const ok = await disconnectGoogleCalendar(userId);

        if (ok) {
          const stateDisconnected =
            document.getElementById("state-disconnected");
          if (stateDisconnected) stateDisconnected.style.display = "block";

          if ((window as any).showToast) {
            (window as any).showToast(
              "Cuenta de Google Calendar desvinculada correctamente.",
              "success",
            );
          }
        }
      } catch (err: any) {
        if ((window as any).showToast) {
          (window as any).showToast(
            "Error al desvincular: " + err.message,
            "error",
          );
        }
      } finally {
        btnDisconnect.disabled = false;
      }
    });
  }

  // 3. Forzar Sincronización / Refrescar
  const btnForceSync = document.getElementById("btn-force-sync");
  const syncIcon = document.getElementById("sync-spinner-icon");
  const iframe = document.getElementById(
    "google-calendar-iframe",
  ) as HTMLIFrameElement;

  if (btnForceSync) {
    btnForceSync.addEventListener("click", () => {
      if (iframe) {
        const currentSrc = iframe.src;
        iframe.src = "";
        setTimeout(() => {
          iframe.src = currentSrc;
        }, 100);
      }
    });
  }

  // 4. Alternador de Pestañas: Agenda y Semáforo SLA vs Google Workspace Embed
  const tabBtnGoogle = document.getElementById("tab-btn-google-embed");
  const tabBtnSemaforo = document.getElementById("tab-btn-semaforo");
  const containerGoogle = document.getElementById("container-google-embed");
  const containerSemaforo = document.getElementById("container-semaforo-view");

  function switchCalendarTab(showSemaforo: boolean) {
    if (showSemaforo) {
      tabBtnSemaforo?.classList.add("active");
      tabBtnGoogle?.classList.remove("active");
      if (containerGoogle) containerGoogle.style.display = "none";
      if (containerSemaforo) containerSemaforo.style.display = "block";
    } else {
      tabBtnGoogle?.classList.add("active");
      tabBtnSemaforo?.classList.remove("active");
      if (containerGoogle) containerGoogle.style.display = "block";
      if (containerSemaforo) containerSemaforo.style.display = "none";
    }
  }

  tabBtnGoogle?.addEventListener("click", () => switchCalendarTab(false));
  tabBtnSemaforo?.addEventListener("click", () => switchCalendarTab(true));

  // 4.1 Activar cookies de Google si se requiere
  document
    .getElementById("btn-activate-cookies")
    ?.addEventListener("click", () => {
      window.open(
        "https://calendar.google.com/calendar/u/0/embed?ctz=America/Bogota",
        "gcal_auth",
        "width=660,height=640",
      );
    });

  // 5. Inicializar la agenda interactiva Pro Max inmediatamente
  initCalendario();
</script>
