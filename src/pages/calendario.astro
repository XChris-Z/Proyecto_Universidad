  :global(.gcal-cell-dots-preview) {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  :global(.gcal-sem-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  :global(.gcal-sem-dot.danger) {
    background: #dc2626;
    box-shadow: 0 0 4px rgba(220, 38, 38, 0.6);
  }
  :global(.gcal-sem-dot.warning) {
    background: #f59e0b;
    box-shadow: 0 0 4px rgba(245, 158, 11, 0.6);
  }
  :global(.gcal-sem-dot.safe) {
    background: #10b981;
    box-shadow: 0 0 4px rgba(16, 185, 129, 0.6);
  }
  :global(.gcal-sem-dot.completed) {
    background: #00594E;
    box-shadow: 0 0 0 1px #B5A160;
  }

  :global(.gcal-day-num) {
    font-size: 0.78rem;
    font-weight: 750;
