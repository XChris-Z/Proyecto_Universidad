---
// src/pages/calendario.astro
// Módulo de Calendario Institucional UI/UX Pro Max: Agenda y Semáforo SLA
// Crossfade y Shared Element Transitions
import AppLayout from "@layouts/AppLayout.astro";
import { supabase } from "@lib/supabase";
import { SESSION_COOKIE_KEY } from "@lib/constants";

// Obtener usuario autenticado desde la cookie de sesión del middleware
const sessionUserId =
  Astro.cookies.get(SESSION_COOKIE_KEY)?.value || "usr-root";

// Consultar perfil del usuario en Supabase PostgreSQL
const { data: userProfile } = await supabase
  .from("profiles")
  .select("id, email, full_name, google_calendar_connected, google_calendar_id")
  .or(`id.eq.${sessionUserId},email.eq.${sessionUserId}`)
  .maybeSingle();

const isConnected = !!userProfile?.google_calendar_connected;
const userEmail = userProfile?.email || "christianlemus.es@unitropico.edu.co";
const userId = userProfile?.id || sessionUserId;

// URL parametrizada para el componente embebido seguro de Google Calendar
const calendarEmbedUrl = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(userEmail)}&ctz=America/Bogota&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=1&showCalendars=0&showTz=1&mode=MONTH`;

// Manejo de parámetros de retorno de la sincronización
const isJustConnected = Astro.url.searchParams.get("connected") === "true";
const errorParam = Astro.url.searchParams.get("error");
---

<AppLayout
  title="Calendario Institucional y Semáforo SLA"
  activeNav="calendario"
>
  <div class="calendario-promax-workspace">
    <!-- Notificaciones visuales de estado -->
    {
      isJustConnected && (
        <div class="promax-banner success" id="alert-connect-success">
          <div class="banner-content">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <>
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </>
            </svg>
            <span>
              Google Calendar institucional sincronizado correctamente para{" "}
              <strong>{userEmail}</strong>.
            </span>
          </div>
          <button
            type="button"
            class="banner-close"
            onclick="this.parentElement.style.display='none'"
          >
            &times;
          </button>
        </div>
      )
    }

    {
      errorParam && (
        <div class="promax-banner warning" id="alert-connect-error">
          <div class="banner-content">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <>
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </>
            </svg>
            <span>
              {errorParam === "cancelled"
                ? "Se canceló la autorización de Google Calendar."
                : "No se pudo completar la sincronización con Google. La agenda opera con la base de datos en tiempo real."}
            </span>
          </div>
          <button
            type="button"
            class="banner-close"
            onclick="this.parentElement.style.display='none'"
          >
            &times;
          </button>
        </div>
      )
    }

    <!-- ================================================================= -->
    <!-- ESTADO 1: BANNER INFORMATIVO SI NO ESTÁ CONECTADO A GOOGLE        -->
    <!-- ================================================================= -->
    <div
      id="state-disconnected"
      style={`display: ${isConnected ? "none" : "block"};`}
    >
      <div class="google-connect-pill-card">
        <div class="connect-left">
          <div class="connect-icon-wrap">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                x1="8"
                y1="2"
                x2="8"
                y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg
            >
          </div>
          <div>
            <div class="connect-title">Google Calendar Institucional</div>
            <div class="connect-subtitle">
              Conecta tu cuenta ({userEmail}) para sincronización bidireccional
              automática
            </div>
          </div>
        </div>
        <button
          type="button"
          id="btn-connect-google"
          class="btn-connect-google-pill"
          data-user-id={userId}
        >
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
            ></path>
          </svg>
          <span id="btn-connect-label">Vincular Google Calendar</span>
        </button>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- ESTADO 2: CONTENEDOR PRINCIPAL CALENDARIO PRO MAX                -->
    <!-- ================================================================= -->
    <div id="state-connected" style="display: block;">
      <!-- CABECERA INSTITUCIONAL Y ACCIONES DE NAVEGACIÓN -->
      <header class="promax-module-header">
        <div class="header-titles">
          <div class="header-pretitle">
            <span class="live-status-pill" id="gcal-sync-badge">
              <span class="badge-dot-live"></span>
              {
                isConnected
                  ? "Google Calendar Activo"
                  : "Base de Datos en Tiempo Real"
              }
            </span>
            <span class="account-chip" title={userEmail}>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                ></path><circle cx="12" cy="7" r="4"></circle></svg
              >
              <span>{userEmail}</span>
            </span>
          </div>
          <h2 class="module-main-title">Calendario Institucional</h2>
          <p class="module-subtitle">Agenda ejecutiva unificada</p>
        </div>

        <div class="header-actions">
          <!-- Alternador de Pestaña: Agenda y Semáforo SLA vs Visor Google Calendar -->
          <div class="promax-tab-switcher">
            <button type="button" class="tab-pill active" id="tab-btn-semaforo">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                  x1="8"
                  y1="2"
                  x2="8"
                  y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                ></line></svg
              >
              <span>Agenda</span>
            </button>
            <button type="button" class="tab-pill" id="tab-btn-google-embed">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="12" cy="12" r="10"></circle><line
                  x1="2"
                  y1="12"
                  x2="22"
                  y2="12"></line><path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path></svg
              >
              <span>Google Calendar</span>
            </button>
          </div>

          <!-- Botón Sincronizar -->
          <button
            type="button"
            class="btn-promax-secondary"
            id="btn-force-sync"
            title="Actualizar eventos de base de datos y Google"
          >
            <svg
              id="sync-spinner-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              ><path
                d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"
              ></path></svg
            >
            <span>Sincronizar</span>
          </button>

          <!-- Botón Crear Evento -->
          <button
            type="button"
            class="btn-promax-primary"
            id="btn-gcal-create-event"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
            <span> Agendar Compromiso</span>
          </button>

          <!-- Botón Desvincular (discreto) -->
          {
            isConnected && (
              <button
                type="button"
                class="btn-promax-ghost-danger"
                id="btn-disconnect-calendar"
                data-user-id={userId}
                title="Desconectar cuenta de Google"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <>
                    <path d="M18.36 6.64a9 9 0 1 1-12.73 0" />
                    <line x1="12" y1="2" x2="12" y2="12" />
                  </>
                </svg>
              </button>
            )
          }
        </div>
      </header>

      <!-- =============================================================== -->
      <!-- VISTA 1: AGENDA Y SEMÁFORO SLA (VISTA PRINCIPAL)                -->
      <!-- =============================================================== -->
      <main id="container-semaforo-view" class="promax-calendar-surface">
        <!-- 1. BENTO HEADER INTELIGENTE (RESUMEN SEMÁFORO SLA & FILTROS) -->
        <section class="bento-header-grid" aria-label="Resumen de Semáforo SLA">
          <!-- Card 1: Críticos / Vencidos -->
          <article
            class="bento-sla-card danger"
            data-sla-filter="danger"
            title="Clic para filtrar compromisos críticos"
          >
            <div class="bento-card-top">
              <div class="bento-icon-badge danger">
                <span class="live-radar-pulse"></span>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  ><path
                    d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                  ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                    x1="12"
                    y1="17"
                    x2="12.01"
                    y2="17"></line></svg
                >
              </div>
              <span class="bento-tag danger">Término Inmediato</span>
              <span class="bento-active-badge" style="display: none;"
                >Filtro Activo &times;</span
              >
            </div>
            <div class="bento-card-kpi-row">
              <span class="bento-kpi tabular-nums" id="gcal-crit-count">0</span>
              <span class="bento-kpi-label">radicados</span>
            </div>
            <div class="bento-card-bottom">
              <h4 class="bento-card-title">Críticos / Vencidos</h4>
              <p class="bento-card-desc">
                Atención inmediata (≤ 2 días restantes)
              </p>
            </div>
          </article>

          <!-- Card 2: Próximos a Vencer -->
          <article
            class="bento-sla-card warning"
            data-sla-filter="warning"
            title="Clic para filtrar compromisos en alerta"
          >
            <div class="bento-card-top">
              <div class="bento-icon-badge warning">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  ><circle cx="12" cy="12" r="10"></circle><polyline
                    points="12 6 12 12 16 14"></polyline></svg
                >
              </div>
              <span class="bento-tag warning">Alerta SLA</span>
              <span class="bento-active-badge" style="display: none;"
                >Filtro Activo &times;</span
              >
            </div>
            <div class="bento-card-kpi-row">
              <span class="bento-kpi tabular-nums" id="gcal-warn-count">0</span>
              <span class="bento-kpi-label">radicados</span>
            </div>
            <div class="bento-card-bottom">
              <h4 class="bento-card-title">Próximos a Vencer</h4>
              <p class="bento-card-desc">
                Ventana de alerta (3 a 7 días restantes)
              </p>
            </div>
          </article>

          <!-- Card 3: En Tiempo / Saludables -->
          <article
            class="bento-sla-card safe"
            data-sla-filter="safe"
            title="Clic para filtrar compromisos en término seguro"
          >
            <div class="bento-card-top">
              <div class="bento-icon-badge safe">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
                    points="22 4 12 14.01 9 11.01"></polyline></svg
                >
              </div>
              <span class="bento-tag safe">SLA Cumplido</span>
              <span class="bento-active-badge" style="display: none;"
                >Filtro Activo &times;</span
              >
            </div>
            <div class="bento-card-kpi-row">
              <span class="bento-kpi tabular-nums" id="gcal-safe-count">0</span>
              <span class="bento-kpi-label">radicados</span>
            </div>
            <div class="bento-card-bottom">
              <h4 class="bento-card-title">En Término Seguro</h4>
              <p class="bento-card-desc">
                Dentro del plazo SLA (&gt; 7 días restantes)
              </p>
            </div>
          </article>
        </section>

        <!-- 2. BARRA DE CONTROL Y NAVEGACIÓN EJECUTIVA -->
        <nav
          class="promax-executive-nav"
          aria-label="Navegación del Calendario"
        >
          <!-- Izquierda: Navegación de Fecha -->
          <div class="nav-date-group">
            <button type="button" class="btn-today-pill" id="gcal-btn-today"
              >Hoy</button
            >
            <div class="nav-arrows-capsule">
              <button
                type="button"
                class="btn-nav-arrow"
                id="gcal-btn-prev"
                title="Período anterior"
                aria-label="Anterior"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  ><polyline points="15 18 9 12 15 6"></polyline></svg
                >
              </button>
              <button
                type="button"
                class="btn-nav-arrow"
                id="gcal-btn-next"
                title="Período siguiente"
                aria-label="Siguiente"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  ><polyline points="9 18 15 12 9 6"></polyline></svg
                >
              </button>
            </div>
            <h3 class="current-period-heading" id="gcal-current-label">
              Mes Actual
            </h3>
          </div>

          <!-- Centro: Buscador en tiempo real -->
          <div class="nav-search-group">
            <div class="search-glass-field">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                ><circle cx="11" cy="11" r="8"></circle><line
                  x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65"></line></svg
              >
              <input
                type="text"
                id="gcal-search-input"
                placeholder="Buscar radicado, asunto, responsable..."
                autocomplete="off"
              />
            </div>
          </div>

          <!-- Derecha: Selector de Vista con Indicador Deslizante (Shared Element) & Filtros -->
          <div class="nav-views-group">
            <!-- Categorías discretas -->
            <div class="categories-filter-popover" id="gcal-category-filters">
              <label class="filter-chip-toggle">
                <input type="checkbox" value="peticion" checked />
                <span class="chip-color-dot peticion"></span>
                <span>Peticiones</span>
              </label>
              <label class="filter-chip-toggle">
                <input type="checkbox" value="reporte" checked />
                <span class="chip-color-dot reporte"></span>
                <span>Reportes</span>
              </label>
              <label class="filter-chip-toggle">
                <input type="checkbox" value="colegiado" checked />
                <span class="chip-color-dot colegiado"></span>
                <span>Colegiados</span>
              </label>
            </div>

            <!-- Selector de Vista Segmentado -->
            <div class="view-segmented-control" id="gcal-view-switcher">
              <div class="view-indicator-pill" id="view-switcher-indicator">
              </div>
              <button
                type="button"
                class="gcal-view-btn active"
                data-gview="month">Mes</button
              >
              <button type="button" class="gcal-view-btn" data-gview="week"
                >Semana</button
              >
              <button type="button" class="gcal-view-btn" data-gview="day"
                >Día</button
              >
              <button type="button" class="gcal-view-btn" data-gview="agenda"
                >Agenda</button
              >
            </div>
          </div>
        </nav>

        <!-- 3. CUERPO PRINCIPAL ASIMÉTRICO (1.6fr 1fr en Desktop) -->
        <div class="promax-calendar-workspace-split">
          <!-- PANEL IZQUIERDO: LIENZO DE CALENDARIO EJECUTIVO (1.6fr) -->
          <section class="promax-canvas-column">
            <!-- Vista 1: Mes (Cápsulas Flotantes Pro Max) -->
            <div class="canvas-view-card" id="gcal-month-view">
              <div class="month-weekdays-header">
                <div class="weekday-header-cell">DOM</div>
                <div class="weekday-header-cell">LUN</div>
                <div class="weekday-header-cell">MAR</div>
                <div class="weekday-header-cell">MIÉ</div>
                <div class="weekday-header-cell">JUE</div>
                <div class="weekday-header-cell">VIE</div>
                <div class="weekday-header-cell">SÁB</div>
              </div>
              <div class="month-cells-grid" id="gcal-month-grid-cells">
                <!-- Generado dinámicamente por JS con cápsulas flotantes -->
              </div>
            </div>

            <!-- Vista 2: Semana -->
            <div
              class="canvas-view-card"
              id="gcal-week-view"
              style="display: none;"
            >
              <div class="week-grid-container" id="gcal-week-container"></div>
            </div>

            <!-- Vista 3: Día -->
            <div
              class="canvas-view-card"
              id="gcal-day-view"
              style="display: none;"
            >
              <div id="gcal-day-container"></div>
            </div>

            <!-- Vista 4: Agenda Completa (cuando se selecciona vista agenda) -->
            <div
              class="canvas-view-card"
              id="gcal-agenda-view"
              style="display: none;"
            >
            </div>
          </section>

          <!-- PANEL DERECHO: AGENDA & MONITOR SLA (TIMELINE VERTICAL 1fr) -->
          <aside class="promax-timeline-column" id="gcal-timeline-monitor">
            <div class="timeline-monitor-card">
              <div class="timeline-header">
                <div class="timeline-title-wrap">
                  <div class="timeline-title-row">
                    <span class="timeline-live-node"></span>
                    <h3 class="timeline-heading">Agenda & Monitor SLA</h3>
                  </div>
                  <p
                    class="timeline-subheading"
                    id="timeline-current-filter-desc"
                  >
                    Compromisos Oficiales en Tiempo Real
                  </p>
                </div>
                <button
                  type="button"
                  class="btn-clear-selection-pill"
                  id="btn-clear-day-filter"
                  style="display: none;"
                  title="Mostrar todos los compromisos"
                >
                  <span>Ver Todos</span>
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    ><line x1="18" y1="6" x2="6" y2="18"></line><line
                      x1="6"
                      y1="6"
                      x2="18"
                      y2="18"></line></svg
                  >
                </button>
              </div>

              <!-- LÍNEA DE TIEMPO VERTICAL CONTINUA -->
              <div class="timeline-items-flow" id="timeline-items-container">
                <!-- Las tarjetas y nodos de la línea de tiempo se renderizan dinámicamente -->
              </div>
            </div>
          </aside>
        </div>
      </main>

      <!-- =============================================================== -->
      <!-- VISTA 2: VISOR GOOGLE WORKSPACE EMBEBIDO                        -->
      <!-- =============================================================== -->
      <section
        id="container-google-embed"
        class="promax-calendar-surface"
        style="display: none;"
      >
        <div class="google-iframe-card">
          <div class="iframe-toolbar">
            <div class="iframe-meta">
              <span class="badge-dot-live"></span>
              <span>Visor Oficial Google Calendar (Cuenta: {userEmail})</span>
            </div>
            <button
              type="button"
              class="btn-promax-secondary btn-sm"
              id="btn-activate-cookies"
            >
              Permitir Cookies / Abrir en Ventana
            </button>
          </div>
          <iframe
            id="google-calendar-iframe"
            src={calendarEmbedUrl}
            class="google-calendar-frame"
            frameborder="0"
            scrolling="no"
            loading="lazy"
            title="Google Calendar Oficial Unitrópico"></iframe>
        </div>
      </section>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- MODAL 1: AGENDAR COMPROMISO / EVENTO EN CALENDARIO Y PLATAFORMA   -->
  <!-- ================================================================= -->
  <div
    class="modal-backdrop"
    id="new-calendario-modal"
    style="display: none; z-index: 9999;"
  >
    <div class="modal-card promax-glass-modal">
      <div class="modal-header">
        <h3 class="modal-title-pro">
          <div class="modal-icon-wrap">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                x1="8"
                y1="2"
                x2="8"
                y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><line
                x1="12"
                y1="14"
                x2="12"
                y2="18"></line><line x1="10" y1="16" x2="14" y2="16"
              ></line></svg
            >
          </div>
          <span>Agendar Compromiso Oficial</span>
        </h3>
        <button
          type="button"
          class="btn-close-modal"
          id="btn-close-new-cal-modal">&times;</button
        >
      </div>

      <form id="new-calendario-form" class="modal-body promax-form">
        <div class="form-group">
          <label class="form-label-pro"
            >Título del Compromiso o Actividad *</label
          >
          <input
            type="text"
            id="input-cal-titulo"
            required
            placeholder="Ej: Sustentación CSU / Sesión de Trabajo"
            class="form-control-pro"
          />
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label class="form-label-pro">Tipo de Compromiso *</label>
            <select id="select-cal-tipo" class="form-control-pro">
              <option value="peticion">Petición / PQRS (Término Legal)</option>
              <option value="colegiado">Sesión Cuerpos Colegiados</option>
              <option value="reporte">Reporte a Entes de Control</option>
              <option value="academica">Actividad Académica</option>
              <option value="financiero">Gestión Financiera</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label-pro">Fecha del Término / Evento *</label>
            <input
              type="date"
              id="input-cal-fecha"
              required
              class="form-control-pro"
            />
          </div>
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label class="form-label-pro">Dependencia o Destino</label>
            <input
              type="text"
              id="input-cal-destino"
              placeholder="Ej: Rectoría / Secretaría General"
              class="form-control-pro"
            />
          </div>

          <div class="form-group">
            <label class="form-label-pro">Funcionario Responsable</label>
            <input
              type="text"
              id="input-cal-responsable"
              placeholder="Ej: ING. Christian Lemus"
              class="form-control-pro"
            />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label-pro">Descripción o Notas de Radicado</label>
          <textarea
            id="input-cal-descripcion"
            rows="2"
            placeholder="Detalles o radicado asociado..."
            class="form-control-pro resize-y"></textarea>
        </div>

        <div class="modal-footer-pro">
          <button
            type="button"
            class="btn-promax-secondary"
            id="btn-cancel-new-cal">Cancelar</button
          >
          <button
            type="submit"
            class="btn-promax-primary"
            id="btn-submit-new-cal"
          >
            Agendar en Calendario
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- MODAL 2: DETALLE DE COMPROMISOS DEL DÍA                           -->
  <!-- ================================================================= -->
  <div
    class="modal-backdrop"
    id="cal-day-events-modal"
