  /* ==========================================================================
     PANEL DERECHO: AGENDA & MONITOR SLA (TIMELINE VERTICAL)
     ========================================================================== */
  .promax-timeline-column {
    min-width: 0;
  }
  .timeline-monitor-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.04);
  }

  .timeline-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid #f1f5f9;
  }
  .timeline-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .timeline-live-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00594e;
    box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.2);
  }
  .timeline-heading {
    font-size: 1.05rem;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .timeline-subheading {
    font-size: 0.78rem;
    color: #64748b;
    margin: 2px 0 0 16px;
  }

  .btn-clear-selection-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #00594e;
    background: rgba(0, 89, 78, 0.08);
    border: 1px solid rgba(0, 89, 78, 0.2);
    padding: 3px 9px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-clear-selection-pill:hover {
    background: rgba(0, 89, 78, 0.16);
  }

  /* Conector vertical continuo */
  .timeline-items-flow {
    position: relative;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-height: 640px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .timeline-items-flow::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: repeating-linear-gradient(
      to bottom,
      #cbd5e1 0,
      #cbd5e1 4px,
      transparent 4px,
      transparent 8px
    );
  }

  /* Tarjeta de la línea de tiempo */
  :global(.pro-timeline-card) {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 16px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
    cursor: pointer;
    transition:
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.pro-timeline-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
    border-color: #cbd5e1;
  }
  :global(.pro-timeline-card.focused-card) {
    border-color: #00594e !important;
    box-shadow:
      0 0 0 3px rgba(0, 89, 78, 0.18),
      0 8px 24px -4px rgba(0, 89, 78, 0.15) !important;
  }

  :global(.timeline-node-pin) {
    position: absolute;
    left: -20px;
    top: 16px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #64748b;
    box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.15);
    z-index: 2;
  }
  :global(.timeline-node-pin.danger) {
    border-color: #dc2626;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.2);
  }
  :global(.timeline-node-pin.warning) {
    border-color: #d97706;
    box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.2);
  }
  :global(.timeline-node-pin.safe) {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }
  :global(.timeline-node-pin.completed) {
    border-color: #00594E;
    background: #00594E;
    box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.22);
  }

  :global(.timeline-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  :global(.timeline-rad-badge-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  :global(.timeline-rad-mono) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 800;
    font-size: 0.76rem;
    color: #0f172a;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 2px 7px;
    border-radius: 6px;
  }
  :global(.timeline-sla-badge) {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
  }
  :global(.timeline-sla-badge.badge-danger) {
    background: #fee2e2;
    color: #991b1b;
  }
  :global(.timeline-sla-badge.badge-warning) {
    background: #fef3c7;
    color: #92400e;
  }
  :global(.timeline-sla-badge.badge-safe) {
    background: #d1fae5;
    color: #065f46;
  }
  :global(.timeline-sla-badge.badge-completed) {
    background: #00594E;
    color: #FFFFFF;
    border: 1px solid #B5A160;
  }

  :global(.timeline-type-pill) {
    font-size: 0.65rem;
    font-weight: 800;
    color: #00594e;
    background: rgba(0, 89, 78, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  :global(.timeline-card-title) {
    font-size: 0.94rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px 0;
    line-height: 1.35;
  }
  :global(.timeline-card-desc) {
    font-size: 0.8rem;
    color: #64748b;
