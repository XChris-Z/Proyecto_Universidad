    padding: 1px 4px;
    border-radius: 4px;
  }
  :global(.chip-days-badge.danger) {
    background: #fee2e2;
    color: #991b1b;
  }
  :global(.chip-days-badge.warning) {
    background: #fef3c7;
    color: #92400e;
  }
  :global(.chip-days-badge.safe) {
