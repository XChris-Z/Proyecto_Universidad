     ========================================================================== */
  .promax-calendar-workspace-split {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 1080px) {
    .promax-calendar-workspace-split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .bento-header-grid {
      grid-template-columns: 1fr;
    }
  }

  /* LIENZO DE CALENDARIO (PANEL IZQUIERDO) */
  .promax-canvas-column {
    min-width: 0;
  }
  .canvas-view-card {
    background: rgba(248, 250, 252, 0.9);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    padding: 16px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }

  .month-weekdays-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-bottom: 8px;
    text-align: center;
  }
  .weekday-header-cell {
    font-size: 0.72rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.06em;
    padding: 6px 0;
    text-transform: uppercase;
  }

  .month-cells-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }

  /* Cápsulas Flotantes Pro Max (.gcal-cell) */
  :global(.gcal-cell) {
    position: relative;
