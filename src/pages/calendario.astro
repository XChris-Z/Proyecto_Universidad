      <div class="modal-header">
        <h3 id="cal-day-modal-title" class="modal-title-pro">
          Compromisos del Día
        </h3>
        <button
          type="button"
          class="btn-close-modal"
          id="btn-close-cal-day-modal">&times;</button
        >
      </div>
      <div
        class="modal-body"
        id="cal-day-modal-body"
        style="max-height: 420px; overflow-y: auto;"
      >
        <!-- Lista de compromisos del día -->
      </div>
      <div class="modal-footer-pro" style="justify-content: space-between;">
        <button
          type="button"
          class="btn-promax-secondary btn-sm"
          id="btn-cal-day-switch-to-day">Ver en Vista Día</button
        >
        <button
          type="button"
          class="btn-promax-ghost btn-sm"
          id="btn-close-cal-day-modal-footer">Cerrar</button
        >
      </div>
    </div>
  </div>
</AppLayout>

