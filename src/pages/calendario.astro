---
// src/pages/calendario.astro
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout title="Calendario Institucional y Semáforo" activeNav="calendario">
  <div class="panel-box" style="padding: 0; overflow: hidden; border: none; background: transparent;">
    
    <div class="gcal-container">
      <!-- Google Calendar Top Navigation Bar -->
      <div class="gcal-topbar">
        <div class="gcal-topbar-left">
          <button type="button" class="gcal-btn-create" id="btn-gcal-create-event">
            <svg viewBox="0 0 36 36"><path fill="#4285F4" d="M16 16v14h4V20z"/><path fill="#34A853" d="M30 16H20l-4 4h14z"/><path fill="#FBBC05" d="M6 16h10l4-4H6z"/><path fill="#EA4335" d="M20 16V2h-4v14z"/><path fill="none" d="M0 0h36v36H0z"/></svg>
            <span>Crear</span>
          </button>

          <button type="button" class="gcal-btn-today" id="gcal-btn-today">Hoy</button>

          <div class="gcal-nav-arrows">
            <button type="button" class="gcal-arrow-btn" id="gcal-btn-prev" title="Mes Anterior">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="gcal-arrow-btn" id="gcal-btn-next" title="Mes Siguiente">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>

          <h3 class="gcal-current-date-title" id="gcal-current-label">Octubre de 2026</h3>
        </div>

        <div class="gcal-topbar-right">
          <!-- Estado de Sincronización Google Calendar -->
          <div id="gcal-sync-indicator" style="display: flex; align-items: center; gap: 8px;">
            <button type="button" class="btn btn-secondary btn-sm" id="btn-gcal-sync" title="Sincronizar eventos de Google Calendar" style="padding: 6px 12px; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 6px;">
              <svg id="sync-icon-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
              <span>Sincronizar</span>
            </button>
            <span class="badge" id="gcal-sync-badge" style="font-size: 0.72rem; padding: 4px 8px; cursor: pointer;" title="Haz clic para conectar o reconectar tu cuenta institucional">
              Detectando...
            </span>
          </div>

          <div class="search-box" style="width: 200px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="gcal-search-input" placeholder="Buscar en calendario...">
          </div>

          <div class="gcal-view-selector" id="gcal-view-switcher">
            <button type="button" class="gcal-view-btn active" data-gview="month">Mes</button>
            <button type="button" class="gcal-view-btn" data-gview="week">Semana</button>
            <button type="button" class="gcal-view-btn" data-gview="day">Día</button>
            <button type="button" class="gcal-view-btn" data-gview="agenda">Agenda</button>
          </div>
        </div>
      </div>

      <!-- Google Calendar Body (Sidebar + View Area) -->
      <div class="gcal-body-split">
        <!-- Sidebar Lateral (Google Calendar Style) -->
        <aside class="gcal-sidebar-panel">
          <!-- Mini Calendario Interactivo -->
          <div class="gcal-mini-cal">
            <div class="gcal-mini-header">
              <span id="gcal-mini-title">Oct 2026</span>
              <div style="display: flex; gap: 2px;">
                <button type="button" class="gcal-arrow-btn" id="gcal-mini-prev" style="width:22px; height:22px;">&larr;</button>
                <button type="button" class="gcal-arrow-btn" id="gcal-mini-next" style="width:22px; height:22px;">&rarr;</button>
              </div>
            </div>
            <div class="gcal-mini-grid">
              <span class="gcal-mini-day-title">D</span>
              <span class="gcal-mini-day-title">L</span>
              <span class="gcal-mini-day-title">M</span>
              <span class="gcal-mini-day-title">M</span>
              <span class="gcal-mini-day-title">J</span>
              <span class="gcal-mini-day-title">V</span>
              <span class="gcal-mini-day-title">S</span>
            </div>
            <div class="gcal-mini-grid" id="gcal-mini-days-container">
              <!-- Días generados dinámicamente -->
            </div>
          </div>

          <!-- Semáforo Institucional de Cumplimiento -->
          <div class="gcal-semaforo-box">
            <h5>
              <span>Semáforo Institucional</span>
              <span style="font-size: 0.65rem; color: var(--primary); font-weight: 700;">En Tiempo Real</span>
            </h5>
            <div class="gcal-semaforo-row">
              <span style="color: #dc2626; display: flex; align-items: center; gap: 6px;">
                <span class="gcal-cat-dot" style="background: #dc2626;"></span> Críticos / &lt;5 días
              </span>
              <span class="badge-counter" id="gcal-crit-count" style="background: #dc2626; color: #fff;">0</span>
            </div>
            <div class="gcal-semaforo-row">
              <span style="color: #d97706; display: flex; align-items: center; gap: 6px;">
                <span class="gcal-cat-dot" style="background: #f59e0b;"></span> Advertencia Media
              </span>
              <span class="badge-counter" id="gcal-warn-count" style="background: #f59e0b; color: #fff;">0</span>
            </div>
            <div class="gcal-semaforo-row">
              <span style="color: #059669; display: flex; align-items: center; gap: 6px;">
                <span class="gcal-cat-dot" style="background: #10b981;"></span> En Término Seguro
              </span>
              <span class="badge-counter" id="gcal-safe-count" style="background: #10b981; color: #fff;">0</span>
            </div>
          </div>

          <!-- Mis Calendarios y Filtros de Categoría -->
          <div class="gcal-categories-box">
            <h5>Mis Calendarios Unitrópico</h5>
            <div class="gcal-cal-checkbox-list" id="gcal-category-filters">
              <label class="gcal-cal-item-label">
                <input type="checkbox" value="peticion" checked>
                <span class="gcal-cat-dot" style="background: #d93025;"></span>
                <span>Vencimiento Peticiones (SLA)</span>
              </label>
              <label class="gcal-cal-item-label">
                <input type="checkbox" value="reporte" checked>
                <span class="gcal-cat-dot" style="background: #f29900;"></span>
                <span>Reportes MEN / Entes Control</span>
              </label>
              <label class="gcal-cal-item-label">
                <input type="checkbox" value="colegiado" checked>
                <span class="gcal-cat-dot" style="background: #1e8e3e;"></span>
                <span>Sesiones Cuerpos Colegiados</span>
              </label>
              <label class="gcal-cal-item-label">
                <input type="checkbox" value="academica" checked>
                <span class="gcal-cat-dot" style="background: #1a73e8;"></span>
                <span>Actividades Institucionales</span>
              </label>
              <label class="gcal-cal-item-label">
                <input type="checkbox" value="financiero" checked>
                <span class="gcal-cat-dot" style="background: #9334e6;"></span>
                <span>Cierres Financieros CSU</span>
              </label>
            </div>
          </div>
        </aside>

        <!-- Vista Principal de Calendario -->
        <div class="gcal-view-area">
          <!-- Vista Mes (Default Google Calendar) -->
          <div class="gcal-month-table" id="gcal-month-view">
            <div class="gcal-weekdays-row">
              <div class="gcal-weekday-col">DOM</div>
              <div class="gcal-weekday-col">LUN</div>
              <div class="gcal-weekday-col">MAR</div>
              <div class="gcal-weekday-col">MIÉ</div>
              <div class="gcal-weekday-col">JUE</div>
              <div class="gcal-weekday-col">VIE</div>
              <div class="gcal-weekday-col">SÁB</div>
            </div>
            <div class="gcal-month-grid-cells" id="gcal-month-grid-cells">
              <!-- Generado dinámicamente -->
            </div>
          </div>

          <!-- Vista Semana -->
          <div class="gcal-week-table" id="gcal-week-view" style="display: none;">
            <div class="gcal-week-grid" id="gcal-week-container">
              <!-- Generado dinámicamente -->
            </div>
          </div>

          <!-- Vista Día -->
          <div class="gcal-day-table" id="gcal-day-view" style="display: none;">
            <div id="gcal-day-container">
              <!-- Generado dinámicamente -->
            </div>
          </div>

          <!-- Vista Agenda / Semáforo Completo -->
          <div class="gcal-agenda-view" id="gcal-agenda-view" style="display: none;">
            <!-- Generado dinámicamente por fecha con chips de semáforo -->
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Modal: Agendar Actividad o Reporte en Calendario -->
  <div class="modal-backdrop" id="new-calendario-modal">
    <div class="modal-card" style="max-width: 580px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Agendar Actividad o Reporte Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-new-cal-modal">&times;</button>
      </div>
      <form id="new-calendario-form">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">Título del Compromiso / Evento *</label>
            <input type="text" class="form-input" id="input-cal-titulo" placeholder="Ej: Reporte SNIES al MEN o Sesión Ordinaria CSU" required>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Tipo de Evento *</label>
              <select class="form-select" id="select-cal-tipo" required>
                <option value="reporte">Reporte Obligatorio a Ente de Control</option>
                <option value="colegiado">Sesión de Cuerpo Colegiado (CSU / CA)</option>
                <option value="academica">Actividad Académica Institucional</option>
                <option value="financiero">Cierre Financiero o Presupuestal</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Entidad Receptora / Destino</label>
              <input type="text" class="form-input" id="input-cal-destino" placeholder="Ej: MEN / Contraloría / DIAN / CSU">
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Fecha Límite / Día de Evento *</label>
              <input type="date" class="form-input" id="input-cal-fecha" required>
            </div>
            <div class="form-group">
              <label class="form-label">Dependencia Responsable</label>
              <input type="text" class="form-input" id="input-cal-responsable" placeholder="Ej: Dirección de Planeación">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" id="btn-cancel-new-cal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Agendar en Semáforo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Compromisos del Día en Calendario -->
  <div class="modal-backdrop" id="cal-day-events-modal">
    <div class="modal-card" style="max-width: 680px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span id="cal-day-modal-title">Compromisos del Día</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-cal-day-modal">&times;</button>
      </div>
      <div class="modal-body" id="cal-day-modal-body">
        <!-- Lista de compromisos con semáforo institucional -->
      </div>
      <div class="modal-footer" style="justify-content: space-between;">
        <button type="button" class="btn btn-ghost" id="btn-close-cal-day-modal-footer">Cerrar</button>
        <button type="button" class="btn btn-primary" id="btn-cal-day-switch-to-day">
          <span>Ver en Vista Día Completa</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { initCalendario } from '@scripts/calendario';
  initCalendario();
</script>

