    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 8px;
  }
  :global(.meta-item) {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Barra de Progreso SLA Pro Max */
  :global(.timeline-sla-progress-wrap) {
    margin-top: 10px;
    background: #f8fafc;
    border-radius: 8px;
    padding: 8px 10px;
    border: 1px solid #f1f5f9;
  }
  :global(.timeline-sla-progress-track) {
    width: 100%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  :global(.timeline-sla-progress-fill) {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.timeline-sla-progress-fill.danger) {
    background: linear-gradient(90deg, #ef4444, #dc2626);
  }
  :global(.timeline-sla-progress-fill.warning) {
    background: linear-gradient(90deg, #f59e0b, #d97706);
  }
  :global(.timeline-sla-progress-fill.safe) {
    background: linear-gradient(90deg, #10b981, #059669);
  }
  :global(.timeline-sla-progress-fill.completed) {
    background: linear-gradient(90deg, #00594E, #B5A160);
  }

  :global(.timeline-sla-progress-labels) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 750;
