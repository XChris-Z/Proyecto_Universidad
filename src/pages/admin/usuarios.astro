      text-transform: uppercase !important;
    }
    @media (max-width: 820px) {
      .roles-modal-body {
        grid-template-columns: 1fr !important;
      }
      .roles-sidebar-col {
        border-right: none !important;
        border-bottom: 1px solid #E2E8F0 !important;
        max-height: 210px !important;
      }
    }
  </style>

  <script>
    import { ALL_PERMISSION_IDS, DEFAULT_FUNCIONARIO_PERMISSIONS, RBAC_MODULES } from '@data/roles';
    import { getRoleDisplayName, isAdminRoleCode, normalizePermissionsList } from '@lib/permissions';
    import type { SystemRole } from '@lib/types';

    const bootstrapEl = document.getElementById('rbac-bootstrap-json');
    let bootstrapData: any = {};
    try {
      bootstrapData = bootstrapEl?.textContent ? JSON.parse(bootstrapEl.textContent) : {};
    } catch {
      bootstrapData = {};
    }

    let rolesCatalog: SystemRole[] = Array.isArray(bootstrapData.roles) ? bootstrapData.roles : [];
    let userCustomRolesMap: Record<string, string> = bootstrapData.userCustomRoles || {};
    let userPermissionsMap: Record<string, string[]> = bootstrapData.userPermissions || {};
    let activePermsUserId: string | null = null;
    let activePermsUserEmail = '';
    let activePermsUserName = '';
    let activeRoleEditorId = '';

    async function refreshRbacStateFromServer() {
      try {
        const res = await fetch('/api/admin/rbac', { credentials: 'same-origin' });
        if (!res.ok) return;
        const data = await res.json();
        if (data?.success) {
          rolesCatalog = Array.isArray(data.roles) ? data.roles : rolesCatalog;
          userCustomRolesMap = data.userCustomRoles || {};
          userPermissionsMap = data.userPermissions || {};
          syncRoleSelectDropdowns();
          updateRolesKpi();
        }
      } catch (err) {
        console.warn('Aviso sincronizando matriz RBAC:', err);
      }
    }

    function updateRolesKpi() {
      const kpiRoles = document.getElementById('kpi-total-roles');
      const kpiSub = document.getElementById('kpi-custom-roles-sub');
      const customCount = rolesCatalog.filter((r) => !r.isProtected).length;
      if (kpiRoles) kpiRoles.textContent = String(rolesCatalog.length);
      if (kpiSub) kpiSub.textContent = `${customCount} rol(es) personalizado(s)`;
    }

    function syncRoleSelectDropdowns() {
      document.querySelectorAll<HTMLSelectElement>('.role-select-dropdown').forEach((sel) => {
        const prev = sel.value || 'funcionario';
        sel.innerHTML = '';
        rolesCatalog.forEach((r) => {
          const opt = document.createElement('option');
          opt.value = r.id;
          opt.textContent = r.name;
          sel.appendChild(opt);
        });
        if (rolesCatalog.some((r) => r.id === prev)) {
          sel.value = prev;
        } else {
          sel.value = 'funcionario';
        }
      });
    }

    // 1. Filtrado y Búsqueda en la Tabla
    const searchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.user-filter-btn');

    function applyUserFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const activeBtn = document.querySelector('.user-filter-btn.active');
      const selectedFilter = activeBtn?.getAttribute('data-role') || 'all';

      const rows = document.querySelectorAll<HTMLTableRowElement>('#users-table-body .user-row');
      rows.forEach((row) => {
        const name = (row.dataset.userName || '').toLowerCase();
        const email = (row.dataset.userEmail || '').toLowerCase();
        const cargo = (row.dataset.userCargo || '').toLowerCase();
        const roleCat = row.dataset.userRoleCat || 'funcionario';
        const roleName = (row.dataset.userRoleName || '').toLowerCase();

        const matchesQuery =
          !query || name.includes(query) || email.includes(query) || cargo.includes(query) || roleName.includes(query);
        const matchesRole = selectedFilter === 'all' || roleCat === selectedFilter;

        row.style.display = matchesQuery && matchesRole ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', applyUserFilters);
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        applyUserFilters();
      });
    });

    // 2. Acoplamiento automático entre Ver y Gestionar en matrices RBAC
    function setupMatrixCoupling(container: HTMLElement | null, verSelector: string, manageSelector: string, onChange?: () => void) {
      container?.addEventListener('change', (e) => {
        const cb = e.target as HTMLInputElement | null;
        if (!cb || cb.type !== 'checkbox') return;
        const modId = cb.dataset.moduleId;
        if (!modId) return;

        if (cb.classList.contains(manageSelector) && cb.checked) {
          const verCb = container.querySelector<HTMLInputElement>(`.${verSelector}[data-module-id="${modId}"]`);
          if (verCb) verCb.checked = true;
        } else if (cb.classList.contains(verSelector) && !cb.checked) {
          const manCb = container.querySelector<HTMLInputElement>(`.${manageSelector}[data-module-id="${modId}"]`);
          if (manCb) manCb.checked = false;
        }
        if (onChange) onChange();
      });
    }

    function updateUserMatrixSummary() {
      const enabledModules = RBAC_MODULES.filter((mod) => {
        const ver = document.querySelector<HTMLInputElement>(`.perm-ver-cb[data-module-id="${mod.id}"]`)?.checked;
        const man = document.querySelector<HTMLInputElement>(`.perm-manage-cb[data-module-id="${mod.id}"]`)?.checked;
        return Boolean(ver || man);
      }).length;
      const sumEl = document.getElementById('perms-summary-count');
      if (sumEl) sumEl.textContent = `${enabledModules} de ${RBAC_MODULES.length} módulos habilitados`;
    }

    // 3. Modal 1: Permisos RBAC 12 Módulos por Usuario
    const permsModal = document.getElementById('modal-permissions');
    const permsUserName = document.getElementById('perm-modal-user-name');
    const permsUserDesc = document.getElementById('perm-modal-user-desc');
    const permsAdminBanner = document.getElementById('perms-admin-banner');
    const permsQuickActions = document.getElementById('perms-quick-actions');
    const btnSavePerms = document.getElementById('btn-save-dynamic-perms') as HTMLButtonElement | null;
    const btnClosePerms = document.getElementById('btn-close-perms-modal');
    const btnCancelPerms = document.getElementById('btn-cancel-perms-modal');

    setupMatrixCoupling(permsModal, 'perm-ver-cb', 'perm-manage-cb', updateUserMatrixSummary);

    function closePermsModal() {
      if (permsModal) permsModal.style.display = 'none';
      activePermsUserId = null;
      activePermsUserEmail = '';
      activePermsUserName = '';
    }

    btnClosePerms?.addEventListener('click', closePermsModal);
    btnCancelPerms?.addEventListener('click', closePermsModal);

    function applyPresetToCheckboxes(selectorPrefix: 'perm' | 'role-perm', preset: string) {
      const allCbs = document.querySelectorAll<HTMLInputElement>(
        selectorPrefix === 'perm' ? '.perm-checkbox' : '.role-perm-checkbox'
      );
      allCbs.forEach((cb) => {
        if (cb.disabled) return;
        const pid = cb.dataset.permId || '';
        if (preset === 'clear_all') cb.checked = false;
        else if (preset === 'view_all') cb.checked = pid.endsWith('.ver');
        else if (preset === 'full_modules') cb.checked = true;
      });
      if (selectorPrefix === 'perm') updateUserMatrixSummary();
    }

    document.querySelectorAll<HTMLButtonElement>('.btn-perm-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        applyPresetToCheckboxes('perm', btn.dataset.preset || '');
      });
    });

    function openPermsModal(userId: string, userEmail: string, userName: string, userCargo: string, userRoleId: string) {
      activePermsUserId = userId;
      activePermsUserEmail = userEmail.toLowerCase();
      activePermsUserName = userName;

      const roleObj = rolesCatalog.find((r) => r.id === userRoleId || r.code === userRoleId);
      const isUserAdmin = userId === 'usr-root' || isAdminRoleCode(userRoleId);
      const roleLabel = isUserAdmin ? 'Administrador' : roleObj?.name || getRoleDisplayName(userRoleId, rolesCatalog);

      if (permsUserName) permsUserName.textContent = `Permisos: ${userName}`;
      if (permsUserDesc) permsUserDesc.textContent = `${userCargo} • Rol: ${roleLabel}`;
      if (permsAdminBanner) permsAdminBanner.style.display = isUserAdmin ? 'block' : 'none';
      if (permsQuickActions) permsQuickActions.style.display = isUserAdmin ? 'none' : 'flex';
      if (btnSavePerms) btnSavePerms.disabled = isUserAdmin;

      const hasOverrideId = Object.prototype.hasOwnProperty.call(userPermissionsMap, userId);
      const hasOverrideEmail = Boolean(
        activePermsUserEmail && Object.prototype.hasOwnProperty.call(userPermissionsMap, activePermsUserEmail)
      );
      const effectivePerms = isUserAdmin
        ? ALL_PERMISSION_IDS
        : hasOverrideId
          ? normalizePermissionsList(userPermissionsMap[userId])
          : hasOverrideEmail
            ? normalizePermissionsList(userPermissionsMap[activePermsUserEmail])
            : normalizePermissionsList(roleObj?.permissions || DEFAULT_FUNCIONARIO_PERMISSIONS);

      document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach((cb) => {
        const permId = cb.dataset.permId || '';
        cb.checked = isUserAdmin || effectivePerms.includes(permId);
        cb.disabled = isUserAdmin;
      });

      updateUserMatrixSummary();
      if (permsModal) permsModal.style.display = 'flex';
    }

    btnSavePerms?.addEventListener('click', async () => {
      if (!activePermsUserId) return;
      const selectedPerms: string[] = [];
      document.querySelectorAll<HTMLInputElement>('.perm-checkbox:checked').forEach((cb) => {
        if (cb.dataset.permId) selectedPerms.push(cb.dataset.permId);
      });

      if (btnSavePerms) {
        btnSavePerms.textContent = 'Guardando...';
        btnSavePerms.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'save_user_permissions',
            userId: activePermsUserId,
            userEmail: activePermsUserEmail,
            userName: activePermsUserName,
            permissions: selectedPerms,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Error guardando permisos en servidor.');
        }

        const savedList = Array.isArray(data.permissions) ? data.permissions : selectedPerms;
        userPermissionsMap[activePermsUserId] = savedList;
        if (activePermsUserEmail) userPermissionsMap[activePermsUserEmail] = savedList;

        (window as any).showToast('Matriz de permisos RBAC guardada correctamente.', 'success');
        closePermsModal();
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error al guardar permisos.', 'error');
      } finally {
        if (btnSavePerms) {
          btnSavePerms.textContent = 'Guardar Permisos RBAC';
          btnSavePerms.disabled = false;
        }
      }
    });

    // 4. Modal 3: Editar Usuario y Rol
    const editUserModal = document.getElementById('modal-edit-user');
    const editUserId = document.getElementById('edit-user-id') as HTMLInputElement | null;
    const editUserName = document.getElementById('edit-user-name') as HTMLInputElement | null;
    const editUserEmail = document.getElementById('edit-user-email') as HTMLInputElement | null;
    const editUserRole = document.getElementById('edit-user-role') as HTMLSelectElement | null;
    const editUserCargo = document.getElementById('edit-user-cargo') as HTMLInputElement | null;
    const formEditUser = document.getElementById('form-edit-user');
    const btnCloseEdit = document.getElementById('btn-close-edit-modal');
    const btnCancelEdit = document.getElementById('btn-cancel-edit-user');

    function closeEditModal() {
      if (editUserModal) editUserModal.style.display = 'none';
    }
    btnCloseEdit?.addEventListener('click', closeEditModal);
    btnCancelEdit?.addEventListener('click', closeEditModal);

    function openEditModal(userId: string, userName: string, userEmail: string, userCargo: string, userRoleId: string) {
      syncRoleSelectDropdowns();
      if (editUserId) editUserId.value = userId;
      if (editUserName) editUserName.value = userName;
      if (editUserEmail) editUserEmail.value = userEmail;
      if (editUserCargo) editUserCargo.value = userCargo;
      if (editUserRole) {
        editUserRole.value = rolesCatalog.some((r) => r.id === userRoleId) ? userRoleId : 'funcionario';
        editUserRole.disabled = userId === 'usr-root';
      }
      if (editUserModal) editUserModal.style.display = 'flex';
    }

    formEditUser?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!editUserId || !editUserName || !editUserRole || !editUserCargo) return;

      const id = editUserId.value;
      const name = editUserName.value.trim();
      const email = editUserEmail?.value.trim().toLowerCase() || '';
      const roleId = editUserRole.value;
      const cargo = editUserCargo.value.trim();

      const submitBtn = document.getElementById('btn-submit-edit-user') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Guardando...';
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'update_user',
            userId: id,
            userEmail: email,
            name,
            roleId,
            cargo,
            applyRolePermissions: true,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo actualizar el usuario.');
        }

        (window as any).showToast('Usuario actualizado con éxito.', 'success');
        closeEditModal();
        setTimeout(() => window.location.reload(), 450);
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error al modificar usuario.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Guardar Modificaciones';
        }
      }
    });

    // 5. Modal 2: Crear Usuario
    const createModal = document.getElementById('modal-create-user');
    const btnOpenCreate = document.getElementById('btn-open-create-user');
    const btnCloseCreate = document.getElementById('btn-close-create-modal');
    const btnCancelCreate = document.getElementById('btn-cancel-create-user');
    const passInput = document.getElementById('create-user-password') as HTMLInputElement | null;
    const btnGenPass = document.getElementById('btn-generate-password');
    const formCreate = document.getElementById('form-create-new-user');

    function toggleCreateModal(open: boolean) {
      if (open) syncRoleSelectDropdowns();
      if (createModal) createModal.style.display = open ? 'flex' : 'none';
    }

    btnOpenCreate?.addEventListener('click', () => toggleCreateModal(true));
    btnCloseCreate?.addEventListener('click', () => toggleCreateModal(false));
    btnCancelCreate?.addEventListener('click', () => toggleCreateModal(false));

    btnGenPass?.addEventListener('click', () => {
      if (!passInput) return;
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%&*';
      let pass = '';
      for (let i = 0; i < 10; i++) {
        pass += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      passInput.value = pass;
    });

    formCreate?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('create-user-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('create-user-email') as HTMLInputElement).value.trim().toLowerCase();
      const roleId = (document.getElementById('create-user-role') as HTMLSelectElement).value;
      const cargo = (document.getElementById('create-user-cargo') as HTMLInputElement).value.trim();
      const password = passInput?.value.trim() || '';

      if (password.length < 8) {
        (window as any).showToast('La contraseña provisional debe tener al menos 8 caracteres.', 'warning');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-create-user') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando usuario...';
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'create_user',
            name,
            email,
            password,
            roleId,
            cargo,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Error creando usuario en base de datos.');
        }

        (window as any).showToast(data.message || `Usuario ${name} registrado satisfactoriamente.`, 'success');
        toggleCreateModal(false);
        (formCreate as HTMLFormElement).reset();
        setTimeout(() => window.location.reload(), 550);
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error creando usuario.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Crear Usuario';
        }
      }
    });

    // 6. Modal 4: Eliminar Usuario
    let userToDelete: { id: string; name: string; email: string } | null = null;
    const deleteModal = document.getElementById('modal-delete-user');
    const deleteModalName = document.getElementById('delete-user-modal-name');
    const deleteModalEmail = document.getElementById('delete-user-modal-email');
    const btnCancelDelete = document.getElementById('btn-cancel-delete-user');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete-user');

    function closeDeleteModal() {
      if (deleteModal) deleteModal.style.display = 'none';
      userToDelete = null;
    }

    btnCancelDelete?.addEventListener('click', closeDeleteModal);

    btnConfirmDelete?.addEventListener('click', async () => {
      const targetUser = userToDelete;
      if (!targetUser) return;

      const confirmBtn = btnConfirmDelete as HTMLButtonElement | null;
      if (confirmBtn) {
        confirmBtn.textContent = 'Eliminando...';
        confirmBtn.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'delete_user',
            userId: targetUser.id,
            userEmail: targetUser.email,
            userName: targetUser.name,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo eliminar el usuario.');
        }

        document.getElementById(`row-user-${targetUser.id}`)?.remove();
        (window as any).showToast(`El usuario ${targetUser.name} fue eliminado.`, 'success');
        closeDeleteModal();
        setTimeout(() => window.location.reload(), 400);
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error eliminando usuario.', 'error');
      } finally {
        if (confirmBtn) {
          confirmBtn.textContent = 'Confirmar Eliminación';
          confirmBtn.disabled = false;
        }
      }
    });

    // 7. Modal 5: Gestión y Creación de Roles Personalizados (+ Gestionar Roles)
    const rolesModal = document.getElementById('modal-roles');
    const btnOpenRolesModal = document.getElementById('btn-open-roles-modal');
    const btnCloseRolesModal = document.getElementById('btn-close-roles-modal');
    const btnCancelRolesModal = document.getElementById('btn-cancel-roles-modal');
    const rolesListContainer = document.getElementById('roles-catalog-list');
    const btnNewCustomRole = document.getElementById('btn-new-custom-role');
    const formRoleEditor = document.getElementById('form-role-editor') as HTMLFormElement | null;
    const roleEditId = document.getElementById('role-edit-id') as HTMLInputElement | null;
    const roleEditName = document.getElementById('role-edit-name') as HTMLInputElement | null;
    const roleEditColor = document.getElementById('role-edit-color') as HTMLInputElement | null;
    const roleColorPicker = document.getElementById('role-color-picker');
    const roleColorTrigger = document.getElementById('role-color-trigger') as HTMLButtonElement | null;
    const roleColorDropdown = document.getElementById('role-color-dropdown');
    const roleColorDot = document.getElementById('role-color-dot');
    const roleColorLabel = document.getElementById('role-color-label');
    const roleEditDesc = document.getElementById('role-edit-desc') as HTMLTextAreaElement | null;
    const roleEditPropagate = document.getElementById('role-edit-propagate') as HTMLInputElement | null;
    const roleAdminLockBanner = document.getElementById('role-admin-lock-banner');
    const btnSaveRole = document.getElementById('btn-save-role') as HTMLButtonElement | null;
    const roleLivePreviewBadge = document.getElementById('role-live-preview-badge') as HTMLElement | null;
    const roleLivePreviewDot = document.getElementById('role-live-preview-dot') as HTMLElement | null;
    const roleLivePreviewText = document.getElementById('role-live-preview-text') as HTMLElement | null;
    const roleFooterPermSummary = document.getElementById('role-footer-perm-summary') as HTMLElement | null;

    const ROLE_COLOR_NAMES: Record<string, string> = {
      '#00594E': 'Verde Unitrópico',
      '#B5A160': 'Dorado Institucional',
      '#003830': 'Verde Bosque',
      '#786832': 'Bronce Oscuro',
      '#1E293B': 'Pizarra Ejecutivo',
      '#334155': 'Carbón Institucional',
      '#7F1D1D': 'Vinotinto Sobrio',
    };

    const MAX_MODULE_PERMS = RBAC_MODULES.length * 2;
    const MODULE_ID_SET = new Set(RBAC_MODULES.map((m) => m.id));

    function computeModulePermStats(rawPerms: string[], isAdmin = false) {
      if (isAdmin) {
        return { verCount: RBAC_MODULES.length, manageCount: RBAC_MODULES.length, totalActive: MAX_MODULE_PERMS };
      }
      const norm = normalizePermissionsList(rawPerms);
      let verCount = 0;
      let manageCount = 0;
      norm.forEach((pid) => {
        const [modId, action] = pid.split('.');
        if (!modId || !MODULE_ID_SET.has(modId)) return;
        if (action === 'ver') verCount += 1;
        else if (action === 'gestionar') manageCount += 1;
      });
      return { verCount, manageCount, totalActive: verCount + manageCount };
    }

    function hexToSoftRgba(hex: string, alpha: number): string {
      const clean = hex.replace('#', '');
      if (clean.length !== 6) return `rgba(0, 89, 78, ${alpha})`;
      const r = parseInt(clean.slice(0, 2), 16);
      const g = parseInt(clean.slice(2, 4), 16);
      const b = parseInt(clean.slice(4, 6), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function updateRoleBadgePreview() {
      const hex = roleEditColor?.value || '#00594E';
      const labelTxt = (roleEditName?.value || '').trim() || 'Nuevo Rol';
      if (roleLivePreviewText) roleLivePreviewText.textContent = labelTxt.toUpperCase();
      if (roleLivePreviewDot) roleLivePreviewDot.style.background = hex;
      if (roleLivePreviewBadge) {
        roleLivePreviewBadge.style.color = hex;
        roleLivePreviewBadge.style.borderColor = hexToSoftRgba(hex, 0.42);
        roleLivePreviewBadge.style.background = hexToSoftRgba(hex, 0.08);
      }
    }

    function refreshLiveEditorRoleCount() {
      const checkedPerms: string[] = [];
      document.querySelectorAll<HTMLInputElement>('.role-perm-checkbox:checked').forEach((cb) => {
        if (cb.dataset.permId) checkedPerms.push(cb.dataset.permId);
      });
      const stats = computeModulePermStats(checkedPerms, activeRoleEditorId === 'admin');
      if (roleFooterPermSummary) {
        roleFooterPermSummary.innerHTML = `${stats.verCount} Ver &middot; ${stats.manageCount} Gestionar (${stats.totalActive}/${MAX_MODULE_PERMS} activos)`;
      }
      if (activeRoleEditorId) {
        const activeBadge = rolesListContainer?.querySelector<HTMLElement>(
          `[data-role-badge-id="${activeRoleEditorId}"]`
        );
        if (activeBadge) {
          activeBadge.textContent = `${stats.totalActive}/${MAX_MODULE_PERMS} activos`;
        }
      }
    }

    function setSelectedRoleColor(rawHex: string, disabled = false) {
      const normalized = (rawHex && rawHex !== '#2563EB' ? rawHex : '#00594E').toUpperCase();
      const matchingKey = Object.keys(ROLE_COLOR_NAMES).find((k) => k.toUpperCase() === normalized) || '#00594E';
      if (roleEditColor) roleEditColor.value = matchingKey;
      if (roleColorDot) (roleColorDot as HTMLElement).style.background = matchingKey;
      if (roleColorLabel) roleColorLabel.textContent = ROLE_COLOR_NAMES[matchingKey] || 'Verde Unitrópico';
      if (roleColorTrigger) roleColorTrigger.disabled = disabled;
      if (roleColorDropdown) (roleColorDropdown as HTMLElement).style.display = 'none';
      document.querySelectorAll<HTMLButtonElement>('.role-color-option').forEach((opt) => {
        const optHex = (opt.dataset.color || '').toUpperCase();
        opt.classList.toggle('selected', optHex === matchingKey.toUpperCase());
      });
      document.querySelectorAll<HTMLButtonElement>('.role-color-swatch').forEach((sw) => {
        const swHex = (sw.dataset.color || '').toUpperCase();
        sw.classList.toggle('selected', swHex === matchingKey.toUpperCase());
        sw.disabled = disabled;
      });
      updateRoleBadgePreview();
    }

    roleColorTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!roleColorDropdown || roleColorTrigger.disabled) return;
      const isOpen = (roleColorDropdown as HTMLElement).style.display === 'flex';
      (roleColorDropdown as HTMLElement).style.display = isOpen ? 'none' : 'flex';
    });

    document.querySelectorAll<HTMLButtonElement>('.role-color-option').forEach((opt) => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const chosen = opt.dataset.color || '#00594E';
        setSelectedRoleColor(chosen, roleColorTrigger?.disabled || false);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.role-color-swatch').forEach((sw) => {
      sw.addEventListener('click', () => {
        if (sw.disabled) return;
        const chosen = sw.dataset.color || '#00594E';
        setSelectedRoleColor(chosen, roleColorTrigger?.disabled || false);
      });
    });

    roleEditName?.addEventListener('input', updateRoleBadgePreview);

    document.addEventListener('click', (e) => {
      if (roleColorDropdown && roleColorPicker && !roleColorPicker.contains(e.target as Node)) {
        (roleColorDropdown as HTMLElement).style.display = 'none';
      }
    });

    setupMatrixCoupling(rolesModal, 'role-ver-cb', 'role-manage-cb', refreshLiveEditorRoleCount);

    document.querySelectorAll<HTMLButtonElement>('.btn-role-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        applyPresetToCheckboxes('role-perm', btn.dataset.preset || '');
        refreshLiveEditorRoleCount();
      });
    });

    function loadRoleIntoEditor(role?: SystemRole | null) {
      const isNew = !role;
      const isAdminRole = Boolean(role && role.id === 'admin');
      const isBaseProtected = Boolean(role && role.isProtected);

      activeRoleEditorId = role ? role.id : '';
      if (roleEditId) roleEditId.value = activeRoleEditorId;
      if (roleEditName) {
        roleEditName.value = role ? role.name : '';
        roleEditName.readOnly = isBaseProtected;
        roleEditName.style.background = isBaseProtected ? '#F8FAFC' : '#FFFFFF';
      }
      setSelectedRoleColor(role?.color || '#00594E', isAdminRole);
      if (roleEditDesc) {
        roleEditDesc.value = role?.desc || '';
        roleEditDesc.readOnly = isAdminRole;
        roleEditDesc.style.background = isAdminRole ? '#F8FAFC' : '#FFFFFF';
      }
      if (roleAdminLockBanner) {
        roleAdminLockBanner.style.display = isAdminRole ? 'block' : 'none';
      }
      if (btnSaveRole) {
        btnSaveRole.disabled = isAdminRole;
        btnSaveRole.textContent = isNew ? 'Crear Rol' : 'Guardar Cambios del Rol';
      }

      const rolePerms = isAdminRole
        ? ALL_PERMISSION_IDS
        : normalizePermissionsList(role?.permissions || []);

      document.querySelectorAll<HTMLInputElement>('.role-perm-checkbox').forEach((cb) => {
        const pid = cb.dataset.permId || '';
        cb.checked = isAdminRole || (!isNew && rolePerms.includes(pid));
        cb.disabled = isAdminRole;
      });

      updateRoleBadgePreview();
      renderRolesCatalogList();
      refreshLiveEditorRoleCount();
    }

    function renderRolesCatalogList() {
      if (!rolesListContainer) return;
      rolesListContainer.innerHTML = '';

      rolesCatalog.forEach((r) => {
        const isSelected = activeRoleEditorId === r.id;
        const safeColor = r.color && r.color !== '#2563EB' ? r.color : (r.id === 'admin' ? '#00594E' : '#786832');
        const stats = computeModulePermStats(r.permissions || [], r.id === 'admin');

        const row = document.createElement('div');
        row.className = 'role-selector-row';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `role-selector-btn ${isSelected ? 'active' : ''}`;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.innerHTML = `
          <div class="role-selector-top" style="${!r.isProtected ? 'padding-right: 26px;' : ''}">
            <span class="role-selector-name">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: ${safeColor}; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.14);"></span>
              <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${r.name}</span>
            </span>
            <svg class="role-selector-chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
          <div class="role-selector-meta">
            <span>${r.isProtected ? 'Rol base' : 'Personalizado'}</span>
            <span class="role-selector-badge" data-role-badge-id="${r.id}">${stats.totalActive}/${MAX_MODULE_PERMS} activos</span>
          </div>
        `;
        btn.addEventListener('click', () => loadRoleIntoEditor(r));
        row.appendChild(btn);

        if (!r.isProtected) {
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'btn-delete-custom-role';
          delBtn.dataset.roleId = r.id;
          delBtn.dataset.roleName = r.name;
          delBtn.title = 'Eliminar rol personalizado';
          delBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`;
          row.appendChild(delBtn);
        }

        rolesListContainer.appendChild(row);
      });
    }

    function openRolesModal() {
      const initialRole = rolesCatalog.find((r) => !r.isProtected) || rolesCatalog.find((r) => r.id === 'funcionario') || rolesCatalog[0];
      loadRoleIntoEditor(initialRole || null);
      if (rolesModal) rolesModal.style.display = 'flex';
    }

    function closeRolesModal() {
      if (rolesModal) rolesModal.style.display = 'none';
    }

    btnOpenRolesModal?.addEventListener('click', openRolesModal);
    btnCloseRolesModal?.addEventListener('click', closeRolesModal);
    btnCancelRolesModal?.addEventListener('click', closeRolesModal);
    btnNewCustomRole?.addEventListener('click', () => loadRoleIntoEditor(null));

    rolesListContainer?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      const delBtn = target?.closest('.btn-delete-custom-role') as HTMLButtonElement | null;
      if (!delBtn) return;

      e.stopPropagation();
      const roleId = delBtn.dataset.roleId || '';
      const roleName = delBtn.dataset.roleName || 'Rol';
      if (!roleId) return;

      const confirmed = await (window as any).showConfirm(
        `¿Eliminar el rol personalizado "${roleName}"? Los usuarios asignados pasarán automáticamente al rol Funcionario.`,
        'Eliminar Rol RBAC'
      );
      if (!confirmed) return;

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ action: 'delete_role', roleId }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo eliminar el rol.');
        }

        rolesCatalog = Array.isArray(data.roles) ? data.roles : rolesCatalog.filter((r) => r.id !== roleId);
        syncRoleSelectDropdowns();
        updateRolesKpi();
        loadRoleIntoEditor(rolesCatalog.find((r) => r.id === 'funcionario') || rolesCatalog[0] || null);
        (window as any).showToast(`Rol "${roleName}" eliminado correctamente.`, 'success');
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error eliminando rol.', 'error');
      }
    });

    formRoleEditor?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!roleEditName) return;

      const name = roleEditName.value.trim();
      const id = (roleEditId?.value || '').trim();
      const desc = roleEditDesc?.value.trim() || '';
      const color = roleEditColor?.value || '#00594E';
      const propagateToUsers = Boolean(roleEditPropagate?.checked);

      const selectedPerms: string[] = [];
      document.querySelectorAll<HTMLInputElement>('.role-perm-checkbox:checked').forEach((cb) => {
        if (cb.dataset.permId) selectedPerms.push(cb.dataset.permId);
      });

      if (!name) {
        (window as any).showToast('Ingrese un nombre válido para el rol.', 'warning');
        return;
      }

      if (btnSaveRole) {
        btnSaveRole.disabled = true;
        btnSaveRole.textContent = 'Guardando...';
      }

      try {
        const res = await fetch('/api/admin/rbac', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            action: 'upsert_role',
            id,
            name,
            desc,
            color,
            permissions: selectedPerms,
            propagateToUsers,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo guardar el rol.');
        }

        rolesCatalog = Array.isArray(data.roles) ? data.roles : rolesCatalog;
        syncRoleSelectDropdowns();
        updateRolesKpi();
        if (data.role) {
          loadRoleIntoEditor(data.role);
        } else {
          renderRolesCatalogList();
        }
        (window as any).showToast(data.message || `Rol "${name}" guardado correctamente.`, 'success');
      } catch (err: any) {
        (window as any).showToast(err?.message || 'Error guardando el rol.', 'error');
      } finally {
        if (btnSaveRole) {
          btnSaveRole.disabled = activeRoleEditorId === 'admin';
          btnSaveRole.textContent = activeRoleEditorId ? 'Guardar Cambios del Rol' : 'Crear Rol';
        }
      }
    });

    // 8. Delegación Global de Clics en la Tabla de Usuarios
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const permsBtn = target.closest('.btn-manage-perms') as HTMLElement | null;
      if (permsBtn) {
        e.preventDefault();
        openPermsModal(
          permsBtn.dataset.userId || '',
          permsBtn.dataset.userEmail || '',
          permsBtn.dataset.userName || '',
          permsBtn.dataset.userCargo || '',
          permsBtn.dataset.userRole || 'funcionario'
        );
        return;
      }

      const editBtn = target.closest('.btn-edit-user') as HTMLElement | null;
      if (editBtn) {
        e.preventDefault();
        openEditModal(
          editBtn.dataset.userId || '',
          editBtn.dataset.userName || '',
          editBtn.dataset.userEmail || '',
          editBtn.dataset.userCargo || '',
          editBtn.dataset.userRole || 'funcionario'
        );
        return;
      }

      const deleteBtn = target.closest('.btn-delete-user') as HTMLElement | null;
      if (deleteBtn) {
        e.preventDefault();
        userToDelete = {
          id: deleteBtn.dataset.userId || '',
          name: deleteBtn.dataset.userName || '',
          email: deleteBtn.dataset.userEmail || '',
        };
        if (deleteModal && deleteModalName && deleteModalEmail) {
          deleteModalName.textContent = userToDelete.name;
          deleteModalEmail.textContent = userToDelete.email;
          deleteModal.style.display = 'flex';
        }
      }
    });

    refreshRbacStateFromServer();
  </script>
</AppLayout>
