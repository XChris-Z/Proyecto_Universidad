                      <span id="role-color-label" style="font-size: 0.82rem; font-weight: 700; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Verde Unitrópico</span>
                    </span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2.4" style="flex-shrink: 0;"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                  <div class="role-color-dropdown" id="role-color-dropdown" style="display: none;">
                    {ROLE_PALETTE_OPTIONS.map((c) => (
                      <button type="button" class="role-color-option" data-color={c.hex} data-label={c.name}>
                        <span style={`width: 14px; height: 14px; border-radius: 50%; background: ${c.hex}; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.15);`}></span>
                        <span style="font-size: 0.80rem; font-weight: 700; color: #111827;">{c.name}</span>
                        <span style="margin-left: auto; font-family: monospace; font-size: 0.70rem; color: #64748B;">{c.hex}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Swatches clicables + Vista previa en vivo del Badge del Rol -->
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 8px 12px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; flex-shrink: 0;">
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span style="font-size: 0.70rem; font-weight: 800; color: #64748B; text-transform: uppercase;">Muestras:</span>
                <div style="display: flex; align-items: center; gap: 6px;">
