              </label>

              <div style="display: flex; gap: 6px;">
                <button type="button" class="btn-role-preset" data-preset="view_all" style="font-size: 0.70rem; font-weight: 750; padding: 4px 9px; border-radius: 6px; border: 1px solid #DBD2B0; background: #F7F5EE; color: #786832; cursor: pointer;">Solo Ver</button>
                <button type="button" class="btn-role-preset" data-preset="full_modules" style="font-size: 0.70rem; font-weight: 750; padding: 4px 9px; border-radius: 6px; border: 1px solid #B2CFCB; background: #F2F7F6; color: #00594E; cursor: pointer;">Todos</button>
                <button type="button" class="btn-role-preset" data-preset="clear_all" style="font-size: 0.70rem; font-weight: 750; padding: 4px 9px; border-radius: 6px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">Limpiar</button>
              </div>
            </div>

            <!-- Tabla Scrollable con Cabecera Sticky (12 Módulos Completos) -->
            <div class="roles-modules-table-wrap pro-scroll-container">
              <table class="roles-modules-table">
                <thead>
                  <tr>
                    <th style="text-align: left;">Módulo ({RBAC_MODULES.length})</th>
                    <th style="text-align: center; width: 92px;">Ver</th>
                    <th style="text-align: center; width: 112px;">Gestionar</th>
                  </tr>
                </thead>
                <tbody>
                  {RBAC_MODULES.map((mod) => (
                    <tr class="role-module-row">
                      <td>
                        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                          <div class="role-module-icon-box">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d={SIDEBAR_MODULE_ICONS[mod.id] || SIDEBAR_MODULE_ICONS.dashboard} />
                            </svg>
                          </div>
                          <div style="min-width: 0;">
                            <div style="font-weight: 750; font-size: 0.81rem; color: #111827; line-height: 1.25;">{mod.label}</div>
                            <div style="font-size: 0.69rem; color: #64748B;">{mod.group}</div>
                          </div>
                        </div>
                      </td>
                      <td style="text-align: center;">
                        <div style="display: inline-flex; justify-content: center;">
                          <label class="switch switch-sm">
                            <input type="checkbox" class="role-perm-checkbox role-ver-cb" data-matrix="role" data-module-id={mod.id} data-perm-id={`${mod.id}.ver`} />
                            <span class="slider"></span>
                          </label>
                        </div>
                      </td>
                      <td style="text-align: center;">
                        <div style="display: inline-flex; justify-content: center;">
                          <label class="switch switch-sm">
                            <input type="checkbox" class="role-perm-checkbox role-manage-cb" data-matrix="role" data-module-id={mod.id} data-perm-id={`${mod.id}.gestionar`} />
                            <span class="slider slider-gold"></span>
                          </label>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </form>
        </div>

        <!-- ZONA 3: FOOTER DE ANCHO COMPLETO FIJO AL PIE DEL MODAL -->
        <div class="roles-modal-footer">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span id="role-footer-perm-summary" style="font-size: 0.76rem; font-weight: 800; color: #00594E; background: #F2F7F6; border: 1px solid #B2CFCB; padding: 5px 11px; border-radius: 999px;">
              0 Ver &middot; 0 Gestionar (0/24 activos)
            </span>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" class="btn btn-secondary" id="btn-cancel-roles-modal">Cerrar</button>
            <button type="submit" form="form-role-editor" id="btn-save-role" class="btn btn-primary" style="font-weight: 800; padding: 9px 20px;">Guardar Cambios del Rol</button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script id="rbac-bootstrap-json" type="application/json" set:html={initialRbacBootstrap}></script>

