                    <button
                      type="button"
                      class="role-color-swatch"
                      data-color={c.hex}
                      data-label={c.name}
                      title={`${c.name} (${c.hex})`}
                      style={`background: ${c.hex};`}
                    />
                  ))}
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 0.70rem; font-weight: 800; color: #64748B; text-transform: uppercase;">Vista Previa:</span>
                <span id="role-live-preview-badge" class="role-live-preview-pill" style="background: #F2F7F6; border: 1px solid #00594E; color: #00594E;">
                  <span id="role-live-preview-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #00594E; flex-shrink: 0;"></span>
                  <span id="role-live-preview-text">FUNCIONARIO</span>
                </span>
              </div>
            </div>

            <!-- Descripción / Alcance sin recortes -->
            <div style="flex-shrink: 0;">
              <label style="font-size: 0.72rem; font-weight: 800; color: #52606D; text-transform: uppercase; letter-spacing: 0.03em; display: block; margin-bottom: 5px;">Descripción / Alcance</label>
              <textarea id="role-edit-desc" rows="2" placeholder="Describe las responsabilidades y alcance operativo del rol..." class="role-desc-input role-desc-textarea"></textarea>
            </div>

            <!-- Barra de Sincronización + Presets -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 9px; padding: 8px 12px; flex-shrink: 0;">
              <label style="display: flex; align-items: center; gap: 8px; font-size: 0.76rem; font-weight: 700; color: #334155; cursor: pointer;">
