                                const isDelivered = ofiAnexos.length > 0 || (subcarpetas.length === 1 && isStateEntregado);
                                const ofiNombre = Array.isArray(r.oficinas) ? (r.oficinas[0]?.nombre || 'Oficina Responsable') : (r.oficinas?.nombre || 'Oficina Responsable');
