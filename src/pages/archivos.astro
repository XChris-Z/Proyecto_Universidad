---
// src/pages/archivos.astro
export const prerender = false;

import AppLayout from '@layouts/AppLayout.astro';
import '../styles/archivos.css';
import { supabase } from '@lib/supabase';
import { calculateDeadlineProgress } from '@lib/utils';
import { Buffer } from 'node:buffer';
import { getDeterministicPin } from '@lib/security';
import { separarRespuestaMeta, esSubcarpetaValida, filtrarSubcarpetasValidas } from '@lib/subcarpetas';

// Interfaces estrictas para TypeScript
export interface PeticionAnexo {
  id: string;
  nombre_archivo: string;
  storage_path: string;
  tamano_bytes: number | null;
  mime_type?: string | null;
  es_anexo_oficina?: boolean | null;
  peticion_responsable_id?: string | null;
  subcarpeta_id?: string | null;
  created_at: string;
}

export interface OficinaInfo {
  id: string;
  codigo: string;
  nombre: string;
  email_institucional?: string | null;
}

export interface PeticionResponsable {
  id: string;
  codigo_acceso: string;
  subcarpeta_id?: string | null;
  estado_entrega?: string | null;
  fecha_entrega?: string | null;
  observaciones_entrega?: string | null;
  storage_subfolder_path?: string | null;
  oficinas?: OficinaInfo | null;
}

export interface PeticionSubcarpeta {
  id: string;
  peticion_id: string;
  nombre: string;
  descripcion?: string | null;
  created_at?: string;
}

export interface PeticionExpediente {
  id: string;
  numero_radicado: string;
  asunto: string;
  descripcion?: string | null;
  categoria?: string | null;
  instrucciones_anexos?: string | null;
  pin_acceso?: string | null;
  solicitante_nombre: string;
  solicitante_tipo?: string | null;
  solicitante_email?: string | null;
  fecha_radicacion?: string | null;
  fecha_limite_entrega?: string | null;
  fecha_limite_responsable?: string | null;
  storage_folder_path?: string | null;
  estado: string;
  prioridad?: string | null;
  created_at: string;
  respuesta_mensaje?: string | null;
  respuesta_funcionario?: string | null;
  respuesta_fecha_envio?: string | null;
  respuesta_expira_at?: string | null;
  respuesta_pin_solicitante?: string | null;
  respuesta_archivos_incluidos?: string[] | null;
  respuesta_drive_url?: string | null;
  peticion_anexos?: PeticionAnexo[];
  peticion_responsables?: PeticionResponsable[];
  subcarpetas?: PeticionSubcarpeta[];
}

// Consultar peticiones, archivo principal y anexos reales en PostgreSQL
const { data: dbPeticiones } = await (supabase
  .from('peticiones' as any)
  .select(`
    id,
    numero_radicado,
    asunto,
    descripcion,
    categoria,
    instrucciones_anexos,
    solicitante_nombre,
    solicitante_tipo,
    solicitante_email,
    fecha_radicacion,
    fecha_limite_entrega,
    fecha_limite_responsable,
    storage_folder_path,
    estado,
    prioridad,
    created_at,
    peticion_anexos (
      id,
      nombre_archivo,
      storage_path,
      tamano_bytes,
      mime_type,
      es_anexo_oficina,
      peticion_responsable_id,
      created_at
    ),
    peticion_responsables (
      id,
      codigo_acceso,
      estado_entrega,
      fecha_entrega,
      observaciones_entrega,
      storage_subfolder_path,
      oficinas (
        id,
        codigo,
        nombre,
        email_institucional
      )
    )
  `)
  .order('created_at', { ascending: false }) as any);

// Consultar catálogo de oficinas para modal de asignación de subcarpetas
const { data: oficinasCatalogoDb } = await (supabase
  .from('oficinas' as any)
  .select('id, codigo, nombre, email_institucional')
  .eq('activo', true)
  .order('nombre') as any);

const oficinasCatalogo = (oficinasCatalogoDb as any[]) || [];

// Consultar subcarpetas asociadas de forma segura y defensiva
const subcarpetasPorPeticion: Record<string, any[]> = {};
try {
  const { data: allSubcarpetas } = await (supabase
    .from('peticion_subcarpetas' as any)
    .select('id, peticion_id, nombre, descripcion, created_at')
    .order('created_at', { ascending: true }) as any);

  if (allSubcarpetas && allSubcarpetas.length > 0) {
    allSubcarpetas.forEach((sub: any) => {
      const petId = String(sub?.peticion_id || '');
      if (petId) {
        if (!subcarpetasPorPeticion[petId]) {
          subcarpetasPorPeticion[petId] = [];
        }
        subcarpetasPorPeticion[petId]!.push(sub);
      }
    });
  }
} catch {
  // Ignorar si la tabla física aún no existe
}

// Consultar mapeos de subcarpeta_id en peticion_responsables y peticion_anexos de forma segura
const respSubcarpetasMap: Record<string, string> = {};
try {
  const { data: respSubs } = await (supabase
    .from('peticion_responsables' as any)
    .select('id, subcarpeta_id') as any);
  if (respSubs && respSubs.length > 0) {
    respSubs.forEach((r: any) => {
      if (r && r.id && r.subcarpeta_id) respSubcarpetasMap[r.id] = r.subcarpeta_id;
    });
  }
} catch {}

const anexoSubcarpetasMap: Record<string, string> = {};
try {
  const { data: anexoSubs } = await (supabase
    .from('peticion_anexos' as any)
    .select('id, subcarpeta_id') as any);
  if (anexoSubs && anexoSubs.length > 0) {
    anexoSubs.forEach((a: any) => {
      if (a && a.id && a.subcarpeta_id) anexoSubcarpetasMap[a.id] = a.subcarpeta_id;
    });
  }
} catch {}

const rawPeticiones = (dbPeticiones as any[]) || [];

// Helper robusto para inferir subcarpetas virtuales si la tabla física aún no tiene registros (retrocompatibilidad)
function combineSubcarpetas(p: any, dbSubs: any[] = []): any[] {
  const mapByName: Record<string, any> = {};
  filtrarSubcarpetasValidas(dbSubs || []).forEach(s => {
    if (s && s.nombre && s.nombre.trim().toLowerCase() !== 'expediente general') {
      mapByName[s.nombre.trim().toUpperCase()] = s;
    }
  });

  const foundSubs: Record<string, { id: string; peticion_id: string; nombre: string; descripcion?: string | null }> = {};

  (p.peticion_responsables || []).forEach((r: any) => {
    const raw = r?.observaciones_entrega || '';
    const { textoLimpio } = separarRespuestaMeta(raw);
    const withoutPin = textoLimpio.replace(/^PIN:\s*[0-9A-Z]{6}(\s*\|\s*)?/i, '');
    const matches = withoutPin.matchAll(/\[([^\]\r\n]+)\](?:\s*:?\s*([^|\[\r\n]+))?/g);
    for (const m of matches) {
      const name = String(m?.[1] || '').trim();
      const desc = String(m?.[2] || '').trim() || null;
      if (name && esSubcarpetaValida({ nombre: name, descripcion: desc })) {
        const key = name.toUpperCase();
        const existing = foundSubs[key];
        if (!existing) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: desc,
          };
        } else if (!existing.descripcion && desc) {
          existing.descripcion = desc;
        }
      }
    }
  });

  (p.peticion_anexos || []).forEach((a: any) => {
    const fileName = a?.nombre_archivo || '';
    const m = fileName.match(/\[([^\]\r\n]+)\]/i);
    if (m && m[1]) {
      const name = String(m[1] || '').trim();
      if (name && esSubcarpetaValida({ nombre: name })) {
        const key = name.toUpperCase();
        if (!foundSubs[key]) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: null,
          };
        }
      }
    }
  });

  const { textoLimpio: cleanDesc } = separarRespuestaMeta(p.instrucciones_anexos || p.descripcion || '');
  if (cleanDesc) {
    const matches = cleanDesc.matchAll(/\[([^\]\r\n]+)\](?:\s*:?\s*([^|\[\r\n]+))?/g);
    for (const m of matches) {
      const name = String(m?.[1] || '').trim();
      const desc = String(m?.[2] || '').trim() || null;
      if (name && esSubcarpetaValida({ nombre: name, descripcion: desc })) {
        const key = name.toUpperCase();
        const existing = foundSubs[key];
        if (!existing) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: desc,
          };
        } else if (!existing.descripcion && desc) {
          existing.descripcion = desc;
        }
      }
    }
  }

  Object.values(foundSubs).forEach(s => {
    if (esSubcarpetaValida(s)) {
      const k = s.nombre.trim().toUpperCase();
      if (!mapByName[k]) mapByName[k] = s;
    }
  });

  const list = filtrarSubcarpetasValidas(Object.values(mapByName));
  if (list.length === 0 && (p.peticion_responsables?.length > 0 || (p.peticion_anexos && p.peticion_anexos.some((a: any) => a.es_anexo_oficina)))) {
    const { textoLimpio } = separarRespuestaMeta(p.instrucciones_anexos);
    list.push({
      id: `sub-default-${p.id}`,
      peticion_id: p.id,
      nombre: 'Subcarpeta 1',
      descripcion: textoLimpio || 'Aportes y requerimientos de dependencias',
    });
  }

  return filtrarSubcarpetasValidas(list);
}

const peticiones: PeticionExpediente[] = rawPeticiones.map((p) => {
  const respObs = p.peticion_responsables?.find((r: any) => r?.observaciones_entrega?.includes('PIN:'))?.observaciones_entrega;
  const pinMatch = respObs?.match(/PIN:\s*([0-9A-Z]{6})/i);
  const storedPin = pinMatch ? (pinMatch[1] || null) : null;

  const enrichedResponsables = (p.peticion_responsables || []).map((r: any) => ({
    ...r,
    subcarpeta_id: r.subcarpeta_id || respSubcarpetasMap[r.id] || null,
  }));

  const enrichedAnexos = (p.peticion_anexos || []).map((a: any) => ({
    ...a,
    subcarpeta_id: a.subcarpeta_id || anexoSubcarpetasMap[a.id] || null,
  }));

  const initialSubs = subcarpetasPorPeticion[p.id] || [];
  const finalSubs = combineSubcarpetas(p, initialSubs);

  return {
    ...p,
    peticion_responsables: enrichedResponsables,
    peticion_anexos: enrichedAnexos,
    subcarpetas: finalSubs,
    pin_acceso: storedPin || p.pin_acceso || getDeterministicPin(p.numero_radicado || p.id),
  };
});
const totalCount = peticiones.length;
const pendingCount = peticiones.filter((p) => p.estado !== 'respondida' && p.estado !== 'completada').length;
const respondedCount = peticiones.filter((p) => p.estado === 'respondida' || p.estado === 'completada').length;

let safeCount = 0;
let warnCount = 0;
let criticalCount = 0;

peticiones.forEach((p) => {
  const prog = calculateDeadlineProgress(p.fecha_radicacion || p.created_at, p.fecha_limite_entrega);
  if (prog.daysRemaining > 7) safeCount++;
  else if (prog.daysRemaining >= 3) warnCount++;
  else criticalCount++;
});

// Función para obtener URL pública de descarga en Supabase Storage
function getDownloadUrl(storagePath: string | null | undefined): string {
  if (!storagePath) return '#';
  const clean = storagePath.replace(/^peticiones\//, '');
  return `https://irjjpjtvhxoakiazfswn.supabase.co/storage/v1/object/public/peticiones/${clean}`;
}

const peticionesJson = JSON.stringify(peticiones);
const peticionesBase64 = Buffer.from(peticionesJson, 'utf-8').toString('base64');
---

<AppLayout title="Gestor de Archivos y Carpetas de Radicados" activeNav="archivos">
  <div class="archivos-wrapper" style="display: flex; flex-direction: column; gap: 20px;">

    <!-- =========================================================================
         1. VISTA GENERAL DE EXPLORADOR DE CARPETAS (RAÍZ)
         Se oculta por completo cuando se abre una carpeta para dar paso a la vista dedicada
         ========================================================================= -->
    <div id="explorer-root-view" style="display: flex; flex-direction: column; gap: 20px;">

      <!-- Barra de Navegación y Herramientas Estilo Google Drive -->
      <div class="card" style="padding: 16px 20px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        
        <!-- Breadcrumb de Raíz -->
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <div style="font-weight: 800; font-size: 0.95rem; color: var(--text-main);">Gestor de Archivos y Expedientes</div>
            <div style="font-size: 0.72rem; color: var(--text-muted);">Directorio raíz de expedientes virtuales</div>
          </div>
        </div>

        <!-- Acciones de Cabecera: Buscador, Alternador y Nueva Radicación -->
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <!-- Buscador en Vivo -->
          <div style="position: relative; width: 260px;">
            <input type="text" id="drive-search-input" placeholder="Buscar carpeta, radicado o titular..." class="form-input" style="padding-left: 34px; height: 38px; font-size: 0.82rem;" />
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 11px; top: 12px; color: var(--text-muted);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <!-- Alternador Vista Carpetas / Vista Lista -->
          <div style="display: flex; background: var(--bg-surface-elevated); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 2px;">
            <button type="button" id="btn-view-grid" class="view-toggle-btn active" title="Vista de Carpetas estilo Drive">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>Carpetas</span>
            </button>
            <button type="button" id="btn-view-table" class="view-toggle-btn" title="Vista de Tabla Detallada">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              <span>Lista</span>
            </button>
          </div>

          <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.82rem; height: 38px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            <span>Nueva Carpeta / Radicación</span>
          </a>
        </div>
      </div>

      <!-- Pestañas de Filtro Rápido -->
      <div class="filter-tabs" id="archivos-filter-tabs">
        <button class="filter-tab active" data-filter="all">
          <span>Todas las Carpetas</span>
          <span class="filter-count" id="count-all">{totalCount}</span>
        </button>
        <button class="filter-tab" data-filter="pending">
          <span class="dist-dot" style="background: var(--dorado-oscuro);"></span>
          <span>En Trámite</span>
          <span class="filter-count" id="count-pending">{pendingCount}</span>
        </button>
        <button class="filter-tab" data-filter="responded">
          <span class="dist-dot" style="background: var(--verde-principal);"></span>
          <span>Respondidas</span>
          <span class="filter-count" id="count-responded">{respondedCount}</span>
        </button>
        <button class="filter-tab" data-filter="safe">
          <span class="dist-dot" style="background: #16a34a;"></span>
          <span>Plazo Saludable</span>
          <span class="filter-count" id="count-safe">{safeCount}</span>
        </button>
        <button class="filter-tab" data-filter="warn">
          <span class="dist-dot" style="background: #d97706;"></span>
          <span>Próximo a Vencer</span>
          <span class="filter-count" id="count-warn">{warnCount}</span>
        </button>
        <button class="filter-tab" data-filter="critical">
          <span class="dist-dot" style="background: #dc2626;"></span>
          <span>Crítico / Vencido</span>
          <span class="filter-count" id="count-critical">{criticalCount}</span>
        </button>
      </div>

      <!-- SECCIÓN A: MODO CUADRÍCULA DE CARPETAS (GRID ESTILO GOOGLE DRIVE) -->
      <div id="drive-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 16px;">
        {peticiones.length > 0 ? (
          peticiones.map((doc) => {
            const isResponded = doc.estado === 'respondida' || doc.estado === 'completada';
            const anexos = doc.peticion_anexos || [];
            const anexoPrincipal = anexos.find((a) => !a.es_anexo_oficina) || anexos[0];
            const responsables = doc.peticion_responsables || [];
            const prog = calculateDeadlineProgress(doc.fecha_radicacion || doc.created_at, doc.fecha_limite_entrega);
            const filterSla = prog.daysRemaining <= 2 ? 'critical' : prog.daysRemaining <= 7 ? 'warn' : 'safe';

            return (
              <div 
                class="drive-folder-card" 
                id={`card-folder-${doc.id}`}
                data-folder-id={doc.id}
                data-id={doc.id}
                data-radicado={doc.numero_radicado}
                data-pin={doc.pin_acceso || '849201'}
                data-asunto={doc.asunto}
                data-solicitante={doc.solicitante_nombre}
                data-status={isResponded ? 'responded' : 'pending'} 
                data-sla={filterSla}
              >
                <!-- Cabecera de Carpeta -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="folder-svg-icon" style="width: 44px; height: 44px; border-radius: 10px; background: rgba(0, 89, 78, 0.08); color: var(--verde-principal); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(0, 89, 78, 0.2);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                    </div>
                    <div>
                      <span class="radicado-chip">{doc.numero_radicado}</span>
                      <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 3px;">
                        Radicado: {doc.fecha_radicacion || 'Reciente'}
                      </div>
                    </div>
                  </div>

                  <span style={`font-size: 0.68rem; font-weight: 800; padding: 2px 8px; border-radius: 4px; background: ${prog.bgLight}; color: ${prog.color};`}>
                    {prog.statusBadge}
                  </span>
                </div>

                <!-- Título de la Carpeta (Asunto) -->
                <h4 class="folder-title" title={doc.asunto}>{doc.asunto}</h4>

                <!-- Solicitante -->
                <div style="font-size: 0.76rem; color: var(--text-muted); margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <span style="font-weight: 700; color: var(--text-main);">{doc.solicitante_nombre}</span> ({doc.solicitante_tipo === 'Docente' ? 'Profesor' : (doc.solicitante_tipo || 'Ciudadano')})
                </div>

                <!-- Barra de Semáforo SLA en la Tarjeta -->
                <div style="margin-bottom: 12px; background: #FAF9F5; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-subtle);">
                  <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.70rem; margin-bottom: 4px;">
                    <span style="color: var(--text-muted); font-weight: 600;">Término Legal ({doc.fecha_limite_entrega}):</span>
                    <span style={`font-weight: 800; color: ${prog.color};`}>{prog.percentage}% consumido</span>
                  </div>
                  <div style="width: 100%; height: 6px; background: #E2E8F0; border-radius: 9999px; overflow: hidden;">
                    <div style={`width: ${prog.percentage}%; height: 100%; background: ${prog.color}; transition: width 0.3s ease; border-radius: 9999px;`}></div>
                  </div>
                </div>

                <!-- Contenido de la Carpeta (Archivos & Subcarpetas de Oficinas) -->
                <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 10px 12px; font-size: 0.75rem; margin-bottom: 14px; display: flex; flex-direction: column; gap: 6px;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      <span>Documento Raíz:</span>
                    </span>
                    <span style="font-weight: 700; color: var(--verde-principal); max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      {anexoPrincipal?.nombre_archivo || 'Documento Inicial'}
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                      <span>Subcarpetas:</span>
                    </span>
                    <span style="font-weight: 800; color: var(--text-main);">
                      {responsables.length} dependencias
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: var(--text-muted);">Límite Dependencias:</span>
                    <span style="font-weight: 700; color: var(--dorado-oscuro); font-family: monospace;">
                      {doc.fecha_limite_responsable}
                    </span>
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--border-subtle); padding-top: 5px;">
                    <span style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      <span>PIN Acceso:</span>
                    </span>
                    <div style="display: flex; align-items: center; gap: 5px;">
                      <span style="font-family: monospace; font-size: 0.72rem; font-weight: 800; background: rgba(217, 119, 6, 0.12); color: #b45309; border: 1px solid rgba(217, 119, 6, 0.25); padding: 1px 6px; border-radius: 4px; letter-spacing: 0.05em;">
                        {doc.pin_acceso || '849201'}
                      </span>
                      <button
                        type="button"
                        class="btn-copy-pin"
                        data-pin={doc.pin_acceso || '849201'}
                        title="Copiar PIN de 6 dígitos"
                        style="border: 1px solid var(--border-subtle); background: #ffffff; border-radius: 4px; padding: 2px 5px; font-size: 0.65rem; cursor: pointer; color: var(--text-muted); display: inline-flex; align-items: center; gap: 2px;"
                      >
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        <span>Copiar</span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Barra de Acciones de la Carpeta -->
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px; border-top: 1px solid var(--border-subtle); padding-top: 10px;">
                  <button 
                    type="button" 
                    class="btn-open-folder btn-abrir-carpeta btn btn-primary btn-sm" 
                    style="flex: 1; justify-content: center; gap: 6px; font-weight: 800; font-size: 0.8rem; cursor: pointer;" 
                    data-folder-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    onclick={`window.openFolderDetail && window.openFolderDetail('${doc.id || doc.numero_radicado}')`}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span>Abrir Carpeta</span>
                  </button>

                  {anexoPrincipal && (
                    <a 
                      href={getDownloadUrl(anexoPrincipal.storage_path)} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="btn-icon-action" 
                      title="Descargar documento principal" 
                      style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: #ffffff; color: var(--text-muted); display: flex; align-items: center; justify-content: center;"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </a>
                  )}

                  <button 
                    type="button" 
                    class="btn-icon-action btn-edit-pet" 
                    data-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    data-asunto={doc.asunto}
                    data-solicitante={doc.solicitante_nombre}
                    data-tipo={doc.solicitante_tipo || 'Ciudadano'}
                    data-prioridad={doc.prioridad || 'Media'}
                    data-entrega={doc.fecha_limite_entrega}
                    data-estado={doc.estado || 'en_tramite'}
                    title="Editar Expediente"
                    style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--dorado-borde); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center; cursor: pointer;"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>

                  <button 
                    type="button" 
                    class="btn-icon-action btn-delete-pet" 
                    data-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    title="Eliminar Carpeta y Radicado"
                    style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </div>
              </div>
            );
          })
        ) : (
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px auto;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin: 0 0 6px 0;">No hay carpetas de expedientes creadas</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); max-width: 480px; margin: 0 auto 16px auto;">
              Al radicar una nueva petición se creará automáticamente su carpeta virtual con su documento inicial y las subcarpetas de las dependencias asignadas.
            </p>
            <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              <span>Radicar Primera Petición</span>
            </a>
          </div>
        )}
      </div>

      <!-- SECCIÓN B: MODO LISTA TABULAR DETALLADA -->
      <div id="drive-table-container" style="display: none !important;">
        <div class="table-responsive pro-scroll-container table-scroll-wrapper" style="max-height: 540px; overflow-y: auto; overflow-x: auto; border-radius: 12px;">
          <table class="doc-table">
            <thead style="position: sticky; top: 0; z-index: 10;">
              <tr style="background: #F2F7F6; border-bottom: 2px solid #DCE4E3;">
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Carpeta / Expediente</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Radicado</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Fechas (Radicado - Límite)</th>
                <th style="min-width: 170px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Plazo General (SLA)</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Oficinas Responsables</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Estado</th>
                <th style="text-align: right; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Acciones</th>
              </tr>
            </thead>
            <tbody id="documents-table-body">
              {peticiones.map((doc) => {
                const prog = calculateDeadlineProgress(doc.fecha_radicacion || doc.created_at, doc.fecha_limite_entrega);
                const isResponded = doc.estado === 'respondida' || doc.estado === 'completada';
                const anexos = doc.peticion_anexos || [];
                const anexoPrincipal = anexos.find((a) => !a.es_anexo_oficina) || anexos[0];
                const responsables = doc.peticion_responsables || [];
                const filterSla = prog.daysRemaining <= 2 ? 'critical' : prog.daysRemaining <= 7 ? 'warn' : 'safe';

                return (
                  <tr class="doc-row" id={`row-folder-${doc.id}`} data-id={doc.id} data-radicado={doc.numero_radicado} data-pin={doc.pin_acceso || '849201'} data-asunto={doc.asunto} data-solicitante={doc.solicitante_nombre} data-status={isResponded ? 'responded' : 'pending'} data-sla={filterSla}>
                    <td>
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <div class="doc-icon-badge pdf" style="width: 34px; height: 34px; font-size: 0.68rem; background: var(--verde-suave-bg); color: var(--verde-principal); border: 1px solid var(--verde-borde); display: flex; align-items: center; justify-content: center; border-radius: 6px;">
                          <span>DOC</span>
                        </div>
                        <div>
                          <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">{doc.asunto}</div>
                          <div style="font-size: 0.74rem; color: var(--text-muted);">
                            {(doc.solicitante_tipo === 'Docente' ? 'Profesor' : doc.solicitante_tipo) || 'Peticionario'} &bull; {doc.solicitante_nombre}
                            {anexoPrincipal && (
                              <span style="color: var(--verde-principal); font-weight: 600; margin-left: 6px;">
                                ({anexoPrincipal.nombre_archivo})
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="radicado-chip">{doc.numero_radicado}</span>
                      <div style="margin-top: 4px; display: inline-flex; align-items: center; gap: 4px; background: rgba(217, 119, 6, 0.12); border: 1px solid rgba(217, 119, 6, 0.25); padding: 1px 5px; border-radius: 4px;">
                        <span style="font-family: monospace; font-size: 0.68rem; font-weight: 800; color: #b45309;">PIN {doc.pin_acceso || '849201'}</span>
                        <button 
                          type="button" 
                          class="btn-copy-pin"
                          data-pin={doc.pin_acceso || '849201'}
                          title="Copiar PIN de 6 dígitos" 
                          style="border: none; background: transparent; cursor: pointer; color: #b45309; padding: 0; display: inline-flex; align-items: center;"
                        >
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                      </div>
                    </td>
                    <td style="font-size: 0.8rem;">
                      <div>Rad: <strong>{doc.fecha_radicacion || '--'}</strong></div>
                      <div style="color: var(--text-muted); font-size: 0.74rem;">Límite: {doc.fecha_limite_entrega}</div>
                    </td>
                    <td>
                      <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.72rem; margin-bottom: 3px;">
                        <span style={`font-weight: 800; color: ${prog.color};`}>{prog.percentage}%</span>
                        <span style="color: var(--text-muted); font-size: 0.68rem;">{prog.daysRemaining} días</span>
                      </div>
                      <div style="width: 100%; height: 5px; background: #E2E8F0; border-radius: 9999px; overflow: hidden;">
                        <div style={`width: ${prog.percentage}%; height: 100%; background: ${prog.color}; border-radius: 9999px;`}></div>
                      </div>
                    </td>
                    <td>
                      <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-main);">
                        {responsables.length} asignadas
                      </span>
                      <div style="font-size: 0.70rem; color: var(--dorado-oscuro);">Límite: {doc.fecha_limite_responsable}</div>
                    </td>
                    <td>
                      <span style={`font-size: 0.72rem; font-weight: 700; padding: 4px 8px; border-radius: 4px; ${isResponded ? 'background: #DCFCE7; color: #15803D;' : 'background: #FEF3C7; color: #92400E;'}`}>
                        {isResponded ? 'Respondida' : 'En Trámite'}
                      </span>
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                      <div style="display: inline-flex; align-items: center; gap: 6px;">
                        <button type="button" class="btn btn-primary btn-sm btn-open-folder btn-abrir-carpeta" data-folder-id={doc.id} data-radicado={doc.numero_radicado} onclick={`window.openFolderDetail && window.openFolderDetail('${doc.id || doc.numero_radicado}')`} style="font-size: 0.75rem; font-weight: 700; cursor: pointer;">
                          Abrir
                        </button>

                        <button 
                          type="button" 
                          class="btn-icon-action btn-edit-pet" 
                          data-id={doc.id} 
                          data-radicado={doc.numero_radicado}
                          data-asunto={doc.asunto}
                          data-solicitante={doc.solicitante_nombre}
                          data-tipo={doc.solicitante_tipo || 'Ciudadano'}
                          data-prioridad={doc.prioridad || 'Media'}
                          data-entrega={doc.fecha_limite_entrega}
                          data-estado={doc.estado || 'en_tramite'}
                          title="Editar Expediente"
                          style="width: 30px; height: 30px; border-radius: var(--radius-sm); border: 1px solid var(--dorado-borde); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center; cursor: pointer;"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>

                        <button 
                          type="button" 
                          class="btn-icon-action btn-delete-pet" 
                          data-id={doc.id} 
                          data-radicado={doc.numero_radicado}
                          title="Eliminar Expediente"
                          style="width: 30px; height: 30px; border-radius: var(--radius-sm); border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- =========================================================================
         2. VISTA DEDICADA Y EXCLUSIVA DE CARPETA (ESTILO GOOGLE DRIVE)
         Ocupa el 100% de la pantalla reemplazando al listado de carpetas
         ========================================================================= -->
    <div id="explorer-folder-view" style="display: none; flex-direction: column; gap: 20px;">
      <!-- El contenido completo de la carpeta se inyecta dinámicamente vía TypeScript/JS -->
    </div>

  </div>

  <!-- Modal: Editar Petición desde Gestor de Archivos -->
  <div class="modal-backdrop" id="modal-edit-peticion" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="edit-modal-title">Editar Carpeta / Radicado</span>
        </h3>
        <button type="button" id="btn-close-edit-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>

      <form id="form-edit-peticion" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" id="edit-pet-id" />

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Asunto del Expediente *</label>
          <input type="text" id="edit-pet-asunto" required class="form-input" style="font-size: 0.88rem; font-weight: 600;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Solicitante *</label>
            <input type="text" id="edit-pet-solicitante" required class="form-input" />
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo</label>
            <select id="edit-pet-tipo" class="form-select">
              <option value="Estudiante">Estudiante</option>
              <option value="Docente">Profesor</option>
              <option value="Egresado">Egresado</option>
              <option value="Ciudadano">Ciudadano</option>
              <option value="Ente de Control">Ente de Control</option>
              <option value="Entidad Gubernamental">Entidad Gubernamental</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Prioridad</label>
            <select id="edit-pet-prioridad" class="form-select">
              <option value="Baja">Baja</option>
              <option value="Media">Media</option>
              <option value="Alta">Alta</option>
            </select>
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Estado</label>
            <select id="edit-pet-estado" class="form-select">
              <option value="en_tramite">En Trámite</option>
              <option value="respondida">Respondida</option>
              <option value="archivada">Archivada</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Fecha Límite General de Entrega *</label>
          <input type="date" id="edit-pet-entrega" required class="form-input" />
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 16px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-edit-pet">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-save-edit-pet">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Crear Subcarpeta y Asignar Dependencias desde Expediente -->
  <div class="modal-backdrop" id="modal-crear-subcarpeta" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 660px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden; max-height: 90vh; display: flex; flex-direction: column;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Nueva Subcarpeta de Expediente</span>
        </h3>
        <button type="button" id="btn-close-subcarpeta-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>

      <form id="form-crear-subcarpeta" style="padding: 24px; display: flex; flex-direction: column; gap: 16px; overflow-y: auto;">
        <input type="hidden" id="subcarpeta-target-pet-id" />

        <div style="background: var(--verde-suave-bg); border: 1px solid var(--verde-borde); border-radius: 6px; padding: 10px 14px; font-size: 0.82rem; color: var(--verde-oscuro);">
          Radicado: <strong id="subcarpeta-target-radicado" style="font-family: monospace;">RAD-2026-XXXXX</strong> &bull; Creación de espacio virtual de anexos
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-main); text-transform: uppercase;">Nombre de la Subcarpeta *</label>
          <input type="text" id="subcarpeta-nombre-input" required class="form-input" placeholder="Ej. Soportes Financieros, Concepto Jurídico..." style="font-size: 0.88rem; font-weight: 700;" />
        </div>

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Instrucciones o Requerimiento de Anexos</label>
          <textarea id="subcarpeta-desc-input" rows="2" class="form-input" placeholder="Detalle qué documentos o soportes deben remitir las dependencias..." style="font-size: 0.82rem; resize: vertical;"></textarea>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--dorado-oscuro); text-transform: uppercase;">Dependencias Responsables a Asignar *</label>
            <span id="subcarpeta-modal-selected-count" style="font-size: 0.70rem; font-weight: 700; color: var(--verde-principal); background: var(--verde-suave-bg); padding: 2px 8px; border-radius: 4px;">0 seleccionadas</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 8px; max-height: 220px; overflow-y: auto; padding: 6px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #FAF9F5;" id="subcarpeta-modal-oficinas-list">
            <!-- Oficinas generadas vía JS -->
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--border-subtle); padding-top: 16px;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-crear-subcarpeta">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-crear-subcarpeta" style="font-weight: 800;">
            Crear Subcarpeta y Notificar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Enviar Respuesta Oficial al Solicitante (UI/UX Pro Max Sobrio) -->
  <div class="modal-backdrop" id="modal-responder-solicitante" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 2100; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card responder-modal-card">
      
      <!-- Encabezado Institucional del Modal (Bento Pro Max Limpio en Blanco) -->
      <div class="responder-modal-header">
        <div class="header-brand-block">
          <div class="header-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </div>
          <div>
            <span class="header-portal-tag">SGD Unitrópico &bull; Cierre del Ciclo Documental</span>
            <h3 class="header-main-title">Despacho de Respuesta Oficial al Solicitante</h3>
          </div>
        </div>
        <button type="button" id="btn-close-responder-modal" class="btn-close-responder-clean" title="Cerrar ventana">&times;</button>
      </div>

      <form id="form-responder-solicitante" class="responder-modal-body">
        <input type="hidden" id="responder-pet-id" />

        <!-- SECCIÓN 1: DATOS DEL SOLICITANTE Y VIGENCIA TEMPORAL -->
        <div class="responder-section-block">
          <div class="responder-section-heading">
            <span class="heading-accent-bar"></span>
            <h4>Datos del Solicitante y Vigencia Temporal</h4>
          </div>
          
          <div class="responder-meta-grid">
            <!-- Radicado & Asunto -->
            <div class="responder-meta-card">
              <span class="meta-label">Radicado y Asunto:</span>
              <div id="responder-disp-radicado" class="meta-radicado-val">RAD-2026-XXXXX</div>
              <div id="responder-disp-asunto" class="meta-asunto-val">Asunto</div>
            </div>

            <!-- Solicitante & Correo editable -->
            <div class="responder-meta-card">
              <span class="meta-label">Solicitante:</span>
              <div id="responder-disp-solicitante" class="meta-solicitante-val">Nombre del Solicitante</div>
              <div style="margin-top: 6px;">
                <label for="responder-solicitante-email" class="meta-sublabel">Correo de Notificación (Editable si requiere corrección):</label>
                <input type="email" id="responder-solicitante-email" required class="responder-email-input" />
              </div>
            </div>
          </div>

          <!-- Banner de Vigencia Estricta 10 Días -->
          <div class="responder-vigencia-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <div>
              <strong>Candado de Vigencia Temporal (10 Días Calendario):</strong>
              <span> El enlace de acceso y los archivos estarán habilitados para consulta y descarga pública hasta el <strong id="responder-disp-fecha-expira">--</strong>. Tras este plazo caducará automáticamente.</span>
            </div>
          </div>
        </div>

        <!-- SECCIÓN 2: SELECCIÓN DE SOPORTES Y ANEXOS A HABILITAR -->
        <div class="responder-section-block">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div class="responder-section-heading">
              <span class="heading-accent-bar"></span>
              <h4>Selección de Soportes y Anexos a Habilitar</h4>
            </div>
            <button type="button" id="btn-toggle-all-responder-files" class="btn-toggle-files-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              <span>Marcar / Desmarcar todos</span>
            </button>
          </div>

          <p class="responder-hint-text">
            Revise los soportes consolidados del expediente. Los archivos marcados con casilla de verificación serán los únicos disponibles para descarga en el portal del solicitante.
          </p>

          <div id="responder-archivos-container" class="responder-files-container" style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 4px 2px;">
            <!-- Inyectado dinámicamente -->
          </div>
        </div>

        <!-- SECCIÓN 3: REDACCIÓN DEL PRONUNCIAMIENTO OFICIAL (100% ANCHO, BENTO PRO MAX) -->
        <div class="responder-section-block">
          <div class="responder-section-heading">
            <span class="heading-accent-bar"></span>
            <h4>Redacción del Pronunciamiento Oficial</h4>
          </div>

          <div class="responder-redaccion-bento">
            <!-- Fila Funcionario / Dependencia -->
            <div class="form-field-group">
              <label for="responder-funcionario-input" class="responder-field-label">
                Funcionario / Dependencia que emite la respuesta *
              </label>
              <input 
                type="text" 
                id="responder-funcionario-input" 
                class="responder-input-text" 
                value="Oficina de Correspondencia y Gestión Documental" 
                placeholder="Ej: Oficina de Correspondencia y Gestión Documental"
                required 
              />
            </div>

            <!-- Fila Texto de la Respuesta Oficial -->
            <div class="form-field-group">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">
                <label for="responder-mensaje-input" class="responder-field-label">
                  Texto de la Respuesta Oficial *
                </label>
                <span style="font-size: 0.70rem; color: #52606D; font-weight: 500;">
                  Se incluirá en el cuerpo del correo y portal oficial
                </span>
              </div>
              <textarea 
                id="responder-mensaje-input" 
                rows="6" 
                class="responder-textarea-text" 
                placeholder="Redacte la respuesta formal y de fondo al solicitante..." 
                required
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Botones de Acción / Pie del Modal -->
        <div class="responder-modal-footer">
          <button type="button" class="btn-responder-cancel" id="btn-cancel-responder-modal">
            Cancelar
          </button>
          <button type="submit" class="btn-responder-submit" id="btn-submit-responder">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span id="btn-submit-responder-text">Confirmar y Enviar Respuesta Oficial</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- BANNER FLOTANTE / TOAST PRO MAX DE ÉXITO GOOGLE DRIVE -->
  <div 
    id="drive-success-toast" 
    style="display: none; position: fixed; bottom: 24px; right: 24px; z-index: 2500; max-width: 440px; width: calc(100% - 48px); background: #FFFFFF; border: 1.5px solid #00594E; border-top: 5px solid #00594E; border-radius: 14px; box-shadow: 0 10px 30px rgba(0, 89, 78, 0.18); padding: 18px 20px;"
  >
    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 8px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 8px; background: #E6EFEF; color: #00594E; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid #B2CFCB;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="9 11 12 14 22 4"/></svg>
        </div>
        <div>
          <h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #0f172a;">Expediente Respaldado en Drive</h4>
          <span style="font-size: 0.74rem; color: #786832; font-weight: 700;">Árbol de carpetas generado sin comprimir</span>
        </div>
      </div>
      <button type="button" id="btn-close-drive-toast" style="background: transparent; border: none; font-size: 1.3rem; line-height: 1; color: #64748B; cursor: pointer; padding: 2px 6px;">&times;</button>
    </div>
    <p id="drive-toast-message" style="margin: 0 0 14px 0; font-size: 0.82rem; color: #334155; line-height: 1.45;">
      Se ha creado la estructura completa con el documento radicado y los anexos organizados por subcarpeta.
    </p>
    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <a 
        id="btn-drive-open-link" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer" 
        style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #00594E; color: #FFFFFF; font-weight: 800; font-size: 0.80rem; border-radius: 8px; text-decoration: none; transition: background 0.2s; box-shadow: 0 2px 6px rgba(0, 89, 78, 0.2);"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>Abrir Carpeta en Google Drive</span>
      </a>
      <button 
        type="button" 
        id="btn-drive-copy-link" 
        style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; font-weight: 700; font-size: 0.80rem; border-radius: 8px; cursor: pointer; transition: all 0.2s;"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span id="btn-drive-copy-text">Copiar Enlace</span>
      </button>
    </div>
  </div>

  <script id="data-archivos-oficinas" type="application/json" set:html={JSON.stringify(oficinasCatalogo)} />

  

  <!-- Datos Seguros de Peticiones Incrustados en el DOM (Dual: Base64 blindado + JSON Script) -->
  <div id="peticiones-b64-payload" data-payload={peticionesBase64} style="display: none;" aria-hidden="true"></div>
  <script id="peticiones-data" type="application/json" is:inline set:html={peticionesJson}></script>

  <!-- Lógica Interactiva del Explorador de Carpetas -->
  <script>
  import { initArchivos } from '@scripts/archivos';
  initArchivos();
</script>
</AppLayout>
