---
// src/pages/archivos.astro
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout title="Módulo de Archivos y Gestión Documental" activeNav="archivos">
  <div class="section-toolbar">
    <div class="filter-tabs">
      <button class="filter-tab active" data-filter="all">
        <span>Todos</span>
        <span class="filter-count" id="count-all">7</span>
      </button>
      <button class="filter-tab" data-filter="pending">
        <span class="dist-dot" style="background: #F59E0B;"></span>
        <span>Pendientes Resp.</span>
        <span class="filter-count" id="count-pending">6</span>
      </button>
      <button class="filter-tab" data-filter="responded">
        <span class="dist-dot" style="background: #10B981;"></span>
        <span>Respondidas</span>
        <span class="filter-count" id="count-responded">1</span>
      </button>
      <button class="filter-tab" data-filter="safe">
        <span class="dist-dot" style="background: #10B981;"></span>
        <span>En Plazo</span>
        <span class="filter-count" id="count-safe">3</span>
      </button>
      <button class="filter-tab" data-filter="warn">
        <span class="dist-dot" style="background: #F59E0B;"></span>
        <span>Por Vencer</span>
        <span class="filter-count" id="count-warn">2</span>
      </button>
      <button class="filter-tab" data-filter="critical">
        <span class="dist-dot" style="background: #EF4444;"></span>
        <span>Críticos (&gt;80%)</span>
        <span class="filter-count" id="count-critical">2</span>
      </button>
    </div>

    <div>
      <button class="btn btn-primary" id="btn-open-upload-modal-view">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span>Subir Nuevo Archivo</span>
      </button>
    </div>
  </div>

  <div class="table-responsive">
    <table class="doc-table">
      <thead>
        <tr>
          <th>Archivo / Petición</th>
          <th>Radicado</th>
          <th>Fechas (Radicado - Plazo)</th>
          <th>Plazo de Vencimiento (Progreso)</th>
          <th>Responsable Asignado</th>
          <th>Estado Trámite / Respuesta</th>
          <th style="text-align: right;">Acciones</th>
        </tr>
      </thead>
      <tbody id="documents-table-body">
        <!-- Dinámico desde JS -->
      </tbody>
    </table>
  </div>

  <!-- Modal: Asignar Responsable -->
  <div class="modal-backdrop" id="reassign-modal" style="display: none;">
    <div class="modal-card" style="max-width: 520px;">
      <div class="modal-header">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          <span>Asignar Responsable</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-reassign-modal">&times;</button>
      </div>

      <div class="modal-body">
        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px;">
          Documento: <strong id="reassign-doc-name" style="color: var(--text-main);">...</strong>
        </div>

        <div class="search-box" style="width: 100%; margin-bottom: 12px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" id="user-search-input" placeholder="Buscar funcionario por nombre o cargo...">
        </div>

        <div class="user-picker-list" id="user-picker-container" style="max-height: 280px; overflow-y: auto;">
          <!-- Opciones dinámicas -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="btn-cancel-reassign">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btn-save-reassignment">Confirmar Asignación</button>
      </div>
    </div>
  </div>

  <!-- Modal: Previsualización con Pestañas (Petición vs Respuesta) -->
  <div class="modal-backdrop" id="preview-modal" style="display: none;">
    <div class="modal-card" style="max-width: 780px;">
      <div class="modal-header">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span id="preview-modal-main-title">Ficha del Expediente y Trámite</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-preview-modal">&times;</button>
      </div>

      <!-- Barra de pestañas en modal de previa -->
      <div class="modal-tab-nav">
        <button type="button" class="modal-tab-btn active" id="tab-btn-preview-doc">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>1. Petición / Archivo Original</span>
        </button>
        <button type="button" class="modal-tab-btn" id="tab-btn-preview-response">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><polyline points="9 10 12 7 15 10"/><line x1="12" y1="7" x2="12" y2="13"/></svg>
          <span>2. Oficio de Respuesta</span>
          <span class="tab-badge badge-warn" id="preview-response-tab-badge">Pendiente</span>
        </button>
      </div>

      <div class="modal-body" id="preview-modal-content">
        <!-- Contenido dinámico desde JS -->
      </div>

      <div class="modal-footer" style="justify-content: space-between;">
        <button type="button" class="btn btn-ghost" id="btn-close-preview-footer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Responder Petición Institucional -->
  <div class="modal-backdrop" id="response-modal" style="display: none;">
    <div class="modal-card" style="max-width: 820px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><polyline points="9 10 12 7 15 10"/><line x1="12" y1="7" x2="12" y2="13"/></svg>
          <span>Responder Petición / Solicitud Institucional</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-response-modal">&times;</button>
      </div>

      <form id="response-doc-form">
        <div class="modal-body">
          <div class="petition-summary-box" id="response-petition-summary">
            <!-- Dinámico desde JS -->
          </div>

          <div class="form-group">
            <label class="form-label">Plantillas de Respuesta Automáticas</label>
            <select class="form-select" id="select-response-template">
              <!-- Opciones dinámicas -->
            </select>
            <div class="template-quick-chips" id="template-chips-container" style="display: flex; flex-wrap: wrap;">
              <!-- Chips rápidos -->
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Radicado de Respuesta / Salida *</label>
              <input type="text" class="form-input" id="input-response-radicado" readonly style="background: var(--bg-surface-elevated); font-weight: 700; color: var(--primary);">
            </div>
            <div class="form-group">
              <label class="form-label">Sentido de la Decisión / Trámite *</label>
              <select class="form-select" id="select-response-decision" required>
                <option value="Favorable / Solicitud Aprobada">Favorable / Solicitud Aprobada</option>
                <option value="Informativo / En Trámite">Informativo / En Trámite</option>
                <option value="Requerimiento de Información">Requerimiento de Información</option>
                <option value="No Procedente / Desfavorable">No Procedente / Desfavorable</option>
                <option value="Traslado por Competencia">Traslado por Competencia</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Asunto Oficial de la Comunicación *</label>
            <input type="text" class="form-input" id="input-response-subject" placeholder="Ej: Respuesta formal a solicitud..." required>
          </div>

          <div class="form-group">
            <label class="form-label">Cuerpo del Oficio Institucional *</label>
            <textarea class="form-textarea" id="input-response-body" rows="7" required></textarea>
          </div>
        </div>

        <div class="modal-footer" style="justify-content: space-between;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-response">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btn-submit-response">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Guardar y Vincular Respuesta</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import { initArchivos } from '@scripts/archivos';
  initArchivos();
</script>

