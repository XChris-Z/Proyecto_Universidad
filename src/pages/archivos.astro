                                const obsSinRevision = sanitizeRevisionTokens(rawObs).replace(/\[RECHAZADO[^\]]*\]:?[^|]*/gi, '').trim();
                                const cleanObs = extractSubObs(obsSinRevision, sub.nombre);
                                const subReqText = (sub.descripcion || '').trim().toLowerCase();
