                                                  data-ofi-nombre="${escapeHtml(ofiNombre)}"
                                                  title="Aprobar soporte documental"
                                                  style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; font-size: 0.72rem; font-weight: 750; border-radius: 6px; background: #E6EFEF; color: #00594E; border: 1px solid #00594E; cursor: pointer; transition: all 0.2s ease;"
                                                >
                                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
                                                  <span>Aprobar</span>
                                                </button>
                                              ` : ''}
                                              <button
                                                type="button"
                                                class="btn-rechazar-aporte"
                                                data-anexo-id="${escapeHtml(String(oa.id))}"
                                                data-peticion-id="${escapeHtml(String(peticion.id))}"
                                                data-responsable-id="${escapeHtml(String(r.id))}"
                                                data-sub-nombre="${escapeHtml(sub.nombre)}"
                                                data-file-name="${escapeHtml(cleanOaName)}"
                                                data-ofi-nombre="${escapeHtml(ofiNombre)}"
                                                title="Rechazar / devolver soporte y notificar a la dependencia"
                                                style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; font-size: 0.72rem; font-weight: 750; border-radius: 6px; background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; cursor: pointer; transition: all 0.2s ease;"
                                              >
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                <span>Rechazar</span>
                                              </button>
                                              <a 
                                                href="${getPublicStorageUrl(oa.storage_path)}" 
                                                download="${escapeHtml(oa.nombre_archivo)}" 
                                                onclick="event.stopPropagation()" 
                                                class="btn-download-discreet" 
                                                style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; font-size: 0.74rem; font-weight: 600; border-radius: 6px; background: #f8fafc; color: #334155; border: 1px solid #cbd5e1; text-decoration: none; transition: all 0.2s ease;"
                                                onmouseover="this.style.borderColor='#00594E'; this.style.color='#00594E'; this.style.background='#ffffff';"
                                                onmouseout="this.style.borderColor='#cbd5e1'; this.style.color='#334155'; this.style.background='#f8fafc';"
                                                title="Descargar archivo"
                                              >
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                <span>Descargar</span>
