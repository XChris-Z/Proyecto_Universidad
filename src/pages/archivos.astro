    function updateAnexosCountPill() {
      const listContainer = document.getElementById('composer-anexos-list');
      const countPill = document.getElementById('composer-anexos-count-pill');
      if (!listContainer || !countPill) return;
      const checkedCount = listContainer.querySelectorAll('input[name="anexos_opcionales"]:checked').length;
      countPill.textContent = `${checkedCount} seleccionado${checkedCount === 1 ? '' : 's'}`;
