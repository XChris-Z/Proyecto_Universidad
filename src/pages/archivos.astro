                      style="height: 32px; padding: 0 14px; background: #00594E; color: #FFFFFF; border-radius: 7px; font-size: 0.78rem; font-weight: 600; border: 1px solid #00594E; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 3px rgba(0, 89, 78, 0.12); transition: all 0.2s ease;"
                    >
