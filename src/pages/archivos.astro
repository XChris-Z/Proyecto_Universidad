      }

      // C. Botón Marcar Expediente como Completo (Cierre Interno sin correo externo)
      const completarBtn = target.closest('.btn-completar-expediente') as HTMLButtonElement | null;
      if (completarBtn) {
        e.preventDefault();
        e.stopPropagation();
        const petId = completarBtn.getAttribute('data-id') || '';
        const radicado = completarBtn.getAttribute('data-radicado') || '';
        if (petId) {
          handleCompletarExpediente(petId, radicado, completarBtn);
        }
        return;
      }

      // C2. Botón + Prórroga
      const prorrogaBtn = target.closest('.btn-open-prorroga-modal') as HTMLElement | null;
      if (prorrogaBtn) {
        e.preventDefault();
        e.stopPropagation();
        const petId = prorrogaBtn.getAttribute('data-id') || '';
        if (petId) openProrrogaModal(petId);
        return;
      }

      // C3. Botón Aprobar Aporte Documental
      const aprobarBtn = target.closest('.btn-aprobar-aporte') as HTMLButtonElement | null;
      if (aprobarBtn) {
        e.preventDefault();
        e.stopPropagation();
        handleAprobarAporte(aprobarBtn);
        return;
      }

      // C4. Botón Rechazar / Devolver Aporte Documental
      const rechazarBtn = target.closest('.btn-rechazar-aporte') as HTMLButtonElement | null;
      if (rechazarBtn) {
        e.preventDefault();
        e.stopPropagation();
        openRechazarModal(rechazarBtn);
        return;
      }

      // D. Botón Respaldar Expediente en Google Drive
      const driveBtn = target.closest('.btn-export-drive') as HTMLElement | null;
      if (driveBtn) {
        e.preventDefault();
        e.stopPropagation();
        const petId = driveBtn.getAttribute('data-id') || '';
        const radicado = driveBtn.getAttribute('data-radicado') || 'RAD';
        if (petId) {
          handleExportToGoogleDrive(petId, radicado, driveBtn);
        }
        return;
      }

      // B. Botón Eliminar Carpeta
      const deleteBtn = target.closest('.btn-delete-pet') as HTMLElement | null;
      if (deleteBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = deleteBtn.getAttribute('data-id');
        const radicado = deleteBtn.getAttribute('data-radicado');
        if (!id) return;

        const confirmed = typeof (window as any).showConfirm === 'function'
          ? await (window as any).showConfirm(
              `¿Está seguro de que desea eliminar definitivamente la carpeta del radicado ${radicado}?\n\nEsta acción purgará los archivos almacenados en Storage y registrará el evento en la Auditoría institucional.`,
              'Confirmar Eliminación'
            )
          : true;
        if (!confirmed) return;

        deleteBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch('/api/peticiones/eliminar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            (window as any).showToast('Error al eliminar: ' + (data.error || 'No se pudo eliminar'), 'error');
            deleteBtn.removeAttribute('disabled');
            return;
          }

          const card = document.getElementById(`card-folder-${id}`);
          if (card) card.remove();
          const row = document.getElementById(`row-folder-${id}`);
          if (row) row.remove();

          if (currentActiveFolderId === id) {
            closeFolderDetail();
          }

          (window as any).showToast(`Carpeta y radicado ${radicado} eliminados exitosamente.`, 'success');
        } catch (err) {
          (window as any).showToast('Error de conexión al eliminar.', 'error');
          deleteBtn.removeAttribute('disabled');
        }
        return;
      }

      // C. Botón "Abrir Carpeta" (.btn-open-folder o .btn-abrir-carpeta)
      const openBtn = target.closest('.btn-open-folder, .btn-abrir-carpeta') as HTMLElement | null;
      if (openBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = openBtn.getAttribute('data-radicado') || openBtn.getAttribute('data-folder-id') || openBtn.getAttribute('data-id');
        if (id) openFolderDetail(id);
        return;
      }

      // D. Clic en la tarjeta de carpeta (sin tocar botones secundarios)
      const folderCard = target.closest('.drive-folder-card') as HTMLElement | null;
      if (folderCard && !target.closest('.btn-edit-pet, .btn-delete-pet, a, button')) {
        const id = folderCard.getAttribute('data-radicado') || folderCard.getAttribute('data-folder-id') || folderCard.getAttribute('data-id');
        if (id) openFolderDetail(id);
        return;
      }

      // E. Clic en la fila de tabla (sin tocar la columna de acciones)
      const tableRow = target.closest('.doc-row') as HTMLElement | null;
      if (tableRow && !target.closest('td:last-child, a, button')) {
        const id = tableRow.getAttribute('data-radicado') || tableRow.getAttribute('data-folder-id') || tableRow.getAttribute('data-id');
        if (id) openFolderDetail(id);
        return;
      }

      // F. Botón Copiar PIN
      const copyPinBtn = target.closest('.btn-copy-pin') as HTMLElement | null;
      if (copyPinBtn) {
        e.preventDefault();
        e.stopPropagation();
        const pin = copyPinBtn.getAttribute('data-pin') || '849201';
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(pin);
          }
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast(`PIN de acceso ${pin} copiado al portapapeles.`, 'info');
          } else {
            alert(`PIN copiado: ${pin}`);
          }
        } catch {
          alert(`PIN copiado: ${pin}`);
        }
        return;
      }
    });

    // 5. Filtrado por Pestañas con Transición Crossfade Pro Max
    const filterTabs = document.querySelectorAll('#archivos-filter-tabs .filter-tab');
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const filter = tab.getAttribute('data-filter') || 'all';
        applyFilters(filter, (searchInput ? searchInput.value : '').toLowerCase().trim(), true);
      });
    });

    // 6. Buscador interactivo en vivo con Crossfade fluido
    searchInput?.addEventListener('input', () => {
      const activeTab = document.querySelector('#archivos-filter-tabs .filter-tab.active');
      const filter = activeTab ? activeTab.getAttribute('data-filter') || 'all' : 'all';
      applyFilters(filter, searchInput.value.toLowerCase().trim(), false);
    });

    function applyFilters(filterStatus: string, searchText: string, useViewTransition = false) {
      const cards = document.querySelectorAll('.drive-folder-card');
      const rows = document.querySelectorAll('.doc-row');
      const emptySearchBanner = document.getElementById('drive-search-empty-state') as HTMLElement | null;

      const updateDomVisibility = () => {
        let visibleCards = 0;

        cards.forEach((el) => {
          const card = el as HTMLElement;
          const status = card.getAttribute('data-status');
          const sla = card.getAttribute('data-sla');
          const radicado = (card.getAttribute('data-radicado') || '').toLowerCase();
          const asunto = (card.getAttribute('data-asunto') || '').toLowerCase();
          const solicitante = (card.getAttribute('data-solicitante') || '').toLowerCase();

          let matchesStatus = true;
          if (filterStatus === 'pending') matchesStatus = status === 'pending';
          else if (filterStatus === 'responded') matchesStatus = status === 'responded';
          else if (filterStatus === 'safe' || filterStatus === 'warn' || filterStatus === 'critical') matchesStatus = status !== 'responded' && sla === filterStatus;

          let matchesSearch = true;
          if (searchText) {
            matchesSearch = radicado.includes(searchText) || asunto.includes(searchText) || solicitante.includes(searchText);
          }

          const show = matchesStatus && matchesSearch;
          card.style.display = show ? 'flex' : 'none';
          if (show) visibleCards++;
        });

        rows.forEach((el) => {
          const row = el as HTMLElement;
          const status = row.getAttribute('data-status');
          const sla = row.getAttribute('data-sla');
          const radicado = (row.getAttribute('data-radicado') || '').toLowerCase();
          const asunto = (row.getAttribute('data-asunto') || '').toLowerCase();
          const solicitante = (row.getAttribute('data-solicitante') || '').toLowerCase();

          let matchesStatus = true;
          if (filterStatus === 'pending') matchesStatus = status === 'pending';
          else if (filterStatus === 'responded') matchesStatus = status === 'responded';
          else if (filterStatus === 'safe' || filterStatus === 'warn' || filterStatus === 'critical') matchesStatus = status !== 'responded' && sla === filterStatus;

          let matchesSearch = true;
          if (searchText) {
            matchesSearch = radicado.includes(searchText) || asunto.includes(searchText) || solicitante.includes(searchText);
          }

          row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
        });

        if (emptySearchBanner) {
          emptySearchBanner.style.display = cards.length > 0 && visibleCards === 0 ? 'block' : 'none';
        }
      };

      if (useViewTransition && typeof document !== 'undefined' && 'startViewTransition' in document) {
        try {
          (document as any).startViewTransition(() => {
            updateDomVisibility();
          });
          return;
        } catch {}
      }

      if (gridContainer) {
        gridContainer.classList.add('grid-crossfade-leave');
        requestAnimationFrame(() => {
          updateDomVisibility();
          gridContainer.classList.remove('grid-crossfade-leave');
          gridContainer.classList.remove('grid-crossfade-enter');
          void gridContainer.offsetWidth;
          gridContainer.classList.add('grid-crossfade-enter');
        });
      } else {
        updateDomVisibility();
      }
    }

    // 7. Modal Editar Petición
    const closeEdit = () => { if (editModal) editModal.style.display = 'none'; };
    document.getElementById('btn-close-edit-modal')?.addEventListener('click', closeEdit);
    document.getElementById('btn-cancel-edit-pet')?.addEventListener('click', closeEdit);

    formEdit?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-edit-pet') as HTMLButtonElement | null;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Actualizando...';
      }

      try {
        const payload = {
          id: inputId ? inputId.value : '',
          asunto: inputAsunto ? inputAsunto.value.trim() : '',
          solicitante_nombre: inputSolicitante ? inputSolicitante.value.trim() : '',
          solicitante_tipo: selectTipo ? selectTipo.value : 'Ciudadano',
          prioridad: selectPrioridad ? selectPrioridad.value : 'Media',
          estado: selectEstado ? selectEstado.value : 'en_tramite',
          fecha_limite_entrega: inputEntrega ? inputEntrega.value : '',
        };

        const res = await fetch('/api/peticiones/editar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          (window as any).showToast('Error al actualizar: ' + (data.error || 'No se pudo actualizar'), 'error');
          return;
        }

        (window as any).showToast('Expediente actualizado con éxito.', 'success');
        setTimeout(() => window.location.reload(), 600);
      } catch (err) {
        (window as any).showToast('Error de conexión al actualizar.', 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Guardar Cambios';
        }
      }
    });

    // 7.1 Modal Crear Subcarpeta y Asignar Dependencias
    const subcarpetaModal = document.getElementById('modal-crear-subcarpeta');
    const formCrearSubcarpeta = document.getElementById('form-crear-subcarpeta');
    const closeSubModal = () => { if (subcarpetaModal) subcarpetaModal.style.display = 'none'; };
    document.getElementById('btn-close-subcarpeta-modal')?.addEventListener('click', closeSubModal);
    document.getElementById('btn-cancel-crear-subcarpeta')?.addEventListener('click', closeSubModal);

    let archivosOficinasCatalog: any[] = [];
    try {
      const ofiEl = document.getElementById('data-archivos-oficinas');
      if (ofiEl && ofiEl.textContent) {
        archivosOficinasCatalog = JSON.parse(ofiEl.textContent);
      }
    } catch {}

    function openModalCrearSubcarpeta(petId: string, radicado: string) {
      const petIdInput = document.getElementById('subcarpeta-target-pet-id') as HTMLInputElement | null;
      const radicadoLabel = document.getElementById('subcarpeta-target-radicado');
      const nombreInput = document.getElementById('subcarpeta-nombre-input') as HTMLInputElement | null;
      const descInput = document.getElementById('subcarpeta-desc-input') as HTMLTextAreaElement | null;
      const ofisContainer = document.getElementById('subcarpeta-modal-oficinas-list');
      const countLabel = document.getElementById('subcarpeta-modal-selected-count');

      if (petIdInput) petIdInput.value = petId;
      if (radicadoLabel) radicadoLabel.textContent = radicado;
      if (nombreInput) nombreInput.value = '';
      if (descInput) descInput.value = '';
      if (countLabel) countLabel.textContent = '0 seleccionadas';

      if (ofisContainer) {
        ofisContainer.innerHTML = archivosOficinasCatalog.map((ofi: any) => {
          const isTest = (ofi.codigo || '').toUpperCase().includes('PRUEBA') || (ofi.nombre || '').toLowerCase().includes('prueba');
          return `
            <label style="display: flex; align-items: flex-start; gap: 8px; padding: 6px 8px; background: #ffffff; border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer; font-size: 0.78rem;">
              <input type="checkbox" name="subcarpeta_modal_ofi" value="${ofi.id}" style="accent-color: var(--verde-principal); margin-top: 2px;" />
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 700; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  ${ofi.nombre}
                </div>
                ${isTest ? `<span style="font-size: 0.60rem; color: #b45309; font-weight: 800;">PRUEBA</span>` : ''}
              </div>
            </label>
          `;
        }).join('');

        const cbs = ofisContainer.querySelectorAll('input[name="subcarpeta_modal_ofi"]');
        cbs.forEach((cb) => {
          cb.addEventListener('change', () => {
            const checkedCount = ofisContainer.querySelectorAll('input[name="subcarpeta_modal_ofi"]:checked').length;
            if (countLabel) countLabel.textContent = `${checkedCount} seleccionada${checkedCount === 1 ? '' : 's'}`;
          });
        });
      }

      if (subcarpetaModal) subcarpetaModal.style.display = 'flex';
    }

    let isSubmittingSubfolder = false;

    formCrearSubcarpeta?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (isSubmittingSubfolder) return;

      const petIdInput = document.getElementById('subcarpeta-target-pet-id') as HTMLInputElement | null;
      const nombreInput = document.getElementById('subcarpeta-nombre-input') as HTMLInputElement | null;
      const descInput = document.getElementById('subcarpeta-desc-input') as HTMLTextAreaElement | null;
      const submitBtn = document.getElementById('btn-submit-crear-subcarpeta') as HTMLButtonElement | null;

      const petId = petIdInput?.value || '';
      const nombre = nombreInput?.value.trim() || '';
      const descripcion = descInput?.value.trim() || '';

      const checkedOffices: string[] = [];
      document.querySelectorAll('input[name="subcarpeta_modal_ofi"]:checked').forEach((el) => {
        checkedOffices.push((el as HTMLInputElement).value);
      });

      if (!nombre) {
        alert('Por favor ingrese el nombre de la subcarpeta.');
        return;
      }
      if (checkedOffices.length === 0) {
        alert('Por favor seleccione al menos una dependencia responsable.');
        return;
      }

      isSubmittingSubfolder = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando y notificando...';
      }

      try {
        const res = await fetch('/api/peticiones/subcarpetas/crear', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            peticion_id: petId,
            nombre,
            descripcion,
            oficina_ids: checkedOffices,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Error: ' + (data.error || 'No se pudo crear la subcarpeta'), 'error');
          }
          return;
        }

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Subcarpeta creada exitosamente y dependencias notificadas vía correo.', 'success');
        }
        closeSubModal();

        // Actualizar peticion en el array local y re-renderizar sin recarga forzada
        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          if (!pet.subcarpetas) pet.subcarpetas = [];
          if (!pet.subcarpetas.some((s: any) => s.id === data.subcarpeta.id || s.nombre?.toLowerCase() === data.subcarpeta.nombre?.toLowerCase())) {
            pet.subcarpetas.push(data.subcarpeta);
          }
          if (data.subcarpeta?.nombre) {
            const newDesc = data.subcarpeta.descripcion || '';
            const entry = `[${data.subcarpeta.nombre}]: ${newDesc}`;
            pet.instrucciones_anexos = pet.instrucciones_anexos ? `${pet.instrucciones_anexos}\n${entry}` : entry;
          }
          if (Array.isArray(data.responsables)) {
            if (!pet.peticion_responsables) pet.peticion_responsables = [];
            data.responsables.forEach((r: any) => {
              const existingIdx = pet.peticion_responsables!.findIndex((er: any) => er.id === r.id || er.oficina_id === r.oficina_id);
              const matchedOfi = archivosOficinasCatalog.find((o: any) => o.id === r.oficina_id);
              if (existingIdx >= 0) {
                const existing = pet.peticion_responsables![existingIdx];
                if (existing) {
                  if (r.observaciones_entrega) {
                    existing.observaciones_entrega = r.observaciones_entrega;
                  }
                  if (r.subcarpeta_id) {
                    existing.subcarpeta_id = r.subcarpeta_id;
                  }
                }
              } else {
                pet.peticion_responsables!.push({
                  id: r.id,
                  codigo_acceso: r.codigo_acceso,
                  subcarpeta_id: data.subcarpeta.id,
                  estado_entrega: 'Pendiente',
                  observaciones_entrega: r.observaciones_entrega,
                  oficinas: matchedOfi,
                });
              }
            });
          }
          indexPeticion(pet);
          openFolderDetail(petId);
        } else {
          setTimeout(() => window.location.reload(), 600);
        }
      } catch (err: any) {
        console.error('Error al crear subcarpeta:', err);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error de red al crear la subcarpeta.', 'error');
        }
      } finally {
        isSubmittingSubfolder = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Crear Subcarpeta y Notificar';
        }
      }
    });

    // 7.2 Gestión de Cierre Interno, Revisión de Aportes (Aprobar / Rechazar), Prórrogas y Respuesta Final Oficial
    const inputSubirRespuestaFinal = document.getElementById('input-subir-respuesta-final') as HTMLInputElement | null;
    let currentUploadPetId = '';

    // 7.2.1 Modal Rechazar Aporte Documental
    const rechazarModal = document.getElementById('modal-rechazar-aporte');
    const formRechazar = document.getElementById('form-rechazar-aporte');
    const rechazarAnexoId = document.getElementById('rechazar-anexo-id') as HTMLInputElement | null;
    const rechazarPetId = document.getElementById('rechazar-peticion-id') as HTMLInputElement | null;
    const rechazarRespId = document.getElementById('rechazar-responsable-id') as HTMLInputElement | null;
    const rechazarSubNombre = document.getElementById('rechazar-subcarpeta-nombre') as HTMLInputElement | null;
    const rechazarMotivoInput = document.getElementById('rechazar-motivo-input') as HTMLTextAreaElement | null;
    const closeRechazar = () => { if (rechazarModal) rechazarModal.style.display = 'none'; };
    document.getElementById('btn-close-rechazar-modal')?.addEventListener('click', closeRechazar);
    document.getElementById('btn-cancel-rechazar-modal')?.addEventListener('click', closeRechazar);

    function openRechazarModal(btn: HTMLElement) {
      const anexoId = btn.getAttribute('data-anexo-id') || '';
      const petId = btn.getAttribute('data-peticion-id') || '';
      const respId = btn.getAttribute('data-responsable-id') || '';
      const subNombre = btn.getAttribute('data-sub-nombre') || 'Soportes Documentales';
      const fileName = btn.getAttribute('data-file-name') || 'Documento';
      const ofiNombre = btn.getAttribute('data-ofi-nombre') || 'Dependencia Responsable';

      if (rechazarAnexoId) rechazarAnexoId.value = anexoId;
      if (rechazarPetId) rechazarPetId.value = petId;
      if (rechazarRespId) rechazarRespId.value = respId;
      if (rechazarSubNombre) rechazarSubNombre.value = subNombre;

      const dispOfi = document.getElementById('rechazar-disp-oficina');
      const dispSub = document.getElementById('rechazar-disp-subcarpeta');
      const dispArc = document.getElementById('rechazar-disp-archivo');
      if (dispOfi) dispOfi.textContent = ofiNombre;
      if (dispSub) dispSub.textContent = subNombre;
      if (dispArc) dispArc.textContent = fileName;

      if (rechazarMotivoInput) {
        rechazarMotivoInput.value = `El soporte "${fileName}" remitido para la subcarpeta ${subNombre} no cumple con los requisitos solicitados. Por favor revisar y cargar nuevamente el documento corregido en el portal.`;
      }
      if (rechazarModal) rechazarModal.style.display = 'flex';
    }

    async function handleAprobarAporte(btn: HTMLButtonElement) {
      const anexoId = btn.getAttribute('data-anexo-id') || '';
      const petId = btn.getAttribute('data-peticion-id') || '';
      const respId = btn.getAttribute('data-responsable-id') || '';
      const subNombre = btn.getAttribute('data-sub-nombre') || '';
      if (!anexoId || !petId) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/peticiones/anexos/revisar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            accion: 'aprobar',
            anexo_id: anexoId,
            peticion_id: petId,
            responsable_id: respId,
            subcarpeta_nombre: subNombre,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo aprobar el aporte.');
        }

        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          if (data.driveUrl) {
            pet.respuesta_drive_url = data.driveUrl;
          }
          if (Array.isArray(pet.peticion_responsables)) {
            const respObj = pet.peticion_responsables.find((r) => String(r.id) === String(data.responsable_id || respId));
            if (respObj) {
              respObj.estado_entrega = 'Entregado';
              respObj.observaciones_entrega = addApprovedAnexoMarker(respObj.observaciones_entrega, anexoId, subNombre);
            }
          }
          indexPeticion(pet);
          if (currentActiveFolderId === petId) openFolderDetail(petId);
        }

        if (typeof (window as any).showToast === 'function') {
          const okMsg = data.driveSynced
            ? '✓ Aporte aprobado y sincronizado automáticamente en Google Drive'
            : '✓ Aporte documental aprobado correctamente.';
          (window as any).showToast(okMsg, 'success');
        }
      } catch (err: any) {
        btn.disabled = false;
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(err?.message || 'Error al aprobar aporte.', 'error');
        }
      }
    }

    let isSubmittingRechazo = false;
    formRechazar?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (isSubmittingRechazo) return;
      const anexoId = rechazarAnexoId?.value || '';
      const petId = rechazarPetId?.value || '';
      const respId = rechazarRespId?.value || '';
      const subNombre = rechazarSubNombre?.value || '';
      const motivo = rechazarMotivoInput?.value.trim() || '';
      if (!anexoId || !petId || !motivo) return;

      const submitBtn = document.getElementById('btn-submit-rechazar-modal') as HTMLButtonElement | null;
      const submitTxt = document.getElementById('btn-submit-rechazar-text');
      isSubmittingRechazo = true;
      if (submitBtn) submitBtn.disabled = true;
      if (submitTxt) submitTxt.textContent = 'Devolviendo y notificando...';

      try {
        const res = await fetch('/api/peticiones/anexos/revisar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            accion: 'rechazar',
            anexo_id: anexoId,
            peticion_id: petId,
            responsable_id: respId,
            subcarpeta_nombre: subNombre,
            motivo,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo rechazar el aporte.');
        }

        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          if (Array.isArray(pet.peticion_anexos)) {
            pet.peticion_anexos = pet.peticion_anexos.filter((a) => String(a.id) !== String(anexoId));
          }
          if (Array.isArray(pet.peticion_responsables)) {
            const respObj = pet.peticion_responsables.find((r) => String(r.id) === String(data.responsable_id || respId));
            if (respObj) {
              respObj.estado_entrega = data.estado_entrega || 'Pendiente';
              const cleanApproved = removeApprovedAnexoMarker(respObj.observaciones_entrega, anexoId);
              respObj.observaciones_entrega = setRejectedMarker(cleanApproved, subNombre, motivo);
            }
          }
          indexPeticion(pet);
          syncExplorerCountsAndCard(pet);
          if (currentActiveFolderId === petId) openFolderDetail(petId);
        }

        closeRechazar();
        if (typeof (window as any).showToast === 'function') {
          let msgMail = data.email_sent
            ? 'Aporte devuelto y dependencia notificada por correo.'
            : 'Aporte devuelto al estado Pendiente.';
          if (data.driveRemoved) {
            msgMail += ' También fue retirado de Google Drive.';
          }
          (window as any).showToast(msgMail, 'success');
        }
      } catch (err: any) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(err?.message || 'Error al rechazar aporte.', 'error');
        }
      } finally {
        isSubmittingRechazo = false;
        if (submitBtn) submitBtn.disabled = false;
        if (submitTxt) submitTxt.textContent = 'Devolver y Notificar';
      }
    });

    // 7.2.2 Modal Prórroga Auditada
    const prorrogaModal = document.getElementById('modal-prorroga');
    const formProrroga = document.getElementById('form-prorroga');
    const prorrogaPetId = document.getElementById('prorroga-peticion-id') as HTMLInputElement | null;
    const prorrogaNuevaEntrega = document.getElementById('prorroga-nueva-entrega') as HTMLInputElement | null;
    const prorrogaNuevaResp = document.getElementById('prorroga-nueva-resp') as HTMLInputElement | null;
    const prorrogaMotivo = document.getElementById('prorroga-motivo') as HTMLTextAreaElement | null;
    const closeProrroga = () => { if (prorrogaModal) prorrogaModal.style.display = 'none'; };
    document.getElementById('btn-close-prorroga-modal')?.addEventListener('click', closeProrroga);
    document.getElementById('btn-cancel-prorroga-modal')?.addEventListener('click', closeProrroga);

    function openProrrogaModal(petId: string) {
      const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
      if (!pet) return;
      if (prorrogaPetId) prorrogaPetId.value = pet.id;
      const dispRad = document.getElementById('prorroga-disp-radicado');
      const dispAct = document.getElementById('prorroga-disp-actual');
      const entYmd = pet.fecha_limite_entrega ? String(pet.fecha_limite_entrega).slice(0, 10) : '';
      const respYmd = pet.fecha_limite_responsable ? String(pet.fecha_limite_responsable).slice(0, 10) : '';
      if (dispRad) dispRad.textContent = pet.numero_radicado || pet.id;
      if (dispAct) dispAct.textContent = `Plazo actual: ${entYmd || '--'}${respYmd ? ` · Oficinas: ${respYmd}` : ''}`;
      if (prorrogaNuevaEntrega) prorrogaNuevaEntrega.value = entYmd;
      if (prorrogaNuevaResp) prorrogaNuevaResp.value = respYmd;
      if (prorrogaMotivo) prorrogaMotivo.value = '';
      if (prorrogaModal) prorrogaModal.style.display = 'flex';
    }

    let isSubmittingProrroga = false;
    formProrroga?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (isSubmittingProrroga) return;
      const petId = prorrogaPetId?.value || '';
      const nuevaEntrega = prorrogaNuevaEntrega?.value || '';
      const nuevaResp = prorrogaNuevaResp?.value || '';
      const motivo = prorrogaMotivo?.value.trim() || '';
      if (!petId || !nuevaEntrega || !motivo) return;

      const submitBtn = document.getElementById('btn-submit-prorroga') as HTMLButtonElement | null;
      const submitTxt = document.getElementById('btn-submit-prorroga-text');
      isSubmittingProrroga = true;
      if (submitBtn) submitBtn.disabled = true;
      if (submitTxt) submitTxt.textContent = 'Registrando prórroga...';

      try {
        const res = await fetch('/api/peticiones/prorroga', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            peticion_id: petId,
            nueva_fecha_entrega: nuevaEntrega,
            nueva_fecha_responsable: nuevaResp || null,
            motivo,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo registrar la prórroga.');
        }

        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          if (data.peticion?.fecha_limite_entrega) pet.fecha_limite_entrega = data.peticion.fecha_limite_entrega;
          if (data.peticion?.fecha_limite_responsable) pet.fecha_limite_responsable = data.peticion.fecha_limite_responsable;
          if (data.peticion?.instrucciones_anexos) pet.instrucciones_anexos = data.peticion.instrucciones_anexos;
          indexPeticion(pet);
          syncExplorerCountsAndCard(pet);
          if (currentActiveFolderId === petId) openFolderDetail(petId);
        }

        closeProrroga();
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Prórroga guardada y auditada correctamente.', 'success');
        }
      } catch (err: any) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(err?.message || 'Error al guardar la prórroga.', 'error');
        }
      } finally {
        isSubmittingProrroga = false;
        if (submitBtn) submitBtn.disabled = false;
        if (submitTxt) submitTxt.textContent = 'Guardar Prórroga Auditada';
      }
    });

    // 7.2.3 Marcar Expediente como Completo (Cierre Interno)
    async function handleCompletarExpediente(petId: string, radicado: string, btn: HTMLButtonElement) {
      const confirmed = typeof (window as any).showConfirm === 'function'
        ? await (window as any).showConfirm(
            `¿Desea marcar internamente el expediente ${radicado || petId} como Completo?\n\nEl expediente pasará a la pestaña Completadas / Respondidas y actualizará el Dashboard y Calendario sin enviar correos externos.`,
            'Confirmar Cierre Interno'
          )
        : true;
      if (!confirmed) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/peticiones/completar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ peticion_id: petId }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo marcar el expediente como completo.');
        }

        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          if (data.peticion?.estado) pet.estado = data.peticion.estado;
          if (data.peticion?.instrucciones_anexos) pet.instrucciones_anexos = data.peticion.instrucciones_anexos;
          if (data.driveUrl) pet.respuesta_drive_url = data.driveUrl;
          pet.respondida = true;
          indexPeticion(pet);
          syncExplorerCountsAndCard(pet);
          const activeTab = document.querySelector('#archivos-filter-tabs .filter-tab.active');
          const activeFilter = activeTab ? activeTab.getAttribute('data-filter') || 'all' : 'all';
          applyFilters(activeFilter, (searchInput ? searchInput.value : '').toLowerCase().trim(), false);
          if (currentActiveFolderId === petId) openFolderDetail(petId);
        }

        if (typeof (window as any).showToast === 'function') {
          const closeMsg = data.driveSynced
            ? `Expediente ${radicado || petId} cerrado y respaldado automáticamente en Google Drive.`
            : `Expediente ${radicado || petId} marcado como Completo internamente.`;
          (window as any).showToast(closeMsg, 'success');
        }
      } catch (err: any) {
        btn.disabled = false;
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(err?.message || 'Error completando expediente.', 'error');
        }
      }
    }

    // Manejador Global de Subida de Respuesta Final Oficial (respetando nombre 100% original)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.btn-subir-respuesta-final, .btn-cambiar-respuesta-final') as HTMLElement | null;
      if (target) {
        const petId = target.getAttribute('data-peticion-id');
        if (petId) {
          currentUploadPetId = petId;
          if (inputSubirRespuestaFinal) {
            inputSubirRespuestaFinal.value = '';
            inputSubirRespuestaFinal.click();
          }
        }
      }
    });

    inputSubirRespuestaFinal?.addEventListener('change', async () => {
      const file = inputSubirRespuestaFinal.files?.[0];
      if (!file || !currentUploadPetId) return;

      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`Subiendo Respuesta Final Oficial (${file.name})...`, 'info');
      }

      try {
        const petCurrent = peticionesMap.get(currentUploadPetId) || allPeticiones.find((p) => p.id === currentUploadPetId);
        const cleanRadicado = String(petCurrent?.numero_radicado || currentUploadPetId).trim().replace(/[^a-zA-Z0-9_-]/g, '_');
        const cleanFileName = file.name.replace(/[/\\?%*:|"<>]/g, '_').trim();
        const relStoragePath = `${cleanRadicado}/respuesta_final/${cleanFileName}`;
        const uploadedPath = await uploadFileToPeticionesStorage(file, relStoragePath);

        let res: Response;
        if (uploadedPath) {
          res = await fetch('/api/peticiones/subir-respuesta-final', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              peticion_id: currentUploadPetId,
              nombre_archivo: file.name,
              mime_type: file.type || 'application/octet-stream',
              tamano_bytes: file.size,
              storage_path: uploadedPath,
            }),
          });
        } else if (file.size <= 4 * 1024 * 1024) {
          const formData = new FormData();
          formData.append('peticion_id', currentUploadPetId);
          formData.append('archivo', file);

          res = await fetch('/api/peticiones/subir-respuesta-final', {
            method: 'POST',
            body: formData,
          });
        } else {
          throw new Error('No se pudo subir el archivo de gran tamaño al almacenamiento directo. Verifique su conexión e intente nuevamente.');
        }

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo subir la respuesta final.');
        }

        const pet = peticionesMap.get(currentUploadPetId) || allPeticiones.find((p) => p.id === currentUploadPetId);
        if (pet) {
          pet.respuesta_archivo = data.archivo;
          if (data.driveUrl) pet.respuesta_drive_url = data.driveUrl;
          if (!pet.peticion_anexos) pet.peticion_anexos = [];
          const existingIdx = pet.peticion_anexos.findIndex((a: any) => a.storage_path && a.storage_path.includes('/respuesta_final/'));
          if (existingIdx >= 0) {
            pet.peticion_anexos[existingIdx] = data.archivo;
          } else {
            pet.peticion_anexos.push(data.archivo);
          }
          indexPeticion(pet);

          // Si la vista de detalle de la carpeta está activa, refrescarla al instante
          if (currentActiveFolderId === currentUploadPetId) {
            openFolderDetail(currentUploadPetId);
          }
        }

        if (typeof (window as any).showToast === 'function') {
          const uploadOkMsg = data.driveSynced
            ? `Respuesta Final guardada y sincronizada en Google Drive: "${file.name}"`
            : `Respuesta Final Oficial guardada exitosamente: "${file.name}"`;
          (window as any).showToast(uploadOkMsg, 'success');
        }
      } catch (uploadErr: any) {
        console.error('Error subiendo respuesta final:', uploadErr);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(uploadErr.message || 'Error al subir el archivo.', 'error');
        }
      }
    });

    // 7.3 Respaldar / Actualizar Expediente en Google Drive (Reemplazo limpio idempotente)
    let isExportingDrive = false;
    async function handleExportToGoogleDrive(petId: string, radicado: string, _clickedBtn: HTMLElement) {
      if (isExportingDrive) return;

      const allDriveBtns = document.querySelectorAll<HTMLButtonElement>(`.btn-export-drive[data-id="${petId}"]`);
      const hadExistingDrive = Array.from(allDriveBtns).some((b) => b.getAttribute('data-has-drive') === 'true');
      isExportingDrive = true;
      allDriveBtns.forEach((btn) => {
        btn.disabled = true;
        btn.innerHTML = `
          <svg class="spin-animation" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span>Sincronizando carpeta limpia en Drive...</span>
        `;
      });

      let isSuccess = false;
      try {
        const res = await fetch('/api/peticiones/respaldar-drive', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ peticionId: petId }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.success) {
          if (data.missingConfig) {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(
                'Credenciales de Google Drive no configuradas en el servidor. Configure GOOGLE_DRIVE_CLIENT_ID, GOOGLE_DRIVE_CLIENT_SECRET y GOOGLE_DRIVE_REFRESH_TOKEN en el archivo .env o en Vercel.',
                'warning',
                'Aviso del Sistema'
              );
            }
          } else {
            const errorMsg = data.error || 'No se pudo respaldar el expediente en Google Drive.';
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(errorMsg, 'error', 'Error de Sincronización Drive');
            }
          }
          return;
        }

        isSuccess = true;

        // Actualizar enlace en memoria y re-renderizar detalle para mostrar "Actualizar Carpeta" + "Abrir en Drive ↗"
        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          pet.respuesta_drive_url = data.webViewLink;
          indexPeticion(pet);
        }
        if (currentActiveFolderId === petId) {
          openFolderDetail(petId);
        }

        // Mostrar única confirmación visual ejecutiva con enlace directo y copia rápida
        showDriveSuccessToast(
          radicado,
          data.webViewLink,
          data.archivosSubidos || 0,
          data.subcarpetasCreadas || 0,
          data.aprobadosCount
        );
      } catch (err: any) {
        console.error('Error al sincronizar con Google Drive:', err);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error de comunicación con el servicio de Google Drive.', 'error', 'Error de Conexión');
        }
      } finally {
        isExportingDrive = false;
        if (!isSuccess) {
          const restBtns = document.querySelectorAll<HTMLButtonElement>(`.btn-export-drive[data-id="${petId}"]`);
          restBtns.forEach((btn) => {
            btn.disabled = false;
            btn.innerHTML = hadExistingDrive
              ? `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg><span>Actualizar Carpeta en Drive</span>`
              : `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 12 17"/><polyline points="9 14 12 11 15 14"/></svg><span>Respaldar en Drive</span>`;
            btn.style.background = '#F2F7F6';
            btn.style.borderColor = '#00594E';
            btn.style.color = '#00594E';
          });
        }
      }
    }

    function showDriveSuccessToast(
      radicado: string,
      webViewLink: string,
      archivosCount: number,
      subcarpetasCount: number,
      aprobadosCount?: number
    ) {
      const toast = document.getElementById('drive-success-toast');
      const openBtn = document.getElementById('btn-drive-open-link') as HTMLAnchorElement | null;
      const copyBtn = document.getElementById('btn-drive-copy-link');
      const copyText = document.getElementById('btn-drive-copy-text');
      const msg = document.getElementById('drive-toast-message');

      if (!toast) return;

      if (openBtn) openBtn.href = webViewLink;
      if (msg) {
        const extraAprobados =
          typeof aprobadosCount === 'number'
            ? ` (${aprobadosCount} aporte${aprobadosCount === 1 ? '' : 's'} aprobado${aprobadosCount === 1 ? '' : 's'})`
            : '';
        msg.textContent = `Carpeta limpia "${radicado}" sincronizada en Google Drive con ${archivosCount} archivo(s)${extraAprobados} en ${subcarpetasCount} subcarpeta(s).`;
      }

      if (copyBtn) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(webViewLink);
            if (copyText) copyText.textContent = '¡Enlace Copiado!';
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copiar Enlace';
            }, 3000);
          } catch {
            alert('Enlace de Drive: ' + webViewLink);
          }
        };
      }

      const closeBtn = document.getElementById('btn-close-drive-toast');
      if (closeBtn) {
        closeBtn.onclick = () => {
          toast.style.display = 'none';
        };
      }

      toast.style.display = 'block';
    }

    // 8. Auto-abrir carpeta si viene parámetro ?radicado=... o ?id=... en la URL
    const urlParams = new URLSearchParams(window.location.search);
    const targetQuery = urlParams.get('radicado') || urlParams.get('folderId') || urlParams.get('id');
    if (targetQuery) {
      openFolderDetail(targetQuery);
    }

    // 9. Verificación automática silenciosa y botón opcional de recordatorios preventivos (3 días)
    const runDependenciasReminderCheck = async (manual = false) => {
      const btnAlerts = document.getElementById('btn-check-reminders') as HTMLButtonElement | null;
      const originalHtml = btnAlerts ? btnAlerts.innerHTML : '';

      if (manual && btnAlerts) {
        btnAlerts.disabled = true;
        btnAlerts.innerHTML = `<svg class="spin-animation" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg><span>Verificando...</span>`;
      }

      try {
        const res = await fetch('/api/peticiones/recordatorio-dependencias', { method: 'POST' });
        if (!res.ok) throw new Error('Error consultando alertas de vencimiento');
        const data = await res.json();

        if (data?.remindersSent > 0) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast(
              `Se enviaron ${data.remindersSent} recordatorio(s) preventivo(s) por vencimiento próximo a dependencias pendientes.`,
              'success',
              'Recordatorios Enviados'
            );
          }
        } else if (manual && typeof (window as any).showToast === 'function') {
          (window as any).showToast(
            'Todas las dependencias con vencimiento en 3 días o menos ya entregaron o fueron notificadas.',
            'info',
            'Sin Alertas Pendientes'
          );
        }
      } catch (err: any) {
        if (manual && typeof (window as any).showToast === 'function') {
          (window as any).showToast(err?.message || 'No se pudo ejecutar la verificación de alertas.', 'error');
        }
      } finally {
        if (manual && btnAlerts) {
          btnAlerts.disabled = false;
          btnAlerts.innerHTML = originalHtml;
        }
      }
    };

    document.getElementById('btn-check-reminders')?.addEventListener('click', () => {
      runDependenciasReminderCheck(true);
    });

    setTimeout(() => {
      runDependenciasReminderCheck(false);
    }, 650);
  </script>
</AppLayout>
