    function getRespuestaFinalFile(pet: PeticionExpediente | any) {
      if (!pet) return null;
      const { respuestaMeta } = separarRespuestaMeta(pet.instrucciones_anexos || '');
      const respObj = pet.respuesta_archivo || respuestaMeta?.archivo_respuesta || respuestaMeta?.respuesta_archivo || null;
      if (respObj && (respObj.storage_path || respObj.nombre_archivo)) return respObj;
      const anexos = Array.isArray(pet.peticion_anexos) ? pet.peticion_anexos : [];
      return anexos.find((a: any) => a && a.storage_path && a.storage_path.includes('/respuesta_final/')) || null;
    }

    function updateRecipientAvatar(email: string) {
      const avatarImg = document.getElementById('composer-recipient-avatar') as HTMLImageElement | null;
      const avatarFallback = document.getElementById('composer-recipient-avatar-fallback');
      const cleanEmail = (email || '').trim().toLowerCase();
      if (!avatarImg) return;

      if (!cleanEmail || !cleanEmail.includes('@')) {
        avatarImg.style.display = 'none';
        if (avatarFallback) avatarFallback.style.display = 'inline-flex';
        return;
      }

      avatarImg.style.display = 'block';
      if (avatarFallback) avatarFallback.style.display = 'none';
      avatarImg.src = `https://unavatar.io/google/${encodeURIComponent(cleanEmail)}`;
      avatarImg.onerror = () => {
        avatarImg.onerror = null;
        avatarImg.src = `https://unavatar.io/${encodeURIComponent(cleanEmail)}`;
        avatarImg.onerror = () => {
          avatarImg.style.display = 'none';
          if (avatarFallback) avatarFallback.style.display = 'inline-flex';
        };
      };
    }

