---
// src/pages/archivos.astro
export const prerender = false;

import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
import { calculateDeadlineProgress } from '@lib/utils';
import { Buffer } from 'node:buffer';
import { getDeterministicPin } from '@lib/security';
import { separarRespuestaMeta, esSubcarpetaValida, filtrarSubcarpetasValidas, isPeticionRespondida, isAuditLogOfficialResponse, getSlaBucket } from '@lib/subcarpetas';

// Interfaces estrictas para TypeScript
export interface PeticionAnexo {
  id: string;
  nombre_archivo: string;
  storage_path: string;
  tamano_bytes: number | null;
  mime_type?: string | null;
  es_anexo_oficina?: boolean | null;
  peticion_responsable_id?: string | null;
  subcarpeta_id?: string | null;
  created_at: string;
}

export interface OficinaInfo {
  id: string;
  codigo: string;
  nombre: string;
  email_institucional?: string | null;
}

export interface PeticionResponsable {
  id: string;
  codigo_acceso: string;
  subcarpeta_id?: string | null;
  estado_entrega?: string | null;
  fecha_entrega?: string | null;
  observaciones_entrega?: string | null;
  storage_subfolder_path?: string | null;
  oficinas?: OficinaInfo | null;
}

export interface PeticionSubcarpeta {
  id: string;
  peticion_id: string;
  nombre: string;
  descripcion?: string | null;
  created_at?: string;
}

export interface PeticionExpediente {
  id: string;
  numero_radicado: string;
  asunto: string;
  descripcion?: string | null;
  categoria?: string | null;
  instrucciones_anexos?: string | null;
  pin_acceso?: string | null;
  solicitante_nombre: string;
  solicitante_tipo?: string | null;
  solicitante_email?: string | null;
  fecha_radicacion?: string | null;
  fecha_limite_entrega?: string | null;
  fecha_limite_responsable?: string | null;
  storage_folder_path?: string | null;
  estado: string;
  prioridad?: string | null;
  created_at: string;
  respuesta_mensaje?: string | null;
  respuesta_funcionario?: string | null;
  respuesta_fecha_envio?: string | null;
  respuesta_expira_at?: string | null;
  respuesta_pin_solicitante?: string | null;
  respuesta_archivos_incluidos?: string[] | null;
  respuesta_drive_url?: string | null;
  respuesta_archivo?: any;
  tiene_respuesta_audit?: boolean;
  respondida?: boolean;
  peticion_anexos?: PeticionAnexo[];
  peticion_responsables?: PeticionResponsable[];
  subcarpetas?: PeticionSubcarpeta[];
}

// Consultar peticiones, archivo principal y anexos reales en PostgreSQL
const { data: dbPeticiones } = await (supabase
  .from('peticiones' as any)
  .select(`
    id,
    numero_radicado,
    asunto,
    descripcion,
    categoria,
    instrucciones_anexos,
    solicitante_nombre,
    solicitante_tipo,
    solicitante_email,
    fecha_radicacion,
    fecha_limite_entrega,
    fecha_limite_responsable,
    storage_folder_path,
    respuesta_drive_url,
    estado,
    prioridad,
    created_at,
    peticion_anexos (
      id,
      nombre_archivo,
      storage_path,
      tamano_bytes,
      mime_type,
      es_anexo_oficina,
      peticion_responsable_id,
      created_at
    ),
    peticion_responsables (
      id,
      codigo_acceso,
      estado_entrega,
      fecha_entrega,
      observaciones_entrega,
      storage_subfolder_path,
      oficinas (
        id,
        codigo,
        nombre,
        email_institucional
      )
    )
  `)
  .order('created_at', { ascending: false }) as any);

// Consultar catálogo de oficinas para modal de asignación de subcarpetas
const { data: oficinasCatalogoDb } = await (supabase
  .from('oficinas' as any)
  .select('id, codigo, nombre, email_institucional')
  .eq('activo', true)
  .order('nombre') as any);

const oficinasCatalogo = (oficinasCatalogoDb as any[]) || [];

// Consultar subcarpetas asociadas de forma segura y defensiva
const subcarpetasPorPeticion: Record<string, any[]> = {};
try {
  const { data: allSubcarpetas } = await (supabase
    .from('peticion_subcarpetas' as any)
    .select('id, peticion_id, nombre, descripcion, created_at')
    .order('created_at', { ascending: true }) as any);

  if (allSubcarpetas && allSubcarpetas.length > 0) {
    allSubcarpetas.forEach((sub: any) => {
      const petId = String(sub?.peticion_id || '');
      if (petId) {
        if (!subcarpetasPorPeticion[petId]) {
          subcarpetasPorPeticion[petId] = [];
        }
        subcarpetasPorPeticion[petId]!.push(sub);
      }
    });
  }
} catch {
  // Ignorar si la tabla física aún no existe
}

// Consultar mapeos de subcarpeta_id en peticion_responsables y peticion_anexos de forma segura
const respSubcarpetasMap: Record<string, string> = {};
try {
  const { data: respSubs } = await (supabase
    .from('peticion_responsables' as any)
    .select('id, subcarpeta_id') as any);
  if (respSubs && respSubs.length > 0) {
    respSubs.forEach((r: any) => {
      if (r && r.id && r.subcarpeta_id) respSubcarpetasMap[r.id] = r.subcarpeta_id;
    });
  }
} catch {}

const anexoSubcarpetasMap: Record<string, string> = {};
try {
  const { data: anexoSubs } = await (supabase
    .from('peticion_anexos' as any)
    .select('id, subcarpeta_id') as any);
  if (anexoSubs && anexoSubs.length > 0) {
    anexoSubs.forEach((a: any) => {
      if (a && a.id && a.subcarpeta_id) anexoSubcarpetasMap[a.id] = a.subcarpeta_id;
    });
  }
} catch {}

const rawPeticiones = (dbPeticiones as any[]) || [];

// Helper robusto para inferir subcarpetas virtuales si la tabla física aún no tiene registros (retrocompatibilidad)
function combineSubcarpetas(p: any, dbSubs: any[] = []): any[] {
  const mapByName: Record<string, any> = {};
  filtrarSubcarpetasValidas(dbSubs || []).forEach(s => {
    if (s && s.nombre && s.nombre.trim().toLowerCase() !== 'expediente general') {
      mapByName[s.nombre.trim().toUpperCase()] = s;
    }
  });

  const foundSubs: Record<string, { id: string; peticion_id: string; nombre: string; descripcion?: string | null }> = {};

  (p.peticion_responsables || []).forEach((r: any) => {
    const raw = r?.observaciones_entrega || '';
    const { textoLimpio } = separarRespuestaMeta(raw);
    const withoutPin = textoLimpio.replace(/^PIN:\s*[0-9A-Z]{6}(\s*\|\s*)?/i, '');
    const matches = withoutPin.matchAll(/\[([^\]\r\n]+)\](?:\s*:?\s*([^|\[\r\n]+))?/g);
    for (const m of matches) {
      const name = String(m?.[1] || '').trim();
      const desc = String(m?.[2] || '').trim() || null;
      if (name && esSubcarpetaValida({ nombre: name, descripcion: desc })) {
        const key = name.toUpperCase();
        const existing = foundSubs[key];
        if (!existing) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: desc,
          };
        } else if (!existing.descripcion && desc) {
          existing.descripcion = desc;
        }
      }
    }
  });

  (p.peticion_anexos || []).forEach((a: any) => {
    const fileName = a?.nombre_archivo || '';
    const m = fileName.match(/\[([^\]\r\n]+)\]/i);
    if (m && m[1]) {
      const name = String(m[1] || '').trim();
      if (name && esSubcarpetaValida({ nombre: name })) {
        const key = name.toUpperCase();
        if (!foundSubs[key]) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: null,
          };
        }
      }
    }
  });

  const { textoLimpio: cleanDesc } = separarRespuestaMeta(p.instrucciones_anexos || p.descripcion || '');
  if (cleanDesc) {
    const matches = cleanDesc.matchAll(/\[([^\]\r\n]+)\](?:\s*:?\s*([^|\[\r\n]+))?/g);
    for (const m of matches) {
      const name = String(m?.[1] || '').trim();
      const desc = String(m?.[2] || '').trim() || null;
      if (name && esSubcarpetaValida({ nombre: name, descripcion: desc })) {
        const key = name.toUpperCase();
        const existing = foundSubs[key];
        if (!existing) {
          foundSubs[key] = {
            id: `sub-inf-${p.id}-${key.replace(/[^A-Z0-9_-]/g, '_')}`,
            peticion_id: p.id,
            nombre: name,
            descripcion: desc,
          };
        } else if (!existing.descripcion && desc) {
          existing.descripcion = desc;
        }
      }
    }
  }

  Object.values(foundSubs).forEach(s => {
    if (esSubcarpetaValida(s)) {
      const k = s.nombre.trim().toUpperCase();
      if (!mapByName[k]) mapByName[k] = s;
    }
  });

  const list = filtrarSubcarpetasValidas(Object.values(mapByName));
  if (list.length === 0 && (p.peticion_responsables?.length > 0 || (p.peticion_anexos && p.peticion_anexos.some((a: any) => a.es_anexo_oficina)))) {
    const { textoLimpio } = separarRespuestaMeta(p.instrucciones_anexos);
    list.push({
      id: `sub-default-${p.id}`,
      peticion_id: p.id,
      nombre: 'Subcarpeta 1',
      descripcion: textoLimpio || 'Aportes y requerimientos de dependencias',
    });
  }

  return filtrarSubcarpetasValidas(list);
}

let auditRespLogs: any[] = [];
try {
  const { data: auditData } = await (supabase
    .from('audit_logs' as any)
    .select('action, entity_id, details')
    .or('action_type.eq.RESPUESTA,action.ilike.%Expediente Marcado como Completo%')
    .limit(500) as any);
  if (auditData) auditRespLogs = auditData;
} catch {}

const peticiones: PeticionExpediente[] = rawPeticiones.map((p) => {
  const respObs = p.peticion_responsables?.find((r: any) => r?.observaciones_entrega?.includes('PIN:'))?.observaciones_entrega;
  const pinMatch = respObs?.match(/PIN:\s*([0-9A-Z]{6})/i);
  const storedPin = pinMatch ? (pinMatch[1] || null) : null;

  const auditMatch = auditRespLogs.some((log: any) => isAuditLogOfficialResponse(log, p));

  const enrichedResponsables = (p.peticion_responsables || []).map((r: any) => ({
    ...r,
    subcarpeta_id: r.subcarpeta_id || respSubcarpetasMap[r.id] || null,
  }));

  const enrichedAnexos = (p.peticion_anexos || []).map((a: any) => ({
    ...a,
    subcarpeta_id: a.subcarpeta_id || anexoSubcarpetasMap[a.id] || null,
  }));

  const initialSubs = subcarpetasPorPeticion[p.id] || [];
  const finalSubs = combineSubcarpetas(p, initialSubs);

  const enriched: PeticionExpediente = {
    ...p,
    tiene_respuesta_audit: auditMatch,
    peticion_responsables: enrichedResponsables,
    peticion_anexos: enrichedAnexos,
    subcarpetas: finalSubs,
    pin_acceso: storedPin || p.pin_acceso || getDeterministicPin(p.numero_radicado || p.id),
  };

  return {
    ...enriched,
    respondida: isPeticionRespondida(enriched),
  };
});
const totalCount = peticiones.length;
const pendingCount = peticiones.filter((p) => !isPeticionRespondida(p)).length;
const respondedCount = peticiones.filter((p) => isPeticionRespondida(p)).length;

let safeCount = 0;
let warnCount = 0;
let criticalCount = 0;

peticiones.forEach((p) => {
  if (isPeticionRespondida(p)) return;
  const prog = calculateDeadlineProgress(p.fecha_radicacion || p.created_at, p.fecha_limite_entrega);
  const bucket = getSlaBucket(prog.daysRemaining);
  if (bucket === 'safe') safeCount++;
  else if (bucket === 'warn') warnCount++;
  else criticalCount++;
});

// Función para obtener URL pública de descarga en Supabase Storage
function getDownloadUrl(storagePath: string | null | undefined): string {
  if (!storagePath) return '#';
  const clean = storagePath.replace(/^peticiones\//, '');
  return `https://irjjpjtvhxoakiazfswn.supabase.co/storage/v1/object/public/peticiones/${clean}`;
}

// Paleta institucional estricta para semáforo y Chart Elements en tarjetas
function getSlaTone(filterSla: string) {
  if (filterSla === 'critical') {
    return { bar: '#DC2626', text: '#DC2626', badgeBg: '#FEF2F2', badgeBorder: '#FECACA', badgeText: '#B91C1C' };
  }
  if (filterSla === 'warn') {
    return { bar: '#B5A160', text: '#786832', badgeBg: '#F7F5EE', badgeBorder: '#DBD2B0', badgeText: '#786832' };
  }
  return { bar: '#00594E', text: '#00594E', badgeBg: '#F2F7F6', badgeBorder: '#B2CFCB', badgeText: '#00594E' };
}

function getCardSlaMeta(prog: any, isResponded: boolean) {
  const filterSla = isResponded ? 'safe' : getSlaBucket(prog.daysRemaining);
  const slaTone = getSlaTone(filterSla);
  let cardBadgeText = prog.statusBadge;
  if (isResponded) {
    cardBadgeText = 'Expediente Completo';
  } else if (prog.daysRemaining <= 0) {
    cardBadgeText = 'Vencido';
  } else if (prog.daysRemaining <= 5) {
    cardBadgeText = `Vence en ${prog.daysRemaining}d`;
  }
  const cardPct = isResponded ? 100 : prog.percentage;
  const cardPctText = isResponded ? 'Completado' : `${prog.percentage}% consumido`;
  return { filterSla, slaTone, cardBadgeText, cardPct, cardPctText };
}

const peticionesJson = JSON.stringify(peticiones);
const peticionesBase64 = Buffer.from(peticionesJson, 'utf-8').toString('base64');
---

<AppLayout title="Carpetas y Expedientes" activeNav="archivos">
  <div class="archivos-wrapper" style="display: flex; flex-direction: column; gap: 20px;">

    <!-- =========================================================================
         1. VISTA GENERAL DE EXPLORADOR DE CARPETAS (RAÍZ)
         Se oculta por completo cuando se abre una carpeta para dar paso a la vista dedicada
         ========================================================================= -->
    <div id="explorer-root-view" style="display: flex; flex-direction: column; gap: 20px;">

      <!-- Cabecera Bento Grid Pro Max + Chart Element SLA -->
      <div class="card archivos-bento-header">
        <!-- Breadcrumb y resumen visual -->
        <div class="archivos-header-brand">
          <div class="archivos-header-icon">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <div class="archivos-header-title-row">
              <span class="archivos-header-title">Carpetas y Expedientes</span>
              <span class="archivos-total-pill">{totalCount} expediente{totalCount === 1 ? '' : 's'}</span>
            </div>
            <div class="archivos-header-subtitle">Repositorio central de expedientes, trazabilidad de aportes por dependencia y cierre de peticiones</div>
            {totalCount > 0 && (
              <div class="archivos-sla-chart-strip" title={`Distribución SLA: ${respondedCount} Respondida, ${safeCount} Saludable, ${warnCount} Próximo a Vencer, ${criticalCount} Crítico`}>
                <div class="archivos-chart-bar" role="img" aria-label="Distribución de plazos de expedientes">
                  {(safeCount + respondedCount) > 0 && (
                    <span class="archivos-chart-seg is-safe" style={`width: ${Math.round(((safeCount + respondedCount) / totalCount) * 100)}%;`}></span>
                  )}
                  {warnCount > 0 && (
                    <span class="archivos-chart-seg is-warn" style={`width: ${Math.round((warnCount / totalCount) * 100)}%;`}></span>
                  )}
                  {criticalCount > 0 && (
                    <span class="archivos-chart-seg is-critical" style={`width: ${Math.max(4, Math.round((criticalCount / totalCount) * 100))}%;`}></span>
                  )}
                </div>
                <span class="archivos-chart-caption">
                  <strong style="color: #00594E;">{respondedCount}</strong> respondida{respondedCount === 1 ? '' : 's'} &middot; <strong style="color: #00594E;">{safeCount}</strong> al día &middot; <strong style="color: #786832;">{warnCount}</strong> por vencer &middot; <strong style="color: #DC2626;">{criticalCount}</strong> crítico
                </span>
              </div>
            )}
          </div>
        </div>

        <!-- Acciones de Cabecera: Buscador, Alternador, Alertas y Nueva Radicación -->
        <div class="archivos-header-actions">
          <!-- Buscador en Vivo -->
          <div class="archivos-search-wrap">
            <input type="text" id="drive-search-input" placeholder="Buscar carpeta, radicado o titular..." class="form-input archivos-search-input" />
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="archivos-search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>

          <!-- Alternador Vista Carpetas / Vista Lista -->
          <div class="archivos-view-toggle">
            <button type="button" id="btn-view-grid" class="view-toggle-btn active" title="Vista de Carpetas estilo Drive">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>Carpetas</span>
            </button>
            <button type="button" id="btn-view-table" class="view-toggle-btn" title="Vista de Tabla Detallada">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              <span>Lista</span>
            </button>
          </div>

          <!-- Botón opcional de verificación manual de recordatorios 3 días -->
          <button type="button" id="btn-check-reminders" class="btn-archivos-alerts" title="Verificar y enviar recordatorios a dependencias próximas a vencer (3 días o menos)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span>Alertar a dependencias</span>
          </button>

          <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.82rem; height: 38px; border-radius: 10px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
            <span>Nueva Carpeta / Radicación</span>
          </a>
        </div>
      </div>

      <!-- Pestañas de Filtro Rápido en Barra Bento -->
      <div class="archivos-filter-toolbar">
        <div class="filter-tabs" id="archivos-filter-tabs">
          <button class="filter-tab active" data-filter="all">
            <span>Todas las Carpetas</span>
            <span class="filter-count" id="count-all">{totalCount}</span>
          </button>
          <button class="filter-tab" data-filter="pending">
            <span class="dist-dot" style="background: #786832;"></span>
            <span>En Trámite</span>
            <span class="filter-count" id="count-pending">{pendingCount}</span>
          </button>
          <button class="filter-tab" data-filter="responded">
            <span class="dist-dot" style="background: #00594E;"></span>
            <span>Completadas / Respondidas</span>
            <span class="filter-count" id="count-responded">{respondedCount}</span>
          </button>
          <button class="filter-tab" data-filter="safe">
            <span class="dist-dot" style="background: #00594E;"></span>
            <span>Plazo Saludable</span>
            <span class="filter-count" id="count-safe">{safeCount}</span>
          </button>
          <button class="filter-tab" data-filter="warn">
            <span class="dist-dot" style="background: #B5A160;"></span>
            <span>Próximo a Vencer</span>
            <span class="filter-count" id="count-warn">{warnCount}</span>
          </button>
          <button class="filter-tab" data-filter="critical">
            <span class="dist-dot" style="background: #DC2626;"></span>
            <span>Crítico / Vencido</span>
            <span class="filter-count" id="count-critical">{criticalCount}</span>
          </button>
        </div>
      </div>

      <!-- SECCIÓN A: MODO CUADRÍCULA DE CARPETAS (BENTO GRID PRO MAX) -->
      <div id="drive-grid-container" class="archivos-bento-grid">
        {peticiones.length > 0 ? (
          peticiones.map((doc) => {
            const isResponded = isPeticionRespondida(doc);
            const anexos = doc.peticion_anexos || [];
            const anexoPrincipal = anexos.find((a) => !a.es_anexo_oficina) || anexos[0];
            const prog = calculateDeadlineProgress(doc.fecha_radicacion || doc.created_at, doc.fecha_limite_entrega);
            const { filterSla, slaTone, cardBadgeText, cardPct, cardPctText } = getCardSlaMeta(prog, isResponded);

            return (
              <div 
                class="drive-folder-card" 
                id={`card-folder-${doc.id}`}
                data-folder-id={doc.id}
                data-id={doc.id}
                data-radicado={doc.numero_radicado}
                data-pin={doc.pin_acceso || '849201'}
                data-asunto={doc.asunto}
                data-solicitante={doc.solicitante_nombre}
                data-status={isResponded ? 'responded' : 'pending'} 
                data-sla={filterSla}
              >
                <!-- Cabecera de Carpeta -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; gap: 10px;">
                  <div style="display: flex; align-items: flex-start; gap: 10px; min-width: 0;">
                    <div class="folder-svg-icon">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 3px; min-width: 0;">
                      <span class="radicado-chip">{doc.numero_radicado}</span>
                      <div style="font-size: 0.73rem; color: #64748B; white-space: nowrap; font-weight: 500;">
                        Radicado: {doc.fecha_radicacion || 'Reciente'}
                      </div>
                    </div>
                  </div>

                  <span class="folder-sla-badge" style={`font-size: 0.68rem; font-weight: 800; padding: 3px 9px; border-radius: 999px; background: ${slaTone.badgeBg}; color: ${slaTone.badgeText}; border: 1px solid ${slaTone.badgeBorder}; white-space: nowrap; flex-shrink: 0;`}>
                    {cardBadgeText}
                  </span>
                </div>

                <!-- Título de la Carpeta (Asunto) -->
                <h4 class="folder-title" title={doc.asunto}>{doc.asunto}</h4>

                <!-- Solicitante -->
                <div style="font-size: 0.76rem; color: #64748B; margin-bottom: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <span style="font-weight: 700; color: #111827;">{doc.solicitante_nombre}</span> ({doc.solicitante_tipo === 'Docente' ? 'Profesor' : (doc.solicitante_tipo || 'Ciudadano')})
                </div>

                <!-- Bloque Chart Element: Fecha de Expiración -->
                <div class="sla-chart-card">
                  <div class="sla-chart-header">
                    <span class="sla-chart-label">Fecha de Expiración ({doc.fecha_limite_entrega || '--'}):</span>
                    <span class="sla-chart-pct" style={`color: ${slaTone.text};`}>{cardPctText}</span>
                  </div>
                  <div class="sla-chart-track">
                    <div class="sla-chart-fill" style={`width: ${cardPct}%; background: ${slaTone.bar};`}></div>
                  </div>
                </div>

                <!-- Cápsula Bento Pro Max: ÚNICAMENTE PIN de Acceso en una sola línea -->
                <div class="pin-acceso-row">
                  <span class="pin-acceso-label">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#786832" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>PIN Acceso:</span>
                  </span>
                  <span class="pin-acceso-code">{doc.pin_acceso || '849201'}</span>
                  <button
                    type="button"
                    class="btn-copy-pin pin-copy-btn"
                    data-pin={doc.pin_acceso || '849201'}
                    title="Copiar PIN de 6 dígitos"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copiar</span>
                  </button>
                </div>

                <!-- Barra de Acciones de la Carpeta -->
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px; border-top: 1px solid #E2E8F0; padding-top: 10px;">
                  <button 
                    type="button" 
                    class="btn-open-folder btn-abrir-carpeta btn btn-primary btn-sm" 
                    style="flex: 1; justify-content: center; gap: 6px; font-weight: 800; font-size: 0.8rem; cursor: pointer;" 
                    data-folder-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    onclick={`window.openFolderDetail && window.openFolderDetail('${doc.id || doc.numero_radicado}')`}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span>Abrir Carpeta</span>
                  </button>

                  {anexoPrincipal && (
                    <a 
                      href={getDownloadUrl(anexoPrincipal.storage_path)} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="btn-icon-action" 
                      title="Descargar documento principal" 
                      style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: #ffffff; color: var(--text-muted); display: flex; align-items: center; justify-content: center;"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </a>
                  )}

                  <button 
                    type="button" 
                    class="btn-icon-action btn-edit-pet" 
                    data-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    data-asunto={doc.asunto}
                    data-solicitante={doc.solicitante_nombre}
                    data-tipo={doc.solicitante_tipo || 'Ciudadano'}
                    data-prioridad={doc.prioridad || 'Media'}
                    data-entrega={doc.fecha_limite_entrega}
                    data-estado={doc.estado || 'en_tramite'}
                    title="Editar Expediente"
                    style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--dorado-borde); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center; cursor: pointer;"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>

                  <button 
                    type="button" 
                    class="btn-icon-action btn-delete-pet" 
                    data-id={doc.id} 
                    data-radicado={doc.numero_radicado}
                    title="Eliminar Carpeta y Radicado"
                    style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </div>
              </div>
            );
          })
        ) : (
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px auto;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin: 0 0 6px 0;">No hay carpetas de expedientes creadas</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); max-width: 480px; margin: 0 auto 16px auto;">
              Al radicar una nueva petición se creará automáticamente su carpeta virtual con su documento inicial y las subcarpetas de las dependencias asignadas.
            </p>
            <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              <span>Radicar Primera Petición</span>
            </a>
          </div>
        )}

        <div id="drive-search-empty-state" style="display: none; grid-column: 1 / -1; text-align: center; padding: 42px 20px; background: #FFFFFF; border: 1px dashed #DCE4E3; border-radius: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 12px; background: #F2F7F6; border: 1px solid #B2CFCB; color: #00594E; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <div style="font-size: 0.96rem; font-weight: 800; color: #111827; margin-bottom: 4px;">No se encontraron carpetas coincidentes</div>
          <div style="font-size: 0.8rem; color: #64748B;">Ajuste el término de búsqueda o cambie la pestaña de estado SLA.</div>
        </div>
      </div>

      <!-- SECCIÓN B: MODO LISTA TABULAR DETALLADA -->
      <div id="drive-table-container" style="display: none !important;">
        <div class="table-responsive pro-scroll-container table-scroll-wrapper" style="max-height: 540px; overflow-y: auto; overflow-x: auto; border-radius: 12px;">
          <table class="doc-table">
            <thead style="position: sticky; top: 0; z-index: 10;">
              <tr style="background: #F2F7F6; border-bottom: 2px solid #DCE4E3;">
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Carpeta / Expediente</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Radicado</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Fechas (Radicado - Límite)</th>
                <th style="min-width: 170px; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Plazo General (SLA)</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Oficinas Responsables</th>
                <th style="position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Estado</th>
                <th style="text-align: right; position: sticky; top: 0; z-index: 10; background: #F2F7F6; box-shadow: 0 1px 0 #DCE4E3;">Acciones</th>
              </tr>
            </thead>
            <tbody id="documents-table-body">
              {peticiones.map((doc) => {
                const prog = calculateDeadlineProgress(doc.fecha_radicacion || doc.created_at, doc.fecha_limite_entrega);
                const isResponded = isPeticionRespondida(doc);
                const anexos = doc.peticion_anexos || [];
                const anexoPrincipal = anexos.find((a) => !a.es_anexo_oficina) || anexos[0];
                const responsables = doc.peticion_responsables || [];
                const filterSla = isResponded ? 'safe' : getSlaBucket(prog.daysRemaining);

                return (
                  <tr class="doc-row" id={`row-folder-${doc.id}`} data-id={doc.id} data-radicado={doc.numero_radicado} data-pin={doc.pin_acceso || '849201'} data-asunto={doc.asunto} data-solicitante={doc.solicitante_nombre} data-status={isResponded ? 'responded' : 'pending'} data-sla={filterSla}>
                    <td style="vertical-align: middle; min-width: 260px;">
                      <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                        <div class="doc-icon-badge" style="width: 38px; height: 38px; flex-shrink: 0; background: #F2F7F6; color: #00594E; border: 1.5px solid #B2CFCB; display: flex; align-items: center; justify-content: center; border-radius: 10px;">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <div style="min-width: 0; flex: 1;">
                          <div style="font-weight: 750; font-size: 0.88rem; color: #111827; line-height: 1.3; margin-bottom: 3px;" title={doc.asunto}>{doc.asunto}</div>
                          <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 0.74rem; color: #64748B;">
                            <span>{(doc.solicitante_tipo === 'Docente' ? 'Profesor' : doc.solicitante_tipo) || 'Peticionario'} &bull; {doc.solicitante_nombre}</span>
                            {anexoPrincipal && (
                              <span
                                title={anexoPrincipal.nombre_archivo}
                                style="display: inline-flex; align-items: center; gap: 4px; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; border-radius: 6px; padding: 1px 7px; font-weight: 600; font-size: 0.70rem;"
                              >
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="flex-shrink: 0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{anexoPrincipal.nombre_archivo}</span>
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    </td>
                    <td style="vertical-align: middle; white-space: nowrap;">
                      <span class="radicado-chip">{doc.numero_radicado}</span>
                      <div style="margin-top: 4px; display: inline-flex; align-items: center; gap: 4px; background: #F7F5EE; border: 1px solid #DBD2B0; padding: 2px 6px; border-radius: 5px;">
                        <span style="font-family: monospace; font-size: 0.68rem; font-weight: 800; color: #786832;">PIN {doc.pin_acceso || '849201'}</span>
                        <button 
                          type="button" 
                          class="btn-copy-pin"
                          data-pin={doc.pin_acceso || '849201'}
                          title="Copiar PIN de 6 dígitos" 
                          style="border: none; background: transparent; cursor: pointer; color: #786832; padding: 0; display: inline-flex; align-items: center;"
                        >
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                      </div>
                    </td>
                    <td style="font-size: 0.8rem; vertical-align: middle; white-space: nowrap;">
                      <div style="color: #111827;">Rad: <strong>{doc.fecha_radicacion || '--'}</strong></div>
                      <div style="color: #64748B; font-size: 0.74rem;">Límite: {doc.fecha_limite_entrega}</div>
                    </td>
                    <td style="vertical-align: middle; min-width: 110px;">
                      <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.72rem; margin-bottom: 3px;">
                        <span style={`font-weight: 800; color: ${prog.color};`}>{prog.percentage}%</span>
                        <span style="color: #64748B; font-size: 0.68rem;">{prog.daysRemaining} días</span>
                      </div>
                      <div style="width: 100%; height: 5px; background: #E2E8F0; border-radius: 9999px; overflow: hidden;">
                        <div style={`width: ${prog.percentage}%; height: 100%; background: ${prog.color}; border-radius: 9999px;`}></div>
                      </div>
                    </td>
                    <td style="vertical-align: middle; white-space: nowrap;">
                      <span style="font-size: 0.78rem; font-weight: 700; color: #111827;">
                        {responsables.length} asignadas
                      </span>
                      <div style="font-size: 0.70rem; color: #786832;">Límite: {doc.fecha_limite_responsable}</div>
                    </td>
                    <td style="vertical-align: middle; white-space: nowrap;">
                      <span class="row-status-pill" style={`display: inline-flex; align-items: center; gap: 5px; white-space: nowrap !important; font-size: 0.72rem; font-weight: 750; padding: 4px 10px; border-radius: 999px; border: 1px solid ${isResponded ? '#B2CFCB' : '#DBD2B0'}; ${isResponded ? 'background: #F2F7F6; color: #00594E;' : 'background: #F7F5EE; color: #786832;'}`}>
                        <span style={`width: 6px; height: 6px; border-radius: 50%; background: ${isResponded ? '#00594E' : '#B5A160'}; flex-shrink: 0;`}></span>
                        <span>{isResponded ? 'Expediente Completo' : 'En Trámite'}</span>
                      </span>
                    </td>
                    <td style="text-align: right; white-space: nowrap; vertical-align: middle;">
                      <div style="display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px;">
                        <button type="button" class="btn btn-primary btn-sm btn-open-folder btn-abrir-carpeta" data-folder-id={doc.id} data-radicado={doc.numero_radicado} onclick={`window.openFolderDetail && window.openFolderDetail('${doc.id || doc.numero_radicado}')`} style="font-size: 0.75rem; font-weight: 750; cursor: pointer; padding: 6px 12px; border-radius: 8px; background: #00594E; border-color: #00594E; color: #FFFFFF;">
                          Abrir
                        </button>

                        <button 
                          type="button" 
                          class="btn-icon-action btn-edit-pet" 
                          data-id={doc.id} 
                          data-radicado={doc.numero_radicado}
                          data-asunto={doc.asunto}
                          data-solicitante={doc.solicitante_nombre}
                          data-tipo={doc.solicitante_tipo || 'Ciudadano'}
                          data-prioridad={doc.prioridad || 'Media'}
                          data-entrega={doc.fecha_limite_entrega}
                          data-estado={doc.estado || 'en_tramite'}
                          title="Editar Expediente"
                          style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #DBD2B0; background: #F7F5EE; color: #786832; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>

                        <button 
                          type="button" 
                          class="btn-icon-action btn-delete-pet" 
                          data-id={doc.id} 
                          data-radicado={doc.numero_radicado}
                          title="Eliminar Expediente"
                          style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;"
                        >
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- =========================================================================
         2. VISTA DEDICADA Y EXCLUSIVA DE CARPETA (ESTILO GOOGLE DRIVE)
         Ocupa el 100% de la pantalla reemplazando al listado de carpetas
         ========================================================================= -->
    <div id="explorer-folder-view" style="display: none; flex-direction: column; gap: 20px;">
      <!-- El contenido completo de la carpeta se inyecta dinámicamente vía TypeScript/JS -->
    </div>

  </div>

  <!-- Modal: Editar Petición desde Gestor de Archivos -->
  <div class="modal-backdrop" id="modal-edit-peticion" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 16px;">
    <div class="modal-card" style="background: #ffffff; width: 100%; max-width: 620px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); overflow: hidden;">
      <div style="background: var(--verde-principal); color: #ffffff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="edit-modal-title">Editar Carpeta / Radicado</span>
        </h3>
        <button type="button" id="btn-close-edit-modal" style="background: transparent; border: none; font-size: 1.5rem; color: #ffffff; cursor: pointer;">&times;</button>
      </div>

      <form id="form-edit-peticion" style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" id="edit-pet-id" />

        <div class="form-group">
          <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Asunto del Expediente *</label>
          <input type="text" id="edit-pet-asunto" required class="form-input" style="font-size: 0.88rem; font-weight: 600;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Solicitante *</label>
            <input type="text" id="edit-pet-solicitante" required class="form-input" />
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Tipo</label>
            <select id="edit-pet-tipo" class="form-select">
              <option value="Estudiante">Estudiante</option>
              <option value="Docente">Profesor</option>
              <option value="Egresado">Egresado</option>
              <option value="Ciudadano">Ciudadano</option>
              <option value="Ente de Control">Ente de Control</option>
              <option value="Entidad Gubernamental">Entidad Gubernamental</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Prioridad</label>
            <select id="edit-pet-prioridad" class="form-select">
              <option value="Baja">Baja</option>
              <option value="Media">Media</option>
              <option value="Alta">Alta</option>
            </select>
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Estado</label>
            <select id="edit-pet-estado" class="form-select">
