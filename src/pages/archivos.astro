    function renderComposerAnexosOpcionales(pet: PeticionExpediente | any) {
      const listContainer = document.getElementById('composer-anexos-list');
      const actionsGroup = document.getElementById('composer-anexos-actions-group');
      if (!listContainer) return;

      const respFinal = getRespuestaFinalFile(pet);
      const allAnexos = Array.isArray(pet.peticion_anexos) ? pet.peticion_anexos : [];

      // Extraer únicamente aportes de subcarpetas/oficinas (excluyendo la respuesta final y el documento base radicado)
      const anexosOficinas = allAnexos.filter((a: any) => {
        if (!a) return false;
        if (respFinal && (a.id === respFinal.id || a.storage_path === respFinal.storage_path)) return false;
        if (a.storage_path && a.storage_path.includes('/respuesta_final/')) return false;
        return Boolean(a.es_anexo_oficina || a.peticion_responsable_id || a.subcarpeta_id);
      });

      if (anexosOficinas.length === 0) {
        listContainer.innerHTML = `<div class="composer-anexos-empty">No hay aportes cargados en las subcarpetas de este expediente.</div>`;
        if (actionsGroup) actionsGroup.style.display = 'none';
        updateAnexosCountPill();
        return;
      }

      if (actionsGroup) actionsGroup.style.display = 'flex';

      const subcarpetas = filtrarSubcarpetasValidas(
        (pet.subcarpetas && pet.subcarpetas.length > 0)
          ? pet.subcarpetas
          : inferSubcarpetas(pet)
      ).sort((a: any, b: any) => {
        const na = String(a?.nombre ?? '').replace(/^subcarpeta\s+/i, '').trim();
        const nb = String(b?.nombre ?? '').replace(/^subcarpeta\s+/i, '').trim();
        return na.localeCompare(nb, 'es', { numeric: true, sensitivity: 'base' });
      });

      const responsables = Array.isArray(pet.peticion_responsables) ? pet.peticion_responsables : [];

      const { respuestaMeta } = separarRespuestaMeta(pet.instrucciones_anexos || '');
      const prevIncluded = Array.isArray(pet.respuesta_archivos_incluidos)
        ? pet.respuesta_archivos_incluidos
        : (Array.isArray(respuestaMeta?.files) ? respuestaMeta.files : []);
      const prevIncludedSet = new Set(prevIncluded.map((x: any) => String(x)));

      // Enriquecer cada anexo con el código de su subcarpeta y su dependencia
      const enriched = anexosOficinas.map((a: any) => {
        // Buscar subcarpeta correspondiente
        let matchedSub: any = null;
        if (a.subcarpeta_id) {
          matchedSub = subcarpetas.find((s: any) => String(s.id) === String(a.subcarpeta_id)) || null;
        }
        if (!matchedSub) {
          const cleanNameLower = String(a.nombre_archivo || '').toLowerCase();
          const pathLower = String(a.storage_path || '').toLowerCase();
          matchedSub = subcarpetas.find((s: any) => {
            const subClean = String(s.nombre || '').replace(/^subcarpeta\s+/i, '').trim().toLowerCase();
            if (!subClean) return false;
            const slug = subClean.replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
            return cleanNameLower.includes(`[${subClean}]`) ||
              cleanNameLower.includes(`[subcarpeta ${subClean}]`) ||
              (slug && pathLower.includes(`/${slug}/`));
          }) || null;
        }
        if (!matchedSub && a.peticion_responsable_id) {
          const respForSub = responsables.find((r: any) => String(r.id) === String(a.peticion_responsable_id));
          if (respForSub && respForSub.subcarpeta_id) {
            matchedSub = subcarpetas.find((s: any) => String(s.id) === String(respForSub.subcarpeta_id)) || null;
          }
        }
        if (!matchedSub && subcarpetas.length === 1) {
          matchedSub = subcarpetas[0];
        }

        const subCode = matchedSub
          ? String(matchedSub.nombre || '').replace(/^subcarpeta\s+/i, '').trim()
          : 'General';

        // Buscar dependencia correspondiente
        const matchedResp = responsables.find((r: any) =>
          (a.peticion_responsable_id && String(r.id) === String(a.peticion_responsable_id)) ||
          (matchedSub && r.subcarpeta_id && String(r.subcarpeta_id) === String(matchedSub.id))
        );
        let depName = 'Dependencia';
        if (matchedResp) {
          depName = Array.isArray(matchedResp.oficinas)
            ? (matchedResp.oficinas[0]?.nombre || 'Dependencia')
            : (matchedResp.oficinas?.nombre || 'Dependencia');
        } else {
          const depMatch = String(a.nombre_archivo || '').match(/\[Aporte de:\s*([^\]]+)\]/i);
          if (depMatch && depMatch[1]) depName = depMatch[1].trim();
        }

        // Nombre original limpio del archivo (quitando prefijos internos de subcarpeta/aporte si existen)
        const rawFilename = String(a.nombre_archivo || 'Documento_Anexo.pdf');
        const cleanFilename = rawFilename
          .replace(/^\[[^\]]+\]\s*/g, '')
          .replace(/^\[[^\]]+\]\s*/g, '')
          .trim() || rawFilename;

        const isChecked = prevIncludedSet.has(String(a.id)) || prevIncludedSet.has(String(a.storage_path));

        return {
          anexo: a,
          subCode,
          depName,
          cleanFilename,
          isChecked,
        };
      });

      // Ordenar estrictamente usando localeCompare numérico en subCode
      enriched.sort((x: any, y: any) => {
        const subCmp = String(x.subCode).localeCompare(String(y.subCode), 'es', { numeric: true, sensitivity: 'base' });
        if (subCmp !== 0) return subCmp;
        return String(x.cleanFilename).localeCompare(String(y.cleanFilename), 'es', { numeric: true, sensitivity: 'base' });
      });

      listContainer.innerHTML = enriched.map((item: any) => `
        <label class="pro-anexo-check-item">
          <div class="pro-anexo-left">
            <input
              type="checkbox"
              name="anexos_opcionales"
              value="${escapeHtml(item.anexo.id)}"
              class="pro-anexo-checkbox"
              ${item.isChecked ? 'checked' : ''}
            />
            <span class="pro-anexo-sub-badge">[${escapeHtml(item.subCode)} &middot; ${escapeHtml(item.depName)}]</span>
            <span class="pro-anexo-filename" title="${escapeHtml(item.cleanFilename)}">${escapeHtml(item.cleanFilename)}</span>
          </div>
          <span class="pro-anexo-size">${formatFileSize(item.anexo.tamano_bytes)}</span>
        </label>
      `).join('');

      listContainer.querySelectorAll('input[name="anexos_opcionales"]').forEach((chk) => {
        chk.addEventListener('change', updateAnexosCountPill);
      });

      updateAnexosCountPill();
    }

    document.getElementById('btn-anexos-select-all')?.addEventListener('click', () => {
      const listContainer = document.getElementById('composer-anexos-list');
      if (!listContainer) return;
      listContainer.querySelectorAll('input[name="anexos_opcionales"]').forEach((chk: any) => {
        chk.checked = true;
      });
      updateAnexosCountPill();
    });

    document.getElementById('btn-anexos-clear-all')?.addEventListener('click', () => {
      const listContainer = document.getElementById('composer-anexos-list');
      if (!listContainer) return;
      listContainer.querySelectorAll('input[name="anexos_opcionales"]').forEach((chk: any) => {
        chk.checked = false;
      });
      updateAnexosCountPill();
    });

    // Manejador Global de Subida de Respuesta Final Oficial (respetando nombre 100% original)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.btn-subir-respuesta-final, .btn-cambiar-respuesta-final') as HTMLElement | null;
      if (target) {
        const petId = target.getAttribute('data-peticion-id');
        if (petId) {
          currentUploadPetId = petId;
          if (inputSubirRespuestaFinal) {
            inputSubirRespuestaFinal.value = '';
            inputSubirRespuestaFinal.click();
          }
        }
      }
    });

    inputSubirRespuestaFinal?.addEventListener('change', async () => {
      const file = inputSubirRespuestaFinal.files?.[0];
      if (!file || !currentUploadPetId) return;

      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`Subiendo Respuesta Final Oficial (${file.name})...`, 'info');
      }

      try {
        const formData = new FormData();
        formData.append('peticion_id', currentUploadPetId);
        formData.append('archivo', file);

        const res = await fetch('/api/peticiones/subir-respuesta-final', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'No se pudo subir la respuesta final.');
        }

        const pet = peticionesMap.get(currentUploadPetId) || allPeticiones.find((p) => p.id === currentUploadPetId);
        if (pet) {
          pet.respuesta_archivo = data.archivo;
          if (!pet.peticion_anexos) pet.peticion_anexos = [];
          const existingIdx = pet.peticion_anexos.findIndex((a: any) => a.storage_path && a.storage_path.includes('/respuesta_final/'));
          if (existingIdx >= 0) {
            pet.peticion_anexos[existingIdx] = data.archivo;
          } else {
            pet.peticion_anexos.push(data.archivo);
          }
          indexPeticion(pet);

          // Si el modal está abierto, refrescar su tarjeta de adjunto
          if (responderModal && responderModal.style.display !== 'none' && responderPetIdInput?.value === currentUploadPetId) {
            renderComposerAdjunto(pet);
          }

          // Si la vista de detalle de la carpeta está activa, refrescarla al instante
          if (currentActiveFolderId === currentUploadPetId) {
            openFolderDetail(currentUploadPetId);
          }
        }

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(`Respuesta Final Oficial guardada exitosamente: "${file.name}"`, 'success');
        }
      } catch (uploadErr: any) {
        console.error('Error subiendo respuesta final:', uploadErr);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(uploadErr.message || 'Error al subir el archivo.', 'error');
        }
      }
    });

    function openResponderModal(petId: string) {
      const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
      if (!pet) return;

      if (responderPetIdInput) responderPetIdInput.value = pet.id;
      if (composerDispRadicado) composerDispRadicado.textContent = pet.numero_radicado || 'RAD-2026';
      if (composerDispSolNombre) composerDispSolNombre.textContent = pet.solicitante_nombre || 'Ciudadano(a)';
      if (responderEmailInput) {
        responderEmailInput.value = pet.solicitante_email || '';
        updateRecipientAvatar(pet.solicitante_email || '');
      }
      if (composerDispPinBadge) composerDispPinBadge.textContent = `PIN: ${pet.pin_acceso || '849201'}`;

      // Configurar remitente dinámico según usuario en sesión o cuenta institucional
      const currentUser = (window as any).currentLoggedUser;
      const senderEmail = currentUser?.email || 'notificaciones@unitropico.edu.co';
      const senderName = currentUser?.name || 'Gestión Documental Unitrópico';
      const senderAvatarImg = document.getElementById('composer-sender-avatar') as HTMLImageElement | null;
      const senderDisplay = document.getElementById('composer-sender-display');
      if (senderAvatarImg) {
        senderAvatarImg.src = `https://unavatar.io/google/${encodeURIComponent(senderEmail)}`;
      }
      if (senderDisplay) {
        senderDisplay.textContent = `${senderName} <${senderEmail}>`;
      }

      if (responderAsuntoInput) {
        const radStr = pet.numero_radicado || 'RAD-2026';
        const asuntoStr = pet.asunto || 'Petición Oficial';
        responderAsuntoInput.value = `Respuesta Oficial a su Petición Radicado N.° [${radStr}] - ${asuntoStr}`;
      }

      if (responderFuncionarioInput) {
        responderFuncionarioInput.value = pet.respuesta_funcionario || 'Oficina de Correspondencia y Gestión Documental';
      }

      const defaultMensaje = pet.respuesta_mensaje || `Estimado(a) ${pet.solicitante_nombre || 'solicitante'}, en atención a su comunicación oficial radicada bajo el N° ${pet.numero_radicado}, nos permitimos informarle formalmente que la Universidad Internacional del Trópico Americano ha emitido pronunciamiento de fondo.\n\nSe adjunta a la presente notificación el documento oficial de respuesta debidamente suscrito para los fines pertinentes.`;
      if (responderMensajeInput) {
        responderMensajeInput.value = defaultMensaje;
        updateComposerCharCount();
      }

      renderComposerAdjunto(pet);
      renderComposerAnexosOpcionales(pet);

      if (responderModal) responderModal.style.display = 'flex';
    }

    let isSubmittingRespuesta = false;
    formResponder?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      if (isSubmittingRespuesta) return;

      const petId = responderPetIdInput?.value || '';
      const email = responderEmailInput?.value.trim().toLowerCase() || '';
      const asunto = responderAsuntoInput?.value.trim() || '';
      const mensaje = responderMensajeInput?.value.trim() || '';
      const funcionario = responderFuncionarioInput?.value.trim() || '';
      const currentPet = petId ? (peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId)) : null;
      const driveUrl = currentPet?.respuesta_drive_url || null;
      const respFile = getRespuestaFinalFile(currentPet);

      if (!petId || !mensaje) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Por favor ingrese el texto de la respuesta oficial.', 'warning');
        }
        return;
      }

      if (!email || !email.includes('@')) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Por favor ingrese un correo válido para el solicitante.', 'warning');
        }
        return;
      }

      if (!respFile) {
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Debe cargar el archivo obligatorio de Respuesta Final Oficial antes de enviar.', 'warning');
        }
        return;
      }

      const anexosOpcionalesIds: string[] = Array.from(
        document.querySelectorAll('#composer-anexos-list input[name="anexos_opcionales"]:checked')
      ).map((el: any) => String(el.value || '').trim()).filter(Boolean);

      const submitBtn = document.getElementById('btn-submit-responder') as HTMLButtonElement | null;
      const submitText = document.getElementById('btn-submit-responder-text');

      isSubmittingRespuesta = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Enviando y notificando por correo...';
      }

      try {
        const res = await fetch('/api/peticiones/responder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            peticion_id: petId,
            solicitante_email: email,
            asunto,
            respuesta_mensaje: mensaje,
            respuesta_funcionario: funcionario,
            respuesta_drive_url: driveUrl,
            archivo_respuesta: respFile,
            anexos_opcionales: anexosOpcionalesIds,
            respuesta_archivos_incluidos: anexosOpcionalesIds,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Error: ' + (data.error || 'No se pudo enviar la respuesta'), 'error');
          }
          return;
        }

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Respuesta oficial despachada con éxito. Solicitante notificado por correo.', 'success');
        }
        closeResponder();

        // Actualizar peticion en el array local y recargar vista de la carpeta
        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          pet.estado = 'Respondida';
          pet.solicitante_email = email;
          pet.respuesta_mensaje = mensaje;
          pet.respuesta_funcionario = funcionario;
          pet.respuesta_fecha_envio = new Date().toISOString();
          pet.respuesta_expira_at = data.expira_at;
          pet.respuesta_pin_solicitante = data.pin_solicitante;
          pet.respuesta_drive_url = driveUrl || null;
          pet.respuesta_archivos_incluidos = anexosOpcionalesIds;

          indexPeticion(pet);
          openFolderDetail(petId);
        } else {
          setTimeout(() => window.location.reload(), 600);
        }
      } catch (err: any) {
        console.error('Error al despachar respuesta:', err);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error de red al despachar la respuesta oficial.', 'error');
        }
      } finally {
        isSubmittingRespuesta = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Enviar Respuesta Oficial';
        }
      }
    });

    // 7.3 Exportar Expediente a Google Drive (Estructura y Archivos sin comprimir)
    let isExportingDrive = false;
    async function handleExportToGoogleDrive(petId: string, radicado: string, clickedBtn: HTMLElement) {
      if (isExportingDrive) return;

      const allDriveBtns = document.querySelectorAll<HTMLButtonElement>(`.btn-export-drive[data-id="${petId}"]`);
      isExportingDrive = true;
      allDriveBtns.forEach((btn) => {
        btn.disabled = true;
        btn.innerHTML = `
          <svg class="spin-animation" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <span>Creando carpetas y subiendo archivos a Drive...</span>
        `;
      });

      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast(`Iniciando respaldo de ${radicado} en Google Drive...`, 'info', 'Procesando Respaldo');
      }

      let isSuccess = false;
      try {
        const res = await fetch('/api/exportar-drive', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ peticionId: petId }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.success) {
          if (data.missingConfig) {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(
                'Credenciales de Google Drive no configuradas en el servidor. Configure GOOGLE_DRIVE_CLIENT_ID, GOOGLE_DRIVE_CLIENT_SECRET y GOOGLE_DRIVE_REFRESH_TOKEN en el archivo .env o en Vercel.',
                'warning',
                'Aviso del Sistema'
              );
            }
          } else {
            const errorMsg = data.error || 'No se pudo exportar el expediente a Google Drive.';
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(errorMsg, 'error', 'Error de Exportación');
            }
          }
          return;
        }

        isSuccess = true;

        // Éxito: Actualizar en memoria el drive url
        const pet = peticionesMap.get(petId) || allPeticiones.find((p) => p.id === petId);
        if (pet) {
          pet.respuesta_drive_url = data.webViewLink;
          indexPeticion(pet);
        }

        // Mostrar notificación Toast flotante con acciones directas
        showDriveSuccessToast(radicado, data.webViewLink, data.archivosSubidos || 0, data.subcarpetasCreadas || 0);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(`¡Expediente ${radicado} respaldado exitosamente en Google Drive!`, 'success', 'Operación Exitosa');
        }

        allDriveBtns.forEach((btn) => {
          btn.innerHTML = `
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00594E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Respaldado en Drive</span>
          `;
          btn.style.background = '#E6EFEF';
          btn.style.borderColor = '#00594E';
          btn.style.color = '#00594E';
        });
      } catch (err: any) {
        console.error('Error al exportar a Google Drive:', err);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Error de comunicación con el servicio de Google Drive.', 'error', 'Error de Conexión');
        }
      } finally {
        isExportingDrive = false;
        allDriveBtns.forEach((btn) => {
          btn.disabled = false;
          if (!isSuccess) {
            btn.innerHTML = `
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><polyline points="12 11 12 17"/><polyline points="9 14 12 11 15 14"/></svg>
              <span>Respaldar en Drive</span>
            `;
            btn.style.background = '#F2F7F6';
            btn.style.borderColor = '#00594E';
            btn.style.color = '#00594E';
          }
        });
      }
    }

    function showDriveSuccessToast(radicado: string, webViewLink: string, archivosCount: number, subcarpetasCount: number) {
      const toast = document.getElementById('drive-success-toast');
      const openBtn = document.getElementById('btn-drive-open-link') as HTMLAnchorElement | null;
      const copyBtn = document.getElementById('btn-drive-copy-link');
      const copyText = document.getElementById('btn-drive-copy-text');
      const msg = document.getElementById('drive-toast-message');

      if (!toast) return;

      if (openBtn) openBtn.href = webViewLink;
      if (msg) {
        msg.textContent = `Se ha creado en Google Drive la carpeta "${radicado}" con ${archivosCount} archivo(s) organizados en ${subcarpetasCount} subcarpeta(s) sin comprimir.`;
      }

      if (copyBtn) {
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(webViewLink);
            if (copyText) copyText.textContent = '¡Enlace Copiado!';
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copiar Enlace';
            }, 3000);
          } catch {
            alert('Enlace de Drive: ' + webViewLink);
          }
        };
      }

      const closeBtn = document.getElementById('btn-close-drive-toast');
      if (closeBtn) {
        closeBtn.onclick = () => {
          toast.style.display = 'none';
        };
      }

      toast.style.display = 'block';
    }

    // 8. Auto-abrir carpeta si viene parámetro ?radicado=... o ?id=... en la URL
    const urlParams = new URLSearchParams(window.location.search);
    const targetQuery = urlParams.get('radicado') || urlParams.get('folderId') || urlParams.get('id');
    if (targetQuery) {
      openFolderDetail(targetQuery);
    }
  </script>
</AppLayout>
