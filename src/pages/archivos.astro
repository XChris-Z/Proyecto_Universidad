---
// src/pages/archivos.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
import { calculateDeadlineProgress } from '@lib/utils';

// Consultar peticiones y anexos reales en base de datos PostgreSQL
const { data: dbPeticiones } = await (supabase
  .from('peticiones' as any)
  .select(`
    id,
    numero_radicado,
    asunto,
    descripcion,
    solicitante_nombre,
    solicitante_tipo,
    fecha_radicacion,
    fecha_limite_entrega,
    fecha_limite_responsable,
    storage_folder_path,
    estado,
    prioridad,
    peticion_anexos (
      id,
      nombre_archivo,
      storage_file_path,
      tamano_bytes,
      mime_type,
      es_anexo_oficina,
      created_at
    ),
    peticion_responsables (
      id,
      codigo_acceso,
      estado_entrega,
      fecha_entrega,
      oficinas (
        nombre,
        email_institucional
      )
    )
  `)
  .order('created_at', { ascending: false }) as any);

const peticiones = dbPeticiones || [];
const totalCount = peticiones.length;
const pendingCount = peticiones.filter((p: any) => p.estado !== 'respondida' && p.estado !== 'completada').length;
const respondedCount = peticiones.filter((p: any) => p.estado === 'respondida' || p.estado === 'completada').length;

let safeCount = 0;
let warnCount = 0;
let criticalCount = 0;

peticiones.forEach((p: any) => {
  const prog = calculateDeadlineProgress(p.fecha_radicacion, p.fecha_limite_entrega);
  if (prog.percentage < 50) safeCount++;
  else if (prog.percentage <= 80) warnCount++;
  else criticalCount++;
});
---

<AppLayout title="Módulo de Archivos y Gestión Documental" activeNav="archivos">
  <div class="section-toolbar">
    <div class="filter-tabs" id="archivos-filter-tabs">
      <button class="filter-tab active" data-filter="all">
        <span>Todos</span>
        <span class="filter-count" id="count-all">{totalCount}</span>
      </button>
      <button class="filter-tab" data-filter="pending">
        <span class="dist-dot" style="background: var(--dorado-oscuro);"></span>
        <span>En Trámite</span>
        <span class="filter-count" id="count-pending">{pendingCount}</span>
      </button>
      <button class="filter-tab" data-filter="responded">
        <span class="dist-dot" style="background: var(--verde-principal);"></span>
        <span>Respondidas</span>
        <span class="filter-count" id="count-responded">{respondedCount}</span>
      </button>
      <button class="filter-tab" data-filter="safe">
        <span class="dist-dot" style="background: #10B981;"></span>
        <span>En Plazo</span>
        <span class="filter-count" id="count-safe">{safeCount}</span>
      </button>
      <button class="filter-tab" data-filter="warn">
        <span class="dist-dot" style="background: #F59E0B;"></span>
        <span>Por Vencer</span>
        <span class="filter-count" id="count-warn">{warnCount}</span>
      </button>
      <button class="filter-tab" data-filter="critical">
        <span class="dist-dot" style="background: #EF4444;"></span>
        <span>Críticos (&gt;80%)</span>
        <span class="filter-count" id="count-critical">{criticalCount}</span>
      </button>
    </div>

    <div>
      <a href="/peticiones/subir" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        <span>+ Subir Petición / Archivo</span>
      </a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="doc-table">
      <thead>
        <tr>
          <th>Archivo / Petición</th>
          <th>Radicado</th>
          <th>Fechas (Radicación - Plazo)</th>
          <th>Plazo de Vencimiento (SLA)</th>
          <th>Responsables Asignados</th>
          <th>Estado Trámite</th>
          <th style="text-align: right;">Acciones</th>
        </tr>
      </thead>
      <tbody id="documents-table-body">
        {peticiones.length > 0 ? (
          peticiones.map((doc: any) => {
            const prog = calculateDeadlineProgress(doc.fecha_radicacion, doc.fecha_limite_entrega);
            const isResponded = doc.estado === 'respondida' || doc.estado === 'completada';
            const anexoPrincipal = doc.peticion_anexos?.find((a: any) => !a.es_anexo_oficina) || doc.peticion_anexos?.[0];
            const responsables = doc.peticion_responsables || [];
            const filterSla = prog.percentage > 80 ? 'critical' : prog.percentage >= 50 ? 'warn' : 'safe';

            return (
              <tr class="doc-row" data-status={isResponded ? 'responded' : 'pending'} data-sla={filterSla}>
                <td>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="doc-icon-badge pdf" style="width: 34px; height: 34px; font-size: 0.68rem; background: var(--verde-suave-bg); color: var(--verde-principal); border: 1px solid var(--verde-borde); display: flex; align-items: center; justify-content: center; border-radius: 6px;">
                      <span style="font-weight: 800;">DOC</span>
                    </div>
                    <div>
                      <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">{doc.asunto}</div>
                      <div style="font-size: 0.74rem; color: var(--text-muted);">
                        {doc.solicitante_tipo || 'Peticionario'} &bull; {doc.solicitante_nombre}
                        {anexoPrincipal && (
                          <span style="color: var(--verde-principal); font-weight: 600; margin-left: 6px;">
                            📎 {anexoPrincipal.nombre_archivo}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <span style="font-family: monospace; font-size: 0.82rem; font-weight: 700; color: var(--verde-principal); background: var(--verde-suave-bg); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--verde-borde);">
                    {doc.numero_radicado}
                  </span>
                </td>
                <td>
                  <div style="font-size: 0.78rem;">
                    <div>Rad: <strong>{doc.fecha_radicacion}</strong></div>
                    <div style="color: var(--text-muted);">Vence: {doc.fecha_limite_entrega}</div>
                  </div>
                </td>
                <td>
                  <div style="min-width: 140px;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.74rem; margin-bottom: 3px;">
                      <span class={`badge ${prog.statusClass}`} style="font-size: 0.68rem; padding: 1px 6px; border-radius: 4px;">
                        {prog.statusBadge}
                      </span>
                      <span>{prog.percentage}%</span>
                    </div>
                    <div class="dist-progress-bg" style="height: 6px;">
                      <div class="dist-progress-fill" style={`width: ${prog.percentage}%; background: ${prog.percentage > 80 ? 'var(--status-critical)' : prog.percentage > 50 ? 'var(--status-warn)' : 'var(--status-safe)'};`}></div>
                    </div>
                  </div>
                </td>
                <td>
                  {responsables.length > 0 ? (
                    <div style="display: flex; flex-direction: column; gap: 3px;">
                      {responsables.map((r: any) => (
                        <div style="font-size: 0.78rem; color: var(--text-main); display: flex; align-items: center; gap: 4px;">
                          <span style={`width: 6px; height: 6px; border-radius: 50%; background: ${r.estado_entrega === 'entregado' ? 'var(--verde-principal)' : 'var(--dorado-principal)'};`}></span>
                          <span>{r.oficinas?.nombre || 'Oficina'}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <span style="font-size: 0.75rem; color: var(--text-muted);">Sin oficina asignada</span>
                  )}
                </td>
                <td>
                  <span class={`badge-response-status ${isResponded ? 'responded' : 'pending'}`} style="font-size: 0.72rem; padding: 4px 8px; border-radius: 4px;">
                    {isResponded ? '✓ Respondida' : '⏳ En Trámite'}
                  </span>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px;">
                    <a href="/peticiones" class="btn btn-ghost btn-sm" title="Ver detalle de petición en Radicados" style="text-decoration: none;">
                      Ver Radicado
                    </a>
                    {anexoPrincipal?.storage_file_path && (
                      <a href={`https://irjjpjtvhxoakiazfswn.supabase.co/storage/v1/object/public/peticiones/${anexoPrincipal.storage_file_path}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="Descargar anexo principal" style="text-decoration: none;">
                        Descargar
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            );
          })
        ) : (
          <tr>
            <td colspan="7" style="text-align: center; padding: 48px 16px; color: var(--text-muted);">
              <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--verde-principal);"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <strong style="font-size: 1rem; color: var(--text-main);">No hay expedientes ni archivos radicados</strong>
                <p style="font-size: 0.85rem; max-width: 450px; margin: 0 auto;">El archivo central se encuentra limpio. Puede radicar una nueva petición con su soporte documental para iniciar un expediente oficial.</p>
                <a href="/peticiones/subir" class="btn btn-primary btn-sm" style="margin-top: 8px; text-decoration: none;">+ Radicar Primer Archivo</a>
              </div>
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AppLayout>

<script>
  // Filtrado de pestañas en la vista de archivos
  const filterTabs = document.querySelectorAll('#archivos-filter-tabs .filter-tab');
  const rows = document.querySelectorAll('.doc-row') as NodeListOf<HTMLTableRowElement>;

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.getAttribute('data-filter') || 'all';

      rows.forEach(row => {
        const status = row.getAttribute('data-status');
        const sla = row.getAttribute('data-sla');

        if (filter === 'all') {
          row.style.display = '';
        } else if (filter === 'pending') {
          row.style.display = status === 'pending' ? '' : 'none';
        } else if (filter === 'responded') {
          row.style.display = status === 'responded' ? '' : 'none';
        } else if (filter === 'safe' || filter === 'warn' || filter === 'critical') {
          row.style.display = sla === filter ? '' : 'none';
        }
      });
    });
  });
</script>
