        // Parsear instrucciones_anexos y extraer metadata de respuesta
        const { textoLimpio: rawInstrucciones, respuestaMeta } = separarRespuestaMeta(peticion.instrucciones_anexos || peticion.descripcion || '');
        const anexos = Array.isArray(peticion.peticion_anexos) ? peticion.peticion_anexos : [];
        const respObj = peticion.respuesta_archivo || respuestaMeta?.archivo_respuesta || respuestaMeta?.respuesta_archivo || null;
        let anexoRespuestaFinal: any = null;
        if (respObj && (respObj.storage_path || respObj.nombre_archivo)) {
          anexoRespuestaFinal = respObj;
        } else {
          anexoRespuestaFinal = anexos.find((a: any) => a && a.storage_path && a.storage_path.includes('/respuesta_final/')) || null;
        }

        const anexoPrincipal = anexos.find((a: any) => a && !a.es_anexo_oficina && (!anexoRespuestaFinal || (a.id !== anexoRespuestaFinal.id && a.storage_path !== anexoRespuestaFinal.storage_path))) || (anexos[0] && (!anexoRespuestaFinal || (anexos[0].id !== anexoRespuestaFinal.id && anexos[0].storage_path !== anexoRespuestaFinal.storage_path)) ? anexos[0] : null);
        const anexosOficinas = anexos.filter((a: any) => a && a.es_anexo_oficina);
        const responsables = Array.isArray(peticion.peticion_responsables) ? peticion.peticion_responsables : [];

        // Calcular SLA
        let slaPct = 0;
        let daysRemaining = 0;
        let slaColor = '#16a34a';
        try {
          const startStr = peticion.fecha_radicacion || peticion.created_at || '';
          const endStr = peticion.fecha_limite_entrega || '';
          const start = startStr ? new Date(startStr).getTime() : NaN;
          const end = endStr ? new Date(endStr).getTime() : NaN;
          const now = Date.now();
          if (!isNaN(start) && !isNaN(end) && end > start) {
            const totalDays = Math.max(1, Math.round((end - start) / 86400000));
            const elapsed = Math.max(0, Math.round((now - start) / 86400000));
            daysRemaining = Math.max(0, Math.round((end - now) / 86400000));
            slaPct = Math.min(100, Math.round((elapsed / totalDays) * 100));
            if (daysRemaining <= 2) {
              slaColor = '#dc2626';
