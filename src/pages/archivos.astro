  <style is:global>
    /* Estilos Globales para elementos dinámicos del Modal de Respuesta al Solicitante */
    .modal-file-item,
    .responder-file-card {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 14px !important;
      padding: 14px 18px !important;
      margin-bottom: 10px !important;
      background: #F2F7F6;
      border: 1.5px solid #00594E;
      border-radius: 12px !important;
      cursor: pointer !important;
      transition: all 0.2s ease !important;
      user-select: none !important;
      box-sizing: border-box !important;
      width: 100% !important;
    }

    .modal-file-item.selected,
    .responder-file-card.selected,
    .modal-file-item:has(input[type="checkbox"]:checked),
    .responder-file-card:has(input[type="checkbox"]:checked) {
      background: #F2F7F6 !important;
      border-color: #00594E !important;
      box-shadow: 0 2px 6px rgba(0, 89, 78, 0.05) !important;
      opacity: 1 !important;
    }

    .modal-file-item:not(.selected):not(:has(input[type="checkbox"]:checked)),
    .responder-file-card:not(.selected):not(:has(input[type="checkbox"]:checked)) {
      background: #FFFFFF !important;
      border-color: #DCE4E3 !important;
      box-shadow: none !important;
      opacity: 0.75 !important;
    }

    .modal-file-item:hover,
    .responder-file-card:hover {
      border-color: #00594E !important;
    }

    .modal-file-item input[type="checkbox"],
    .responder-file-checkbox {
      accent-color: #00594E !important;
      width: 19px !important;
      height: 19px !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
      margin: 0 !important;
    }

    .file-status-pill {
      display: inline-flex !important;
      align-items: center !important;
      gap: 5px !important;
      padding: 4px 10px !important;
      border-radius: 8px !important;
      font-size: 0.75rem !important;
      font-weight: 700 !important;
      flex-shrink: 0 !important;
      transition: all 0.2s ease !important;
    }

    /* Estilos Pro Max para Píldoras de Dependencias con Semáforo (Verde = Entregado / Rojo = Pendiente) */
    .subcarpeta-deps-row {
      display: inline-flex !important;
      align-items: center !important;
      flex-wrap: wrap !important;
      gap: 6px !important;
      margin-left: 4px !important;
    }

    .dep-status-pill {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      padding: 3px 10px !important;
      border-radius: 999px !important;
      font-size: 0.74rem !important;
      font-weight: 700 !important;
      line-height: 1.2 !important;
      letter-spacing: 0.01em !important;
      white-space: nowrap !important;
      transition: all 0.2s ease !important;
    }

    .dep-status-dot {
      width: 7px !important;
      height: 7px !important;
      border-radius: 50% !important;
      flex-shrink: 0 !important;
    }

    /* ESTADO VERDE: YA ENTREGÓ SU APORTE */
    .dep-status-pill.is-delivered {
      background-color: #E6F4EA !important;
      color: #00594E !important;
      border: 1px solid #86EFAC !important;
    }
    .dep-status-pill.is-delivered .dep-status-dot {
      background-color: #00594E !important;
      box-shadow: 0 0 0 2px rgba(0, 89, 78, 0.18) !important;
    }

    /* ESTADO ROJO: NO HA ENTREGADO (PENDIENTE) */
    .dep-status-pill.is-pending {
      background-color: #FEF2F2 !important;
      color: #B91C1C !important;
      border: 1px solid #FCA5A5 !important;
    }
    .dep-status-pill.is-pending .dep-status-dot {
      background-color: #DC2626 !important;
      box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.18) !important;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .spin-animation {
      animation: spin 1s linear infinite !important;
    }

    @keyframes slideUpToast {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes proMaxCrossfade {
      from { opacity: 0; transform: translateY(6px) scale(0.992); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .composer-modal-card {
      animation: proMaxCrossfade 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .composer-clean-input {
      flex: 1;
      border: 1.5px solid #DCE4E3;
      border-radius: 8px;
      padding: 7px 12px;
      font-size: 0.82rem;
      color: #111827;
      font-weight: 600;
      outline: none;
      background: #FFFFFF;
      font-family: inherit;
      transition: all 0.2s ease;
    }

    .composer-clean-input:focus {
      border-color: #00594E;
      box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
    }

    .composer-clean-textarea {
      width: 100%;
      border: 1.5px solid #DCE4E3;
      border-radius: 10px;
      padding: 13px 15px;
      font-size: 0.86rem;
      line-height: 1.6;
      color: #111827;
      resize: vertical;
      box-sizing: border-box;
      outline: none;
      font-family: inherit;
      background: #FFFFFF;
      transition: all 0.2s ease;
    }

    .composer-clean-textarea:focus {
      border-color: #00594E;
      box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
    }

    /* Bloque 2 de Adjuntos: Anexos de Dependencias Opcionales con Checkboxes */
