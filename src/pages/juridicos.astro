---
// src/pages/juridicos.astro
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout title="Asuntos Jurídicos y Normativos" activeNav="juridicos">
  <div class="panel-box">
    <div class="panel-header" style="flex-wrap: wrap; gap: 14px;">
      <div>
        <div class="panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
          <span>Asuntos Jurídicos y Normativos</span>
        </div>
        <div style="font-size: 0.8rem; color: var(--secondary-light); font-weight: 600; margin-top: 4px;">
          Oficina Asesora Jurídica: Conceptos, Litigios, Auditorías, Directivas, Circulares y Seguimiento a Obligaciones Internas
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button class="btn btn-primary" id="btn-open-gap-modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>+ Proponer Normativa Faltante</span>
        </button>
      </div>
    </div>

    <!-- Pestañas del Módulo Jurídico -->
    <div class="module-tabs" id="juridicos-module-tabs">
      <button class="module-tab-btn active" data-jtab="brechas">
        <span>⚡ Brechas Normativas (Legal Gap)</span>
        <span class="tab-count" id="jcount-brechas">5</span>
      </button>
      <button class="module-tab-btn" data-jtab="conceptos">
        <span>Conceptos (Internos y Externos)</span>
        <span class="tab-count" id="jcount-conceptos">5</span>
      </button>
      <button class="module-tab-btn" data-jtab="litigios">
        <span>Litigios y Asuntos Judiciales</span>
        <span class="tab-count" id="jcount-litigios">4</span>
      </button>
      <button class="module-tab-btn" data-jtab="auditorias">
        <span>Auditorías de Entes de Control</span>
        <span class="tab-count" id="jcount-auditorias">3</span>
      </button>
      <button class="module-tab-btn" data-jtab="directivas">
        <span>Directivas y Circulares</span>
        <span class="tab-count" id="jcount-directivas">5</span>
      </button>
    </div>

    <div id="juridicos-tab-content" style="margin-top: 18px;">
      <!-- Dinámico desde JS según pestaña activa -->
    </div>
  </div>

  <!-- Modal: Proponer Normativa Faltante -->
  <div class="modal-backdrop" id="new-gap-modal" style="display: none;">
    <div class="modal-card" style="max-width: 620px;">
      <div class="modal-header">
        <h3>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Procesar y Formular Normativa Faltante</span>
        </h3>
        <button class="btn-close-modal" id="btn-close-gap-modal">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Norma Requerida *</label>
          <input type="text" class="form-input" placeholder="Ej: Política de Ciberseguridad Institucional">
        </div>
        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Mandato Nacional / Ley</label>
            <input type="text" class="form-input" placeholder="Ej: Ley 1581 de 2012">
          </div>
          <div class="form-group">
            <label class="form-label">Órgano Competente</label>
            <select class="form-select">
              <option>Consejo Superior Universitario</option>
              <option>Consejo Académico</option>
              <option>Rectoría</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Justificación Jurídica</label>
          <textarea class="form-textarea" rows="3" placeholder="Sustento del vacío legal o normativo..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="btn-cancel-gap">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="window.showToast('Propuesta de brecha normativa registrada'); document.getElementById('new-gap-modal').style.display='none';">
          Registrar Formulación
        </button>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { initJuridicos } from '@scripts/juridicos';
  initJuridicos();
</script>

