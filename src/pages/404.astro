---
// src/pages/404.astro
import Layout from '@layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada | SGD Unitrópico">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #063A34 0%, #00594E 60%, #0d2723 100%); padding: 24px;">
    <div style="max-width: 520px; width: 100%; background: #ffffff; border-radius: 16px; padding: 48px 36px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);">
      <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(0, 89, 78, 0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; color: var(--primary);">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>

      <div style="font-size: 3.5rem; font-weight: 900; color: var(--primary); line-height: 1; margin-bottom: 12px; letter-spacing: -1px;">
        404
      </div>

      <h1 style="font-size: 1.35rem; font-weight: 800; color: #1e293b; margin-bottom: 12px;">
        Expediente o Vista No Encontrada
      </h1>

      <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 28px;">
        El radicado, recurso institucional o página a la que intentas acceder no existe en el repositorio oficial o ha sido archivada.
      </p>

      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/dashboard" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Ir al Panel de Control</span>
        </a>
        <a href="/archivos" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px;">
          <span>Explorar Archivos TRD</span>
        </a>
      </div>

      <div style="margin-top: 36px; padding-top: 20px; border-top: 1px solid #e2e8f0; font-size: 0.75rem; color: #94a3b8; font-weight: 600;">
        SISTEMA DE GESTIÓN DOCUMENTAL Y GOBIERNO INSTITUCIONAL &bull; UNITRÓPICO
      </div>
    </div>
  </div>
</Layout>

