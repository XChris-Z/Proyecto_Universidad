                                <span class="inst-block-label">Planeación CSU</span>
                                <span class="inst-block-pill green">
                                  {dashSnap.ultimoInformePlaneacion ? dashSnap.ultimoInformePlaneacion.ejecucionFormatted : '0%'}
                                </span>
                              </div>
                              {
                                dashSnap.ultimoInformePlaneacion ? (
                                  <>
                                    <div class="inst-block-title">{dashSnap.ultimoInformePlaneacion.periodo}</div>
                                    <div class="inst-block-meta">
                                      Rad. CSU: {dashSnap.ultimoInformePlaneacion.radicado_csu} &bull; {dashSnap.ultimoInformePlaneacion.estado}
                                    </div>
                                    <div class="dist-progress-bg promax-track" style="margin-top: 8px;">
                                      <div
                                        class="dist-progress-fill safe-fill"
                                        style={`width: ${Math.min(100, Math.max(4, dashSnap.ultimoInformePlaneacion.ejecucion_pct))}%;`}
                                      ></div>
                                    </div>
                                  </>
                                ) : (
                                  <div class="inst-block-meta">Sin informes de planeación registrados.</div>
                                )
                              }
                            </a>
                          )
                        }

                        {
                          canConvenios && (
                            <a href="/relacionamiento" class="inst-summary-block">
                              <div class="inst-block-top">
                                <span class="inst-block-label">Convenios en Ejecución ({dashSnap.conveniosActivosCount})</span>
                                <span class="inst-block-pill teal tabular-nums">{dashSnap.conveniosCuantiaFormateada}</span>
                              </div>
                              {
                                (() => {
                                  const topConv = dashSnap.conveniosAlertas[0];
                                  return topConv ? (
                                    <>
                                      <div class="inst-block-title">
                                        {topConv.entidad} (#{topConv.numero})
                                      </div>
                                      <div class="inst-block-meta">
                                        {topConv.tipo_label} &bull; Fin: {topConv.fin}
                                        {dashSnap.conveniosProximosVencerCount > 0 && ` • ${dashSnap.conveniosProximosVencerCount} próx. vencer`}
                                      </div>
                                    </>
                                  ) : (
                                    <div class="inst-block-meta">Sin convenios activos registrados.</div>
                                  );
                                })()
                              }
                            </a>
