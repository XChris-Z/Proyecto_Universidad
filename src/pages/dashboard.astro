---
// src/pages/dashboard.astro
// Panel de Control Rectoral UI/UX Pro Max con Bento Grid, Crossfade y Shared Element Transitions
import AppLayout from "@layouts/AppLayout.astro";
import { supabase } from "@lib/supabase";
import { calculateDeadlineProgress } from "@lib/utils";
import { isPeticionRespondida } from "@lib/subcarpetas";

// 1. Consultar peticiones reales en base de datos PostgreSQL
const { data: dbPeticiones } = await (supabase
  .from("peticiones" as any)
  .select(
    `
    id,
    numero_radicado,
    asunto,
    solicitante_nombre,
    solicitante_tipo,
    fecha_radicacion,
    fecha_limite_entrega,
    fecha_limite_responsable,
    estado,
    prioridad,
    instrucciones_anexos,
    respuesta_mensaje,
    respuesta_fecha_envio,
    respuesta_pin_solicitante,
    peticion_anexos ( id, subcarpeta, nombre_archivo ),
    peticion_responsables (
      id,
      estado_entrega,
      oficinas ( nombre )
    )
  `,
  )
  .order("created_at", { ascending: false }) as any);

const { data: dbAuditRespuestas } = await (supabase
  .from("audit_logs" as any)
  .select("entity_id, details")
  .eq("action_type", "RESPUESTA")
  .limit(400) as any);

const auditRespuestas = dbAuditRespuestas || [];

// 2. Consultar normas de cuerpos colegiados reales
const { data: dbNormas } = await (supabase
  .from("colegiados_normas" as any)
  .select("id, organo, tipo, numero, year, fecha, titulo, descriptor, vigencia")
  .order("created_at", { ascending: false }) as any);

// 3. Consultar convenios institucionales reales
const { data: dbConvenios } = await (supabase
  .from("convenios" as any)
  .select("id, tipo, numero, entidad, estado")
  .order("created_at", { ascending: false }) as any);

const peticiones = (dbPeticiones || []).map((p: any) => {
  const auditMatch = auditRespuestas.some(
    (log: any) =>
      String(log.entity_id || "") === String(p.id) ||
      (p.numero_radicado && String(log.details || "").includes(String(p.numero_radicado))),
  );
  const enriched = {
    ...p,
    tiene_respuesta_audit: auditMatch,
  };
  return {
    ...enriched,
    respondida: isPeticionRespondida(enriched),
  };
});
const normas = dbNormas || [];
const convenios = dbConvenios || [];

const totalPeticiones = peticiones.length;
const totalNormas = normas.length;
const totalConvenios = convenios.length;

const totalPendientes = peticiones.filter((p: any) => !p.respondida).length;
const totalRespondidas = peticiones.filter((p: any) => p.respondida).length;
const responseRate =
  totalPeticiones > 0
    ? Math.round((totalRespondidas / totalPeticiones) * 100)
    : 0;

let slaSafe = 0;
let slaWarn = 0;
let slaDanger = 0;

peticiones
  .filter((p: any) => !p.respondida)
  .forEach((p: any) => {
    const prog = calculateDeadlineProgress(
      p.fecha_radicacion,
      p.fecha_limite_entrega,
    );
    if (prog.percentage < 50) slaSafe++;
    else if (prog.percentage <= 80) slaWarn++;
    else slaDanger++;
  });

const slaSafePct =
  totalPendientes > 0 ? Math.round((slaSafe / totalPendientes) * 100) : 100;
const slaWarnPct =
  totalPendientes > 0 ? Math.round((slaWarn / totalPendientes) * 100) : 0;
const slaDangerPct =
  totalPendientes > 0 ? Math.round((slaDanger / totalPendientes) * 100) : 0;

const urgentPeticiones = peticiones
  .filter((p: any) => !p.respondida)
  .slice(0, 6)
  .map((doc: any) => {
    const progress = calculateDeadlineProgress(
      doc.fecha_radicacion,
      doc.fecha_limite_entrega,
    );
    let statusCategory = "danger";
    if (progress.percentage < 50) {
      statusCategory = "safe";
    } else if (progress.percentage <= 80) {
      statusCategory = "warn";
    }
    return {
      ...doc,
      progress,
      statusCategory,
    };
  });
const recentNormas = normas.slice(0, 3);

// Cálculo del medidor circular SVG para tasa de respuesta
const gaugeRadius = 38;
const gaugeCircumference = 2 * Math.PI * gaugeRadius;
const gaugeOffset = gaugeCircumference - (gaugeCircumference * responseRate) / 100;
---

<AppLayout title="Dashboard — Panel de Control Rectoral" activeNav="dashboard">
  <div class="dash-promax-workspace">

    <!-- ================================================================= -->
    <!-- SECCIÓN A: BENTO HERO EJECUTIVO "CENTRO DE MANDO INSTITUCIONAL"  -->
    <!-- ================================================================= -->
    <header class="hero-banner bento-hero-promax">
      <div class="hero-ambient-glow"></div>
      
      <div class="hero-content">
        <div class="hero-live-badge">
          <span class="live-radar-dot"></span>
          <span class="live-badge-text">Sincronización Institucional Activa</span>
          <span class="live-badge-divider">&bull;</span>
          <span class="live-badge-sub">Despacho Rectoral Unitrópico</span>
        </div>
        <h2 class="hero-title">Centro de Mando Institucional</h2>
        <p class="hero-desc">
          Monitoreo integral de gobierno universitario: cuerpos colegiados, convenios interinstitucionales, radicación oficial de peticiones y control de términos de la Universidad Internacional del Trópico Americano.
        </p>
      </div>

      <div class="hero-actions-container">
        <!-- Indicador Maestro de Términos en Plazo SLA -->
        <a
          href="/calendario"
          class="hero-pill glass-capsule hero-sla-card"
          title="Ver cumplimiento de términos SLA en Calendario Institucional"
        >
          <div class="capsule-icon-wrap mint">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="number tabular-nums" id="quick-sla-compliance">
            {slaSafePct}%
          </div>
          <div class="label">Cumplimiento SLA &bull; Términos en Plazo</div>
        </a>

        <!-- Preservación segura de IDs DOM sin impacto visual -->
        <div style="display: none;" aria-hidden="true">
          <span id="quick-total-peticiones">{totalPeticiones}</span>
          <span id="quick-total-normas">{totalNormas}</span>
          <span id="quick-total-convenios">{totalConvenios}</span>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- SECCIÓN B: GRILLA DE LOS 6 KPIS EJECUTIVOS (BENTO CARDS PRO MAX) -->
    <!-- ================================================================= -->
    <section class="kpi-grid-6 bento-kpi-grid" aria-label="Indicadores Clave de Gestión">
      
      <!-- 1. Peticiones y Radicados -->
      <a
        href="/peticiones"
        class="kpi-card bento-kpi-card gold interactive"
        title="Ir al módulo de Peticiones y Expedientes"
      >
        <div class="kpi-accent-bar gold"></div>
        <div class="kpi-header">
          <span class="kpi-title">Peticiones / Expedientes</span>
          <div class="kpi-icon-wrap gold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-docs">{totalPeticiones}</div>
          <span class="kpi-trend-badge warning" id="kpi-pending-docs">
            {totalPendientes} Pendientes
          </span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Eficacia Institucional</span>
          <span class="footer-val gold" id="kpi-response-rate">{responseRate}% Resuelto</span>
        </div>
      </a>

      <!-- 2. Cuerpos Colegiados -->
      <a
        href="/normas"
        class="kpi-card bento-kpi-card emerald interactive"
        title="Ir a Cuerpos Colegiados"
      >
        <div class="kpi-accent-bar emerald"></div>
        <div class="kpi-header">
          <span class="kpi-title">Cuerpos Colegiados</span>
          <div class="kpi-icon-wrap emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-normas">{totalNormas}</div>
          <span class="kpi-trend-badge success">CSU &bull; CA &bull; Rec</span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Actos Sistematizados</span>
          <span class="footer-val emerald">100% Vigentes</span>
        </div>
      </a>

      <!-- 3. Relacionamiento y Convenios -->
      <a
        href="/relacionamiento"
        class="kpi-card bento-kpi-card teal interactive"
        title="Ir a Relacionamiento Institucional y Convenios"
      >
        <div class="kpi-accent-bar teal"></div>
        <div class="kpi-header">
          <span class="kpi-title">Convenios y Cooperación</span>
          <div class="kpi-icon-wrap teal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-convenios">{totalConvenios}</div>
          <span class="kpi-trend-badge info">Nal &bull; Int &bull; Guber</span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Cooperación Oficial</span>
          <span class="footer-val teal">En Ejecución</span>
        </div>
      </a>

      <!-- 4. Asuntos Jurídicos -->
      <a
        href="/juridicos"
        class="kpi-card bento-kpi-card emerald interactive"
        title="Ir a Asuntos Jurídicos"
      >
        <div class="kpi-accent-bar emerald"></div>
        <div class="kpi-header">
          <span class="kpi-title">Asuntos Jurídicos</span>
          <div class="kpi-icon-wrap emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-juridicos-dash">0</div>
          <span class="kpi-trend-badge success">Expedientes</span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Oficina Jurídica</span>
          <span class="footer-val emerald">Al Día</span>
        </div>
      </a>

      <!-- 5. Juzgamiento Disciplinario -->
      <a
        href="/juzgamiento"
        class="kpi-card bento-kpi-card gold interactive"
        title="Ir a Fase de Juzgamiento Disciplinario"
      >
        <div class="kpi-accent-bar gold"></div>
        <div class="kpi-header">
          <span class="kpi-title">Juzgamiento Disciplinario</span>
          <div class="kpi-icon-wrap gold">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-juzgamiento-dash">0</div>
          <span class="kpi-trend-badge warning">Procesos</span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Régimen Disciplinario</span>
          <span class="footer-val gold">Control Preventivo</span>
        </div>
      </a>

      <!-- 6. Planeación y CSU -->
      <a
        href="/planeacion"
        class="kpi-card bento-kpi-card green interactive"
        title="Ir a Planeación y Gestión CSU"
      >
        <div class="kpi-accent-bar green"></div>
        <div class="kpi-header">
          <span class="kpi-title">Planeación y CSU</span>
          <div class="kpi-icon-wrap green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
        </div>
        <div class="kpi-value-row">
          <div class="kpi-number tabular-nums" id="kpi-total-budget-dash">0</div>
          <span class="kpi-trend-badge subtle">Informes</span>
        </div>
        <div class="kpi-footer">
          <span class="footer-label">Seguimiento CSU</span>
          <span class="footer-val green">En Programación</span>
        </div>
      </a>

    </section>

    <!-- ================================================================= -->
    <!-- SECCIÓN C: SPLIT GRID PRINCIPAL (REPARTO + EFICACIA Y SEMÁFORO)   -->
    <!-- ================================================================= -->
    <div class="dashboard-split-grid bento-split-main">
      
      <!-- COLUMNA PRINCIPAL: REPARTO RECTORAL PRIORITARIO CON FILTRO SEGMENTADO -->
      <section class="panel-box bento-panel-main" aria-labelledby="reparto-main-heading">
        
        <div class="panel-header bento-panel-header">
          <div class="panel-title-wrap">
            <div class="panel-title">
              <div class="panel-icon-wrap gold">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <h3 id="reparto-main-heading" class="panel-heading-text">Reparto Rectoral Prioritario</h3>
            </div>
            <p class="panel-subheading-text">Monitoreo y asignación de expedientes oficiales con plazos institucionales</p>
          </div>

          <div class="panel-header-actions">
            <!-- Segmented Control con Shared Element Pill Slider -->
            <div class="dash-segmented-filter" id="dash-sla-segmented-filter">
              <div class="dash-seg-indicator-pill" id="dash-seg-indicator"></div>
              <button type="button" class="dash-seg-btn active" data-filter="all">Todos</button>
              <button type="button" class="dash-seg-btn" data-filter="safe">Óptimos</button>
              <button type="button" class="dash-seg-btn" data-filter="warn">Alerta</button>
              <button type="button" class="dash-seg-btn" data-filter="danger">Críticos</button>
            </div>

            <a href="/archivos" class="panel-link-action" title="Explorar todos los radicados">
              <span>Ver todos</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- LISTADO DE EXPEDIENTES PRIORITARIOS CON MINI BARRAS SLA Y CHIPS MONO -->
        <div
          id="dashboard-critical-list"
          class="critical-docs-flow"
        >
          {
            urgentPeticiones.length > 0 ? (
              urgentPeticiones.map((doc: any) => {
                const { progress, statusCategory } = doc;

                return (
                  <article
                    class={`critical-doc-card promax-floating-card sem-${statusCategory}`}
                    data-status-category={statusCategory}
                    data-doc-id={doc.id}
                  >
                    <div class={`card-sla-edge ${statusCategory}`}></div>

                    <div class="doc-card-body">
                      <!-- Cabecera de la tarjeta: Badges y Radicado Mono -->
                      <div class="doc-meta-top">
                        <div class="doc-badge-group">
                          <span class={`badge promax-badge ${progress.statusClass}`}>
                            {progress.statusBadge}
                          </span>
                          <span class="doc-rad-mono">
                            {doc.numero_radicado || `RAD-${doc.id.slice(0, 8)}`}
                          </span>
                        </div>
                        <span class="doc-urgency-label tabular-nums">
                          {progress.percentage}% tiempo transcurrido
                        </span>
                      </div>

                      <!-- Asunto principal -->
                      <h4 class="doc-subject-title" title={doc.asunto}>
                        {doc.asunto}
                      </h4>

                      <!-- Metadatos de procedencia y término -->
                      <div class="doc-meta-row">
                        <div class="meta-field">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                          <span>Solicitante: <strong>{doc.solicitante_nombre}</strong></span>
                        </div>
                        <div class="meta-field">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          <span>Límite: <strong class="tabular-nums">{doc.fecha_limite_entrega || "En trámite"}</strong></span>
                        </div>
                      </div>

                      <!-- Mini Barra de Progreso SLA Pro Max -->
                      <div class="doc-sla-track">
                        <div
                          class={`doc-sla-fill ${statusCategory}`}
                          style={`width: ${Math.min(100, Math.max(5, progress.percentage))}%;`}
                        ></div>
                      </div>
                    </div>

                    <!-- Botón de acción con micro-animación -->
                    <div class="doc-action-cell">
                      <a
                        href="/peticiones"
                        class="btn-promax-card-action"
                        title="Ver detalle del radicado"
                      >
                        <span>Ver Radicado</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                      </a>
                    </div>
                  </article>
                );
              })
            ) : (
              <div class="bento-empty-state">
                <div class="empty-icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h5 class="empty-title">No hay expedientes prioritarios pendientes</h5>
                <p class="empty-desc">Todos los términos de peticiones y oficios se encuentran al día en el sistema.</p>
              </div>
            )
          }

          <!-- Estado vacío dinámico al filtrar si no hay coincidencias -->
          <div id="dash-filter-empty-state" class="bento-empty-state" style="display: none;">
            <div class="empty-icon-wrap neutral">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <h5 class="empty-title">Sin expedientes en esta categoría</h5>
            <p class="empty-desc">No se encontraron peticiones con el nivel de urgencia seleccionado.</p>
          </div>
        </div>

      </section>

      <!-- COLUMNA DERECHA: EFICACIA INSTITUCIONAL + TÉRMINOS SLA -->
      <aside class="dashboard-side-column bento-side-column">
        
        <!-- WIDGET 1: EFICACIA EN RESPUESTAS A PETICIONES -->
        <div class="panel-box bento-widget-card">
          <div class="panel-header widget-header">
            <div class="panel-title">
              <div class="panel-icon-wrap emerald">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><polyline points="9 10 12 7 15 10"/><line x1="12" y1="7" x2="12" y2="13"/></svg>
              </div>
              <span class="widget-title-text">Eficacia en Peticiones</span>
            </div>
            <a
              href="/peticiones"
              class="badge-response-status responded promax-efficacy-pill"
              id="widget-efficacy-badge"
            >
              {responseRate}% Resuelto
            </a>
          </div>

          <div class="efficacy-card-body bento-efficacy-content">
            
            <!-- Medidor Gauge Circular Pro Max + Métricas Clave -->
            <div class="efficacy-gauge-showcase">
              <div class="circular-gauge-wrapper">
                <svg class="circular-gauge-svg" width="96" height="96" viewBox="0 0 96 96">
                  <!-- Pista de fondo -->
                  <circle
                    class="gauge-track"
                    cx="48"
                    cy="48"
                    r={gaugeRadius}
                    stroke-width="8"
                  />
                  <!-- Anillo de progreso -->
                  <circle
                    class="gauge-fill"
                    cx="48"
                    cy="48"
                    r={gaugeRadius}
                    stroke-width="8"
                    stroke-dasharray={gaugeCircumference}
                    stroke-dashoffset={gaugeOffset}
                  />
                </svg>
                <div class="gauge-center-content">
                  <span class="gauge-number tabular-nums">{responseRate}%</span>
                  <span class="gauge-caption">Eficacia</span>
                </div>
              </div>

              <div class="efficacy-stats-col">
                <div class="efficacy-metric-pill">
                  <span class="metric-dot green"></span>
                  <div>
                    <span class="efficacy-metric-num tabular-nums" id="widget-responded-count">{totalRespondidas}</span>
                    <span class="efficacy-metric-label">Oficios Emitidos</span>
                  </div>
                </div>

                <div class="efficacy-metric-pill">
                  <span class="metric-dot gold"></span>
                  <div>
                    <span class="efficacy-metric-num tabular-nums" id="widget-pending-count">{totalPendientes}</span>
                    <span class="efficacy-metric-label">Pendientes de Trámite</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Barra de progreso lineal de soporte -->
            <div class="dist-item efficacy-progress-section">
              <div class="dist-meta">
                <span class="progress-legend">Tasa de Respuesta Institucional</span>
                <span id="widget-response-pct" class="progress-val-accent tabular-nums">{responseRate}%</span>
              </div>
              <div class="dist-progress-bg promax-track">
                <div
                  class="dist-progress-fill promax-fill"
                  id="widget-response-bar"
                  style={`width: ${responseRate}%;`}
                ></div>
              </div>
            </div>

