                  </div>
                  <div class="band3-stat-box">
                    <span class="band3-stat-val tabular-nums tone-gold">{dashSnap.juzgamientoSegundaInstanciaCount}</span>
                    <span class="band3-stat-lbl">2da Instancia</span>
                  </div>
                  <div class="band3-stat-box">
                    <span class={`band3-stat-val tabular-nums ${dashSnap.juzgamientoProximosVencerCount > 0 ? 'tone-danger' : ''}`}>
                      {dashSnap.juzgamientoProximosVencerCount}
                    </span>
                    <span class="band3-stat-lbl">Próx. vencer &le;5d</span>
                  </div>
                </div>

                {
                  (() => {
                    const topJuzg = dashSnap.juzgamientoAlertas[0];
                    return topJuzg ? (
                      <a href="/juzgamiento" class="band3-juzg-card">
                        <div class="band3-juzg-top">
                          <span class="band2-norma-chip">Rad. {topJuzg.radicado}</span>
                          {topJuzg.dias_restantes !== null && (
                            <span class={`band3-alert-pill ${topJuzg.dias_restantes <= 5 ? 'warn' : 'safe'} tabular-nums`}>
                              {topJuzg.dias_restantes}d restantes
                            </span>
                          )}
                        </div>
                        <div class="band3-juzg-implicado">{topJuzg.implicado}</div>
                        <div class="band3-juzg-etapa">{topJuzg.etapa_procesal}</div>
                      </a>
                    ) : (
                      <div class="band3-optimal-strip">
                        <span>Sin procesos disciplinarios activos.</span>
                      </div>
                    );
                  })()
                }
              </div>
            )
          }
        </section>
      )
    }

    <!-- ================================================================= -->
    <!-- BANDA 4: ACTIVIDAD RECIENTE (ANCHO COMPLETO 100%, GRILLA 2 COLS)  -->
    <!-- ================================================================= -->
    {
      canAuditoria && (
        <section class="dash-band dash-band-4" aria-label="Actividad Reciente">
          <div class="band-card band-audit-card" id="dashboard-audit-widget">
            <div class="band-card-head">
              <div class="band-head-left">
                <div class="band-head-title-row">
                  <div class="band-icon-wrap gold">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </div>
                  <h3 class="band-title">Actividad Reciente</h3>
                </div>
              </div>
              <a href="/auditoria" class="band-link-btn primary-soft" title="Abrir bitácora completa de auditoría">
                <span>Auditoría &rarr;</span>
              </a>
            </div>

            {
              dashSnap.auditActividadReciente.length > 0 ? (
                <div class="band4-audit-grid">
                  {dashSnap.auditActividadReciente.slice(0, 6).map((item) => (
                    <article class="band4-audit-item">
                      <div class="band4-audit-avatar" title={item.actorName}>
                        {item.initials}
                      </div>
                      <div class="band4-audit-body">
                        <div class="band4-audit-top">
                          <span class="band4-audit-actor">{item.actorName}</span>
                          <span class="band4-audit-time tabular-nums">{item.timestamp}</span>
                        </div>
                        <p class="band4-audit-desc">{item.actionTitle}</p>
                        <div class="band4-audit-chips">
                          <span class="audit-entity-chip">{item.entity}</span>
                          {item.esExpediente && item.esEliminacion && (
                            <span class="audit-warning-chip">Expediente eliminado</span>
                          )}
                          {item.esExpediente && !item.esEliminacion && (
                            <span class="audit-exp-chip">Expediente</span>
                          )}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="band-empty-box">
                  <p class="band-empty-desc">Sin actividad de auditoría reciente registrada.</p>
                </div>
              )
            }
          </div>
        </section>
      )
    }

  </section>
</AppLayout>

