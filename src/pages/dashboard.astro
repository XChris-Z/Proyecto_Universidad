    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .bento-panel-main {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.04);
  }

  .bento-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
