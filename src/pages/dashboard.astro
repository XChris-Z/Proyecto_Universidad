  /* ==========================================================================
     4 BANDAS HORIZONTALES EQUILIBRADAS + ANIMACIONES SUTILES
     ========================================================================== */
  .dash-band {
    width: 100%;
    animation: dashBandEnter 0.3s ease-out both;
  }
  .dash-band-1 { animation-delay: 0.03s; }
  .dash-band-2 { animation-delay: 0.08s; }
  .dash-band-3 { animation-delay: 0.13s; }
  .dash-band-4 { animation-delay: 0.18s; }

  @keyframes dashBandEnter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dash-band-1 {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .dash-band-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .dash-band-2.band-single-col {
    grid-template-columns: 1fr;
  }

  .dash-band-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .dash-band-4 {
    display: block;
  }

  .band-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
  }

  .band-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid #EEF2F5;
  }

  .band-head-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
