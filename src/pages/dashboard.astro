  .doc-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.76rem;
    color: #64748b;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .meta-field {
    display: flex;
