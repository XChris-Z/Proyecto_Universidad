                }

                {/* WIDGET 4: ACTIVIDAD RECIENTE / AUDITORÍA (SOLO CON PERMISO AUDITORÍA) */}
                {
                  canAuditoria && (
                    <div class="panel-box bento-widget-card" id="dashboard-audit-widget">
