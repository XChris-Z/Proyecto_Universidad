    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 0.80rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(0, 89, 78, 0.22);
