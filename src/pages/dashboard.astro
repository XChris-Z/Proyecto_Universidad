  .kpi-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .kpi-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .kpi-status-pill.pill-green {
    background: #ECFDF5;
    color: #00594E;
  }
  .kpi-status-pill.pill-green .kpi-pill-dot {
    background: #00594E;
  }

  .kpi-status-pill.pill-gold {
    background: #FEF8E7;
    color: #8A6D1B;
  }
  .kpi-status-pill.pill-gold .kpi-pill-dot {
    background: #B5A160;
  }

  .kpi-status-pill.pill-neutral {
    background: #F1F5F9;
    color: #334155;
  }
  .kpi-status-pill.pill-neutral .kpi-pill-dot {
    background: #64748B;
  }

  .kpi-mini-progress-track {
    height: 5px;
    border-radius: 9999px;
    background: #E2E8F0;
    overflow: hidden;
    margin-top: 12px;
    width: 100%;
  }

  .kpi-mini-progress-fill {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  /* Zona 3: Franja inferior diferenciada */
  .kpi-zone-bottom {
    margin-top: auto;
    background: #F8FAFC;
    border-top: 1px solid #EEF2F5;
    padding: 11px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.76rem;
  }

  .kpi-foot-left {
    color: #64748B;
    font-weight: 500;
    white-space: nowrap;
