    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  .doc-sla-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .doc-sla-fill.danger { background: linear-gradient(90deg, #EF4444, #DC2626); }
  .doc-sla-fill.warn { background: linear-gradient(90deg, #F59E0B, #D97706); }
  .doc-sla-fill.safe { background: linear-gradient(90deg, #10B981, #059669); }

  .doc-action-cell {
    flex-shrink: 0;
  }
  .btn-promax-card-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
