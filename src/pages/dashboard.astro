  .panel-icon-wrap.emerald { background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; }
  .panel-icon-wrap.mint { background: #F2F7F6; color: #00594E; border: 1px solid #B2CFCB; }
  .panel-icon-wrap.amber { background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; }

  .panel-heading-text {
    font-size: 1.15rem;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .panel-subheading-text {
    font-size: 0.80rem;
    color: #64748b;
    margin: 0;
  }

  .panel-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Segmented Filter con Píldora Deslizante */
  .dash-segmented-filter {
    position: relative;
    display: inline-flex;
    background: #f1f5f9;
    padding: 3px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    gap: 2px;
  }
  .dash-seg-indicator-pill {
    position: absolute;
    top: 3px;
    left: 0;
    bottom: 3px;
    background: #ffffff;
    border-radius: 7px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.04);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), width 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }
  .dash-seg-btn {
    position: relative;
    z-index: 2;
    background: transparent;
    border: none;
    padding: 5px 12px;
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748b;
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.18s ease;
  }
  .dash-seg-btn.active {
    color: #00594E;
    font-weight: 850;
  }

  .panel-link-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #00594E;
    text-decoration: none;
    transition: gap 0.15s ease;
  }
  .panel-link-action:hover {
    gap: 8px;
  }

  /* Listado de expedientes prioritarios */
  .critical-docs-flow {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .promax-floating-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 16px 18px 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .promax-floating-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(0, 89, 78, 0.08);
    border-color: #cbd5e1;
  }

  .card-sla-edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
  }
  .card-sla-edge.danger { background: #EF4444; }
  .card-sla-edge.warn { background: #F59E0B; }
  .card-sla-edge.safe { background: #10B981; }

  .doc-card-body {
    flex: 1;
    min-width: 0;
  }

  .doc-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .doc-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .promax-badge {
    font-size: 0.70rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 5px;
  }

  .doc-rad-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    color: #0f172a;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 2px 7px;
    border-radius: 5px;
  }

  .doc-urgency-label {
    font-size: 0.72rem;
    font-weight: 700;
