---
// src/pages/dashboard.astro
// Panel de Control Rectoral UI/UX Pro Max con Bento Grid, RBAC Estricto y Sincronización Real Supabase
export const prerender = false;

import AppLayout from "@layouts/AppLayout.astro";
import { getDashboardSnapshotData } from "@lib/dashboard-data";
import { SESSION_COOKIE_KEY } from "@lib/constants";
import { resolveUserRbacServer } from "@lib/rbac-server";
import { getFirstAllowedPath, tienePermiso } from "@lib/permisos";

// No almacenar en caché para reflejar cambios, permisos y registros al instante
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

// 1. Validación estricta de sesión y matriz RBAC en servidor
const sessionUserId = Astro.cookies.get(SESSION_COOKIE_KEY)?.value;
if (!sessionUserId) {
  return Astro.redirect('/login');
}

const currentRbac = await resolveUserRbacServer(sessionUserId);
if (!currentRbac.authenticated) {
  return Astro.redirect('/login');
}

if (!currentRbac.isAdmin && !tienePermiso(currentRbac, 'dashboard', 'ver')) {
  const fallback = getFirstAllowedPath(currentRbac.effectivePermissions, false);
  return Astro.redirect(`${fallback}?denied=1`);
}

const canSee = (moduleId: string): boolean =>
  currentRbac.isAdmin || tienePermiso(currentRbac, moduleId, 'ver');

const canPeticiones = canSee('peticiones');
const canArchivos = canSee('archivos');
const canAgenda = canSee('agenda_vencimientos');
const canNormas = canSee('cuerpos_colegiados');
const canMiembros = canSee('miembros_consejo');
const canJuridicos = canSee('asuntos_juridicos');
const canJuzgamiento = canSee('fase_juzgamiento');
const canProgramas = canSee('programas_academicos');
const canPlaneacion = canSee('planeacion_csu');
const canConvenios = canSee('relacionamiento_institucional');
const canAuditoria = canSee('auditoria');

const canExportExcel = currentRbac.isAdmin || canPeticiones || canAuditoria;

// 2. Consultar snapshot consolidado en vivo desde Supabase (cada tabla protegida por try/catch independiente)
const dashSnap = await getDashboardSnapshotData();

const totalRespondidas = dashSnap.totalRespondidas;
const totalPendientes = dashSnap.totalPendientes;
const responseRate = dashSnap.responseRate;

const canLeftStack = canPeticiones || canMiembros || canNormas || canJuridicos || canJuzgamiento;
const canRightStack = canPeticiones || canPlaneacion || canConvenios || canAuditoria;
const isSingleSplit = (canLeftStack && !canRightStack) || (!canLeftStack && canRightStack);

const visibleKpiFlags = [
  canPeticiones,
  canNormas,
  canMiembros,
  canJuridicos,
  canJuzgamiento,
  canPlaneacion,
  canConvenios,
  canProgramas,
];
const visibleKpiCount = visibleKpiFlags.filter(Boolean).length;
const hasVisibleKpis = visibleKpiCount > 0;

// Cálculo del medidor circular SVG para tasa de respuesta
const gaugeRadius = 38;
const gaugeCircumference = 2 * Math.PI * gaugeRadius;
const gaugeOffset = Math.round(gaugeCircumference * (1 - responseRate / 100));

const categoryLabelsMap: Record<string, string> = {
  conceptos_internos: 'Conceptos Internos',
  litigios_judiciales: 'Litigios Judiciales',
  auditoria_entes_control: 'Auditoría Entes de Control',
};
---

<AppLayout title="Dashboard — Panel de Control Rectoral" activeNav="dashboard">
  <section
    class="module-board-card dash-promax-workspace"
    data-can-peticiones={canPeticiones ? 'true' : 'false'}
    style="padding: 20px 24px !important; gap: 18px !important;"
  >

    <!-- ================================================================= -->
    <!-- SECCIÓN A: BENTO HERO EJECUTIVO "CENTRO DE MANDO INSTITUCIONAL"  -->
    <!-- ================================================================= -->
    <header class="hero-banner bento-hero-promax">
      <div class="hero-ambient-glow"></div>

      <!-- Marca de agua heráldica oficial Unitrópico -->
      <img
        src="/escudo-blanco.png"
        alt=""
        class="dashboard-heraldic-watermark"
        aria-hidden="true"
      />

      <div class="hero-content">
        <div class="hero-live-badge">
          <span class="live-radar-dot"></span>
          <span class="live-badge-text">Sincronización Institucional Activa</span>
          <span class="live-badge-divider">&bull;</span>
          <span class="live-badge-sub">Despacho Rectoral Unitrópico</span>
        </div>
        <div class="hero-title-row">
          <div class="hero-heraldic-badge" title="Escudo Oficial Unitrópico">
            <img
              src="/escudo-fondo-oscuro.png"
              alt="Escudo Oficial Unitrópico"
              class="hero-heraldic-img"
            />
          </div>
          <h2 class="hero-title">Centro de Mando Institucional</h2>
        </div>
        <p class="hero-desc">
          Monitoreo integral de gobierno universitario: cuerpos colegiados, asuntos jurídicos, convenios interinstitucionales, radicación oficial y control de términos de la Universidad Internacional del Trópico Americano.
        </p>

        <!-- Saludo y Rol RBAC exacto del usuario autenticado -->
        <div class="hero-user-session-row">
          <span class="hero-user-welcome">
            Sesión activa: <strong>{currentRbac.fullName}</strong>
          </span>
          <span class="hero-role-badge-exact" id="dashboard-exact-role-badge">
            {currentRbac.roleName}
          </span>
        </div>
      </div>

      <div class="hero-actions-container">
        <!-- Indicador Maestro de Términos en Plazo (solo si tiene acceso a Peticiones) -->
        {
          canPeticiones && (
            <a
              href={canAgenda ? "/calendario" : "/peticiones"}
              class="hero-pill glass-capsule hero-sla-card"
              title="Ver términos en plazo en Calendario Institucional"
              style="display: inline-flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: 14px; background: rgba(255, 255, 255, 0.12); border: 1.5px solid rgba(255, 255, 255, 0.22); backdrop-filter: blur(12px); text-decoration: none; color: #ffffff;"
            >
              <div class="capsule-icon-wrap mint" style="width: 36px; height: 36px; border-radius: 10px; background: rgba(16, 185, 129, 0.2); color: #34D399; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div>
                <div class="number tabular-nums" id="quick-sla-compliance" style="font-size: 1.25rem; font-weight: 850; line-height: 1; color: #FFFFFF;">
                  {dashSnap.slaSafePct}%
                </div>
                <div class="label" style="font-size: 0.72rem; font-weight: 800; color: #E2E8F0; margin-top: 3px; letter-spacing: 0.03em; text-transform: uppercase;">
                  TÉRMINOS EN PLAZO
                </div>
              </div>
            </a>
          )
        }

        <!-- Botón Compacto de Exportación Ejecutiva "Reporte General" -->
        {
          canExportExcel && (
            <a
              href="/api/dashboard/exportar-excel"
              download
              id="btn-export-excel"
              class="btn-reporte-general"
              title="Descargar informe general completo en Microsoft Excel (.xlsx)"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <polyline points="9 15 12 18 15 15"/>
              </svg>
              <span>Reporte General</span>
            </a>
          )
        }

        <!-- Preservación segura de IDs DOM sin impacto visual -->
        <div style="display: none;" aria-hidden="true">
          <span id="quick-total-peticiones">{dashSnap.totalPeticiones}</span>
          <span id="quick-total-normas">{dashSnap.totalNormas}</span>
          <span id="quick-total-convenios">{dashSnap.totalConvenios}</span>
        </div>
      </div>
    </header>

    <!-- ================================================================= -->
    <!-- SECCIÓN B: GRILLA DE KPIS EJECUTIVOS FILTRADA POR RBAC            -->
    <!-- ================================================================= -->
    {
      hasVisibleKpis && (
        <section
          class={`kpi-grid-6 bento-kpi-grid ${visibleKpiCount > 0 && visibleKpiCount <= 3 ? 'is-compact-rbac' : ''}`}
          aria-label="Indicadores Clave de Gestión"
        >

          {
            canPeticiones && (
              <a
                href="/peticiones"
                class={`kpi-card bento-kpi-card interactive ${dashSnap.totalPendientes > 0 ? 'accent-gold' : 'accent-green'}`}
                title="Ir al módulo de Peticiones y Expedientes"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class={`kpi-icon-box ${dashSnap.totalPendientes > 0 ? 'tone-gold' : 'tone-green'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <span class="kpi-title-clean">Peticiones / Expedientes</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-docs">{dashSnap.totalPeticiones}</span>
                    <span class={`kpi-status-pill ${dashSnap.totalPendientes > 0 ? 'pill-gold' : 'pill-green'}`} id="kpi-pending-docs">
                      <span class="kpi-pill-dot"></span>
                      <span>{dashSnap.totalPendientes === 1 ? '1 Pendiente' : `${dashSnap.totalPendientes} Pendientes`}</span>
                    </span>
                  </div>
                  <div class="kpi-mini-progress-track" aria-hidden="true">
                    <div
                      class="kpi-mini-progress-fill"
                      style={`width: ${Math.min(100, Math.max(0, dashSnap.responseRate))}%; background: ${dashSnap.responseRate >= 50 ? '#00594E' : '#B5A160'};`}
                    ></div>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Drive: {dashSnap.peticionesConDriveCount}/{dashSnap.totalPeticiones}</span>
                  <span class={`kpi-foot-right ${dashSnap.totalPendientes > 0 ? 'tone-gold' : 'tone-green'}`} id="kpi-response-rate">
                    {dashSnap.responseRate}% Resuelto
                  </span>
                </div>
              </a>
            )
          }

          {
            canNormas && (
              <a
                href="/normas"
                class="kpi-card bento-kpi-card interactive accent-green"
                title="Ir a Cuerpos Colegiados"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class="kpi-icon-box tone-green">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <span class="kpi-title-clean">Cuerpos Colegiados</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-normas">{dashSnap.totalNormas}</span>
                    <span class="kpi-status-pill pill-green">
                      <span class="kpi-pill-dot"></span>
                      <span>{dashSnap.normasVigentesCount === 1 ? '1 Vigente' : `${dashSnap.normasVigentesCount} Vigentes`}</span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">CSU {dashSnap.normasPorOrgano.csu} &bull; CA {dashSnap.normasPorOrgano.ca}</span>
                  <span class="kpi-foot-right tone-green">Rectoría {dashSnap.normasPorOrgano.rectoria}</span>
                </div>
              </a>
            )
          }

          {
            canMiembros && (
              <a
                href="/miembros-consejo"
                class={`kpi-card bento-kpi-card interactive ${dashSnap.miembrosProximosVencer.length > 0 ? 'accent-gold' : 'accent-green'}`}
                title="Ir a Miembros de Consejo"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class={`kpi-icon-box ${dashSnap.miembrosProximosVencer.length > 0 ? 'tone-gold' : 'tone-green'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <span class="kpi-title-clean">Miembros de Consejo</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-miembros">{dashSnap.miembrosActivosCount}</span>
                    <span class={`kpi-status-pill ${dashSnap.miembrosProximosVencer.length > 0 ? 'pill-gold' : 'pill-green'}`}>
                      <span class="kpi-pill-dot"></span>
                      <span>
                        {dashSnap.miembrosProximosVencer.length > 0
                          ? `${dashSnap.miembrosProximosVencer.length} Próx. Vencer`
                          : 'Activos Vigentes'}
                      </span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Archivo histórico</span>
                  <span class="kpi-foot-right tone-green">{dashSnap.miembrosArchivoCount} en archivo</span>
                </div>
              </a>
            )
          }

          {
            canJuridicos && (
              <a
                href="/asuntos-juridicos"
                class="kpi-card bento-kpi-card interactive accent-green"
                title="Ir a Asuntos Jurídicos"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class="kpi-icon-box tone-green">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
                    </div>
                    <span class="kpi-title-clean">Asuntos Jurídicos</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-juridicos-dash">{dashSnap.totalJuridicos}</span>
                    <span class="kpi-status-pill pill-green">
                      <span class="kpi-pill-dot"></span>
                      <span>
                        {dashSnap.totalJuridicoCarpetas === 1
                          ? '1 Carpeta'
                          : `${dashSnap.totalJuridicoCarpetas} Carpetas`}
                      </span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Concep. {dashSnap.juridicosPorCategoria.conceptos_internos} &bull; Lit. {dashSnap.juridicosPorCategoria.litigios_judiciales}</span>
                  <span class="kpi-foot-right tone-green">Aud. {dashSnap.juridicosPorCategoria.auditoria_entes_control}</span>
                </div>
              </a>
            )
          }

          {
            canJuzgamiento && (
              <a
                href="/juzgamiento"
                class={`kpi-card bento-kpi-card interactive ${(dashSnap.juzgamientoProximosVencerCount > 0 || dashSnap.juzgamientoActivosCount > 0) ? 'accent-gold' : 'accent-green'}`}
                title="Ir a Fase de Juzgamiento Disciplinario"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class={`kpi-icon-box ${(dashSnap.juzgamientoProximosVencerCount > 0 || dashSnap.juzgamientoActivosCount > 0) ? 'tone-gold' : 'tone-green'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                    <span class="kpi-title-clean">Juzgamiento Disciplinario</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-juzgamiento-dash">{dashSnap.juzgamientoActivosCount}</span>
                    <span class={`kpi-status-pill ${dashSnap.juzgamientoSegundaInstanciaCount > 0 ? 'pill-gold' : 'pill-green'}`}>
                      <span class="kpi-pill-dot"></span>
                      <span>{dashSnap.juzgamientoSegundaInstanciaCount} en 2da Inst.</span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Total: {dashSnap.totalJuzgamiento}</span>
                  <span class="kpi-foot-right tone-gold">{dashSnap.juzgamientoProximosVencerCount} próx. a vencer</span>
                </div>
              </a>
            )
          }

          {
            canPlaneacion && (
              <a
                href="/planeacion"
                class="kpi-card bento-kpi-card interactive accent-green"
                title="Ir a Planeación y Gestión CSU"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class="kpi-icon-box tone-green">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <span class="kpi-title-clean">Planeación y CSU</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-budget-dash">{dashSnap.totalPlaneacion}</span>
                    <span class="kpi-status-pill pill-neutral">
                      <span class="kpi-pill-dot"></span>
                      <span>
                        {dashSnap.ultimoInformePlaneacion ? `${dashSnap.ultimoInformePlaneacion.ejecucionFormatted} Ejec.` : '0% Ejec.'}
                      </span>
                    </span>
                  </div>
                  <div class="kpi-mini-progress-track" aria-hidden="true">
                    <div
                      class="kpi-mini-progress-fill"
                      style={`width: ${Math.min(100, Math.max(0, dashSnap.ultimoInformePlaneacion?.ejecucion_pct ?? 0))}%; background: #00594E;`}
                    ></div>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Último reporte</span>
                  <span class="kpi-foot-right tone-green">
                    {dashSnap.ultimoInformePlaneacion ? dashSnap.ultimoInformePlaneacion.estado : 'Sin registros'}
                  </span>
                </div>
              </a>
            )
          }

          {
            canConvenios && (
              <a
                href="/relacionamiento"
                class={`kpi-card bento-kpi-card interactive ${dashSnap.conveniosProximosVencerCount > 0 ? 'accent-gold' : 'accent-green'}`}
                title="Ir a Relacionamiento Institucional y Convenios"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class={`kpi-icon-box ${dashSnap.conveniosProximosVencerCount > 0 ? 'tone-gold' : 'tone-green'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                    </div>
                    <span class="kpi-title-clean">Convenios Activos</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-convenios">{dashSnap.conveniosActivosCount}</span>
                    <span class={`kpi-status-pill ${dashSnap.conveniosProximosVencerCount > 0 ? 'pill-gold' : 'pill-green'}`}>
                      <span class="kpi-pill-dot"></span>
                      <span>
                        {dashSnap.conveniosProximosVencerCount > 0
                          ? `${dashSnap.conveniosProximosVencerCount} Próx. Vencer`
                          : `Total: ${dashSnap.totalConvenios}`}
                      </span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">Cuantía</span>
                  <span class={`kpi-foot-right tabular-nums ${dashSnap.conveniosProximosVencerCount > 0 ? 'tone-gold' : 'tone-green'}`}>
                    {dashSnap.conveniosCuantiaFormateada}
                  </span>
                </div>
              </a>
            )
          }

          {
            canProgramas && (
              <a
                href="/programas"
                class="kpi-card bento-kpi-card interactive accent-green"
                title="Ir a Programas Académicos"
              >
                <div class="kpi-zone-top">
                  <div class="kpi-identity-left">
                    <div class="kpi-icon-box tone-green">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                    </div>
                    <span class="kpi-title-clean">Programas Académicos</span>
                  </div>
                  <svg class="kpi-arrow-diag" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                </div>

                <div class="kpi-zone-center">
                  <div class="kpi-value-row">
                    <span class="kpi-number-main tabular-nums" id="kpi-total-programas-dash">{dashSnap.totalProgramas}</span>
                    <span class="kpi-status-pill pill-green">
                      <span class="kpi-pill-dot"></span>
                      <span>
                        {dashSnap.programasActivosCount === 1
                          ? '1 Activo'
                          : `${dashSnap.programasActivosCount} Activos`}
                      </span>
                    </span>
                  </div>
                </div>

                <div class="kpi-zone-bottom">
                  <span class="kpi-foot-left">SACES / MEN</span>
                  <span class="kpi-foot-right tone-green">Oferta Oficial</span>
                </div>
              </a>
            )
          }

        </section>
      )
    }

    <!-- ================================================================= -->
    <!-- BANDA 1: CENTRO OPERATIVO DE PETICIONES (62% / 38%, MISMA ALTURA) -->
    <!-- ================================================================= -->
    {
      canPeticiones && (() => {
        const formatShortDate = (raw: unknown): string => {
          const s = String(raw || '').trim();
          const m = s.match(/^(\d{4}-\d{2}-\d{2})/);
          return m?.[1] || '';
        };

        const activeBandDocs = dashSnap.urgentPeticiones.map((doc) => ({
          id: doc.id,
          numero_radicado: doc.numero_radicado,
          asunto: doc.asunto,
          solicitante_nombre: doc.solicitante_nombre,
          fecha_limite_entrega: doc.fecha_limite_entrega,
          fecha_limite_responsable: doc.fecha_limite_responsable,
          hasDriveBackup: doc.hasDriveBackup,
          statusCategory: doc.statusCategory as 'safe' | 'warn' | 'danger' | 'completed',
          percentage: doc.progress.percentage,
          statusClass: doc.progress.statusClass,
          statusBadge: doc.progress.statusBadge,
          cierreDate: '',
        }));

        const completedBandDocs = (dashSnap.peticiones || [])
          .filter((p: any) => Boolean(p?.respondida))
          .map((p: any) => {
            const cierre =
              formatShortDate(p.fecha_respuesta) ||
              formatShortDate(p.respuesta_fecha_envio) ||
              formatShortDate(p.fecha_limite_entrega) ||
              formatShortDate(p.updated_at) ||
              formatShortDate(p.created_at);
            return {
              id: String(p.id || ''),
              numero_radicado: String(p.numero_radicado || `RAD-${String(p.id || '').slice(0, 8)}`),
              asunto: String(p.asunto || 'Expediente sin asunto'),
              solicitante_nombre: String(p.solicitante_nombre || 'Solicitante Institucional'),
              fecha_limite_entrega: formatShortDate(p.fecha_limite_entrega) || 'Cerrado',
              fecha_limite_responsable: formatShortDate(p.fecha_limite_responsable) || '--',
              hasDriveBackup: Boolean(p.drive_folder_id),
              statusCategory: 'completed' as const,
              percentage: 100,
              statusClass: 'badge-completed',
              statusBadge: 'Completado',
              cierreDate: cierre,
            };
          });

        const banda1Docs = [...activeBandDocs, ...completedBandDocs];
        const todosCount = banda1Docs.length;
        const criticosCount = banda1Docs.filter((d) => d.statusCategory === 'danger').length;
        const optimosCount = banda1Docs.filter((d) => d.statusCategory === 'safe').length;
        const completadosCount = banda1Docs.filter((d) => d.statusCategory === 'completed').length;

        const hasSlaDistribution = (dashSnap.slaSafe + dashSnap.slaWarn + dashSnap.slaDanger) > 0;

        return (
          <section class="dash-band dash-band-1" aria-label="Centro Operativo de Peticiones">
            <!-- Columna Izquierda (62%): Reparto Prioritario y Agenda -->
            <div class="band-card band-reparto-card">
              <div class="band-card-head">
                <div class="band-head-left">
                  <div class="band-head-title-row">
                    <div class="band-icon-wrap gold">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3 id="reparto-main-heading" class="band-title">Reparto Prioritario y Agenda</h3>
                  </div>
                  <p class="band-subtitle">
                    Control dual de plazos y respaldo en Drive: {dashSnap.peticionesConDriveCount}/{dashSnap.totalPeticiones}
                  </p>
                </div>

                <div class="band-head-links">
                  {
                    canAgenda && (
                      <a href="/calendario" class="band-link-btn" title="Ir a Agenda">
                        <span>Ver agenda &rarr;</span>
                      </a>
                    )
                  }
                  <a href={canArchivos ? "/archivos" : "/peticiones"} class="band-link-btn primary-soft" title="Explorar carpetas de radicados">
                    <span>Ver carpetas &rarr;</span>
                  </a>
                </div>
              </div>

              <!-- Barra segmentada única con contadores -->
              <div class="band1-filter-bar">
                <div class="dash-segmented-filter" id="dash-sla-segmented-filter">
                  <div class="dash-seg-indicator-pill" id="dash-seg-indicator"></div>
                  <button type="button" class="dash-seg-btn active" data-filter="all">Todos ({todosCount})</button>
                  <button type="button" class="dash-seg-btn" data-filter="danger">Críticos ({criticosCount})</button>
                  <button type="button" class="dash-seg-btn" data-filter="safe">Óptimos ({optimosCount})</button>
                  <button type="button" class="dash-seg-btn" data-filter="completed">Completados ({completadosCount})</button>
                </div>
              </div>

              <!-- Listado unificado de expedientes -->
              <div id="dashboard-critical-list" class="band1-docs-list">
                {
                  banda1Docs.length > 0 ? (
                    banda1Docs.map((doc) => {
                      const targetUrl = canArchivos
                        ? `/archivos?radicado=${encodeURIComponent(doc.numero_radicado || doc.id)}`
                        : `/peticiones?radicado=${encodeURIComponent(doc.numero_radicado || doc.id)}`;

                      return (
                        <article
                          class={`band1-doc-card sem-${doc.statusCategory}`}
                          data-status-category={doc.statusCategory}
                          data-doc-id={doc.id}
                        >
                          <div class={`band1-edge ${doc.statusCategory}`}></div>

                          <div class="band1-doc-main">
                            <div class="band1-doc-top">
                              <div class="band1-badges-left">
                                <span class={`band1-state-badge ${doc.statusClass}`}>
                                  {doc.statusBadge}
                                </span>
                                <span class="band1-rad-mono">
                                  {doc.numero_radicado}
                                </span>
                                <span class={`band1-drive-pill ${doc.hasDriveBackup ? 'is-drive' : 'is-local'}`}>
                                  {doc.hasDriveBackup ? 'Drive' : 'Solo Local'}
                                </span>
                              </div>
                              <span class="band1-pct-label tabular-nums">
                                {doc.statusCategory === 'completed'
                                  ? '100% completado'
                                  : `${doc.percentage}% tiempo consumido`}
                              </span>
                            </div>

                            <h4 class="band1-doc-subject" title={doc.asunto}>{doc.asunto}</h4>

                            <div class="band1-doc-solicitante">
                              Solicitante: <strong>{doc.solicitante_nombre}</strong>
                            </div>

                            <!-- Chips duales de plazo integrados desde Agenda -->
                            <div class="band1-dates-row">
                              {
                                doc.statusCategory === 'completed' ? (
                                  <span class="band1-date-chip is-complete">
                                    &bull; Expediente Completo &middot; {doc.cierreDate || doc.fecha_limite_entrega}
                                  </span>
                                ) : (
                                  <>
                                    {doc.fecha_limite_responsable !== '--' && (
                                      <span class="band1-date-chip is-resp">
                                        Límite Oficinas: <strong class="tabular-nums">{doc.fecha_limite_responsable}</strong>
                                      </span>
                                    )}
                                    <span class="band1-date-chip is-close">
                                      Cierre General: <strong class="tabular-nums">{doc.fecha_limite_entrega || 'En trámite'}</strong>
                                    </span>
                                  </>
                                )
                              }
                            </div>

                            <div class="band1-progress-track">
                              <div
                                class={`band1-progress-fill ${doc.statusCategory}`}
                                style={`width: ${Math.min(100, Math.max(5, doc.percentage))}%;`}
                              ></div>
                            </div>
                          </div>

                          <div class="band1-doc-action">
                            <a href={targetUrl} class="band1-open-btn" title="Abrir carpeta del expediente">
                              <span>Abrir Carpeta &rarr;</span>
                            </a>
                          </div>
                        </article>
                      );
                    })
                  ) : (
                    <div class="band-empty-box">
                      <p class="band-empty-title">No hay expedientes radicados registrados</p>
                      <p class="band-empty-desc">Las peticiones radicadas aparecerán aquí con su seguimiento de plazos.</p>
                    </div>
                  )
                }

                <div id="dash-filter-empty-state" class="band-empty-box" style="display: none;">
                  <p class="band-empty-title">Sin expedientes en esta categoría</p>
                  <p class="band-empty-desc">No hay radicados que coincidan con el filtro seleccionado.</p>
                </div>
              </div>
            </div>

            <!-- Columna Derecha (38%): Eficacia y Semáforo SLA -->
            <aside class="band-card band-efficacy-card" aria-label="Eficacia y Semáforo SLA">
              <div class="band-card-head">
                <div class="band-head-left">
                  <div class="band-head-title-row">
                    <div class="band-icon-wrap emerald">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><polyline points="9 10 12 7 15 10"/><line x1="12" y1="7" x2="12" y2="13"/></svg>
                    </div>
                    <h3 class="band-title">Eficacia y Semáforo SLA</h3>
                  </div>
                </div>
              </div>

              <!-- Bloque Eficacia: Anillo SVG único + 2 contadores compactos -->
              <div class="band1-efficacy-row">
                <div class="circular-gauge-wrapper">
                  <svg class="circular-gauge-svg" width="96" height="96" viewBox="0 0 96 96">
                    <circle class="gauge-track" cx="48" cy="48" r={gaugeRadius} stroke-width="8" />
                    <circle
                      class="gauge-fill dash-animated-ring"
                      cx="48"
                      cy="48"
                      r={gaugeRadius}
                      stroke-width="8"
                      stroke-dasharray={gaugeCircumference}
                      stroke-dashoffset={gaugeOffset}
                    />
                  </svg>
                  <div class="gauge-center-content">
                    <span class="gauge-number tabular-nums">{responseRate}%</span>
                    <span class="gauge-caption">Eficacia</span>
                  </div>
                </div>

                <div class="band1-eff-counters">
                  <div class="band1-eff-stat">
                    <div class="eff-stat-head">
                      <span class="eff-dot green"></span>
                      <span class="eff-stat-num tabular-nums" id="widget-responded-count">{totalRespondidas}</span>
                      <span class="eff-stat-title">Completados</span>
                    </div>
                    <span class="eff-stat-sub">{dashSnap.aportesAprobadosCount || 0} aportes aprobados</span>
                  </div>

                  <div class="band1-eff-stat">
                    <div class="eff-stat-head">
                      <span class="eff-dot gold"></span>
                      <span class="eff-stat-num tabular-nums" id="widget-pending-count">{totalPendientes}</span>
                      <span class="eff-stat-title">En trámite</span>
                    </div>
                    <span class="eff-stat-sub">{dashSnap.dependenciasPendientesCount || 0} dep. por entregar</span>
                  </div>
                </div>
              </div>

              <!-- Separador suave + Semáforo SLA en 1 barra horizontal segmentada -->
              <div class="band1-sla-section">
                <div class="band1-sla-heading-row">
                  <span class="band1-sla-title">Semáforo SLA (En Tiempo Real)</span>
                </div>

                <div class="band1-sla-segmented-bar" role="img" aria-label="Distribución SLA en tiempo real">
                  {
                    hasSlaDistribution ? (
                      <>
                        {dashSnap.slaSafePct > 0 && (
                          <div
                            class="sla-seg-part is-safe"
                            style={`width: ${dashSnap.slaSafePct}%;`}
                            title={`Óptimo (<50%): ${dashSnap.slaSafe}`}
                          ></div>
                        )}
                        {dashSnap.slaWarnPct > 0 && (
                          <div
                            class="sla-seg-part is-warn"
                            style={`width: ${dashSnap.slaWarnPct}%;`}
                            title={`Medio (50%-80%): ${dashSnap.slaWarn}`}
                          ></div>
                        )}
                        {dashSnap.slaDangerPct > 0 && (
                          <div
                            class="sla-seg-part is-danger"
                            style={`width: ${dashSnap.slaDangerPct}%;`}
                            title={`Crítico (>80%): ${dashSnap.slaDanger}`}
                          ></div>
                        )}
                      </>
                    ) : (
                      <div class="sla-seg-part is-safe" style="width: 100%; opacity: 0.25;"></div>
                    )
                  }
                </div>

                <div class="band1-sla-legend-row">
                  <button type="button" class="sla-legend-btn" data-sla-trigger="safe" title="Filtrar óptimos">
                    <span class="sla-leg-dot safe"></span>
                    <span>Óptimo: <strong class="tabular-nums">{dashSnap.slaSafe}</strong></span>
                  </button>
                  <button type="button" class="sla-legend-btn" data-sla-trigger="warn" title="Filtrar en advertencia media">
                    <span class="sla-leg-dot warn"></span>
                    <span>Medio: <strong class="tabular-nums">{dashSnap.slaWarn}</strong></span>
                  </button>
                  <button type="button" class="sla-legend-btn" data-sla-trigger="danger" title="Filtrar críticos">
                    <span class="sla-leg-dot danger"></span>
                    <span>Crítico: <strong class="tabular-nums">{dashSnap.slaDanger}</strong></span>
                  </button>
                </div>
              </div>

              <!-- CTA principal anclado al fondo -->
              <a
                href="/peticiones"
                class="btn-manage-petitions promax-cta-button band1-cta-bottom"
                id="btn-quick-manage-petitions"
              >
                <div class="cta-left">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  <span>Atender Peticiones Pendientes</span>
                </div>
                <span class="badge-counter promax-counter-badge" id="widget-pending-badge">
                  {dashSnap.totalPendientes}
                </span>
              </a>
            </aside>
          </section>
        );
      })()
    }

    <!-- ================================================================= -->
    <!-- BANDA 2: GESTIÓN NORMATIVA Y ESTRATÉGICA (50% / 50%, MISMA ALTURA) -->
    <!-- ================================================================= -->
    {
      (canNormas || canPlaneacion || canConvenios) && (() => {
        const showRightBand2 = canPlaneacion || canConvenios;
        const isSingleBand2 = (canNormas && !showRightBand2) || (!canNormas && showRightBand2);

        const todayYmdBand2 = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Bogota',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(new Date());

        const getNormaVigBadge = (norma: any) => {
          const lower = String(norma?.vigencia || 'vigente').toLowerCase().trim();
          const fin = String(norma?.fecha_fin_vigencia || '').slice(0, 10);
          if (lower.includes('derogad') || lower.includes('modificad')) {
            return { cls: 'is-derogado', label: 'Derogado' };
          }
          if (lower === 'no_vigente' || lower === 'no vigente' || lower === 'vencido' || (fin && fin < todayYmdBand2)) {
            return { cls: 'is-no-vigente', label: 'No Vigente' };
          }
          return { cls: 'is-vigente', label: 'Vigente' };
        };

        return (
          <section
            class={`dash-band dash-band-2 ${isSingleBand2 ? 'band-single-col' : ''}`}
            aria-label="Gestión Normativa y Estratégica"
          >
            {
              canNormas && (
                <div class="band-card band-colegiados-card">
                  <div class="band-card-head">
                    <div class="band-head-left">
                      <div class="band-head-title-row">
                        <div class="band-icon-wrap gold">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        </div>
                        <h3 class="band-title">Cuerpos Colegiados</h3>
                      </div>
                      <p class="band-subtitle">
                        CSU: <strong>{dashSnap.normasPorOrgano.csu}</strong> &middot; CA: <strong>{dashSnap.normasPorOrgano.ca}</strong> &middot; Rectoría: <strong>{dashSnap.normasPorOrgano.rectoria}</strong> &middot; Vigentes: <strong>{dashSnap.normasVigentesCount}</strong>
                      </p>
                    </div>

                    <a href="/normas" class="band-link-btn primary-soft" title="Explorar catálogo de Cuerpos Colegiados">
                      <span>Explorar ({dashSnap.totalNormas}) &rarr;</span>
                    </a>
                  </div>

                  <div class="band2-normas-list" id="dashboard-colegiados-recent-list">
                    {
                      dashSnap.recentNormas.length > 0 ? (
                        dashSnap.recentNormas.slice(0, 4).map((norma: any) => {
                          const vig = getNormaVigBadge(norma);
                          return (
                            <div class="band2-norma-row">
                              <div class="band2-norma-info">
                                <div class="band2-norma-meta">
                                  <span class="band2-norma-chip">{norma.tipo} {norma.numero}</span>
                                  <span class="band2-norma-year tabular-nums">{norma.anio || norma.fecha}</span>
                                  {norma.organo && <span class="band2-norma-organo">{norma.organo}</span>}
                                  <span class={`band2-vig-badge ${vig.cls}`}>
                                    &bull; {vig.label}
                                  </span>
                                </div>
                                <div class="band2-norma-title" title={norma.titulo}>
                                  {norma.titulo}
                                </div>
                              </div>
                              <a href="/normas" class="band2-norma-ver-btn" title="Ver acto en Cuerpos Colegiados">
                                <span>Ver &rarr;</span>
                              </a>
                            </div>
                          );
                        })
                      ) : (
                        <div class="band-empty-box">
                          <p class="band-empty-desc">No hay actos colegiados registrados actualmente.</p>
                        </div>
                      )
                    }
                  </div>
                </div>
              )
            }

            {
              showRightBand2 && (
                <div class="band-card band-estrategica-card">
                  <div class="band-card-head">
                    <div class="band-head-left">
                      <div class="band-head-title-row">
                        <div class="band-icon-wrap emerald">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        </div>
                        <h3 class="band-title">Planeación CSU y Convenios</h3>
                      </div>
                      <p class="band-subtitle">Seguimiento presupuestal y acuerdos interinstitucionales vigentes</p>
                    </div>
                  </div>

                  <div class="band2-estrategica-stack">
                    {
                      canPlaneacion && (
                        <a href="/planeacion" class="band2-sub-box">
                          <div class="band2-sub-top">
                            <span class="band2-sub-label">Planeación CSU</span>
                            <span class="band2-sub-pill green tabular-nums">
                              {dashSnap.ultimoInformePlaneacion ? `${dashSnap.ultimoInformePlaneacion.ejecucionFormatted} Ejecución` : '0% Ejecución'}
                            </span>
                          </div>
                          {
                            dashSnap.ultimoInformePlaneacion ? (
                              <>
                                <div class="band2-sub-title">{dashSnap.ultimoInformePlaneacion.periodo}</div>
                                <div class="band2-sub-meta">
                                  Radicado CSU: {dashSnap.ultimoInformePlaneacion.radicado_csu} &bull; {dashSnap.ultimoInformePlaneacion.estado}
                                </div>
                                <div class="band2-progress-track">
                                  <div
                                    class="band2-progress-fill"
                                    style={`width: ${Math.min(100, Math.max(4, dashSnap.ultimoInformePlaneacion.ejecucion_pct))}%;`}
                                  ></div>
                                </div>
                              </>
                            ) : (
                              <div class="band2-sub-meta">Sin informes de planeación registrados.</div>
                            )
                          }
                        </a>
                      )
                    }

                    {
                      canConvenios && (
                        <a href="/relacionamiento" class="band2-sub-box is-grow">
                          <div class="band2-sub-top">
                            <span class="band2-sub-label">Convenios en Ejecución ({dashSnap.conveniosActivosCount})</span>
                            <span class="band2-sub-pill gold tabular-nums">{dashSnap.conveniosCuantiaFormateada}</span>
                          </div>
                          {
                            (() => {
                              const topConv = dashSnap.conveniosAlertas[0];
                              return topConv ? (
                                <>
                                  <div class="band2-sub-title">
                                    {topConv.entidad} (#{topConv.numero})
                                  </div>
                                  <div class="band2-sub-meta">
                                    {topConv.tipo_label} &bull; Vence: {topConv.fin}
                                    {dashSnap.conveniosProximosVencerCount > 0 && ` • ${dashSnap.conveniosProximosVencerCount} próx. vencer`}
                                  </div>
                                </>
                              ) : (
                                <div class="band2-sub-meta">Sin convenios activos registrados.</div>
                              );
                            })()
                          }
                        </a>
                      )
                    }
                  </div>
                </div>
              )
            }
          </section>
        );
      })()
    }

    <!-- ================================================================= -->
    <!-- BANDA 3: SEGUIMIENTO ESPECIALIZADO (3 COLUMNAS IGUALES RBAC)      -->
    <!-- ================================================================= -->
    {
      (canMiembros || canJuridicos || canJuzgamiento) && (
        <section class="dash-band dash-band-3" aria-label="Seguimiento Especializado">
          {
            canMiembros && (
              <div class="band-card band3-card">
                <div class="band-card-head">
                  <div class="band-head-left">
                    <div class="band-head-title-row">
                      <div class="band-icon-wrap emerald">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      </div>
                      <h3 class="band-title">Miembros de Consejo</h3>
                    </div>
                  </div>
                  <a href="/miembros-consejo" class="band-link-btn primary-soft">
                    <span>Gestionar ({dashSnap.miembrosActivosCount} activos) &rarr;</span>
                  </a>
                </div>

                <div class="band3-mini-stats">
                  <div class="band3-stat-box">
                    <span class="band3-stat-val tabular-nums">{dashSnap.miembrosActivosCount}</span>
                    <span class="band3-stat-lbl">Activos vigentes</span>
                  </div>
                  <div class="band3-stat-box">
                    <span class={`band3-stat-val tabular-nums ${dashSnap.miembrosProximosVencer.length > 0 ? 'tone-gold' : ''}`}>
                      {dashSnap.miembrosProximosVencer.length}
                    </span>
                    <span class="band3-stat-lbl">Próx. a vencer &le;30d</span>
                  </div>
                  <div class="band3-stat-box">
                    <span class="band3-stat-val tabular-nums">{dashSnap.miembrosArchivoCount}</span>
                    <span class="band3-stat-lbl">Archivo histórico</span>
                  </div>
                </div>

                {
                  dashSnap.miembrosProximosVencer.length > 0 ? (
                    <div class="band3-alerts-list">
                      {dashSnap.miembrosProximosVencer.slice(0, 3).map((m) => (
                        <a href="/miembros-consejo" class="band3-alert-row">
                          <div class="band3-alert-top">
                            <span class="band3-alert-pill warn">
                              {m.diasRestantes === 0 ? 'Vence Hoy' : `Faltan ${m.diasRestantes}d`}
                            </span>
                            <span class="band3-alert-date tabular-nums">Fin: {m.fecha_fin}</span>
                          </div>
                          <div class="band3-alert-name">{m.nombre_completo} &mdash; {m.cuerpo_colegiado}</div>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <div class="band3-optimal-strip">
                      <span>&#10003; Sin vencimientos en los próximos 30 días</span>
                    </div>
                  )
                }
              </div>
            )
          }

          {
            canJuridicos && (
              <div class="band-card band3-card">
                <div class="band-card-head">
                  <div class="band-head-left">
                    <div class="band-head-title-row">
                      <div class="band-icon-wrap emerald">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
                      </div>
                      <h3 class="band-title">Asuntos Jurídicos</h3>
                    </div>
                  </div>
                  <a href="/asuntos-juridicos" class="band-link-btn primary-soft">
                    <span>Abrir ({dashSnap.totalJuridicos}) &rarr;</span>
                  </a>
                </div>

                <div class="band3-cat-list">
                  <a href="/asuntos-juridicos" class="band3-cat-row">
                    <span>Conceptos Internos</span>
                    <strong class="tabular-nums">{dashSnap.juridicosPorCategoria.conceptos_internos} docs</strong>
                  </a>
                  <a href="/asuntos-juridicos" class="band3-cat-row">
                    <span>Litigios y Asuntos Judiciales</span>
                    <strong class="tabular-nums">{dashSnap.juridicosPorCategoria.litigios_judiciales} docs</strong>
                  </a>
                  <a href="/asuntos-juridicos" class="band3-cat-row">
                    <span>Auditoría de Entes de Control</span>
                    <strong class="tabular-nums">{dashSnap.juridicosPorCategoria.auditoria_entes_control} docs</strong>
                  </a>
                </div>

                <div class="band3-card-footer">
                  {
                    dashSnap.recentJuridicoDocs[0] ? (
                      <>
                        <span class="band3-foot-label">Último indexado:</span>{' '}
                        <strong class="band3-foot-val">{dashSnap.recentJuridicoDocs[0].titulo}</strong>{' '}
                        <span class="band3-foot-cat">
                          ({categoryLabelsMap[dashSnap.recentJuridicoDocs[0].categoria_raiz] || 'Jurídico'})
                        </span>
                      </>
                    ) : (
                      <span class="band3-foot-label">Sin documentos indexados actualmente.</span>
                    )
                  }
                </div>
              </div>
            )
          }

          {
            canJuzgamiento && (
              <div class="band-card band3-card">
                <div class="band-card-head">
                  <div class="band-head-left">
                    <div class="band-head-title-row">
                      <div class="band-icon-wrap gold">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      </div>
                      <h3 class="band-title">Fase de Juzgamiento</h3>
                    </div>
                  </div>
                  <a href="/juzgamiento" class="band-link-btn primary-soft">
                    <span>Ver ({dashSnap.juzgamientoActivosCount}) &rarr;</span>
                  </a>
                </div>

                <div class="band3-mini-stats">
                  <div class="band3-stat-box">
                    <span class="band3-stat-val tabular-nums">{dashSnap.juzgamientoActivosCount}</span>
