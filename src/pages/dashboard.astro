  }
  .widget-header-chip {
    font-size: 0.68rem;
    font-weight: 750;
    color: #00594E;
    background: rgba(0, 89, 78, 0.08);
    padding: 2px 7px;
    border-radius: 4px;
  }

  /* Showcase de Eficacia con Anillo Gauge */
  .efficacy-gauge-showcase {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 16px;
  }

  .circular-gauge-wrapper {
    position: relative;
    width: 96px;
    height: 96px;
    flex-shrink: 0;
  }
  .circular-gauge-svg {
    transform: rotate(-90deg);
  }
  .gauge-track {
    fill: none;
    stroke: #f1f5f9;
  }
  .gauge-fill {
    fill: none;
    stroke: #00594E;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.6s ease-out;
  }
  .gauge-center-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .gauge-number {
    font-size: 1.15rem;
    font-weight: 850;
    color: #0f172a;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .gauge-caption {
    font-size: 0.60rem;
    font-weight: 750;
    color: #64748b;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .efficacy-stats-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .efficacy-metric-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 12px;
  }
  .metric-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .metric-dot.green { background: #00594E; }
  .metric-dot.gold { background: #B5A160; }

  .efficacy-metric-num {
    font-size: 1.15rem;
    font-weight: 850;
    color: #0f172a;
    line-height: 1;
    display: block;
  }
  .efficacy-metric-label {
    font-size: 0.70rem;
    font-weight: 600;
    color: #64748b;
  }

  .efficacy-progress-section {
    margin-bottom: 14px;
  }
  .progress-legend {
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
  }
  .progress-val-accent {
    font-size: 0.82rem;
    font-weight: 850;
    color: #00594E;
  }
  .promax-track {
    height: 8px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
    margin-top: 6px;
  }
  .promax-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #B5A160 0%, #00594E 100%);
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
