                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      </div>

                      <div class="audit-feed-list">
                        {
                          dashSnap.auditActividadReciente.length > 0 ? (
                            dashSnap.auditActividadReciente.slice(0, 6).map((item) => (
                              <div class="audit-feed-row">
                                <div class="audit-avatar-badge" title={item.actorName}>
                                  {item.initials}
                                </div>
                                <div class="audit-row-content">
                                  <div class="audit-row-top">
                                    <span class="audit-actor-name">{item.actorName}</span>
                                    <span class="audit-time-label tabular-nums">{item.timestamp}</span>
                                  </div>
                                  <p class="audit-action-text">{item.actionTitle}</p>
                                  <div class="audit-badges-row">
                                    <span class="audit-entity-chip">{item.entity}</span>
                                    {item.esExpediente && item.esEliminacion && (
                                      <span class="audit-warning-chip">Expediente eliminado</span>
                                    )}
                                    {item.esExpediente && !item.esEliminacion && (
                                      <span class="audit-exp-chip">Expediente</span>
                                    )}
                                  </div>
                                </div>
                              </div>
                            ))
                          ) : (
                            <p class="empty-desc" style="margin: 8px 0;">Sin actividad de auditoría reciente registrada.</p>
                          )
                        }
                      </div>
                    </div>
                  )
                }

              </aside>
            )
          }

        </div>
      )
    }

    <!-- ================================================================= -->
    <!-- SECCIÓN D: AGENDA UNIFICADA (VISIBLE CON PERMISO AGENDA)          -->
