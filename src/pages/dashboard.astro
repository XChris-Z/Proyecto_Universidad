    font-size: 0.76rem;
    font-weight: 750;
    padding: 7px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.18s ease;
  }
  .btn-promax-card-action:hover {
    background: #00594E;
    color: #ffffff;
    border-color: #00594E;
    box-shadow: 0 4px 10px rgba(0, 89, 78, 0.2);
  }

  /* Estado vacío */
  .bento-empty-state {
    text-align: center;
    padding: 38px 20px;
    background: #f8fafc;
    border-radius: 14px;
    border: 1px dashed #cbd5e1;
  }
  .empty-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px auto;
  }
  .empty-icon-wrap.neutral {
    background: #f1f5f9;
    color: #94a3b8;
  }
  .empty-title {
    font-size: 0.96rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px 0;
  }
  .empty-desc {
    font-size: 0.80rem;
    color: #64748b;
    margin: 0;
  }

  /* ==========================================================================
     COLUMNA DERECHA: EFICACIA Y TÉRMINOS SLA
     ========================================================================== */
  .bento-side-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bento-widget-card {
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }

  .widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
  }
  .widget-title-text {
    font-size: 0.98rem;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.01em;
  }
  .promax-efficacy-pill {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 999px;
    background: #F2F7F6;
    color: #00594E;
    border: 1px solid #B2CFCB;
