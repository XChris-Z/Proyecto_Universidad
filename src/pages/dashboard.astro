  /* ==========================================================================
     ANIMACIONES DE MOVIMIENTO: CROSSFADE & SHARED ELEMENT
     ========================================================================== */
  ::view-transition-old(dash-sla-pill),
  ::view-transition-new(dash-sla-pill) {
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.crossfade-enter) {
    animation: proMaxDashFadeEnter 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  :global(.crossfade-leave) {
    animation: proMaxDashFadeLeave 100ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes proMaxDashFadeEnter {
    from {
      opacity: 0;
      transform: scale(0.98) translateY(3px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
    }
  }

  @keyframes proMaxDashFadeLeave {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
    }
    to {
      opacity: 0;
      transform: scale(0.99) translateY(-2px);
      filter: blur(2px);
    }
  }
</style>

<script>
  import { initDashboard } from "@scripts/dashboard";

  // 1. Inicializar lógica existente de tiempo real en Dashboard
  initDashboard();

  // 2. Control Segmentado Interactivo con Shared Element Slider & Crossfade
  const filterBtns = document.querySelectorAll(".dash-seg-btn");
  const indicator = document.getElementById("dash-seg-indicator");
  let activeFilter = "all";

  function updateSegmentIndicator(activeBtn: HTMLElement) {
    if (!indicator || !activeBtn) return;
    const parent = activeBtn.parentElement;
    if (!parent) return;
    const parentRect = parent.getBoundingClientRect();
    const btnRect = activeBtn.getBoundingClientRect();
    indicator.style.width = `${btnRect.width}px`;
    indicator.style.transform = `translateX(${btnRect.left - parentRect.left}px)`;
  }

  // Inicializar posición de píldora
  const initialActive = document.querySelector(".dash-seg-btn.active") as HTMLElement | null;
  if (initialActive) {
    updateSegmentIndicator(initialActive);
  }

  function filterRepartoCards(filter: string) {
    activeFilter = filter;
    const container = document.getElementById("dashboard-critical-list");
    if (!container) return;

    const cards = container.querySelectorAll(".band1-doc-card");
    let visibleCount = 0;

    const applyFilter = () => {
      cards.forEach((cardEl: Element) => {
        const card = cardEl as HTMLElement;
        const cat = card.getAttribute("data-status-category");
        const show = filter === "all" || cat === filter;
        if (show) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      const emptyMsg = document.getElementById("dash-filter-empty-state");
      if (emptyMsg) {
        emptyMsg.style.display = visibleCount === 0 ? "block" : "none";
      }
    };

    if (typeof document !== "undefined" && "startViewTransition" in document) {
      try {
        (document as any).startViewTransition(() => {
          applyFilter();
        });
        return;
      } catch {
        // Fallback
      }
    }

    // Fallback CSS Crossfade
    container.classList.add("crossfade-leave");
    setTimeout(() => {
      applyFilter();
      container.classList.remove("crossfade-leave");
      container.classList.add("crossfade-enter");
      setTimeout(() => container.classList.remove("crossfade-enter"), 260);
    }, 80);
  }

  const slaTriggerCards = document.querySelectorAll("[data-sla-trigger]");
  function syncSlaLegendState(target: string) {
    slaTriggerCards.forEach((el) => {
      el.classList.toggle("is-active", el.getAttribute("data-sla-trigger") === target);
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      updateSegmentIndicator(btn as HTMLElement);
      const targetFilter = btn.getAttribute("data-filter") || "all";
      syncSlaLegendState(targetFilter);
      filterRepartoCards(targetFilter);
    });
  });

  // Reposicionar indicador en cambio de tamaño de ventana
  window.addEventListener("resize", () => {
    const curActive = document.querySelector(".dash-seg-btn.active") as HTMLElement | null;
    if (curActive) updateSegmentIndicator(curActive);
  });

  // 3. Conexión de clic en Semáforo SLA derecho con Banda 1 izquierda
  slaTriggerCards.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const targetSla = trigger.getAttribute("data-sla-trigger");
      if (!targetSla) return;

      const matchingBtn = document.querySelector(`.dash-seg-btn[data-filter="${targetSla}"]`) as HTMLElement | null;
      const allBtn = document.querySelector('.dash-seg-btn[data-filter="all"]') as HTMLElement | null;

      if (activeFilter === targetSla && allBtn) {
        allBtn.click();
      } else if (matchingBtn) {
        matchingBtn.click();
      } else {
        filterBtns.forEach((b) => b.classList.remove("active"));
        syncSlaLegendState(targetSla);
        filterRepartoCards(targetSla);
      }
    });
  });

  // 4. Disparo automático silencioso de recordatorios preventivos a dependencias (<= 3 días, solo con permiso Peticiones)
  const workspaceEl = document.querySelector(".dash-promax-workspace");
  if (workspaceEl?.getAttribute("data-can-peticiones") === "true") {
    setTimeout(() => {
      fetch('/api/peticiones/recordatorio-dependencias', { method: 'POST' })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (data?.remindersSent > 0 && typeof (window as any).showToast === 'function') {
            (window as any).showToast(
              `Se enviaron ${data.remindersSent} recordatorio(s) preventivo(s) por vencimiento próximo a dependencias pendientes.`,
              'info',
              'Recordatorios Automáticos'
            );
          }
        })
        .catch(() => {});
    }, 600);
  }
</script>
