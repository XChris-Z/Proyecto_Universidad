    .normas-select-vigencia:focus {
      outline: none;
      border-color: #00594E;
      box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
    }

    .normas-visible-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      height: 38px;
      padding: 0 12px;
      border-radius: 10px;
      background: #F7F5EE;
      border: 1px solid #DBD2B0;
      color: #786832;
      font-size: 0.78rem;
      font-weight: 600;
      white-space: nowrap;
    }

    /* Scrollbar propia .pro-scroll-container + Sticky Header */
    .normas-scroll-box {
      max-height: 540px;
      overflow-y: auto;
      overflow-x: auto;
      border: 1px solid #DCE4E3;
      border-radius: 12px;
      background: #FFFFFF;
    }

    .normas-scroll-box.normas-crossfade-in {
      animation: normasCrossfade 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes normasCrossfade {
      from {
        opacity: 0.4;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .normas-pro-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .normas-pro-table thead th {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #F2F7F6;
      color: #00594E;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid #B2CFCB;
      white-space: normal;
      line-height: 1.25;
      vertical-align: middle;
    }

    .normas-scroll-box :global(.normas-pro-table tbody tr) {
      display: table-row;
      border-radius: 0;
      border: none;
      padding: 0;
      position: static;
      overflow: visible;
      background: transparent;
      transform: none;
      box-shadow: none;
    }

    .normas-scroll-box :global(.normas-pro-table tbody tr::before) {
      content: none !important;
      display: none !important;
    }

    .normas-scroll-box :global(.normas-pro-table tbody td) {
      display: table-cell;
      padding: 14px 16px;
      border-bottom: 1px solid #EEF2F5;
      vertical-align: middle;
      font-size: 0.83rem;
      color: #111827;
      min-width: 0;
      overflow-wrap: break-word;
    }

    .normas-scroll-box :global(.normas-pro-table tbody tr:hover) {
      background: #F8FAFC;
    }

    .normas-scroll-box :global(.normas-pro-table tbody tr:last-child td) {
      border-bottom: none;
    }

    @media (min-width: 1024px) {
      .normas-scroll-box {
        overflow-x: hidden;
      }

      .normas-scroll-box :global(.normas-pro-table tbody tr:not([hidden]):not(.is-hidden-row):not(.hidden)) {
        display: table-row;
      }

      .normas-scroll-box :global(.normas-pro-table tbody td) {
        display: table-cell !important;
        vertical-align: middle !important;
        padding: 14px 16px;
        border-bottom: 1px solid #EEF2F5;
      }
    }

    .normas-scroll-box :global(.normas-pro-table tbody tr[hidden]),
    .normas-scroll-box :global(.normas-pro-table tbody tr.is-hidden-row),
    .normas-scroll-box :global(.normas-pro-table tbody tr.hidden) {
      display: none !important;
    }

    .normas-scroll-box :global(.norma-vig-cell) {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
