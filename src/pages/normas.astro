    }

    .btn-normas-primary:hover {
      background: #00443B;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(0, 89, 78, 0.25);
    }

    /* Bento KPI Strip */
    .normas-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .normas-kpi-card {
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-radius: 14px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 2px 8px rgba(17, 24, 39, 0.025);
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .normas-kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 89, 78, 0.08);
    }

    .normas-kpi-card.accent-verde {
      border-top: 3px solid #00594E;
    }

    .normas-kpi-card.accent-dorado {
      border-top: 3px solid #B5A160;
    }

    .normas-kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .normas-kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #475569;
    }

    .normas-kpi-icon {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .normas-kpi-icon.verde {
      background: #F2F7F6;
      color: #00594E;
      border: 1px solid #B2CFCB;
    }

    .normas-kpi-icon.dorado {
      background: #F7F5EE;
      color: #786832;
      border: 1px solid #DBD2B0;
    }

    .normas-kpi-value {
      font-size: 1.75rem;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.025em;
      line-height: 1.1;
      font-variant-numeric: tabular-nums;
    }

    .normas-chart-block {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding-top: 8px;
      border-top: 1px solid #F1F5F9;
    }

    .normas-chart-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.72rem;
      color: #64748B;
      gap: 8px;
    }

    .normas-chart-track {
      width: 100%;
      height: 6px;
      background: #E2E8F0;
      border-radius: 999px;
      overflow: hidden;
    }

    .normas-chart-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Panel Principal */
    .normas-main-panel {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 0;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .normas-tabs-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-bottom: 12px;
      border-bottom: 1px solid #DCE4E3;
    }

    .normas-tabs-bar .module-tab-btn {
      border: 1px solid #DCE4E3;
      border-bottom: 1px solid #DCE4E3;
      background: #F8FAFC;
      color: #475569;
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      gap: 7px;
      transition: all 0.18s ease;
    }

    .normas-tabs-bar .module-tab-btn:hover {
      background: #F2F7F6;
      color: #00594E;
      border-color: #B2CFCB;
    }

    .normas-tabs-bar .module-tab-btn.active {
      background: #00594E;
      color: #FFFFFF;
      border-color: #00594E;
      box-shadow: 0 3px 10px rgba(0, 89, 78, 0.2);
    }

    .normas-tabs-bar .module-tab-btn .tab-count {
      background: #FFFFFF;
      color: #00594E;
      border: 1px solid #DCE4E3;
      font-size: 0.7rem;
      padding: 1px 7px;
    }

    .normas-tabs-bar .module-tab-btn.active .tab-count {
      background: rgba(255, 255, 255, 0.2);
      color: #FFFFFF;
      border-color: transparent;
    }

    .normas-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .normas-search-wrap {
      flex: 1;
      min-width: 260px;
      position: relative;
      display: flex;
      align-items: center;
    }

    .normas-search-wrap svg {
      position: absolute;
      left: 12px;
      color: #64748B;
      pointer-events: none;
    }

    .normas-search-wrap input {
      width: 100%;
      height: 38px;
      padding: 0 12px 0 36px;
      border-radius: 10px;
      border: 1px solid #DCE4E3;
      background: #F8FAFC;
      font-size: 0.84rem;
      color: #111827;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }

    .normas-search-wrap input:focus {
      outline: none;
      background: #FFFFFF;
      border-color: #00594E;
      box-shadow: 0 0 0 3px rgba(0, 89, 78, 0.12);
    }

    .normas-toolbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .normas-select-vigencia {
      height: 38px;
      padding: 0 12px;
      border-radius: 10px;
      border: 1px solid #DCE4E3;
      background: #FFFFFF;
      font-size: 0.82rem;
      font-weight: 600;
      color: #111827;
      cursor: pointer;
