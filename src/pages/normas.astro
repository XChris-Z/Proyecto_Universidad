      <div class="modal-header" style="border-bottom: 1px solid #DCE4E3; background: #F7F5EE; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 34px; height: 34px; border-radius: 9px; background: #B5A160; color: #003830; display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
          </div>
          <h3 style="margin: 0; font-size: 1.02rem; font-weight: 800; color: #111827;">Importar Normativa desde Excel (.XLSX)</h3>
        </div>
        <button type="button" class="btn-close-modal" id="btn-close-excel-modal" aria-label="Cerrar modal" style="background: none; border: none; cursor: pointer; color: #64748B;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body" style="padding: 22px;">
        <div id="excel-dropzone" style="border: 2px dashed #B5A160; border-radius: 12px; padding: 30px 20px; text-align: center; background: #FDFCF9; transition: all 0.2s ease;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#786832" stroke-width="1.8" style="margin: 0 auto 10px auto;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          <div style="font-weight: 700; font-size: 0.92rem; color: #111827;">Arrastre su archivo de Excel o CSV aquí</div>
          <div style="font-size: 0.76rem; color: #64748B; margin-top: 4px;">Soporta archivos .xlsx y .csv (CSU, CA y Rectoría)</div>
          <input type="file" id="excel-file-input" accept=".xlsx,.xls,.csv" style="display: none;" />
          <button type="button" id="btn-browse-excel" class="btn btn-secondary btn-sm" style="margin-top: 14px; background: #FFFFFF; border: 1.5px solid #B5A160; color: #786832; font-weight: 700; border-radius: 8px; padding: 7px 16px; cursor: pointer;">
            Examinar Hoja de Cálculo
          </button>
          <div id="excel-file-name" style="font-size: 0.78rem; font-weight: 700; color: #00594E; margin-top: 10px; display: none;"></div>
        </div>
        <div style="margin-top: 16px; background: #F2F7F6; border: 1px solid #B2CFCB; border-radius: 8px; padding: 12px 14px; font-size: 0.74rem; color: #00443B;">
          <strong>Estructura esperada:</strong> Columnas de <em>Año, Cuerpo Colegiado, Tipo de Acto, Número, Fecha de Expedición, Asunto / Título, Descriptor Temático</em>.
        </div>
        <div class="modal-footer" style="padding: 16px 0 0 0; border-top: 1px solid #DCE4E3; margin-top: 16px; display: flex; justify-content: flex-end; gap: 10px;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-excel">Cancelar</button>
          <button type="button" class="btn btn-primary" id="btn-submit-excel" style="background: #00594E; border-color: #00594E; color: #FFFFFF; font-weight: 700; border-radius: 8px; padding: 8px 18px; cursor: pointer;">Preparar Mapeo de Columnas</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .normas-year-pill {
      all: unset;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      padding: 5px 13px;
      font-size: 0.74rem;
      font-weight: 700;
      color: #64748B;
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.16s ease;
      user-select: none;
    }
    .normas-year-pill:hover {
      background: #F2F7F6;
      color: #00594E;
      border-color: #00594E;
    }
    .normas-year-pill.active {
      background: #00594E;
      color: #FFFFFF;
      border-color: #00594E;
      box-shadow: 0 2px 6px rgba(0, 89, 78, 0.25);
    }

    .normas-bento-shell {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .normas-hero-bento {
      background: transparent;
      border: none;
      border-bottom: 1px solid #EEF2F5;
      padding: 0 0 16px 0;
      border-radius: 0;
      box-shadow: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .normas-eyebrow-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: #786832;
      background: #F7F5EE;
      border: 1px solid #DBD2B0;
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 8px;
    }

    .normas-hero-title {
      margin: 0;
      font-size: 1.28rem;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.02em;
    }

    .normas-hero-subtitle {
      margin: 4px 0 0 0;
      font-size: 0.85rem;
      color: #475569;
      max-width: 680px;
      line-height: 1.45;
    }

    .btn-normas-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 10px;
      border: none;
      background: #00594E;
      color: #FFFFFF;
      font-size: 0.84rem;
      font-weight: 700;
