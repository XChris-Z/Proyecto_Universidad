---
// src/pages/normas.astro
export const prerender = false;

import AppLayout from '@layouts/AppLayout.astro';
import { supabase, supabaseAdmin } from '@lib/supabase';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

const db = (supabaseAdmin || supabase) as any;

// Consultar normas oficiales reales desde Supabase
const { data: dbNormas } = await db
  .from('colegiados_normas')
  .select('*')
  .order('created_at', { ascending: false });

const rawNormas = Array.isArray(dbNormas) ? dbNormas : [];
const todayBogotaYmd = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Bogota',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

function normalizeYmd(raw: string | null | undefined): string {
  if (!raw) return '';
  const m = String(raw).trim().match(/^(\d{4}-\d{2}-\d{2})/);
  return m?.[1] || '';
}

function getOrganStyle(code: string) {
  switch (String(code || '').toLowerCase()) {
    case 'csu':
      return {
        label: 'CSU',
        bg: '#F2F7F6',
        text: '#00594E',
        border: '#B2CFCB',
      };
    case 'ca':
      return {
        label: 'Consejo Académico',
        bg: '#F7F5EE',
        text: '#786832',
        border: '#DBD2B0',
      };
    case 'rectoria':
      return {
        label: 'Rectoría',
        bg: '#E8F2F0',
        text: '#00443B',
        border: '#9DC4BE',
      };
    case 'electoral':
      return {
        label: 'Consejo Electoral',
        bg: '#FAF7ED',
        text: '#786832',
        border: '#D5C694',
      };
    default:
      return {
        label: 'Colegiado',
        bg: '#F8FAFC',
        text: '#475569',
        border: '#DCE4E3',
      };
  }
}

function getVigenciaStyle(vig: string | null | undefined, fechaFin?: string | null) {
  const lower = String(vig || 'vigente').toLowerCase().trim();
  const finYmd = normalizeYmd(fechaFin);

  if (lower.includes('derogad') || lower.includes('modificad')) {
    return {
      key: 'derogado',
      label: 'Derogado',
      bg: '#FFFBEB',
      text: '#B45309',
      border: '#FDE68A',
      dot: '#D97706',
    };
  }
  if (
    lower === 'no_vigente' ||
    lower === 'no vigente' ||
    lower === 'vencido' ||
    (finYmd !== '' && finYmd < todayBogotaYmd)
  ) {
    return {
      key: 'no_vigente',
      label: 'No Vigente',
      bg: '#FEF2F2',
      text: '#B91C1C',
      border: '#FECACA',
      dot: '#DC2626',
    };
  }
  return {
    key: 'vigente',
    label: 'Vigente',
    bg: '#F2F7F6',
    text: '#00594E',
    border: '#B2CFCB',
    dot: '#00594E',
  };
}

const normasView = rawNormas.map((norma: any) => {
  const fechaVal = normalizeYmd(norma.fecha_expedicion || norma.fecha);
  const fechaFinVal = normalizeYmd(norma.fecha_fin_vigencia);
  const anioCalculado =
    norma.anio || norma.year || (fechaVal ? fechaVal.split('-')[0] : '2026');
  const organoCode = String(norma.organo_code || '').toLowerCase().trim();
  const organo = String(norma.cuerpo_colegiado || norma.organo || '').trim();
  const tipo = String(norma.tipo_acto || norma.tipo || '').trim();
  const numero = String(norma.numero_acto || norma.numero || '').trim();
  const titulo = String(norma.asunto || norma.titulo || '').trim();
  const vigStyle = getVigenciaStyle(norma.vigencia, fechaFinVal);

  return {
    ...norma,
    id: String(norma.id),
    organo_code: organoCode,
    year: String(anioCalculado),
    organo,
    tipo,
    numero,
    titulo,
    fecha: fechaVal || String(norma.fecha_expedicion || norma.fecha || ''),
    fecha_fin_vigencia: fechaFinVal,
    organStyle: getOrganStyle(organoCode),
    vigStyle,
  };
});

const total = normasView.length;
const csuCount = normasView.filter((n: any) => n.organo_code === 'csu').length;
const caCount = normasView.filter((n: any) => n.organo_code === 'ca').length;
const recCount = normasView.filter((n: any) => n.organo_code === 'rectoria').length;

const vigentesCount = normasView.filter((n: any) => n.vigStyle.key === 'vigente').length;
const vigentesPct = total > 0 ? Math.round((vigentesCount / total) * 100) : 0;
const csuPct = total > 0 ? Math.round((csuCount / total) * 100) : 0;
const caPct = total > 0 ? Math.round((caCount / total) * 100) : 0;
const recPct = total > 0 ? Math.round((recCount / total) * 100) : 0;

const normasJson = JSON.stringify(normasView);
---

<AppLayout title="Cuerpos Colegiados" activeNav="normas">
  <section class="module-board-card normas-bento-shell">
    <!-- Cabecera Ejecutiva Bento -->
    <header class="normas-hero-bento">
      <div class="normas-hero-info">
        <div class="normas-eyebrow-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>COMPENDIO NORMATIVO INSTITUCIONAL</span>
        </div>
        <h2 class="normas-hero-title">Cuerpos Colegiados</h2>
        <p class="normas-hero-subtitle">
          Repositorio oficial de acuerdos y resoluciones expedidos por el Consejo Superior Universitario, Consejo Académico y Rectoría.
        </p>
      </div>

      <div class="normas-hero-actions" style="display: flex; align-items: center; gap: 10px;">
        <button class="btn-normas-secondary" id="btn-open-excel-modal" type="button" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; background: #F7F5EE; border: 1.5px solid #B5A160; color: #786832; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.2s ease;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>Importar Excel (.xlsx)</span>
        </button>
        <button class="btn-normas-primary" id="btn-open-new-norma-modal" type="button">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M12 5v14M5 12h14"/></svg>
          <span>Radicar Nuevo Acto / Norma</span>
        </button>
      </div>
    </header>

    <!-- Bento KPI Strip con Chart Elements -->
    <section class="normas-kpi-grid" aria-label="Resumen por cuerpo colegiado">
      <article class="normas-kpi-card accent-verde">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Total Actos Sistematizados</span>
          <span class="normas-kpi-icon verde">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value" id="normas-kpi-total">{total}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Estado vigente</span>
            <strong id="normas-kpi-vigentes-text" style="color: #00594E;">{vigentesCount} ({vigentesPct}%)</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" id="normas-kpi-vigentes-bar" style={`width: ${vigentesPct}%; background: #00594E;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-verde">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Consejo Superior (CSU)</span>
          <span class="normas-kpi-icon verde">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{csuCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Participación CSU</span>
            <strong style="color: #00594E;">{csuPct}% del compendio</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${csuPct}%; background: #00594E;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-dorado">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Consejo Académico (CA)</span>
          <span class="normas-kpi-icon dorado">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{caCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Participación CA</span>
            <strong style="color: #786832;">{caPct}% del compendio</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${caPct}%; background: #B5A160;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-dorado">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Rectoría</span>
          <span class="normas-kpi-icon dorado">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{recCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Resoluciones y Actos Rectorales</span>
            <strong style="color: #786832;">{recPct}% del compendio</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${recPct}%; background: #B5A160;`}></div>
          </div>
        </div>
      </article>
    </section>

    <!-- Panel Principal Bento: Filtros + Tabla Scrollable Pro Max -->
    <section class="normas-main-panel">
      <!-- Píldoras Interactivas por Órgano Colegiado -->
      <div class="normas-tabs-bar" id="normas-module-tabs" role="tablist" aria-label="Filtrar por cuerpo colegiado">
        <button type="button" class="module-tab-btn active" data-org="all">
          <span>Todos los Órganos</span>
          <span class="tab-count" id="normas-count-all">{total}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="csu">
          <span>Consejo Superior (CSU)</span>
          <span class="tab-count" id="normas-count-csu">{csuCount}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="ca">
          <span>Consejo Académico (CA)</span>
          <span class="tab-count" id="normas-count-ca">{caCount}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="rectoria">
          <span>Rectoría</span>
          <span class="tab-count" id="normas-count-rectoria">{recCount}</span>
        </button>
      </div>

      <!-- Filtro Histórico por Año (desde 2021 en adelante) -->
      <div class="normas-year-pills" id="normas-year-tabs" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px; margin-bottom: 4px; padding: 4px 2px;">
        <span style="font-size: 0.74rem; font-weight: 700; color: #64748B; text-transform: uppercase; margin-right: 2px;">Año:</span>
        <button type="button" class="normas-year-pill active" data-year="all">Todos</button>
        <button type="button" class="normas-year-pill" data-year="2026">2026</button>
        <button type="button" class="normas-year-pill" data-year="2025">2025</button>
        <button type="button" class="normas-year-pill" data-year="2024">2024</button>
        <button type="button" class="normas-year-pill" data-year="2023">2023</button>
        <button type="button" class="normas-year-pill" data-year="2022">2022</button>
        <button type="button" class="normas-year-pill" data-year="2021">2021</button>
      </div>

      <!-- Barra de Búsqueda y Vigencia -->
      <div class="normas-toolbar">
        <div class="normas-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="text"
            id="normas-search-input"
            placeholder="Buscar por número (Ej: Acuerdo 014), descriptor temático o palabra clave..."
          />
        </div>

        <div class="normas-toolbar-right">
          <select class="normas-select-vigencia" id="normas-filter-vigencia" aria-label="Filtrar por vigencia">
            <option value="all" selected>Todas las Vigencias</option>
            <option value="vigente">Vigente</option>
            <option value="no_vigente">No Vigente / Vencido</option>
            <option value="derogado">Derogado / Modificado</option>
          </select>

          <div class="normas-visible-badge">
            <span>Mostrando</span>
            <strong id="normas-visible-count">{total}</strong>
            <span>de {total}</span>
          </div>
        </div>
      </div>

      <!-- Contenedor con Scrollbar Propia (.pro-scroll-container) y Cabecera Sticky -->
      <div class="normas-scroll-box pro-scroll-container" id="normas-scroll-container">
        {normasView.length > 0 ? (
          <table class="normas-pro-table">
            <thead>
              <tr>
                <th style="width: 17%;">Órgano Colegiado</th>
                <th style="width: 12%;">Acto / Consecutivo</th>
                <th style="width: 24%;">Título Oficial y Descriptor Temático</th>
                <th style="width: 16%;">Expedición y Signatarios</th>
                <th style="width: 12%;">Vigencia</th>
                <th style="width: 19%; text-align: right;">Documento</th>
              </tr>
            </thead>
            <tbody id="normas-table-body">
              {normasView.map((norma: any) => (
                <tr
                  class="norma-row"
                  data-id={norma.id}
                  data-org={norma.organo_code}
                  data-vigencia={norma.vigStyle.key}
                  data-year={norma.year}
                  data-search={`${norma.numero} ${norma.tipo} ${norma.titulo} ${norma.descriptor || ''} ${norma.resumen || ''} ${norma.organo || ''} ${norma.signatarios || ''} ${norma.year}`.toLowerCase()}
                >
                  <td>
                    <span
                      class="norma-organ-pill"
                      style={`background: ${norma.organStyle.bg}; color: ${norma.organStyle.text}; border: 1px solid ${norma.organStyle.border};`}
                    >
                      {norma.organo || norma.organStyle.label}
                    </span>
                  </td>
                  <td>
                    <div class="norma-consecutivo-wrap">
                      <span class="norma-numero-chip">{norma.numero}</span>
                      <span class="norma-tipo-label">{norma.tipo}</span>
                    </div>
                  </td>
                  <td>
                    <div class="norma-titulo-main">{norma.titulo}</div>
                    <div class="norma-meta-sub">
                      {norma.descriptor && (
                        <span class="norma-descriptor-tag">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                          <span>{norma.descriptor}</span>
                        </span>
                      )}
                      {norma.resumen && norma.resumen !== norma.titulo && (
                        <span class="norma-resumen-text">{norma.resumen}</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <div class="norma-fecha-line">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      <span>{norma.fecha || 'Sin fecha'}</span>
                    </div>
                    <div class="norma-signatario-line">{norma.signatarios || 'Secretaría General'}</div>
                  </td>
                  <td>
                    <div class="norma-vig-cell">
                      <span
                        class="norma-vigencia-badge"
                        style={`background: ${norma.vigStyle.bg}; color: ${norma.vigStyle.text}; border: 1px solid ${norma.vigStyle.border};`}
                      >
                        <span class="norma-vig-dot" style={`background: ${norma.vigStyle.dot};`}></span>
                        <span>{norma.vigStyle.label}</span>
                      </span>
                      {norma.fecha_fin_vigencia && (
                        <span class="norma-vig-fin-sub">Hasta: {norma.fecha_fin_vigencia}</span>
                      )}
                    </div>
                  </td>
                  <td style="text-align: right;">
                    <div class="norma-doc-actions">
                      {norma.archivo_url ? (
                        <>
                          <a
                            href={norma.archivo_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-norma-download"
                            title={`Ver documento: ${norma.archivo_nombre || 'PDF'}`}
                            style="text-decoration: none;"
                          >
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <span>Ver</span>
                          </a>
                          <a
                            href={norma.archivo_url}
                            download={norma.archivo_nombre || `${norma.tipo}_${norma.numero}.pdf`}
                            class="btn-norma-download"
                            title="Descargar documento"
                            style="text-decoration: none;"
                          >
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            <span>Descargar</span>
                          </a>
                        </>
                      ) : null}
                      <button
                        type="button"
                        class="btn-norma-download btn-norma-edit"
                        data-id={norma.id}
                        title={`Editar acto y vigencia: ${norma.tipo} ${norma.numero}`}
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        <span>Editar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
              <tr id="normas-filter-empty-row" class="normas-filter-empty-row is-hidden-row">
                <td colspan="6">
                  <div class="normas-empty-state" style="padding: 36px 16px;">
                    <div class="normas-empty-icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    </div>
                    <div class="normas-empty-title">No hay actos que coincidan con los filtros seleccionados</div>
                    <p class="normas-empty-desc">Ajuste el órgano colegiado, año, vigencia o términos de búsqueda.</p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        ) : (
          <div class="normas-empty-state">
            <div class="normas-empty-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div class="normas-empty-title">No hay actos ni normas sistematizadas actualmente</div>
            <p class="normas-empty-desc">Utilice el botón superior para radicar el primer acto administrativo oficial.</p>
          </div>
        )}
      </div>
    </section>
  </section>

  <!-- Modal Unificado: Radicar Nuevo Acto / Editar Acto y Vigencia -->
  <div class="modal-backdrop" id="new-norma-modal" style="display: none;">
    <div class="modal-card normas-modal-card" style="max-width: 620px;">
      <div class="modal-header" style="border-bottom: 1px solid #DCE4E3; background: #F2F7F6;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 34px; height: 34px; border-radius: 9px; background: #00594E; color: #FFFFFF; display: flex; align-items: center; justify-content: center;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          </div>
          <h3 id="norma-modal-title" style="margin: 0; font-size: 1.02rem; font-weight: 800; color: #111827;">Radicar Nuevo Acto / Norma</h3>
        </div>
        <button type="button" class="btn-close-modal" id="btn-close-new-norma-modal" aria-label="Cerrar modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="form-new-norma">
          <input type="hidden" id="norma-edit-id" value="" />

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Cuerpo Colegiado *</label>
              <select class="form-select normas-input" id="new-norma-organo" required>
                <option value="csu">Consejo Superior Universitario (CSU)</option>
                <option value="ca">Consejo Académico (CA)</option>
                <option value="rectoria">Rectoría (Resolución Rectoral)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Año del Acto *</label>
              <select class="form-select normas-input" id="new-norma-year" required>
                <option value="2026">2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
                <option value="2023">2023</option>
                <option value="2022">2022</option>
                <option value="2021">2021</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Tipo de Acto *</label>
              <input type="text" class="form-input normas-input" id="new-norma-tipo" placeholder="Ej: Acuerdo o Resolución" required />
            </div>
            <div class="form-group">
              <label class="form-label">Número / Consecutivo *</label>
              <input type="text" class="form-input normas-input" id="new-norma-numero" placeholder="Ej: Acuerdo 015" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Título Oficial / Asunto *</label>
            <textarea class="form-textarea normas-input" id="new-norma-titulo" rows="2" placeholder="Por el cual se adopta..." required></textarea>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Fecha de Expedición *</label>
              <input type="date" class="form-input normas-input" id="new-norma-fecha" required />
            </div>
            <div class="form-group">
              <label class="form-label">Fecha Fin de Vigencia (Opcional)</label>
              <input type="date" class="form-input normas-input" id="new-norma-fecha-fin" />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Estado de Vigencia *</label>
              <select class="form-select normas-input" id="new-norma-vigencia" required>
                <option value="Vigente">Vigente</option>
                <option value="No Vigente">No Vigente</option>
                <option value="Derogado / Modificado">Derogado / Modificado</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Descriptor Temático</label>
              <input type="text" class="form-input normas-input" id="new-norma-descriptor" placeholder="Ej: Régimen Profesoral" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Documento Soporte Oficial (PDF o DOCX)</label>
            <div style="border: 1.5px dashed #B2CFCB; border-radius: 10px; padding: 14px; background: #F8FAFB; text-align: center;">
              <input type="file" id="new-norma-archivo" accept=".pdf,.docx" style="display: none;" />
              <button type="button" id="btn-browse-norma-archivo" class="btn btn-secondary btn-sm" style="background: #FFFFFF; border: 1.5px solid #00594E; color: #00594E; font-weight: 700; padding: 6px 14px; border-radius: 8px; cursor: pointer;">
                Seleccionar Documento (PDF / DOCX)
              </button>
              <div id="norma-archivo-label" style="font-size: 0.74rem; color: #64748B; margin-top: 6px;">
                Ningún documento adjunto (opcional)
              </div>
            </div>
          </div>

          <div class="modal-footer" style="padding: 14px 0 0 0; border-top: 1px solid #DCE4E3; margin-top: 6px;">
            <button type="button" class="btn btn-ghost" id="btn-cancel-norma">Cancelar</button>
            <button type="submit" class="btn-normas-primary" id="btn-submit-norma">Guardar Acto</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Datos de Normas serializados para edición instantánea -->
  <script id="normas-data-json" type="application/json" is:inline set:html={normasJson}></script>

  <!-- Modal para Importar Excel (.XLSX) -->
  <div class="modal-backdrop" id="excel-import-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(2px);">
