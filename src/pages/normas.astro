---
// src/pages/normas.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';

// Consultar normas oficiales reales desde Supabase
const { data: dbNormas } = await (supabase
  .from('colegiados_normas' as any)
  .select('*')
  .order('created_at', { ascending: false }) as any);

const rawNormas = Array.isArray(dbNormas) ? dbNormas : [];
const total = rawNormas.length;
const csuCount = rawNormas.filter((n: any) => n.organo_code === 'csu').length;
const caCount = rawNormas.filter((n: any) => n.organo_code === 'ca').length;
const recCount = rawNormas.filter((n: any) => n.organo_code === 'rectoria').length;
const eleCount = rawNormas.filter((n: any) => n.organo_code === 'electoral').length;

const vigentesCount = rawNormas.filter((n: any) => String(n.vigencia || '').toLowerCase() === 'vigente').length;
const vigentesPct = total > 0 ? Math.round((vigentesCount / total) * 100) : 0;
const csuPct = total > 0 ? Math.round((csuCount / total) * 100) : 0;
const caPct = total > 0 ? Math.round((caCount / total) * 100) : 0;
const otrosCount = recCount + eleCount;
const recPct = total > 0 ? Math.round((recCount / total) * 100) : 0;
const elePct = total > 0 ? Math.round((eleCount / total) * 100) : 0;

function getOrganStyle(code: string) {
  switch (code) {
    case 'csu':
      return {
        label: 'CSU',
        bg: '#F2F7F6',
        text: '#00594E',
        border: '#B2CFCB',
      };
    case 'ca':
      return {
        label: 'Consejo Académico',
        bg: '#F7F5EE',
        text: '#786832',
        border: '#DBD2B0',
      };
    case 'rectoria':
      return {
        label: 'Rectoría',
        bg: '#E8F2F0',
        text: '#00443B',
        border: '#9DC4BE',
      };
    case 'electoral':
      return {
        label: 'Consejo Electoral',
        bg: '#FAF7ED',
        text: '#786832',
        border: '#D5C694',
      };
    default:
      return {
        label: 'Colegiado',
        bg: '#F8FAFC',
        text: '#475569',
        border: '#DCE4E3',
      };
  }
}

function getVigenciaStyle(vig: string) {
  const lower = String(vig || 'vigente').toLowerCase().trim();
  if (lower === 'derogado') {
    return {
      key: 'derogado',
      label: 'Derogado',
      bg: '#F1F5F9',
      text: '#475569',
      border: '#CBD5E1',
      dot: '#64748B',
    };
  }
  if (lower === 'modificado') {
    return {
      key: 'modificado',
      label: 'Modificado',
      bg: '#F7F5EE',
      text: '#786832',
      border: '#DBD2B0',
      dot: '#B5A160',
    };
  }
  return {
    key: 'vigente',
    label: 'Vigente',
    bg: '#F2F7F6',
    text: '#00594E',
    border: '#B2CFCB',
    dot: '#00594E',
  };
}

const normasView = rawNormas.map((norma: any) => ({
  ...norma,
  organStyle: getOrganStyle(norma.organo_code),
  vigStyle: getVigenciaStyle(norma.vigencia),
}));
---

<AppLayout title="Cuerpos Colegiados y Normativa" activeNav="normas">
  <div class="normas-bento-shell">
    <!-- Cabecera Ejecutiva Bento -->
    <section class="normas-hero-bento">
      <div class="normas-hero-info">
        <div class="normas-eyebrow-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>COMPENDIO NORMATIVO INSTITUCIONAL</span>
        </div>
        <h2 class="normas-hero-title">Sistematización de Actos y Cuerpos Colegiados</h2>
        <p class="normas-hero-subtitle">
          Repositorio oficial de acuerdos y resoluciones expedidos por el Consejo Superior Universitario, Consejo Académico, Rectoría y Consejo Electoral.
        </p>
      </div>

      <div class="normas-hero-actions">
        <button class="btn-normas-primary" id="btn-open-new-norma-modal" type="button">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M12 5v14M5 12h14"/></svg>
          <span>Radicar Nuevo Acto / Norma</span>
        </button>
      </div>
    </section>

    <!-- Bento KPI Strip con Chart Elements -->
    <section class="normas-kpi-grid" aria-label="Resumen por cuerpo colegiado">
      <article class="normas-kpi-card accent-verde">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Total Actos Sistematizados</span>
          <span class="normas-kpi-icon verde">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{total}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Estado vigente</span>
            <strong style="color: #00594E;">{vigentesCount} ({vigentesPct}%)</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${vigentesPct}%; background: #00594E;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-verde">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Consejo Superior (CSU)</span>
          <span class="normas-kpi-icon verde">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{csuCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Participación CSU</span>
            <strong style="color: #00594E;">{csuPct}% del compendio</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${csuPct}%; background: #00594E;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-dorado">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Consejo Académico (CA)</span>
          <span class="normas-kpi-icon dorado">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{caCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Participación CA</span>
            <strong style="color: #786832;">{caPct}% del compendio</strong>
          </div>
          <div class="normas-chart-track">
            <div class="normas-chart-fill" style={`width: ${caPct}%; background: #B5A160;`}></div>
          </div>
        </div>
      </article>

      <article class="normas-kpi-card accent-dorado">
        <div class="normas-kpi-top">
          <span class="normas-kpi-label">Rectoría y Electoral</span>
          <span class="normas-kpi-icon dorado">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </span>
        </div>
        <div class="normas-kpi-value">{otrosCount}</div>
        <div class="normas-chart-block">
          <div class="normas-chart-meta">
            <span>Rectoría {recCount} &middot; Electoral {eleCount}</span>
            <strong style="color: #786832;">{recPct + elePct}%</strong>
          </div>
          <div class="normas-chart-track" style="display: flex;">
            <div class="normas-chart-fill" style={`width: ${recPct}%; background: #00594E; border-radius: 999px 0 0 999px;`}></div>
            <div class="normas-chart-fill" style={`width: ${elePct}%; background: #B5A160; border-radius: 0 999px 999px 0;`}></div>
          </div>
        </div>
      </article>
    </section>

    <!-- Panel Principal Bento: Filtros + Tabla Scrollable Pro Max -->
    <section class="normas-main-panel">
      <!-- Píldoras Interactivas por Órgano Colegiado -->
      <div class="normas-tabs-bar" id="normas-module-tabs" role="tablist" aria-label="Filtrar por cuerpo colegiado">
        <button type="button" class="module-tab-btn active" data-org="all">
          <span>Todos los Órganos</span>
          <span class="tab-count" id="normas-count-all">{total}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="csu">
          <span>Consejo Superior (CSU)</span>
          <span class="tab-count" id="normas-count-csu">{csuCount}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="ca">
          <span>Consejo Académico (CA)</span>
          <span class="tab-count" id="normas-count-ca">{caCount}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="rectoria">
          <span>Rectoría</span>
          <span class="tab-count" id="normas-count-rectoria">{recCount}</span>
        </button>
        <button type="button" class="module-tab-btn" data-org="electoral">
          <span>Consejo Electoral</span>
          <span class="tab-count" id="normas-count-electoral">{eleCount}</span>
        </button>
      </div>

      <!-- Barra de Búsqueda y Vigencia -->
      <div class="normas-toolbar">
        <div class="normas-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="text"
            id="normas-search-input"
            placeholder="Buscar por número (Ej: Acuerdo 014), descriptor temático o palabra clave..."
          />
        </div>

        <div class="normas-toolbar-right">
          <select class="normas-select-vigencia" id="normas-filter-vigencia" aria-label="Filtrar por vigencia">
            <option value="all" selected>Todas las Vigencias</option>
            <option value="vigente">Solo Vigentes</option>
            <option value="modificado">Modificados</option>
            <option value="derogado">Derogados</option>
          </select>

          <div class="normas-visible-badge">
            <span>Mostrando</span>
            <strong id="normas-visible-count">{total}</strong>
            <span>de {total}</span>
          </div>
        </div>
      </div>

      <!-- Contenedor con Scrollbar Propia (.pro-scroll-container) y Cabecera Sticky -->
      <div class="normas-scroll-box pro-scroll-container" id="normas-scroll-container">
        {normasView.length > 0 ? (
          <table class="normas-pro-table">
            <thead>
              <tr>
                <th style="width: 175px;">Órgano Colegiado</th>
                <th style="width: 165px;">Acto / Consecutivo</th>
                <th>Título Oficial y Descriptor Temático</th>
                <th style="width: 195px;">Expedición y Signatarios</th>
                <th style="width: 120px;">Vigencia</th>
                <th style="width: 130px; text-align: right;">Documento</th>
              </tr>
            </thead>
            <tbody id="normas-table-body">
              {normasView.map((norma: any) => (
                <tr
                  class="norma-row colegiado-card"
                  data-org={norma.organo_code}
                  data-vigencia={norma.vigStyle.key}
                >
                  <td>
                    <span
                      class="norma-organ-pill"
                      style={`background: ${norma.organStyle.bg}; color: ${norma.organStyle.text}; border: 1px solid ${norma.organStyle.border};`}
                    >
                      {norma.organo || norma.organStyle.label}
                    </span>
                  </td>
                  <td>
                    <div class="norma-consecutivo-wrap">
                      <span class="norma-numero-chip">{norma.numero}</span>
                      <span class="norma-tipo-label">{norma.tipo}</span>
                    </div>
                  </td>
                  <td>
                    <div class="norma-titulo-main">{norma.titulo}</div>
                    <div class="norma-meta-sub">
                      {norma.descriptor && (
                        <span class="norma-descriptor-tag">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                          <span>{norma.descriptor}</span>
                        </span>
                      )}
                      {norma.resumen && norma.resumen !== norma.titulo && (
                        <span class="norma-resumen-text">{norma.resumen}</span>
                      )}
                    </div>
                  </td>
                  <td>
                    <div class="norma-fecha-line">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      <span>{norma.fecha || 'Sin fecha'}</span>
                    </div>
                    <div class="norma-signatario-line">{norma.signatarios || 'Secretaría General'}</div>
                  </td>
                  <td>
                    <span
                      class="norma-vigencia-badge"
                      style={`background: ${norma.vigStyle.bg}; color: ${norma.vigStyle.text}; border: 1px solid ${norma.vigStyle.border};`}
                    >
                      <span class="norma-vig-dot" style={`background: ${norma.vigStyle.dot};`}></span>
                      <span>{norma.vigStyle.label}</span>
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button
                      type="button"
                      class="btn-norma-download"
                      data-norma-label={`${norma.tipo} ${norma.numero}`}
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      <span>PDF</span>
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div class="normas-empty-state">
            <div class="normas-empty-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div class="normas-empty-title">No hay actos ni normas sistematizadas actualmente</div>
            <p class="normas-empty-desc">Utilice el botón superior para radicar el primer acto administrativo oficial.</p>
          </div>
        )}

        <div id="normas-filter-empty" class="normas-empty-state" style="display: none;">
          <div class="normas-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </div>
          <div class="normas-empty-title">Sin coincidencias para este filtro</div>
          <p class="normas-empty-desc">Ajuste el órgano colegiado, la vigencia o las palabras clave de búsqueda.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal para radicar nuevo acto administrativo -->
  <div class="modal-backdrop" id="new-norma-modal" style="display: none;">
    <div class="modal-card normas-modal-card" style="max-width: 600px;">
      <div class="modal-header" style="border-bottom: 1px solid #DCE4E3; background: #F2F7F6;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 34px; height: 34px; border-radius: 9px; background: #00594E; color: #FFFFFF; display: flex; align-items: center; justify-content: center;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          </div>
          <h3 style="margin: 0; font-size: 1.02rem; font-weight: 800; color: #111827;">Radicar Nuevo Acto / Norma</h3>
        </div>
        <button type="button" class="btn-close-modal" id="btn-close-new-norma-modal" aria-label="Cerrar modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="form-new-norma">
          <div class="form-group">
            <label class="form-label">Cuerpo Colegiado *</label>
            <select class="form-select normas-input" id="new-norma-organo" required>
              <option value="csu">Consejo Superior Universitario (CSU)</option>
              <option value="ca">Consejo Académico (CA)</option>
              <option value="rectoria">Rectoría (Resolución Rectoral)</option>
              <option value="electoral">Consejo Electoral</option>
            </select>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Tipo de Acto *</label>
              <input type="text" class="form-input normas-input" id="new-norma-tipo" placeholder="Ej: Acuerdo o Resolución" required />
            </div>
            <div class="form-group">
              <label class="form-label">Número / Consecutivo *</label>
              <input type="text" class="form-input normas-input" id="new-norma-numero" placeholder="Ej: Acuerdo 015" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Título Oficial *</label>
            <textarea class="form-textarea normas-input" id="new-norma-titulo" rows="2" placeholder="Por el cual se adopta..." required></textarea>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label class="form-label">Fecha de Expedición *</label>
              <input type="date" class="form-input normas-input" id="new-norma-fecha" required />
            </div>
            <div class="form-group">
              <label class="form-label">Descriptor Temático</label>
              <input type="text" class="form-input normas-input" id="new-norma-descriptor" placeholder="Ej: Régimen Profesoral" />
            </div>
          </div>
          <div class="modal-footer" style="padding: 14px 0 0 0; border-top: 1px solid #DCE4E3; margin-top: 6px;">
            <button type="button" class="btn btn-ghost" id="btn-cancel-norma">Cancelar</button>
            <button type="submit" class="btn-normas-primary" id="btn-submit-norma">Guardar Acto</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    .normas-bento-shell {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .normas-hero-bento {
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-left: 4px solid #00594E;
      border-radius: 16px;
      padding: 20px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      box-shadow: 0 2px 10px rgba(17, 24, 39, 0.03);
    }

    .normas-eyebrow-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: #786832;
      background: #F7F5EE;
      border: 1px solid #DBD2B0;
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 8px;
    }

    .normas-hero-title {
      margin: 0;
      font-size: 1.28rem;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.02em;
    }

    .normas-hero-subtitle {
      margin: 4px 0 0 0;
      font-size: 0.85rem;
      color: #475569;
      max-width: 680px;
      line-height: 1.45;
    }

    .btn-normas-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 10px;
      border: none;
      background: #00594E;
      color: #FFFFFF;
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
      box-shadow: 0 4px 12px rgba(0, 89, 78, 0.2);
      white-space: nowrap;
    }

    .btn-normas-primary:hover {
      background: #00443B;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(0, 89, 78, 0.25);
    }

    /* Bento KPI Strip */
    .normas-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .normas-kpi-card {
      background: #FFFFFF;
      border: 1px solid #DCE4E3;
      border-radius: 14px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 2px 8px rgba(17, 24, 39, 0.025);
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .normas-kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 89, 78, 0.08);
    }

    .normas-kpi-card.accent-verde {
      border-top: 3px solid #00594E;
    }

    .normas-kpi-card.accent-dorado {
      border-top: 3px solid #B5A160;
    }

    .normas-kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

