---
// src/pages/consulta-respuesta.astro
export const prerender = false;

import Layout from '@layouts/Layout.astro';
---

<Layout title="Consulta de Respuesta Oficial — SGD Unitrópico">
  <div class="consulta-page-wrapper">
    
    <!-- ENCABEZADO INSTITUCIONAL SUPERIOR -->
    <header class="consulta-navbar">
      <div class="navbar-content">
        <div class="brand-group">
          <div class="logo-box">
            <img src="/logo-unitropico.png" alt="Unitrópico" class="nav-logo" onerror="this.style.display='none'" />
          </div>
          <div class="brand-text">
            <span class="sub-portal-tag">• PORTAL OFICIAL DE CONSULTA DOCUMENTAL • UNITRÓPICO</span>
            <h1 class="portal-main-title">Entrega de Respuestas Oficiales y Expedientes</h1>
          </div>
        </div>
        <div class="nav-right">
          <span class="badge-ley">Ley 1755 de 2015</span>
        </div>
      </div>
      <div class="gold-accent-line"></div>
    </header>

    <main class="consulta-main-content">

      <!-- ===================================================================
           PANTALLA 1: FORMULARIO DE ACCESO Y VALIDACIÓN (CANDADO 10 DÍAS)
           =================================================================== -->
      <section id="auth-section" class="auth-container">
        
        <div class="auth-bento-card">
          <div class="auth-icon-circle">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>

          <h2 class="auth-title">Consulta de Respuesta Oficial</h2>
          <p class="auth-subtitle">
            Ingrese el número de radicado, su correo electrónico y el código de seguridad (PIN de 6 dígitos) remitido en la notificación institucional para consultar su respuesta oficial y descargar los anexos.
          </p>

          <!-- Banner Informativo de Vigencia 10 Días -->
          <div class="vigencia-info-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><strong>Vigencia Temporal:</strong> El acceso a los anexos del expediente se mantiene activo durante <strong>10 días calendario</strong> contados a partir del envío de la respuesta.</span>
          </div>

          <form id="form-consulta-auth" class="auth-form" autocomplete="off">
            <div class="form-group">
              <label for="input-radicado" class="form-label">
                NÚMERO DE RADICADO *
              </label>
              <div class="input-icon-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <input 
                  type="text" 
                  id="input-radicado" 
                  name="radicado" 
                  class="form-input" 
                  placeholder="Ej: RAD-2026-00019" 
                  required 
                  style="text-transform: uppercase; font-family: monospace; font-weight: 700; letter-spacing: 0.5px;"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="input-email" class="form-label">
                CORREO ELECTRÓNICO REGISTRADO *
              </label>
              <div class="input-icon-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <input 
                  type="email" 
                  id="input-email" 
                  name="email" 
                  class="form-input" 
                  placeholder="ejemplo@correo.com" 
                  required 
                />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label for="input-pin" class="form-label">
                  CÓDIGO DE SEGURIDAD (PIN DE 6 DÍGITOS) *
                </label>
                <span class="badge-anti-enum">Confidencial</span>
              </div>
              <div class="input-icon-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input 
                  type="text" 
                  id="input-pin" 
                  name="pin" 
                  class="form-input" 
                  placeholder="6 dígitos (ej: 492810)" 
                  maxlength="8" 
                  required 
                  style="font-family: monospace; font-weight: 800; font-size: 1.1rem; letter-spacing: 3px;"
                />
              </div>
            </div>

            <div id="auth-error-box" class="auth-alert-box error" style="display: none;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span id="auth-error-msg">Error de autenticación</span>
            </div>

            <button type="submit" id="btn-submit-auth" class="btn-primary-consulta">
              <span id="btn-text">Consultar y Desbloquear Expediente</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>

          <footer class="auth-card-footer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Trazabilidad y fe pública garantizada &bull; Universidad Internacional del Trópico Americano</span>
          </footer>
        </div>

      </section>

      <!-- ===================================================================
           PANTALLA 2: VISTA DEL PRONUNCIAMIENTO Y EXPEDIENTE (CROSSFADE)
           =================================================================== -->
      <section id="expediente-section" class="expediente-container" style="display: none;">
        
        <!-- BARRA SUPERIOR DE VIGENCIA Y SALIDA -->
        <div class="vigencia-banner">
          <div class="vigencia-left">
            <div class="pulse-dot"></div>
            <div>
              <strong style="color: #006837; font-size: 0.88rem;">Expediente Oficial Desbloqueado</strong>
              <div style="font-size: 0.78rem; color: #475569;" id="disp-vigencia-text">
                Acceso temporal habilitado hasta el [Fecha] (Quedan [X] días)
              </div>
            </div>
          </div>
          <button type="button" id="btn-logout" class="btn-logout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Finalizar Consulta</span>
          </button>
        </div>

        <!-- TARJETA BENTO EJECUTIVA: RESPUESTA OFICIAL DEL FUNCIONARIO -->
        <article class="bento-card respuesta-oficial-card">
          <div class="respuesta-card-header">
            <div class="chips-row">
              <span class="chip-radicado" id="disp-radicado">RAD-2026-XXXXX</span>
              <span class="chip-estado-respondida">Respondida Formalmente</span>
            </div>
            <span class="emision-fecha" id="disp-fecha-emision">Fecha de emisión: --</span>
          </div>

          <h2 class="asunto-title" id="disp-asunto">Asunto de la Petición</h2>

          <div class="funcionario-sign-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Pronunciamiento emitido por: <strong id="disp-funcionario">Oficina de Correspondencia y Gestión Documental</strong></span>
          </div>

          <!-- CONTENIDO TEXTUAL DE LA RESPUESTA OFICIAL -->
          <div class="respuesta-text-container">
            <div class="respuesta-text-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              <span>TEXTO DEL PRONUNCIAMIENTO INSTITUCIONAL</span>
            </div>
            <div class="respuesta-text-body" id="disp-mensaje-respuesta">
              Cargando respuesta oficial...
            </div>
          </div>

          <!-- ENLACE EXTERNO DRIVE (SI APLICA) -->
          <div id="drive-link-box" class="drive-link-box" style="display: none;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              <div>
                <strong style="color: #0f172a; font-size: 0.88rem;">Repositorio Complementario Externo</strong>
                <p style="margin: 2px 0 0 0; font-size: 0.78rem; color: #475569;">El funcionario adjuntó un repositorio adicional con documentos o material audiovisual complementario.</p>
              </div>
            </div>
            <a id="drive-link-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn-external-drive">
              <span>Abrir Repositorio Compartido</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>

          <!-- METADATOS COMPACTOS DEL RADICADO -->
          <div class="metadatos-grid">
            <div class="meta-item">
              <span class="meta-label">Solicitante:</span>
              <span class="meta-val" id="disp-solicitante">--</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Tipo de Persona:</span>
              <span class="meta-val" id="disp-tipo-sol">--</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Fecha Radicación:</span>
              <span class="meta-val" id="disp-fecha-rad">--</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Categoría Legal:</span>
              <span class="meta-val" id="disp-categoria">--</span>
            </div>
          </div>
        </article>

        <!-- EXPLORADOR DE SOPORTES Y SUBCARPETAS -->
        <section class="anexos-explorer-section">
          <div class="explorer-section-header">
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              <h3 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: #0f172a;">Anexos y Documentos de Soporte del Expediente</h3>
            </div>
            <span class="badge-total-files" id="disp-total-files">0 archivos disponibles</span>
          </div>

          <!-- CONTENEDOR DINÁMICO DE SUBCARPETAS (1A, 1B, ETC.) -->
          <div id="subcarpetas-container" class="subcarpetas-container">
            <!-- Inyectado dinámicamente -->
          </div>
        </section>

      </section>

      <!-- ===================================================================
           PANTALLA 3: ENLACE CADUCADO / ACCESO EXPIRADO
           =================================================================== -->
      <section id="expired-section" class="auth-container" style="display: none;">
        <div class="auth-bento-card expired">
          <div class="expired-icon-circle">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#991b1b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: #991b1b; margin: 12px 0 6px 0;">Enlace Temporal Vencido (Plazo de 10 días finalizado)</h2>
          <p id="expired-detail-text" style="font-size: 0.88rem; color: #475569; line-height: 1.6; margin: 0 0 20px 0;">
            El periodo habilitado de 10 días calendario para consultar y descargar los documentos de este radicado ha vencido. Por políticas de seguridad documental, el acceso público ha sido cerrado.
          </p>
          <div class="expired-instruction-box">
            <strong>¿Necesita una copia de su respuesta o anexos?</strong>
            <p style="margin: 6px 0 0 0; font-size: 0.80rem; color: #64748b; line-height: 1.5;">
              Por políticas de seguridad y conservación documental, los enlaces temporales de descarga pública se inhabilitan automáticamente tras 10 días. Si requiere una copia formal de este expediente, por favor comuníquese con la Oficina de Gestión Documental y Correspondencia de Unitrópico indicando el número de su radicado.
            </p>
          </div>
          <button type="button" class="btn-primary-consulta" style="margin-top: 20px;" onclick="window.location.href='/consulta-respuesta'">
            <span>Consultar Otro Radicado</span>
          </button>
        </div>
      </section>

    </main>

    <!-- PIE DE PÁGINA INSTITUCIONAL -->
    <footer class="consulta-footer">
      <div class="footer-inner">
        <div>
          <strong style="color: #006837; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px;">Universidad Internacional del Trópico Americano — Unitrópico</strong>
          <div style="font-size: 0.74rem; color: #64748b; margin-top: 3px;">
            Sede Principal: Carrera 19 No. 39-40, Yopal, Casanare, Colombia &bull; Personería Jurídica Res. 1311/2002 MinEducación
          </div>
        </div>
        <div style="font-size: 0.72rem; color: #94a3b8; text-align: right;">
          Sistema de Gestión Documental y Archivo Central &bull; 2026
        </div>
      </div>
    </footer>

  </div>
</Layout>

<style>
  :root {
    --green-main: #006837;
    --green-dark: #052e16;
    --green-light: #f0fdf4;
    --green-border: #bbf7d0;
    --gold-main: #b8860b;
    --gold-light: #fefce8;
    --gold-border: #fef08a;
    --slate-text: #0f172a;
    --slate-muted: #64748b;
    --bg-page: #f8fafc;
    --card-border: rgba(15, 23, 42, 0.08);
  }

  .consulta-page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-page);
    font-family: 'Montserrat', -apple-system, sans-serif;
  }

  /* BARRA DE NAVEGACIÓN INSTITUCIONAL */
  .consulta-navbar {
    background: #006837;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 10px rgba(0, 50, 25, 0.2);
  }
  .navbar-content {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .logo-box {
    background: #ffffff;
    padding: 4px 8px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-logo {
    height: 32px;
    width: auto;
  }
  .sub-portal-tag {
    font-size: 0.65rem;
    font-weight: 800;
    color: #fde68a;
    letter-spacing: 1px;
    display: block;
  }
  .portal-main-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    margin: 2px 0 0 0;
    letter-spacing: 0.2px;
  }
  .badge-ley {
    font-size: 0.70rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .gold-accent-line {
    height: 3px;
    background: #b8860b;
    width: 100%;
  }

  .consulta-main-content {
    flex: 1;
    max-width: 1100px;
    width: 100%;
    margin: 32px auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* PANTALLA 1: TARJETA DE ACCESO */
  .auth-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
  }
  .auth-bento-card {
    background: #ffffff;
    border: 1px solid var(--card-border);
    border-top: 4px solid var(--green-main);
    border-radius: 14px;
    padding: 36px 32px;
    max-width: 520px;
    width: 100%;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    text-align: center;
  }
  .auth-bento-card.expired {
    border-top-color: #991b1b;
  }
  .auth-icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green-light);
    border: 1px solid var(--green-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px auto;
  }
  .expired-icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #fef2f2;
    border: 1px solid #fecaca;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px auto;
  }
  .auth-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--slate-text);
    margin: 0 0 8px 0;
  }
  .auth-subtitle {
    font-size: 0.84rem;
    color: var(--slate-muted);
    line-height: 1.6;
    margin: 0 0 20px 0;
  }
  .vigencia-info-pill {
    background: var(--gold-light);
    border: 1px solid var(--gold-border);
    border-left: 3px solid var(--gold-main);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.78rem;
    color: #854d0e;
    text-align: left;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 24px;
    line-height: 1.45;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .form-label {
    font-size: 0.72rem;
    font-weight: 750;
    color: #334155;
    letter-spacing: 0.5px;
  }
  .badge-anti-enum {
    font-size: 0.65rem;
    font-weight: 700;
    color: #854d0e;
    background: var(--gold-light);
    border: 1px solid var(--gold-border);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .input-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-icon-wrapper svg {
    position: absolute;
    left: 12px;
    pointer-events: none;
  }
  .form-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px 11px 38px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.88rem;
    color: #0f172a;
    background: #ffffff;
    transition: all 0.2s ease;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--green-main);
    box-shadow: 0 0 0 3px rgba(0, 104, 55, 0.12);
  }

  .auth-alert-box {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.80rem;
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.4;
  }
  .auth-alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .btn-primary-consulta {
    background: #006837;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    box-shadow: 0 3px 10px rgba(0, 104, 55, 0.2);
    transition: all 0.2s ease;
  }
  .btn-primary-consulta:hover {
    background: #052e16;
  }
  .btn-primary-consulta:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .auth-card-footer {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid #f1f5f9;
    font-size: 0.72rem;
    color: var(--slate-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .expired-instruction-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px 16px;
    text-align: left;
    font-size: 0.82rem;
  }

  /* PANTALLA 2: VISTA EXPEDIENTE */
  .expediente-container {
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: fadeIn 0.35s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .vigencia-banner {
    background: #ffffff;
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--green-main);
    border-radius: 10px;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
  }
  .vigencia-left {
    display: flex;
