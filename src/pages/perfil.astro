---
// src/pages/perfil.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
---

<AppLayout title="Mi Perfil Institucional" activeNav="perfil">
  <div class="module-board-card profile-board-card">
    
    <!-- Encabezado Compacto del Módulo -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 14px; border-bottom: 1.5px solid #E2E8F0; margin-bottom: 18px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 36px; height: 36px; border-radius: 10px; background: #F2F7F6; border: 1.5px solid #B2CFCB; display: flex; align-items: center; justify-content: center; color: #00594E; flex-shrink: 0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div>
          <h1 style="font-size: 1.25rem; font-weight: 800; color: #111827; margin: 0; line-height: 1.2;">Mi Perfil Institucional</h1>
          <span style="font-size: 0.74rem; color: #52606D;">Identidad oficial, credenciales y seguridad de acceso en el SGD Unitrópico</span>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 6px; background: #F0FDF4; border: 1px solid #BBF7D0; padding: 4px 12px; border-radius: 999px;">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: #16A34A;"></span>
        <span style="font-size: 0.72rem; font-weight: 750; color: #166534;">Sesión Activa Oficial</span>
      </div>
    </div>

    <!-- Bento Grid Compacto en 2 Columnas (Zero-Scroll) -->
    <div class="profile-bento-grid">
      
      <!-- COLUMNA 1 (IZQUIERDA, 300px): Identidad y Ficha Institucional -->
      <div class="profile-card-col profile-card-left">
        
        <!-- Tarjeta de Identidad y Avatar Compacto (64px) -->
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; padding-bottom: 14px; border-bottom: 1px solid #E2E8F0;">
          <div class="avatar-upload-wrap" style="position: relative; margin-bottom: 10px;">
            <div class="avatar-preview-box" id="avatar-preview-box" style="width: 64px; height: 64px; border-radius: 50%; background: #E6EFEF; border: 2.5px solid #00594E; box-shadow: 0 2px 8px rgba(0,89,78,0.15); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 800; color: #00594E; overflow: hidden;">
              <span id="profile-avatar-initials">CL</span>
              <img id="profile-avatar-img" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
            </div>
            <label for="avatar-file-input" class="btn-avatar-camera" id="btn-avatar-camera" title="Cambiar foto institucional" style="position: absolute; bottom: -2px; right: -2px; width: 24px; height: 24px; background: #B5A160; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 2px solid #FFFFFF; box-shadow: 0 2px 6px rgba(0,0,0,0.2); color: #FFFFFF;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </label>
            <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp" style="display: none;" />
          </div>

          <h2 id="profile-name-display" style="font-size: 1.05rem; font-weight: 800; color: #111827; margin: 0 0 4px 0; line-height: 1.25;">Cargando perfil...</h2>
          <span class="role-badge admin" id="profile-role-badge" style="background: #F7F5EE; color: #786832; border: 1px solid #DBD2B0; font-weight: 800; font-size: 0.68rem; padding: 2px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">ADMINISTRADOR</span>
          <p id="profile-cargo-display" style="font-size: 0.76rem; color: #52606D; margin: 0; font-weight: 500;">
            Despacho Institucional &bull; SGD
          </p>
        </div>

        <!-- Metadatos protegidos (Solo Lectura) -->
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;">
              <label style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase;">Correo Institucional</label>
              <span style="font-size: 0.62rem; font-weight: 750; color: #DC2626; background: #FEE2E2; padding: 1px 6px; border-radius: 999px;">Inmutable</span>
            </div>
            <div style="position: relative;">
              <input type="email" id="input-email-locked" class="form-input-compact" value="cargando..." readonly disabled style="padding-right: 28px;" />
              <div style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); color: #94A3B8;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
            </div>
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;">
              <label style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase;">Rol Asignado</label>
              <span style="font-size: 0.62rem; font-weight: 750; color: #00594E; background: #E6EFEF; padding: 1px 6px; border-radius: 999px;">Protegido</span>
            </div>
            <input type="text" id="input-role-title" class="form-input-compact" value="Administrador General" readonly disabled />
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;">
              <label style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase;">Dependencia</label>
              <span style="font-size: 0.62rem; font-weight: 750; color: #786832; background: #F7F5EE; padding: 1px 6px; border-radius: 999px;">Protegido</span>
            </div>
            <input type="text" id="input-dependencia-title" class="form-input-compact" value="Despacho Institucional" readonly disabled />
          </div>
        </div>

      </div>

      <!-- COLUMNA 2 (DERECHA, 1fr): Edición de Nombre y Seguridad -->
      <div class="profile-card-col profile-card-right">
        
        <!-- Bloque 1: Edición de Nombre -->
        <div style="padding-bottom: 14px; border-bottom: 1px solid #E2E8F0;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <div style="width: 26px; height: 26px; border-radius: 6px; background: #E6EFEF; color: #00594E; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <div>
              <h3 style="font-size: 0.92rem; font-weight: 800; color: #111827; margin: 0;">Nombre Oficial del Funcionario</h3>
              <span style="font-size: 0.70rem; color: #52606D;">Nombre formal en oficios y radicaciones internas</span>
            </div>
          </div>

          <form id="form-profile-info" onsubmit="return false;" style="display: flex; flex-direction: column; gap: 6px;">
            <div style="display: flex; gap: 8px;">
              <input type="text" id="input-full-name" class="form-input-compact profile-custom-input" placeholder="Nombre Completo Institucional" required style="flex: 1;" />
              <button type="button" id="btn-save-name" style="background: #00594E; color: #FFFFFF; font-weight: 800; font-size: 0.78rem; padding: 0 16px; height: 38px; border: none; border-radius: 8px; cursor: pointer; white-space: nowrap; box-shadow: 0 1px 4px rgba(0,89,78,0.2);">
                Guardar Nombre
              </button>
            </div>
            <small id="name-save-status" style="font-size: 0.70rem; display: none; font-weight: 700;"></small>
          </form>
        </div>

        <!-- Bloque 2: Cambio de Contraseña -->
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <div style="width: 26px; height: 26px; border-radius: 6px; background: #F7F5EE; color: #786832; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
              <h3 style="font-size: 0.92rem; font-weight: 800; color: #111827; margin: 0;">Seguridad y Clave de Acceso</h3>
              <span style="font-size: 0.70rem; color: #52606D;">Actualización protegida de contraseña</span>
            </div>
          </div>

          <form id="form-change-password" style="display: flex; flex-direction: column; gap: 10px;">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
              <div class="form-group" style="grid-column: span 2;">
                <label for="current-password" style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase; margin-bottom: 2px; display: block;">Contraseña Actual</label>
                <input type="password" id="current-password" required placeholder="Contraseña actual" class="form-input-compact profile-custom-input" autocomplete="current-password" />
              </div>

              <div class="form-group">
                <label for="new-password" style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase; margin-bottom: 2px; display: block;">Nueva Contraseña</label>
                <input type="password" id="new-password" required placeholder="Mínimo 8 caracteres" class="form-input-compact profile-custom-input" autocomplete="new-password" />
              </div>

              <div class="form-group">
                <label for="confirm-password" style="font-size: 0.68rem; font-weight: 800; color: #52606D; text-transform: uppercase; margin-bottom: 2px; display: block;">Confirmar Nueva Contraseña</label>
                <input type="password" id="confirm-password" required placeholder="Repite contraseña" class="form-input-compact profile-custom-input" autocomplete="new-password" />
                <div id="password-match-msg" style="font-size: 0.68rem; margin-top: 2px; display: none;"></div>
              </div>
            </div>

            <!-- Criterios de Seguridad Compactos (2 Columnas) -->
            <div class="password-policy-box" id="password-policy-box" style="background: #F8FAFB; padding: 8px 12px; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 0.68rem;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px;">
                <div id="rule-length" style="color: #64748B; display: flex; align-items: center; gap: 5px;">
                  <span class="policy-dot" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #94A3B8;"></span> Mínimo 8 caracteres
                </div>
                <div id="rule-upper" style="color: #64748B; display: flex; align-items: center; gap: 5px;">
                  <span class="policy-dot" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #94A3B8;"></span> 1 Mayúscula (A-Z)
                </div>
                <div id="rule-lower" style="color: #64748B; display: flex; align-items: center; gap: 5px;">
                  <span class="policy-dot" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #94A3B8;"></span> 1 Minúscula (a-z)
                </div>
                <div id="rule-number" style="color: #64748B; display: flex; align-items: center; gap: 5px;">
                  <span class="policy-dot" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #94A3B8;"></span> 1 Número (0-9)
                </div>
                <div id="rule-special" style="color: #64748B; display: flex; align-items: center; gap: 5px; grid-column: span 2;">
                  <span class="policy-dot" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #94A3B8;"></span> 1 Carácter especial (!@#$%^&*...)
                </div>
              </div>
            </div>

            <!-- Botón de Guardar Contraseña alineado a la derecha -->
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 2px;">
              <div id="password-status-feedback" style="font-size: 0.74rem; font-weight: 700; display: none;"></div>
              <button type="submit" id="btn-submit-password" style="display: flex; align-items: center; justify-content: center; gap: 6px; height: 38px; padding: 0 20px; background: #00594E; border: none; border-radius: 8px; color: #FFFFFF; font-weight: 800; font-size: 0.80rem; cursor: pointer; box-shadow: 0 2px 6px rgba(0,89,78,0.2); white-space: nowrap;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
                <span>Actualizar Contraseña</span>
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>

  </div>

  <style>
    .profile-board-card {
      max-height: calc(100vh - 105px);
      box-sizing: border-box;
      overflow-y: auto;
      padding: 18px 22px !important;
    }
    .profile-bento-grid {
      display: grid;
      grid-template-columns: 290px 1fr;
      gap: 16px;
      align-items: start;
    }
    .profile-card-col {
      border-radius: 12px;
      padding: 14px 16px;
      box-sizing: border-box;
    }
    .profile-card-left {
      background: #F8FAFB;
      border: 1px solid #E2E8F0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .profile-card-right {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .form-input-compact {
      width: 100%;
      height: 38px;
      padding: 0 10px;
      border: 1px solid #CBD5E1;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.82rem;
      color: #111827;
      background: #FFFFFF;
      box-sizing: border-box;
      transition: all 0.15s ease;
    }
    .form-input-compact:focus,
    .profile-custom-input:focus {
      outline: none;
      border-color: #00594E !important;
      box-shadow: 0 0 0 2.5px rgba(0, 89, 78, 0.15) !important;
    }
    .form-input-compact:disabled {
      background: #F1F5F9;
      color: #334155;
      cursor: not-allowed;
      border-color: #E2E8F0;
    }
    @media (max-width: 860px) {
      .profile-bento-grid {
        grid-template-columns: 1fr !important;
      }
      .profile-board-card {
        max-height: none !important;
      }
    }
  </style>

  <script>
    import { supabase } from '@lib/supabase';

    let currentUserId = 'usr-root';
    let currentUserEmail = 'christianlemus.es@unitropico.edu.co';

    // 1. Cargar perfil desde Supabase y localStorage
    async function loadUserProfile() {
      const storedUser = localStorage.getItem('sgd_current_user');
      let user = null;
      if (storedUser) {
        try { user = JSON.parse(storedUser); } catch(e) {}
      }

      if (user) {
        currentUserId = user.id || 'usr-root';
        currentUserEmail = user.email || 'christianlemus.es@unitropico.edu.co';
      }

      const nameEl = document.getElementById('profile-name-display');
      const cargoEl = document.getElementById('profile-cargo-display');
      const badgeEl = document.getElementById('profile-role-badge');
      const inputName = document.getElementById('input-full-name') as HTMLInputElement;
      const inputEmail = document.getElementById('input-email-locked') as HTMLInputElement;
      const inputRole = document.getElementById('input-role-title') as HTMLInputElement;
      const inputCargo = document.getElementById('input-dependencia-title') as HTMLInputElement;
      const avatarInitials = document.getElementById('profile-avatar-initials');
      const img = document.getElementById('profile-avatar-img') as HTMLImageElement;

      // Consultar perfil real en Supabase
      try {
        const { data: profile, error } = await supabase
          .from('profiles')
          .select('*')
          .or(`id.eq.${currentUserId},email.eq.${currentUserEmail}`)
          .maybeSingle();

        if (profile && !error) {
          if (nameEl) nameEl.textContent = profile.full_name;
          if (cargoEl) cargoEl.textContent = profile.cargo || profile.role;
          if (inputName) inputName.value = profile.full_name;
          if (inputEmail) inputEmail.value = profile.email;
          if (inputRole) inputRole.value = profile.role === 'admin' ? 'Administrador General' : 'Funcionario Institucional';
          if (inputCargo) inputCargo.value = profile.cargo || 'Despacho Institucional';

          const isAdmin = profile.role === 'admin';
          if (badgeEl) {
            badgeEl.textContent = isAdmin ? 'ADMINISTRADOR' : 'FUNCIONARIO';
            badgeEl.className = isAdmin ? 'role-badge admin' : 'role-badge funcionario';
          }

          if (profile.avatar_url && img && avatarInitials) {
            img.src = profile.avatar_url;
            img.style.display = 'block';
            avatarInitials.style.display = 'none';
          } else if (avatarInitials) {
            const initials = profile.full_name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'UN';
            avatarInitials.textContent = initials;
          }
        } else if (user) {
          // Fallback a storedUser
          if (nameEl) nameEl.textContent = user.name || 'Usuario';
          if (inputName) inputName.value = user.name || '';
          if (inputEmail) inputEmail.value = user.email || '';
          if (inputRole) inputRole.value = user.role || '';
        }
      } catch (err) {
        console.warn('Error consultando perfil en Supabase:', err);
      }
    }

    // 2. Guardar Nombre Completo en Supabase (Profiles + Users + Audit)
    const btnSaveName = document.getElementById('btn-save-name');
    const inputName = document.getElementById('input-full-name') as HTMLInputElement;
    const nameStatus = document.getElementById('name-save-status');

    if (btnSaveName && inputName) {
      btnSaveName.addEventListener('click', async () => {
        const newName = inputName.value.trim();
        if (!newName) {
          window.showToast('Por favor ingresa un nombre válido.');
          return;
        }

        btnSaveName.textContent = 'Guardando...';
        (btnSaveName as HTMLButtonElement).disabled = true;

        try {
          const nowIso = new Date().toISOString();
          const targetId = currentUserId || 'usr-root';

          // Actualizar en tabla profiles
          const { error: pErr } = await supabase
            .from('profiles')
            .update({ full_name: newName, updated_at: nowIso })
            .eq('id', targetId);

          // Actualizar en tabla users
          await supabase
            .from('users')
            .update({ name: newName, updated_at: nowIso })
            .eq('id', targetId);

          // Actualizar vista local y global en vivo
          const nameEl = document.getElementById('profile-name-display');
          if (nameEl) nameEl.textContent = newName;
          document.querySelectorAll<HTMLElement>('[data-user-display-name], #user-display-name').forEach((el) => {
            el.textContent = newName;
          });

          // Actualizar localStorage y despachar evento en vivo
          localStorage.setItem('unitropico_user_name', newName);
          const storedUser = localStorage.getItem('sgd_current_user');
          if (storedUser) {
            try {
              const u = JSON.parse(storedUser);
              u.name = newName;
              localStorage.setItem('sgd_current_user', JSON.stringify(u));
            } catch(e) {}
          }
          window.dispatchEvent(new CustomEvent('unitropico:profile-updated', {
            detail: { nombre: newName }
          }));

          if (nameStatus) {
            nameStatus.style.display = 'block';
            nameStatus.style.color = '#059669';
            nameStatus.textContent = 'Nombre guardado exitosamente.';
            setTimeout(() => { nameStatus.style.display = 'none'; }, 4000);
          }
        } catch (err) {
          console.error('Error guardando nombre:', err);
          if (nameStatus) {
            nameStatus.style.display = 'block';
            nameStatus.style.color = '#dc2626';
            nameStatus.textContent = 'No se pudo guardar el nombre.';
          }
        } finally {
          btnSaveName.textContent = 'Guardar';
          (btnSaveName as HTMLButtonElement).disabled = false;
        }
      });
    }

    // 3. Subida de Avatar al bucket 'avatars' de Supabase Storage
    const avatarInput = document.getElementById('avatar-file-input') as HTMLInputElement;
    const btnAvatarCamera = document.getElementById('btn-avatar-camera');

    btnAvatarCamera?.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (typeof (window as any).abrirModalSubida === 'function') {
        const files = await (window as any).abrirModalSubida({
          titulo: 'Cambiar Foto Institucional',
          subtitulo: 'Arrastra tu foto de perfil o examina en tu equipo (PNG, JPG, WEBP)',
          accept: 'image/png,image/jpeg,image/webp',
          multiple: false,
          maxSizeMB: 5,
          textoConfirmar: 'Actualizar Foto',
        });
        if (files && files[0] && avatarInput) {
          const dt = new DataTransfer();
          dt.items.add(files[0]);
          avatarInput.files = dt.files;
          avatarInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      } else {
        avatarInput?.click();
      }
    });

    if (avatarInput) {
      avatarInput.addEventListener('change', async (e: Event) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
          window.showToast('La imagen no debe superar los 5 MB.');
          return;
        }

        const fileExt = file.name.split('.').pop() || 'png';
        const fileName = `${currentUserId}_${Date.now()}.${fileExt}`;

        try {
          // Subir archivo al bucket 'avatars' en Supabase Storage
          const { data, error } = await supabase.storage
            .from('avatars')
            .upload(fileName, file, { upsert: true });

          let publicUrl = '';
          if (!error && data) {
            const { data: urlData } = supabase.storage.from('avatars').getPublicUrl(fileName);
            publicUrl = urlData.publicUrl;
          } else {
            // DataURL de respaldo si falla storage directo
            publicUrl = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result as string);
              reader.readAsDataURL(file);
            });
          }

          const cacheBustedUrl = `${publicUrl}${publicUrl.includes('?') ? '&' : '?'}v=${Date.now()}`;

          // Actualizar avatar_url en tabla profiles de Supabase
          const targetId = currentUserId || 'usr-root';
          const updateFilter = currentUserEmail 
            ? `id.eq.${targetId},email.eq.${currentUserEmail}`
            : `id.eq.${targetId}`;

          await supabase
            .from('profiles')
            .update({ avatar_url: cacheBustedUrl, updated_at: new Date().toISOString() })
            .or(updateFilter);

          // Guardar y actualizar vista globalmente al instante sin recarga
          localStorage.setItem('unitropico_user_avatar', cacheBustedUrl);
          localStorage.setItem('sgd_user_avatar', cacheBustedUrl);
          localStorage.setItem(`sgd_avatar_${targetId}`, cacheBustedUrl);
          if (currentUserEmail) {
            localStorage.setItem(`sgd_avatar_${currentUserEmail}`, cacheBustedUrl);
          }
          const rawUser = localStorage.getItem("sgd_current_user");
          let uObj: any = {};
          if (rawUser) {
            try { uObj = JSON.parse(rawUser); } catch(e) {}
          }
          uObj.avatar_url = cacheBustedUrl;
          uObj.avatarUrl = cacheBustedUrl;
          localStorage.setItem("sgd_current_user", JSON.stringify(uObj));

          // Actualizar todas las instancias de avatar en el DOM al instante
          document.querySelectorAll<HTMLImageElement>('img[data-user-avatar], .global-user-avatar-img, .sidebar-user-card img, #profile-avatar-img, #sidebar-avatar-img').forEach((img) => {
            img.src = cacheBustedUrl;
            img.style.display = "block";
          });
          document.querySelectorAll<HTMLElement>('#sidebar-avatar-text, #profile-avatar-initials').forEach((init) => {
            init.style.display = "none";
          });

          if (window.currentLoggedUser) {
            window.currentLoggedUser.avatar_url = cacheBustedUrl;
            (window.currentLoggedUser as any).avatarUrl = cacheBustedUrl;
          }
          if (window.updateUserProfileUI) {
            window.updateUserProfileUI();
          }

          window.dispatchEvent(new CustomEvent("unitropico:profile-updated", {
            detail: {
              avatarUrl: cacheBustedUrl,
              nombre: document.getElementById('profile-name-display')?.textContent || ''
            }
          }));
          window.dispatchEvent(new CustomEvent("sgd-user-updated", { detail: { avatar_url: cacheBustedUrl } }));

          window.showToast('Foto de perfil actualizada correctamente.');
        } catch (err) {
          console.error('Error subiendo avatar:', err);
          window.showToast('No se pudo subir la foto de perfil.');
        }
      });
    }

    // 4. Validación Estricta de Contraseña en Tiempo Real
    const newPassInput = document.getElementById('new-password') as HTMLInputElement;
    const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement;
    const matchMsg = document.getElementById('password-match-msg');

    const ruleLength = document.getElementById('rule-length');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleLower = document.getElementById('rule-lower');
    const ruleNumber = document.getElementById('rule-number');
    const ruleSpecial = document.getElementById('rule-special');

    function checkRules(val: string): boolean {
      const hasLength = val.length >= 8;
      const hasUpper = /[A-Z]/.test(val);
      const hasLower = /[a-z]/.test(val);
      const hasNumber = /[0-9]/.test(val);
      const hasSpecial = /[^A-Za-z0-9]/.test(val);

      updateRuleUI(ruleLength, hasLength);
      updateRuleUI(ruleUpper, hasUpper);
      updateRuleUI(ruleLower, hasLower);
      updateRuleUI(ruleNumber, hasNumber);
      updateRuleUI(ruleSpecial, hasSpecial);

      return hasLength && hasUpper && hasLower && hasNumber && hasSpecial;
    }

    function updateRuleUI(el: HTMLElement | null, valid: boolean) {
      if (!el) return;
      const text = el.getAttribute('data-policy-label') || el.textContent?.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚ\s!@#$%^&*().-]/g, '').trim() || '';
      if (!el.getAttribute('data-policy-label')) el.setAttribute('data-policy-label', text);

      if (valid) {
        el.style.color = '#059669';
        el.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3" style="display: inline-block; vertical-align: middle;"><polyline points="20 6 9 17 4 12"/></svg> <span>${text}</span>`;
      } else {
        el.style.color = 'var(--text-muted)';
        el.innerHTML = `<span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--text-muted); margin: 0 3px; vertical-align: middle;"></span> <span>${text}</span>`;
      }
    }

    if (newPassInput) {
      newPassInput.addEventListener('input', () => {
        checkRules(newPassInput.value);
        checkMatch();
      });
    }

    if (confirmPassInput) {
      confirmPassInput.addEventListener('input', checkMatch);
    }

    function checkMatch() {
      if (!matchMsg || !confirmPassInput || !newPassInput) return;
      if (!confirmPassInput.value) {
        matchMsg.style.display = 'none';
        return;
      }
      matchMsg.style.display = 'block';
      if (confirmPassInput.value === newPassInput.value) {
        matchMsg.style.color = '#059669';
        matchMsg.textContent = 'Las contraseñas coinciden correctamente.';
      } else {
        matchMsg.style.color = '#DC2626';
        matchMsg.textContent = 'Las contraseñas no coinciden.';
      }
    }

    // 5. Envío del Formulario de Cambio de Contraseña vía Supabase Auth
    const passForm = document.getElementById('form-change-password');
    const statusFeedback = document.getElementById('password-status-feedback');

    if (passForm) {
      passForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const currentPass = (document.getElementById('current-password') as HTMLInputElement)?.value;
        const newPass = newPassInput?.value;
        const confirmPass = confirmPassInput?.value;

        if (!currentPass) {
          window.showToast('Por favor ingresa tu contraseña actual.');
          return;
        }

        if (!checkRules(newPass)) {
          window.showToast('La nueva contraseña no cumple con todos los criterios de seguridad institucional.');
          return;
        }

        if (newPass !== confirmPass) {
          window.showToast('La confirmación de la contraseña no coincide.');
          return;
        }

        const submitBtn = document.getElementById('btn-submit-password') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Actualizando contraseña...';
        }

        try {
          // Intentar actualizar contraseña a través del cliente oficial de Supabase Auth
          const { data, error } = await supabase.auth.updateUser({ password: newPass });

          // Desmarcar contraseña provisional en tabla profiles
          const targetId = currentUserId || 'usr-root';
          await supabase
            .from('profiles')
            .update({ is_provisional_password: false, updated_at: new Date().toISOString() })
            .eq('id', targetId);

          if (statusFeedback) {
            statusFeedback.style.display = 'block';
            statusFeedback.style.color = '#059669';
            statusFeedback.textContent = 'Contraseña institucional actualizada exitosamente.';
          }

          window.showToast('Contraseña actualizada exitosamente con los estándares de seguridad institucional.');
          (passForm as HTMLFormElement).reset();
          checkRules('');
          if (matchMsg) matchMsg.style.display = 'none';
        } catch (err: any) {
          console.error('Error al actualizar contraseña:', err);
          if (statusFeedback) {
            statusFeedback.style.display = 'block';
            statusFeedback.style.color = '#dc2626';
            statusFeedback.textContent = 'Error actualizando contraseña: ' + (err.message || 'Error de conexión');
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span>Actualizar Contraseña Institucional</span>
            `;
          }
        }
      });
    }

    // Inicializar de inmediato sin depender exclusivamente de DOMContentLoaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadUserProfile);
    } else {
      loadUserProfile();
    }
  </script>
</AppLayout>
