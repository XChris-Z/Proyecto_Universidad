---
// src/pages/perfil.astro
import AppLayout from '@layouts/AppLayout.astro';
import { supabase } from '@lib/supabase';
---

<AppLayout title="Mi Perfil Institucional" activeNav="perfil">
  <div class="profile-container" style="max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">
    
    <!-- Header del Perfil -->
    <div class="card profile-header-card" style="padding: 28px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap; border-left: 5px solid var(--verde-principal); background: #ffffff;">
      <div class="avatar-upload-wrap" style="position: relative;">
        <div class="avatar-preview-box" id="avatar-preview-box" style="width: 104px; height: 104px; border-radius: var(--radius-full); background: var(--verde-suave-bg); border: 3px solid var(--verde-borde); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: 800; color: var(--verde-principal); overflow: hidden; box-shadow: var(--shadow-sm);">
          <span id="profile-avatar-initials">CL</span>
          <img id="profile-avatar-img" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
        </div>
        <label for="avatar-file-input" class="btn-avatar-camera" title="Cambiar foto de perfil" style="position: absolute; bottom: 0; right: 0; width: 34px; height: 34px; background: var(--dorado-principal); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; cursor: pointer; border: 2px solid #ffffff; box-shadow: 0 2px 6px rgba(0,0,0,0.15); color: #ffffff;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </label>
        <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp" style="display: none;" />
      </div>

      <div class="profile-info-main" style="flex: 1; min-width: 260px;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h2 id="profile-name-display" style="font-size: 1.45rem; font-weight: 800; color: var(--text-main); margin: 0;">Dr. Cristian Lemus</h2>
          <span class="role-badge admin" id="profile-role-badge">ADMINISTRADOR</span>
        </div>
        <p id="profile-cargo-display" style="font-size: 0.88rem; color: var(--text-muted); margin: 4px 0 12px 0;">Rector Magnífico / Administrador del SGD</p>
        
        <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; background: var(--verde-suave-bg); color: var(--verde-principal); padding: 5px 12px; border-radius: var(--radius-sm); border: 1px solid var(--verde-borde);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Identidad Institucional Verificada en Supabase PostgreSQL</span>
        </div>
      </div>

      <div class="profile-quick-stats" style="display: flex; gap: 16px; border-left: 1px solid var(--border-color); padding-left: 20px;">
        <div>
          <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Estado de Cuenta</div>
          <div style="font-size: 0.95rem; font-weight: 800; color: var(--verde-principal); display: flex; align-items: center; gap: 6px; margin-top: 2px;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--verde-principal);"></span> Activo
          </div>
        </div>
      </div>
    </div>

    <!-- Grid de 2 Columnas: Datos Inmutables vs Cambio de Contraseña -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;" class="profile-grid-cols">
      
      <!-- Columna 1: Información Institucional (Email Bloqueado Estrictamente) -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle);">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--verde-suave-bg); color: var(--verde-principal); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">Datos del Funcionario</h3>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Información asignada por la administración</span>
          </div>
        </div>

        <form id="form-immutable-info" onsubmit="return false;" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nombre Completo</label>
            <input type="text" id="input-full-name" class="form-input" value="Dr. Cristian Lemus" readonly style="background: var(--bg-surface-elevated); cursor: not-allowed;" />
          </div>

          <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Correo Electrónico Institucional</label>
              <span style="font-size: 0.70rem; font-weight: 700; color: var(--verde-principal); background: var(--verde-suave-bg); padding: 2px 8px; border-radius: var(--radius-sm);">Inmutable</span>
            </div>
            <div style="position: relative;">
              <input type="email" id="input-email-locked" class="form-input" value="root@unitropico.edu.co" readonly disabled style="background: #F8FAFC; color: #475569; border-color: #E2E8F0; cursor: not-allowed; padding-right: 36px; font-weight: 600;" />
              <div style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted);" title="El correo electrónico es estrictamente inmutable por seguridad institucional.">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
            </div>
            <small style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px; display: block;">
              Protegido a nivel de motor de base de datos PostgreSQL mediante disparador (trigger) PL/pgSQL inmutable.
            </small>
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Rol en el Sistema</label>
            <input type="text" id="input-role-title" class="form-input" value="Administrador General" readonly style="background: var(--bg-surface-elevated); cursor: not-allowed;" />
          </div>

          <div class="form-group">
            <label style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Dependencia / Despacho</label>
            <input type="text" class="form-input" value="Despacho de Rectoría" readonly style="background: var(--bg-surface-elevated); cursor: not-allowed;" />
          </div>
        </form>
      </div>

      <!-- Columna 2: Cambio de Contraseña con Validación Estricta -->
      <div class="card" style="padding: 24px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border-subtle);">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--dorado-suave-bg); color: var(--dorado-oscuro); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div>
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">Seguridad y Contraseña</h3>
            <span style="font-size: 0.74rem; color: var(--text-muted);">Actualizar clave de acceso institucional</span>
          </div>
        </div>

        <form id="form-change-password" style="display: flex; flex-direction: column; gap: 14px;">
          <div class="form-group">
            <label for="current-password" style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Contraseña Actual</label>
            <input type="password" id="current-password" required placeholder="Ingresa tu contraseña actual" class="form-input" autocomplete="current-password" />
          </div>

          <div class="form-group">
            <label for="new-password" style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nueva Contraseña</label>
            <input type="password" id="new-password" required placeholder="Mínimo 8 caracteres seguros" class="form-input" autocomplete="new-password" />
          </div>

          <!-- Indicadores visuales de política estricta -->
          <div class="password-policy-box" style="background: var(--bg-surface-elevated); padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); font-size: 0.74rem; display: flex; flex-direction: column; gap: 6px;">
            <div style="font-weight: 700; color: var(--text-muted); margin-bottom: 2px;">Criterios de Seguridad Requeridos:</div>
            <div id="rule-length" style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span class="policy-icon">⚪</span> Mínimo 8 caracteres
            </div>
            <div id="rule-upper" style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span class="policy-icon">⚪</span> Al menos una letra mayúscula (A-Z)
            </div>
            <div id="rule-lower" style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span class="policy-icon">⚪</span> Al menos una letra minúscula (a-z)
            </div>
            <div id="rule-number" style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span class="policy-icon">⚪</span> Al menos un número (0-9)
            </div>
            <div id="rule-special" style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
              <span class="policy-icon">⚪</span> Al menos un carácter especial (!@#$%^&*...)
            </div>
          </div>

          <div class="form-group">
            <label for="confirm-password" style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Confirmar Nueva Contraseña</label>
            <input type="password" id="confirm-password" required placeholder="Repite la nueva contraseña" class="form-input" autocomplete="new-password" />
            <div id="password-match-msg" style="font-size: 0.72rem; margin-top: 4px; display: none;"></div>
          </div>

          <div style="margin-top: 6px;">
            <button type="submit" id="btn-submit-password" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 11px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span>Guardar Nueva Contraseña</span>
            </button>
          </div>
        </form>
      </div>

    </div>

  </div>

  <style>
    @media (max-width: 768px) {
      .profile-grid-cols {
        grid-template-columns: 1fr !important;
      }
    }
    .form-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.85rem;
      color: var(--text-main);
      transition: var(--transition-normal);
    }
    .form-input:focus {
      outline: none;
      border-color: var(--verde-principal);
      box-shadow: 0 0 0 3px var(--verde-suave-bg);
    }
  </style>

  <script>
    import { supabase } from '@lib/supabase';

    // 1. Cargar datos del usuario logueado desde sesión / localStorage
    function loadUserProfile() {
      const storedUser = localStorage.getItem('sgd_current_user');
      let user = null;
      if (storedUser) {
        try { user = JSON.parse(storedUser); } catch(e) {}
      }

      const nameEl = document.getElementById('profile-name-display');
      const cargoEl = document.getElementById('profile-cargo-display');
      const badgeEl = document.getElementById('profile-role-badge');
      const inputName = document.getElementById('input-full-name') as HTMLInputElement;
      const inputEmail = document.getElementById('input-email-locked') as HTMLInputElement;
      const inputRole = document.getElementById('input-role-title') as HTMLInputElement;
      const avatarInitials = document.getElementById('profile-avatar-initials');

      if (user) {
        if (nameEl) nameEl.textContent = user.name || 'Usuario';
        if (cargoEl) cargoEl.textContent = user.role || 'Funcionario';
        if (inputName) inputName.value = user.name || '';
        if (inputEmail) inputEmail.value = user.email || '';
        if (inputRole) inputRole.value = user.role || '';
        if (avatarInitials) avatarInitials.textContent = user.initials || 'UN';

        const isAdmin = user.roleId === 'admin' || user.roleId === 'role-root' || user.role?.toLowerCase().includes('admin');
        if (badgeEl) {
          badgeEl.textContent = isAdmin ? 'ADMINISTRADOR' : 'FUNCIONARIO';
          badgeEl.className = isAdmin ? 'role-badge admin' : 'role-badge funcionario';
        }

        // Cargar foto si ya existe
        const savedAvatar = localStorage.getItem(`sgd_avatar_${user.id}`);
        if (savedAvatar) {
          const img = document.getElementById('profile-avatar-img') as HTMLImageElement;
          if (img && avatarInitials) {
            img.src = savedAvatar;
            img.style.display = 'block';
            avatarInitials.style.display = 'none';
          }
        }
      }
    }

    // 2. Subida de Avatar al bucket 'avatars' de Supabase Storage
    const avatarInput = document.getElementById('avatar-file-input') as HTMLInputElement;
    if (avatarInput) {
      avatarInput.addEventListener('change', async (e: Event) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        // Validar tamaño (máximo 5MB)
        if (file.size > 5 * 1024 * 1024) {
          alert('La imagen no debe superar los 5 MB.');
          return;
        }

        const storedUser = localStorage.getItem('sgd_current_user');
        const userId = storedUser ? JSON.parse(storedUser).id : 'usr-default';
        const fileExt = file.name.split('.').pop() || 'png';
        const fileName = `${userId}_avatar_${Date.now()}.${fileExt}`;

        try {
          // Intentar subir a Supabase Storage bucket 'avatars'
          const { data, error } = await supabase.storage
            .from('avatars')
            .upload(fileName, file, { upsert: true });

          let publicUrl = '';
          if (!error && data) {
            const { data: urlData } = supabase.storage.from('avatars').getPublicUrl(fileName);
            publicUrl = urlData.publicUrl;
          } else {
            // Fallback a DataURL para visualización instantánea offline
            publicUrl = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result as string);
              reader.readAsDataURL(file);
            });
          }

          // Guardar y actualizar vista
          localStorage.setItem(`sgd_avatar_${userId}`, publicUrl);
          const img = document.getElementById('profile-avatar-img') as HTMLImageElement;
          const initials = document.getElementById('profile-avatar-initials');
          if (img && initials) {
            img.src = publicUrl;
            img.style.display = 'block';
            initials.style.display = 'none';
          }

          alert('Foto de perfil actualizada correctamente.');
        } catch (err) {
          console.error('Error subiendo avatar:', err);
          alert('No se pudo subir la foto de perfil.');
        }
      });
    }

    // 3. Validación Estricta de Contraseña en Tiempo Real
    const newPassInput = document.getElementById('new-password') as HTMLInputElement;
    const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement;
    const matchMsg = document.getElementById('password-match-msg');

    const ruleLength = document.getElementById('rule-length');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleLower = document.getElementById('rule-lower');
    const ruleNumber = document.getElementById('rule-number');
    const ruleSpecial = document.getElementById('rule-special');

    function checkRules(val: string): boolean {
      const hasLength = val.length >= 8;
      const hasUpper = /[A-Z]/.test(val);
      const hasLower = /[a-z]/.test(val);
      const hasNumber = /[0-9]/.test(val);
      const hasSpecial = /[^A-Za-z0-9]/.test(val);

      updateRuleUI(ruleLength, hasLength);
      updateRuleUI(ruleUpper, hasUpper);
      updateRuleUI(ruleLower, hasLower);
      updateRuleUI(ruleNumber, hasNumber);
      updateRuleUI(ruleSpecial, hasSpecial);

      return hasLength && hasUpper && hasLower && hasNumber && hasSpecial;
    }

    function updateRuleUI(el: HTMLElement | null, valid: boolean) {
      if (!el) return;
      if (valid) {
        el.style.color = '#059669';
        el.innerHTML = `<span style="color: #059669; font-weight: bold;">✔</span> ${el.textContent?.replace(/[⚪✔✖]/g, '').trim()}`;
      } else {
        el.style.color = 'var(--text-muted)';
        el.innerHTML = `<span style="color: var(--text-muted);">⚪</span> ${el.textContent?.replace(/[⚪✔✖]/g, '').trim()}`;
      }
    }

    if (newPassInput) {
      newPassInput.addEventListener('input', () => {
        checkRules(newPassInput.value);
        checkMatch();
      });
    }

    if (confirmPassInput) {
      confirmPassInput.addEventListener('input', checkMatch);
    }

    function checkMatch() {
      if (!matchMsg || !confirmPassInput || !newPassInput) return;
      if (!confirmPassInput.value) {
        matchMsg.style.display = 'none';
        return;
      }
      matchMsg.style.display = 'block';
      if (confirmPassInput.value === newPassInput.value) {
        matchMsg.style.color = '#059669';
        matchMsg.textContent = '✔ Las contraseñas coinciden correctamente.';
      } else {
        matchMsg.style.color = '#DC2626';
        matchMsg.textContent = '✖ Las contraseñas no coinciden.';
      }
    }

    // 4. Envío del Formulario de Cambio de Contraseña
    const passForm = document.getElementById('form-change-password');
    if (passForm) {
      passForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const currentPass = (document.getElementById('current-password') as HTMLInputElement)?.value;
        const newPass = newPassInput?.value;
        const confirmPass = confirmPassInput?.value;

        if (!currentPass) {
          alert('Por favor ingresa tu contraseña actual.');
          return;
        }

        if (!checkRules(newPass)) {
          alert('La nueva contraseña no cumple con todos los criterios de seguridad institucional.');
          return;
        }

        if (newPass !== confirmPass) {
          alert('La confirmación de la contraseña no coincide.');
          return;
        }

        // Simular éxito y guardar indicador de cambio
        alert('Contraseña actualizada exitosamente con los estándares de seguridad institucional.');
        (passForm as HTMLFormElement).reset();
        checkRules('');
        if (matchMsg) matchMsg.style.display = 'none';
      });
    }

    // Inicializar al cargar
    document.addEventListener('DOMContentLoaded', loadUserProfile);
  </script>
</AppLayout>

